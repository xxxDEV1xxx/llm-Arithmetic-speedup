# ---------- Configuration ----------
LOG_FILE = Path("/data/sda4/llm_benchmark.log")
DEFAULT_MODEL = "/usr/local/bin/llm.new"

# Make sure the log directory exists
LOG_FILE.parent.mkdir(parents=True, exist_ok=True)

def invoke_llm(prompt: str, timeout: int = 60, model: str = DEFAULT_MODEL) -> None:
    """Run one prompt, time it, and append result to the log file."""
    start_ns = time.perf_counter_ns()

    try:
        result = subprocess.run(
            [model],
            input=prompt + "\n",
            text=True,
            capture_output=True,
            timeout=timeout,
        )
        rc = result.returncode
        stdout = result.stdout.strip()
        stderr = result.stderr.strip()
    except subprocess.TimeoutExpired:
        rc = -1
        stdout = ""
        stderr = f"TIMEOUT after {timeout}s"
    except Exception as e:
        rc = -2
        stdout = ""
        stderr = f"ERROR: {e}"

    end_ns = time.perf_counter_ns()
    duration_ms = (end_ns - start_ns) / 1_000_000

    # Build log entry
    log_entry = (
        f"{'='*80}\n"
        f"PROMPT : {prompt}\n"
        f"MODEL  : {model}\n"
        f"EXIT   : {rc}\n"
        f"TIME   : {duration_ms:.3f} ms\n"
        f"STDOUT :\n{stdout}\n"
    )
    if stderr:
        log_entry += f"STDERR :\n{stderr}\n"
    log_entry += f"{'='*80}\n\n"

    # Append to log file
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(log_entry)


