            "of mathematics applied to astronomy, timekeeping, and surveying."
        )

    # Reflections about coordinate axes.
    if "reflection" in low and "y-axis" in low:
        return (
            "REFLECTION ABOUT THE Y-AXIS — The coordinate rule is "
            "(x, y) → (-x, y). The x-coordinate changes sign; the y-coordinate "
