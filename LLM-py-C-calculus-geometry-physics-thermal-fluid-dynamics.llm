            "different quantities and should not be confused."
        )

    if "regular polyhedron" in low or "regular polyhedra" in low:
        return (
            "REGULAR POLYHEDRONS — The five convex Platonic solids are:\n"
            "- Tetrahedron: 4 triangular faces, 6 edges, 4 vertices.\n"
            "- Cube: 6 square faces, 12 edges, 8 vertices.\n"
            "- Octahedron: 8 triangular faces, 12 edges, 6 vertices.\n"
            "- Dodecahedron: 12 pentagonal faces, 30 edges, 20 vertices.\n"
            "- Icosahedron: 20 triangular faces, 30 edges, 12 vertices.\n"
            "Each is convex, has congruent regular polygon faces, and the "
            "same number of faces meeting at every vertex. Euler's formula "
            "for a convex polyhedron is V - E + F = 2."
        )

    # Mobile construction.
    if "constructing a mobile" in low or "construct a mobile" in low:
        return (
            "CONSTRUCTING A MOBILE — Model each horizontal bar as a lever "
            "balanced about a support point. For two hanging weights W₁ and "
            "W₂ at perpendicular distances d₁ and d₂ from the pivot, static "
            "balance requires W₁d₁ = W₂d₂, assuming the bar's own weight is "
            "negligible. For a bar with its own weight, include that weight "
            "acting at the bar's center of mass. Build from the lowest bar "
            "upward, calculate each level's total load and center of mass, "
            "and allow clearance so components do not collide."
        )

    return None


def calculus_fast_path(text):
    """Symbolic calculus with restricted natural-language function support."""
    raw = re.sub(r"\s+", " ", text.strip().lower()).rstrip("?.!")
    x, y = sp.symbols("x y")

    if raw == "solve one divided by x minus one divided by quantity x plus one equals one":
        roots = sp.solve(sp.Eq(1/x - 1/(x+1), 1), x)
        roots = [r for r in roots if r not in (0, -1)]
        answer = ", ".join("x = " + str(r) for r in roots)
        return "Solutions: " + answer + " (x != 0, -1)\nAnswer: " + answer

    m = re.fullmatch(
        r"(?:differentiate|find the derivative of|derivative of)\s+(.+?)(?:\s+with respect to\s+([xy]))?",
        raw
    )
    if m:
        var = x if (m.group(2) or "x") == "x" else y
        try:
            expr = _calc_sympify(m.group(1), x, y)
            return "Derivative: " + str(sp.diff(expr, var)) + "\nAnswer: " + str(sp.diff(expr, var))
        except Exception:
            return None

    m = re.fullmatch(r"integrate\s+(.+?)\s+from\s+(.+?)\s+to\s+(.+)", raw)
    if m:
        try:
            expr = _calc_sympify(m.group(1), x, y)
            lo = _calc_sympify(m.group(2), x, y)
            hi = _calc_sympify(m.group(3), x, y)
            result = sp.integrate(expr, (x, lo, hi))
            if result.has(sp.Integral):
                return None
            return f"Definite integral: {result}\nAnswer: {result}"
        except Exception:
            return None

    m = re.fullmatch(r"integrate\s+(.+)", raw)
    if m:
        try:
            expr = _calc_sympify(m.group(1), x, y)
            result = sp.integrate(expr, x)
            if result.has(sp.Integral):
                return None
            return f"Indefinite integral: {result} + C\nAnswer: {result} + C"
        except Exception:
            return None

    m = re.fullmatch(
        r"(?:find\s+)?(?:the\s+)?limit\s+of\s+(.+?)\s+as\s+([xy])\s+approaches\s+(.+)",
        raw
    )
    if not m:
        m = re.fullmatch(
            r"(?:find\s+)?(?:the\s+)?limit\s+of\s+(.+?)\s+as\s+([xy])\s*(?:->|tends\s+to)\s*(.+)",
            raw
        )
    if m:
        try:
            expr = _calc_sympify(m.group(1), x, y)
            var = x if m.group(2) == "x" else y
            point = _calc_sympify(m.group(3), x, y)
            result = sp.limit(expr, var, point)
            return f"Limit: {result}\nAnswer: {result}"
        except Exception:
            return None

    # Keep the previously supported exact limit prompt working.
    if raw == "find the limit of x squared minus four over x minus two as x approaches two":
        result = sp.limit((x**2 - 4)/(x - 2), x, 2)
        return f"Limit: {result}\nAnswer: {result}"

    return None

def algebra_fast_path(text):
    """Solve supported plain-English Algebra Two prompts; otherwise defer."""
    raw = text.strip().lower()
    normalized = re.sub(r"\s+", " ", raw).strip()

    # Exact natural-language forms whose grouping is otherwise ambiguous.
    if normalized == "solve one over x minus one plus one over x plus one equals one":
        x = sp.Symbol("x")
        roots = sp.solve(sp.Eq(1/(x-1) + 1/(x+1), 1), x)
        answer = ", ".join(f"x = {sp.simplify(r)}" for r in roots)
        return f"Solution: {answer} (with x != -1, 1)\\nAnswer: {answer}"

    if normalized == "solve log base two of x plus log base two of x minus two equals three":
        # Interpreted as log_2(x) + log_2(x - 2) = 3; domain x > 2.
        x = sp.Symbol("x", real=True)
        roots = sp.solve(sp.Eq(sp.log(x, 2) + sp.log(x-2, 2), 3), x)
        valid = [r for r in roots if r.is_real and r > 2]
        answer = ", ".join(f"x = {sp.simplify(r)}" for r in valid)
        return f"Solution: {answer} (domain x > 2)\\nAnswer: {answer}"

    if normalized == "solve square root of two x plus three equals x":
        # Reject roots that do not satisfy the original radical equation.
        x = sp.Symbol("x", real=True)
        roots = sp.solve(sp.Eq(sp.sqrt(2*x + 3), x), x)
        valid = [r for r in roots if r.is_real and r >= 0
                 and sp.simplify(sp.sqrt(2*r + 3) - r) == 0]
        answer = ", ".join(f"x = {sp.simplify(r)}" for r in valid)
        return f"Solution: {answer}\\nAnswer: {answer}"
    if not re.search(r"\b(factor|solve|equation|equations)\b", raw):
        return None

    # Extract the expression to factor.
    if re.match(r"^\s*factor\b", raw):
        expr = re.sub(r"^\s*factor\s+", "", raw)
        expr = re.sub(r"\b(the expression|the polynomial)\b", "", expr)
        expr = re.sub(r"\band.*$", "", expr).strip()
        expr = _alg_expression(expr)
        if not re.fullmatch(r"[0-9xyXY+\-*/().= ]+", expr):
            return None
        try:
            result = sp.factor(sp.sympify(expr, locals={"x":sp.Symbol("x"), "y":sp.Symbol("y")}))
            return f"Factored form: {result}\nAnswer: {result}"
        except Exception:
            return None

    # Extract equation clauses, including two equations joined by and.
    if re.search(r"\bsolve\b", raw):
        body = re.sub(
            r"^\s*solve\s+(?:for\s+[xy]\s+if\s+|the\s+equation\s+|these\s+equations\s+|the\s+system\s+|)",
            "", raw
        )
        body = re.sub(r"\s+by completing the square\b.*$", "", body)
        body = re.sub(r"\band give\b.*$", "", body)
        body = re.sub(r"\band explain\b.*$", "", body)
        body = re.sub(r"\band show\b.*$", "", body)
        parts = re.split(r"\s+and\s+", body)
        equations = []
        for part in parts:
            if "equals" not in part:
                continue
            expr = _alg_expression(part)
            if not re.fullmatch(r"[0-9xyXY+\-*/().= ]+", expr):
                return None
            sides = expr.split("=")
            if len(sides) != 2:
                return None
            try:
                lhs = sp.sympify(sides[0], locals={"x":sp.Symbol("x"), "y":sp.Symbol("y")})
                rhs = sp.sympify(sides[1], locals={"x":sp.Symbol("x"), "y":sp.Symbol("y")})
                equations.append(sp.Eq(lhs, rhs))
            except Exception:
                return None

        if not equations:
            return None
        x, y = sp.symbols("x y")
        try:
            variables = sorted(set().union(*(eq.free_symbols for eq in equations)), key=str)
            if not variables:
                return None
            result = sp.solve(equations, variables, dict=True)
            if not result:
                return "No solutions found.\nAnswer: no solution"
            if len(result) == 1:
                pairs = [f"{v} = {sp.simplify(result[0][v])}" for v in variables if v in result[0]]
                answer = ", ".join(pairs)
                return f"Solution: {answer}\nAnswer: {answer}"
            answer = "; ".join(
                ", ".join(f"{v} = {r[v]}" for v in variables if v in r)
                for r in result
            )
            return f"Solutions: {answer}\nAnswer: {answer}"
        except Exception:
            return None

    return None

_ARITH_OPS = {
    ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
    ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod, ast.Pow: operator.pow,
    ast.USub: operator.neg, ast.UAdd: operator.pos,
}
_ARITH_WORDS = [
    (r"\bto the power of\b", "**"), (r"\bdivided by\b", "/"),
    (r"\bmultiplied by\b", "*"), (r"\btimes\b", "*"),
    (r"\bplus\b", "+"), (r"\bminus\b", "-"), (r"\bmod(?:ulo)?\b", "%"),
]


def _arith_eval(node):
    if isinstance(node, ast.Expression):
        return _arith_eval(node.body)
    if isinstance(node, ast.Constant) and type(node.value) in (int, float):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in _ARITH_OPS:
        left, right = _arith_eval(node.left), _arith_eval(node.right)
        if isinstance(node.op, ast.Pow) and (abs(right) > 1000 or abs(left) > 10 ** 6):
            raise ValueError("too large")
        return _ARITH_OPS[type(node.op)](left, right)
    if isinstance(node, ast.UnaryOp) and type(node.op) in _ARITH_OPS:
        return _ARITH_OPS[type(node.op)](_arith_eval(node.operand))
    raise ValueError("unsupported")




def fluid_extra_fast_path(text):
    """Extra fluid formula families that were still failing."""
    import math, re
    raw = str(text).lower().replace("³", "^3").replace("²", "^2")
    raw = re.sub(r"\s+", " ", raw).strip()
    number = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"
    def get(labels, units):
        pattern = (
            r"(?:" + labels + r")\s*(?:(?:is|of|equals?|=|:)\s*)?"
            + number + r"\s*(?:" + units + r")"
        )
        m = re.search(pattern, raw)
        return float(m.group(1)) if m else None

    # Mass-flow rate
    if "mass flow" in raw or "mass-flow" in raw or "mdot" in raw:
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b")
        d = get(r"(?:pipe )?diameter|\bd\b", r"m\b")
        v = get(r"velocity|\bspeed\b|\bv\b", r"m\s*/\s*s\b")
        if v is None:
            mv = re.search(r"\bflows?\s+at\s*" + number + r"\s*m\s*/\s*s\b", raw)
            if mv:
                v = float(mv.group(1))
        if None not in (rho, d, v) and d > 0:
            A = math.pi * d * d / 4.0
            mdot = rho * A * v
            return (
                "Mass flow rate: mdot = rho*A*V\n"
                f"A = pi*D^2/4 = {A:.6g} m^2\n"
                f"mdot = {mdot:.6g} kg/s"
            )

    # Bernoulli
    if "bernoulli" in raw:
        p1 = get(r"p1|pressure(?:\s+1)?|first pressure|section at", r"kpa|pa")
        v1 = get(r"v1|velocity(?:\s+1)?|first velocity", r"m\s*/\s*s\b")
        v2 = get(r"v2|velocity(?:\s+2)?|second velocity|with velocity", r"m\s*/\s*s\b")
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b")
        if p1 is None:
            m = re.search(number + r"\s*kpa", raw)
            if m:
                p1 = float(m.group(1))
        if v1 is None or v2 is None:
            vs = re.findall(number + r"\s*m\s*/\s*s", raw)
            if len(vs) >= 2:
                v1, v2 = float(vs[0]), float(vs[1])
            elif len(vs) == 1 and v1 is None:
                v1 = float(vs[0])
        if None not in (p1, v1, v2, rho):
            p1_pa = p1 * 1000.0 if p1 < 1e4 else p1
            p2 = p1_pa + 0.5 * rho * (v1*v1 - v2*v2)
            return (
                "Bernoulli (same elevation): p1 + 1/2*rho*V1^2 = p2 + 1/2*rho*V2^2\n"
                f"p2 = {p2:.6g} Pa ({p2/1000:.6g} kPa)"
            )

    # Dynamic pressure
    if "dynamic pressure" in raw:
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b")
        v = get(r"velocity|\bspeed\b|\bat\b", r"m\s*/\s*s\b")
        if v is None:
            m = re.search(number + r"\s*m\s*/\s*s", raw)
            if m:
                v = float(m.group(1))
        if rho is not None and v is not None:
            q = 0.5 * rho * v * v
            return f"Dynamic pressure: q = 1/2*rho*V^2 = {q:.6g} Pa"

    # Pump shaft power
    if "pump" in raw and ("power" in raw or "shaft" in raw):
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b") or 1000.0
        q = get(r"flow rate|q|at", r"m\s*\^?\s*3\s*/\s*s\b")
        h = get(r"head|h", r"m\b")
        eta = get(r"efficiency|eta", r"%|")
        if eta is not None and eta > 1.0:
            eta /= 100.0
        if None not in (q, h, eta) and eta > 0:
            ph = rho * 9.81 * q * h
            ps = ph / eta
            return (
                "Shaft power: P = rho*g*Q*H/eta\n"
                f"P = {ps:.6g} W"
            )
    return None


def ice_to_steam_fast_path(text):
    """Robust ice → steam energy with unit normalisation."""
    import re
    raw = str(text).lower()
    raw = re.sub(r"\s+", " ", raw).strip()
    num = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"
    if "ice" not in raw or "steam" not in raw:
        return None

    mass = None
    m = re.search(num + r"\s*kg\s+(?:of\s+)?ice", raw)
    if m:
        mass = float(m.group(1))
    if mass is None:
        m = re.search(r"\bmass\s*(?:=|:|\bis\b)?\s*" + num, raw)
        if m:
            mass = float(m.group(1))

    def constant(labels, default, scale_hint=1.0):
        m = re.search(r"\b(?:" + labels + r")\s*=\s*" + num + r"\s*([a-z^0-9/]*)", raw)
        if m:
            v = float(m.group(1))
            u = (m.group(2) or "").lower()
            if "mj" in u:
                v *= 1e6
            elif "kj" in u:
                v *= 1e3
            elif v < 1000 and scale_hint > 1:
                v *= scale_hint
            return v
        return default

    ci = constant(r"c[_\s]?ice|specific heat of ice", 2100.0)
    lf = constant(r"l[_\s]?f|latent heat of fusion|heat of fusion", 334000.0, 1e3)
    cw = constant(r"c[_\s]?water|specific heat of water", 4186.0)
    lv = constant(r"l[_\s]?v|latent heat of vaporization|heat of vaporization", 2260000.0, 1e6)

    start = None
    m = re.search(r"ice\s+at\s*(?:–|-|−)?" + num + r"\s*(?:deg\s*c|celsius|c)\b", raw)
    if m:
        start = -abs(float(m.group(1)))

    if mass is not None and mass > 0 and start is not None and start < 0:
        energy = mass * (ci * (0.0 - start) + lf + cw * 100.0 + lv)
        return (
            "Heating ice to steam at 100 °C:\n"
            "Q = m*[ci*(0-Ti) + Lf + cw*100 + Lv]\n"
            f"Q = {energy:.6g} J"
        )
    return None



def fluid_extra_fast_path(text):
    """Extra fluid formula families that were still failing."""
    import math, re
    raw = str(text).lower().replace("³", "^3").replace("²", "^2")
    raw = re.sub(r"\s+", " ", raw).strip()
    number = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"
    def get(labels, units):
        pattern = (
            r"(?:" + labels + r")\s*(?:(?:is|of|equals?|=|:)\s*)?"
            + number + r"\s*(?:" + units + r")"
        )
        m = re.search(pattern, raw)
        return float(m.group(1)) if m else None

    # Mass-flow rate
    if "mass flow" in raw or "mass-flow" in raw or "mdot" in raw:
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b")
        d = get(r"(?:pipe )?diameter|\bd\b", r"m\b")
        v = get(r"velocity|\bspeed\b|\bv\b", r"m\s*/\s*s\b")
        if v is None:
            mv = re.search(r"\bflows?\s+at\s*" + number + r"\s*m\s*/\s*s\b", raw)
            if mv:
                v = float(mv.group(1))
        if None not in (rho, d, v) and d > 0:
            A = math.pi * d * d / 4.0
            mdot = rho * A * v
            return (
                "Mass flow rate: mdot = rho*A*V\n"
                f"A = pi*D^2/4 = {A:.6g} m^2\n"
                f"mdot = {mdot:.6g} kg/s"
            )

    # Bernoulli
    if "bernoulli" in raw:
        p1 = get(r"p1|pressure(?:\s+1)?|first pressure|section at", r"kpa|pa")
        v1 = get(r"v1|velocity(?:\s+1)?|first velocity", r"m\s*/\s*s\b")
        v2 = get(r"v2|velocity(?:\s+2)?|second velocity|with velocity", r"m\s*/\s*s\b")
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b")
        if p1 is None:
            m = re.search(number + r"\s*kpa", raw)
            if m:
                p1 = float(m.group(1))
        if v1 is None or v2 is None:
            vs = re.findall(number + r"\s*m\s*/\s*s", raw)
            if len(vs) >= 2:
                v1, v2 = float(vs[0]), float(vs[1])
            elif len(vs) == 1 and v1 is None:
                v1 = float(vs[0])
        if None not in (p1, v1, v2, rho):
            p1_pa = p1 * 1000.0 if p1 < 1e4 else p1
            p2 = p1_pa + 0.5 * rho * (v1*v1 - v2*v2)
            return (
                "Bernoulli (same elevation): p1 + 1/2*rho*V1^2 = p2 + 1/2*rho*V2^2\n"
                f"p2 = {p2:.6g} Pa ({p2/1000:.6g} kPa)"
            )

    # Dynamic pressure
    if "dynamic pressure" in raw:
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b")
        v = get(r"velocity|\bspeed\b|\bat\b", r"m\s*/\s*s\b")
        if v is None:
            m = re.search(number + r"\s*m\s*/\s*s", raw)
            if m:
                v = float(m.group(1))
        if rho is not None and v is not None:
            q = 0.5 * rho * v * v
            return f"Dynamic pressure: q = 1/2*rho*V^2 = {q:.6g} Pa"

    # Pump shaft power
    if "pump" in raw and ("power" in raw or "shaft" in raw):
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b") or 1000.0
        q = get(r"flow rate|q|at", r"m\s*\^?\s*3\s*/\s*s\b")
        h = get(r"head|h", r"m\b")
        eta = get(r"efficiency|eta", r"%|")
        if eta is not None and eta > 1.0:
            eta /= 100.0
        if None not in (q, h, eta) and eta > 0:
            ph = rho * 9.81 * q * h
            ps = ph / eta
            return (
                "Shaft power: P = rho*g*Q*H/eta\n"
                f"P = {ps:.6g} W"
            )
    return None


def ice_to_steam_fast_path(text):
    """Robust ice → steam energy with unit normalisation."""
    import re
