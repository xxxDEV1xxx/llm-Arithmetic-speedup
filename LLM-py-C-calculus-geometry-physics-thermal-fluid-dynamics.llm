import unittest
from collections import Counter

def word_frequency(strings):
    counts = Counter()
    for text in strings:
        if not isinstance(text, str):
            raise TypeError("all items must be strings")
        counts.update(re.findall(r"\b\w+\b", text.casefold()))
    return dict(counts)

class WordFrequencyTests(unittest.TestCase):
    def test_case_insensitive(self):
        self.assertEqual(word_frequency(["Cat cat", "CAT dog"]), {"cat": 3, "dog": 1})

    def test_empty_strings(self):
        self.assertEqual(word_frequency(["", "   ", "Dog"]), {"dog": 1})

    def test_empty_list(self):
        self.assertEqual(word_frequency([]), {})

    def test_punctuation(self):
        self.assertEqual(word_frequency(["red, blue! red." ]), {"red": 2, "blue": 1})

if __name__ == "__main__":
    unittest.main()
