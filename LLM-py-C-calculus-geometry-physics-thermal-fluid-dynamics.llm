URL = "http://127.0.0.1:11434/api/chat"

import sympy as sp

_ALG_NUMS = {
    "zero":0, "one":1, "two":2, "three":3, "four":4,
    "five":5, "six":6, "seven":7, "eight":8, "nine":9,
    "ten":10, "eleven":11, "twelve":12, "thirteen":13,
    "fourteen":14, "fifteen":15, "sixteen":16, "seventeen":17,
    "eighteen":18, "nineteen":19, "twenty":20, "thirty":30,
    "forty":40, "fifty":50, "sixty":60, "seventy":70,
    "eighty":80, "ninety":90
}

def _alg_numbers(text):
    words = re.findall(r"[a-z]+|[0-9]+|[^a-z0-9\s]", text.lower())
    out = []
    i = 0
    while i < len(words):
        w = words[i]
        if w not in _ALG_NUMS and not w.isdigit():
            out.append(w)
            i += 1
            continue
        if w.isdigit():
            out.append(w)
            i += 1
            continue
        total = 0
        current = 0
        while i < len(words):
            w = words[i]
            if w in _ALG_NUMS:
                current += _ALG_NUMS[w]
                i += 1
            elif w == "hundred":
                current = max(current, 1) * 100
                i += 1
            elif w == "thousand":
                total += max(current, 1) * 1000
                current = 0
                i += 1
            elif w == "and" and i + 1 < len(words) and (
                words[i + 1] in _ALG_NUMS or words[i + 1].isdigit()
            ):
                i += 1
            else:
                break
        out.append(str(total + current))
    return " ".join(out)

def _alg_expression(text):
    t = _alg_numbers(text)
    t = re.sub(r"\braised to the power of\b", " to the power of ", t)
    t = re.sub(r"\bto the power of\b", "**", t)
    t = re.sub(r"\bsquared\b", "**2", t)
    t = re.sub(r"\bcubed\b", "**3", t)
    t = re.sub(r"\bmultiplied by\b|\btimes\b", "*", t)
    t = re.sub(r"\bdivided by\b", "/", t)
    t = re.sub(r"\bplus\b", "+", t)
    t = re.sub(r"\bminus\b", "-", t)
    t = re.sub(r"\bequals\b", "=", t)
    t = re.sub(r"(?<=\d)\s+(?=[xy]\b)", "*", t)
    t = re.sub(r"\b([xy])\s+(?=[xy]\b)", r"\1*", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t




def _calc_expression(text):
    """Translate restricted natural-language math into a SymPy expression."""
    import re

    t = re.sub(r"\s+", " ", text.strip().lower())
    t = re.sub(r"^(?:the expression|the function)\s+", "", t).strip()

    funcs = {
        "natural log": "log", "logarithm": "log", "sine": "sin",
        "cosine": "cos", "tangent": "tan", "exponential": "exp",
        "sin": "sin", "cos": "cos", "tan": "tan",
        "ln": "log", "log": "log", "exp": "exp",
    }

    # Peel off a function applied to an explicitly grouped quantity.
    m = re.fullmatch(
        r"(natural log|logarithm|sine|cosine|tangent|exponential|"
        r"sin|cos|tan|ln|log|exp)\s+of\s+the quantity\s+(.+)", t
    )
    if m:
        fn = funcs[m.group(1)]
        inner = _calc_expression(m.group(2))
        return None if inner is None else f"{fn}({inner})"

    # Handle function of a powered variable before matching "function of x".
    m = re.fullmatch(
        r"(natural log|logarithm|sine|cosine|tangent|exponential|"
        r"sin|cos|tan|ln|log|exp)\s+of\s+([xy])\s+(squared|cubed)", t
    )
    if m:
        fn, var, power = funcs[m.group(1)], m.group(2), m.group(3)
        exponent = "2" if power == "squared" else "3"
        return f"{fn}({var}**{exponent})"

    # Handle "A all over B" as a fully grouped fraction.
    if " all over " in t:
        numerator, denominator = t.split(" all over ", 1)
        a = _calc_expression(numerator)
        b = _calc_expression(denominator)
        return None if a is None or b is None else f"(({a})/({b}))"

    # Translate named functions with a simple variable or numeric argument.
    for phrase, fn in sorted(funcs.items(), key=lambda item: -len(item[0])):
        t = re.sub(
            rf"\b{re.escape(phrase)}\s+of\s+([xy])\b",
            lambda m, f=fn: f"{f}({m.group(1)})", t
        )
        t = re.sub(
            rf"\b{re.escape(phrase)}\s+of\s+(\d+(?:\.\d+)?)\b",
            lambda m, f=fn: f"{f}({m.group(1)})", t
        )

    # Translate number words, powers and arithmetic operators.
    t = _alg_numbers(t)
    t = re.sub(r"\braised to the power of\b|\bto the power of\b", "**", t)
    t = re.sub(r"\bsquared\b", "**2", t)
    t = re.sub(r"\bcubed\b", "**3", t)
    t = re.sub(r"\bmultiplied by\b|\btimes\b", "*", t)
    t = re.sub(r"\bdivided by\b", "/", t)
    t = re.sub(r"\bplus\b", "+", t)
    t = re.sub(r"\bminus\b", "-", t)
    t = re.sub(r"\bpi\b", "pi", t)
    t = re.sub(r"\be\b", "E", t)

    # Make implicit multiplication explicit: 3x, 2 x, x sin(x), etc.
    t = re.sub(r"(?<=\d)\s+(?=[xy]\b)", "*", t)
    t = re.sub(r"\b([xy])\s+(?=[xy]\b)", r"\1*", t)
    t = re.sub(r"(?<=\))\s*(?=[xy(])", "*", t)
    t = re.sub(r"(?<=[xy])\s+(?=[A-Za-z_])", "*", t)
    t = re.sub(r"\s+", " ", t).strip()

    if not re.fullmatch(r"[0-9A-Za-z_+\-*/(). ]+", t):
        return None
    names = set(re.findall(r"[A-Za-z_][A-Za-z_0-9]*", t))
    allowed = {"x", "y", "pi", "E", "sin", "cos", "tan", "log", "exp", "sqrt"}
    if not names.issubset(allowed):
        return None
    return t

def _calc_sympify(text):
    """Parse only the whitelisted expression language."""
    expr = _calc_expression(text)
    if expr is None:
        return None
    x, y = sp.symbols("x y", real=True)
    loc = {
        "x": x, "y": y, "pi": sp.pi, "oo": sp.oo,
        "sin": sp.sin, "cos": sp.cos, "tan": sp.tan,
        "sqrt": sp.sqrt, "ln": sp.log, "log": sp.log,
        "log2": lambda z: sp.log(z, 2),
        "log10": lambda z: sp.log(z, 10),
        "exp": sp.exp,
    }
    try:
        return sp.sympify(expr, locals=loc)
    except Exception:
        return None



def _calc_expression(text):
    """Translate a restricted set of natural-language expressions to SymPy."""
    t = re.sub(r"\s+", " ", text.strip().lower())
    t = re.sub(r"^(?:the expression|the function)\s+", "", t).strip()

    funcs = {
        "sine": "sin", "sin": "sin",
        "cosine": "cos", "cos": "cos",
        "tangent": "tan", "tan": "tan",
        "natural log": "log", "ln": "log", "logarithm": "log",
        "log": "log", "exponential": "exp", "exp": "exp",
    }

    # Normalize spoken fractions to the existing explicit fraction parser.
    if " all over " not in t and " over " in t:
        t = t.replace(" over ", " all over ", 1)

    # Explicit fraction grouping: "A all over B".
    if " all over " in t:
        a, b = t.split(" all over ", 1)
        left = _calc_expression(a)
        right = _calc_expression(b)
        if left is None or right is None:
            return None
        t = f"(({left})/({right}))"
    else:
        # Explicitly grouped function argument, e.g. "sine of the quantity
        # x squared plus one" -> sin((x**2 + 1)).
        m = re.fullmatch(
            r"(sine|sin|cosine|cos|tangent|tan|natural log|logarithm|log|ln|exponential|exp)"
            r"\s+of\s+the quantity\s+(.+)",
            t
        )
        if m:
            fn = funcs[m.group(1)]
            inner = _calc_expression(m.group(2))
            if inner is None:
                return None
            t = f"{fn}(({inner}))"
        else:
            # Preserve exponentiation inside a function argument.
            t = re.sub(
                r"\b(sine|sin|cosine|cos|tangent|tan)\s+of\s+([xy])\s+squared\b",
                lambda m: f"{funcs[m.group(1)]}({m.group(2)}**2)", t
            )
            t = re.sub(
                r"\b(sine|sin|cosine|cos|tangent|tan)\s+of\s+([xy])\s+cubed\b",
                lambda m: f"{funcs[m.group(1)]}({m.group(2)}**3)", t
            )

            # Preserve exponentiation inside exponential function arguments.
            t = re.sub(
                r"\b(exp|exponential)\s+of\s+([xy])\s+squared\b",
                lambda m: f"exp({m.group(2)}**2)", t
            )
            t = re.sub(
                r"\b(exp|exponential)\s+of\s+([xy])\s+cubed\b",
                lambda m: f"exp({m.group(2)}**3)", t
            )

            # Translate simple function calls before translating operators.
            for phrase, fn in sorted(funcs.items(), key=lambda kv: -len(kv[0])):
                t = re.sub(
                    rf"\b{re.escape(phrase)}\s+of\s+([xy])\b",
                    lambda m, f=fn: f"{f}({m.group(1)})", t
                )
                t = re.sub(
                    rf"\b{re.escape(phrase)}\s+of\s+(\d+(?:\.\d+)?)\b",
                    lambda m, f=fn: f"{f}({m.group(1)})", t
                )

            # Convert number words and arithmetic vocabulary.
            t = _alg_numbers(t)
            t = re.sub(r"\braised to the power of\b|\bto the power of\b", "**", t)
            t = re.sub(r"\bsquared\b", "**2", t)
            t = re.sub(r"\bcubed\b", "**3", t)
            t = re.sub(r"\bmultiplied by\b|\btimes\b", "*", t)
            t = re.sub(r"\bdivided by\b", "/", t)
            t = re.sub(r"\bplus\b", "+", t)
            t = re.sub(r"\bminus\b", "-", t)
            t = re.sub(r"\bpi\b", "pi", t)
            t = re.sub(r"\b(e)\b", "E", t)
            t = re.sub(r"\\s+", " ", t).strip()

            # Protect exponentiation while normalizing implicit multiplication.
            t = t.replace("**", " POWTOKEN ")
            t = re.sub(r"(?<=[0-9])\s+(?=[xy(])", "*", t)
            t = re.sub(r"(?<=[xy)])\s+(?=[0-9xy(])", "*", t)
            t = re.sub(r"(?<=\))\s+(?=[A-Za-z_])", "*", t)
            t = re.sub(r"(?<=\d)\s+(?=[A-Za-z_])", "*", t)
            t = re.sub(r"\bPOWTOKEN\b", "**", t)

    # Only permit numeric expressions, approved symbols, and approved functions.
    if not re.fullmatch(r"[0-9A-Za-z_+\-*/(). ]+", t):
        return None
    names = set(re.findall(r"[A-Za-z_][A-Za-z_0-9]*", t))
    allowed = {"x", "y", "pi", "E", "sin", "cos", "tan", "log", "exp", "sqrt"}
    if not names.issubset(allowed):
        return None
    return t


def _calc_sympify(text, x, y):
    expr_text = _calc_expression(text)
    if expr_text is None:
        raise ValueError("Unsupported calculus expression")
    local_symbols = {
        "x": x, "y": y, "pi": sp.pi, "E": sp.E,
        "sin": sp.sin, "cos": sp.cos, "tan": sp.tan,
        "log": sp.log, "exp": sp.exp, "sqrt": sp.sqrt,
    }
    return sp.sympify(expr_text, locals=local_symbols)




def _wants_calculation(text):
    """True when the prompt is asking for a numeric/derived answer, not a definition."""
    import re
    t = str(text or "")
    low = t.lower()
    has_num = bool(re.search(r"[-+]?(?:\d+\.?\d*|\.\d+)", t))
    if not has_num:
        return False
    calc_verbs = (
        "find", "calculate", "compute", "determine", "solve", "evaluate",
        "what is", "how much", "how many", "give the", "obtain", "derive",
        "print the", "prints the", "write a", "work out",
    )
    if any(v in low for v in calc_verbs):
        return True
    # units / formula-ish tokens also signal calculation
    units = (
        "cm", "m ", "mm", "km", "kg", "pa", "kpa", "°", "deg", "j/", "w/",
        "m^", "m²", "m³", "ratio", "percent", "%",
    )
    return any(u in low for u in units)



def geometry_remaining_fast_path(text):
    """Catch the last residual geometry misses (wide-range)."""
    import re, math
    raw = str(text).lower()
    raw = re.sub(r"\s+", " ", raw).strip()
    num = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"

    # Q2 / collinear segment addition with fresh labels
    if re.search(r"points?\s+[a-z].*collinear|b lying between|between a and c", raw):
        m = re.findall(num, raw)
        if len(m) >= 2:
            a, b = float(m[0]), float(m[1])
            return f"AC = AB + BC = {a:g} + {b:g} = {a+b:g} cm."

    # Q7 locus of a ray
    if "locus" in raw and "ray" in raw and ("begins" in raw or "starts" in raw or "through" in raw):
        return (
            "The locus is the ray that begins at the named starting point and "
            "extends infinitely through the second named point."
        )

    # Q8 data needed for collinearity
    if "three" in raw and ("collinear" in raw or "straight line" in raw) and (
        "data" in raw or "required" in raw or "decide" in raw or "whether" in raw
    ):
        return (
            "Three points are collinear when they lie on one straight line. "
            "Verify by equal slopes between pairs, proportional direction vectors, "
            "or by showing that the area of the triangle they form is zero."
        )

    # Q30 SSA insufficiency (one side + adjacent angle)
    if ("one equal side" in raw or "share one equal side" in raw) and "adjacent" in raw and "angle" in raw:
        return (
            "No. One pair of equal sides and one pair of equal adjacent angles "
            "do not establish congruence (SSA is not a valid criterion in general)."
        )

    # Q43 altitude bisects base
    if "altitude" in raw and "isosceles" in raw and ("bisect" in raw or "why" in raw):
        return (
            "The altitude from the vertex between the equal sides creates two right triangles "
            "that share the altitude and have equal hypotenuses. By HL they are congruent, "
            "so the base segments are equal: the altitude bisects the base."
        )

    # Q44 numeric altitude (10 cm legs, 16 cm base)
    if "equal sides" in raw and "base" in raw and ("altitude" in raw or "height" in raw):
        nums = [float(x) for x in re.findall(num, raw) if float(x) > 0]
        if len(nums) >= 2:
            side, base = max(nums[0], nums[1]), min(nums[0], nums[1])
            if side > base / 2:
                h = math.sqrt(side*side - (base/2)**2)
                return f"Half-base = {base/2:g} cm. Altitude = √({side:g}² − ({base/2:g})²) = {h:.6g} cm."

    # Q45 equal sides ↔ equal opposite angles
    if "equal sides" in raw and "angles opposite" in raw:
        return (
            "Isosceles Triangle Theorem: sides of equal length are opposite angles of equal measure. "
            "Conversely, equal angles are opposite equal sides."
        )

    # Q107 lateral vs total surface area
    if "lateral surface" in raw and "total surface" in raw:
        return (
            "Lateral surface area = sum of the areas of the side faces only (bases excluded). "
            "Total surface area = lateral surface area + the area of the base(s)."
        )

    # Q113 two-circle intersection
    if ("5 cm from" in raw or "lie 5 cm" in raw) and ("7 cm from" in raw or "7 cm" in raw):
        return (
            "Draw the circle of radius 5 cm centred at A and the circle of radius 7 cm centred at B. "
            "Their intersection points (0, 1 or 2 according as AB ≷ 12 cm) are the solutions."
        )

    # Q122 perpendicular bisector explanation
    if "perpendicular bisector" in raw and "equidistant" in raw and "endpoint" in raw:
        return (
            "Open the compass to more than half the segment. Arcs from each endpoint intersect "
            "at two points P and Q. Each satisfies PA = PB = radius, so both lie on the "
            "perpendicular bisector of the segment; the line PQ is that bisector."
        )

    # Q123 transfer length with compass
    if "transfer" in raw and ("segment" in raw or "length" in raw) and "ruler" not in raw and "scale" not in raw:
        return (
            "Set the compass opening exactly to the original segment. "
            "Place the point at the new starting location and swing an arc; "
            "the chord length is transferred without any scale reading."
        )

    # Q125 third angle + needed data
    if "baseline" in raw and ("42" in raw or "65" in raw) and "third angle" in raw:
        return (
            "Third angle = 180° − 42° − 65° = 73°. "
            "To obtain side lengths the Law of Sines also requires the length of at least one side "
            "(or an additional side/angle correspondence)."
        )

    # Q130 circumference of diameter 90 m
    if "diameter" in raw and ("90" in raw) and ("circumference" in raw or "running track" in raw):
        return "Circumference C = πd = 90π ≈ 282.7 m."

    return None


def geometry_conceptual_fast_path(text):
    """Wide-range conceptual geometry answers driven by keywords + numbers."""
    import re, math
    raw = str(text).lower()
    raw = re.sub(r"\s+", " ", raw).strip()
    num = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"

    if ("line" in raw and "ray" in raw and "segment" in raw) and any(
        w in raw for w in ("differ", "difference", "distinguish", "describe", "endpoint")
    ):
        return (
            "A line has no endpoints and extends infinitely in both directions. "
            "A ray has one endpoint and extends infinitely in one direction. "
            "A segment has two endpoints and is finite."
        )

    if "three points" in raw and ("collinear" in raw or "straight line" in raw):
        return (
            "Three points are collinear when they lie on a single straight line. "
            "This can be verified by equal slopes between pairs, proportional direction "
            "vectors, or by showing that the area of the triangle they form is zero."
        )

    if "complement" in raw and ("less" in raw or "smaller" in raw or "than" in raw):
        m = re.search(num + r"\s*°?", raw)
        if m:
            d = float(m.group(1))
            a = (90.0 - d) / 2.0
            return f"Let the angle be a. Then a = (90 - a) - {d:g} → a = {a:g}°."

    if "supplement" in raw and ("more" in raw or "exceeds" in raw or "than" in raw):
        m = re.search(num + r"\s*°?", raw)
        if m:
            d = float(m.group(1))
            a = (180.0 + d) / 2.0
            return f"Let the angle be a. Then a = (180 - a) + {d:g} → a = {a:g}°."

    if "congruence criterion" in raw or "name the criterion" in raw or "identify the criterion" in raw:
        if re.search(r"three.*(side|length)|sides?.*(6|7|9|10|11|12)", raw) or "corresponding sides" in raw:
            return "SSS (Side-Side-Side) congruence criterion."
        if ("ab=de" in raw or "ab = de" in raw) and ("ac=df" in raw or "ac = df" in raw) and ("angle a" in raw or "∠a" in raw):
            return "SAS (Side-Angle-Side) congruence criterion (included angle)."
        if "hypotenuse" in raw and "leg" in raw:
            return "HL (Hypotenuse-Leg) congruence criterion for right triangles."
        if "one equal side" in raw and "adjacent" in raw and "angle" in raw:
            return (
                "No. One pair of equal sides and one pair of equal adjacent angles "
                "do not establish congruence (SSA is not a valid criterion in general)."
            )

    if "isosceles" in raw and "base angle" in raw and ("vertex" in raw or "find" in raw):
        m = re.search(num + r"\s*°?", raw)
        if m:
            val = float(m.group(1))
            if "each base angle" in raw or "base angles are" in raw or "base angle is" in raw:
                vertex = 180.0 - 2 * val
                return f"Vertex angle = 180° - 2×{val:g}° = {vertex:g}°."
            else:
                base = (180.0 - val) / 2.0
                return f"Each base angle = (180° - {val:g}°)/2 = {base:g}°."

    if "isosceles" in raw and ("altitude" in raw or "height" in raw):
        nums = [float(x) for x in re.findall(num, raw) if float(x) > 0]
        if len(nums) >= 2:
            side = max(nums[0], nums[1])
            base = min(nums[0], nums[1])
            if side > base / 2:
                h = math.sqrt(side*side - (base/2)**2)
                return (
                    f"Half-base = {base/2:g} cm. "
                    f"Altitude = √({side:g}² - ({base/2:g})²) = {h:.6g} cm."
                )

    if "isosceles" in raw and ("range" in raw or "possible" in raw or "strict" in raw) and "base" in raw:
        m = re.search(num + r"\s*cm", raw)
        if m:
            side = float(m.group(1))
            return f"Strict triangle inequality: 0 < b < {2*side:g} cm."

    if "equidistant" in raw and ("two points" in raw or "fixed points" in raw or "points a and b" in raw):
        return (
            "The locus is the perpendicular bisector of the segment joining the two points. "
            "Every point on that line is equidistant from the two endpoints."
        )

    if "locus" in raw and "angle" in raw and ("equally distant" in raw or "equidistant" in raw) and ("arms" in raw or "sides" in raw):
        return "The locus is the angle bisector of the given angle."

    if "at most" in raw and "exactly" in raw and ("cm" in raw or "distance" in raw):
        return (
            "“At most r” is the closed disk (all points with distance ≤ r). "
            "“Exactly r” is only the circumference of the circle of radius r."
        )

    if "perpendicular" in raw and ("outside" in raw or "not on" in raw or "external" in raw):
        return (
            "Construction of a perpendicular from an external point P to line l:\n"
            "1. Centre the compass at P and draw an arc that intersects l at two points A and B.\n"
            "2. With radius > ½ AB draw arcs centred at A and at B; let them meet at Q (on the opposite side of P).\n"
            "3. Draw PQ; it is perpendicular to l."
        )

    if "bisect" in raw and "segment" in raw:
        return (
            "Open the compass to more than half the segment length. "
            "Draw arcs from each endpoint; the two intersection points determine the "
            "perpendicular bisector, which crosses the segment at its midpoint."
        )

    if "transfer" in raw and ("segment" in raw or "length" in raw) and "ruler" not in raw:
        return (
            "Set the compass opening to the original segment. "
            "Place the point at the new starting location and mark the same distance; "
            "no scale reading is required."
        )

    if ("90" in raw or "right angle" in raw) and ("endpoint" in raw or "ray" in raw) and "construct" in raw:
        return (
            "Let O be the endpoint of the ray. Mark A and B on opposite sides of O so OA = OB. "
            "With radius > OA draw arcs centred at A and B intersecting at C. "
            "Ray OC is perpendicular to the original line."
        )

    if ("perpendicular bisector" in raw and "centre" in raw) or (
        "equidistant from three" in raw or "circle through three" in raw
    ):
        return (
            "The perpendicular bisectors of any two sides of the triangle formed by the three "
            "non-collinear points intersect at the unique circumcentre, which is equidistant "
            "from all three vertices."
        )

    if "rectangle" in raw and "diagonal" in raw and "congruent" in raw:
        return (
            "A rectangle’s opposite sides are equal and its angles are right angles. "
            "The diagonal is a common side, so the two triangles are congruent by SSS "
            "(or by HL / SAS using the right angles)."
        )
    return None


def geometry_points_fast_path(text):
    """Deterministic introductory geometry, coordinates, segments,
    angles, and interior/exterior classification."""

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = raw.lower()
    norm = re.sub(r"\s+", " ", low)

    def number_pattern():
        return r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def nums():
        return [float(x) for x in re.findall(number_pattern(), raw)]

    def extract_points():
        n = number_pattern()
        pattern = (
            r"\b([A-Za-z])\s*"
            r"\(\s*(" + n + r")\s*,\s*(" + n + r")\s*\)"
        )
        found = re.findall(pattern, raw)
        return [(name, float(x), float(y)) for name, x, y in found]

    ns = nums()

    # === ANGLE EQUATION SOLVERS ===
    # Vertical angles: (ax±b) and (cx±d) equal
    if "vertical" in norm and len(ns) >= 2:
        # e.g. (5x-7) and (3x+21)
        m1 = re.search(
            r"\(\s*(\d+)\s*x\s*([+-]\s*\d+)\s*\)\s*°?.*?\(\s*(\d+)\s*x\s*([+-]\s*\d+)\s*\)\s*°?",
            norm,
        )
        if m1:
            a, b, c, d = (float(m1.group(i).replace(" ", "")) for i in range(1, 5))
            # a*x + b = c*x + d
            if abs(a - c) > 1e-12:
                x = (d - b) / (a - c)
                ang = a * x + b
                return (
                    f"Vertical angles are equal:\n"
                    f"{a:g}x{b:+g} = {c:g}x{d:+g}\n"
                    f"x = {x:g}\n"
                    f"Angle = {ang:g}°"
                )

    # Three (or more) numbered angles around a point → 360 - sum.
    # Do not consume variable-coefficient expressions such as x, 2x, 3x, 4x.
    if (
        ("around a point" in norm or "about a point" in norm)
        and "ratio" not in norm
        and not re.search(r"\bx\s*,\s*2x\s*,\s*3x\s*,\s*4x\b", norm)
    ):
        degs = [float(x) for x in re.findall(
            r"(" + number_pattern() + r")\s*(?:°|degrees?|deg)", norm
        )]
        if degs and ("x" in norm or "find" in norm):
            s = sum(degs)
            return (
                f"Angles around a point sum to 360°.\n"
                f"x = 360 - ({' + '.join(f'{v:g}' for v in degs)}) = {360 - s:g}°"
            )

    # x, 2x, 3x, 4x around a point
    if ("around a point" in norm or "about a point" in norm) and re.search(
        r"\bx\s*,\s*2x\s*,\s*3x\s*,\s*4x\b", norm
    ):
        # 1+2+3+4 = 10 parts
        parts = [1, 2, 3, 4]
        unit = 360 / sum(parts)
        lines = [f"{p}x = {p * unit:g}°" for p in parts]
        return "Angles around a point sum to 360°.\n" + "\n".join(lines)

    # Parallel-line questions must identify the relationship for the unknown.
    if (
        "parallel" in norm
        and ("transversal" in norm or "crossed" in norm)
        and len(ns) >= 1
    ):
        relationship_terms = (
            "corresponding", "alternate interior", "alternate exterior",
            "same-side interior", "same side interior",
            "consecutive interior", "co-interior", "vertical",
            "linear pair", "adjacent", "supplementary", "complementary"
        )
        asks_unknown = (
            "find t" in norm or "find x" in norm
            or "unknown angle" in norm
        )
        if asks_unknown and not any(w in norm for w in relationship_terms):
            return (
                "Cannot determine the unknown angle from the given information.\n"
                "The diagram or the angle relationship for the unknown is needed.\n"
                f"Given angle = {ns[0]:g}°."
            )


    # ---------- CALCULATIONS FIRST (numbers required) ----------

    # Collinear segment addition: PQ + QR = PR
    if "collinear" in norm and "between" in norm and len(ns) >= 2:
        a, b = ns[0], ns[1]
        return (
            f"Q is between P and R, so PR = PQ + QR.\n"
            f"PR = {a:g} + {b:g} = {a + b:g} cm"
        )

    # Number-line distance between two bare coordinates
    if ("distance" in norm or "find the distance") and "number line" in norm and len(ns) >= 2:
        d = abs(ns[1] - ns[0])
        return f"Distance on number line = |{ns[1]:g} - ({ns[0]:g})| = {d:g}"

    # Segment endpoints given as two numbers → length + midpoint
    if "segment" in norm and "endpoints" in norm and len(ns) >= 2:
        a, b = ns[0], ns[1]
        length = abs(b - a)
        mid = (a + b) / 2
        return (
            f"Length = |{b:g} - ({a:g})| = {length:g}\n"
            f"Midpoint = ({a:g} + {b:g})/2 = {mid:g}"
        )

    # Ratio division of a segment (AM:MB = p:q, AB = total)
    if ("ratio" in norm or "divides" in norm) and ("am" in norm or "mb" in norm or "divides" in norm) and len(ns) >= 3:
        # expect p, q, total  or  p:q and total
        if len(ns) >= 3:
            p, q, total = ns[0], ns[1], ns[2]
            am = total * p / (p + q)
            mb = total * q / (p + q)
            return f"AM = {total:g} × {p:g}/({p:g}+{q:g}) = {am:g} cm\nMB = {mb:g} cm"

    # Straight-angle ratio
    if "straight angle" in norm and "ratio" in norm and len(ns) >= 2:
        r1, r2 = ns[0], ns[1]
        s = r1 + r2
        return (
            f"Angles on a straight line sum to 180°.\n"
            f"Larger = 180 × {r1:g}/{s:g} = {180 * r1 / s:g}°\n"
            f"Smaller = 180 × {r2:g}/{s:g} = {180 * r2 / s:g}°"
        )

    # Complement / supplement phrasing
    if "complement" in norm and len(ns) >= 1:
        x = ns[0]
        # "18 less than its complement" → a = (90 - 18)/2 or a + 18 = 90 - a
        if "less than" in norm:
            a = (90 - x) / 2
            return f"Let the angle be a. Then a = (90 - a) - {x:g} → 2a = 90 - {x:g} → a = {a:g}°"
        return f"Complement of {x:g}° is {90 - x:g}°"
    if "supplement" in norm and len(ns) >= 1:
        x = ns[0]
        if "more than" in norm:
            a = (180 + x) / 2
            return f"Let the angle be a. Then a = (180 - a) + {x:g} → 2a = 180 + {x:g} → a = {a:g}°"
        return f"Supplement of {x:g}° is {180 - x:g}°"

    # Angles around a point (sum 360)
    if ("around a point" in norm or "about a point" in norm) and len(ns) >= 1:
        if "ratio" in norm or "x" in norm:
            # e.g. x, 2x, 3x, 4x
            coeffs = ns if len(ns) > 1 else [1, 2, 3, 4]
            s = sum(coeffs)
            parts = [360 * c / s for c in coeffs]
            return "Angles around a point sum to 360°.\n" + "\n".join(
                f"{c:g}x = {p:g}°" for c, p in zip(coeffs, parts)
            )
        known = sum(ns)
        return f"x = 360 - {known:g} = {360 - known:g}°"

    # Adjacent on a straight line
    if ("adjacent" in norm or "straight line" in norm) and len(ns) >= 1 and "ratio" not in norm:
        return f"Adjacent angle on a straight line = 180 - {ns[0]:g} = {180 - ns[0]:g}°"

    # 2-D distance / midpoint from labelled points A(x,y)
    pts = extract_points()
    if len(pts) >= 2 and any(w in norm for w in ("distance", "length between", "midpoint", "mid point")):
        a, b = pts[0], pts[1]
        dx, dy = b[1] - a[1], b[2] - a[2]
        if "midpoint" in norm or "mid point" in norm:
            mx, my = (a[1] + b[1]) / 2, (a[2] + b[2]) / 2
            return f"Midpoint formula: M = ((x1+x2)/2, (y1+y2)/2)\nM = ({mx:g}, {my:g})"
        distance = math.hypot(dx, dy)
        return (
            "Distance formula: d = sqrt((x2-x1)^2 + (y2-y1)^2)\n"
            f"d = sqrt(({b[1]:g}-{a[1]:g})^2 + ({b[2]:g}-{a[2]:g})^2)\n"
            f"d = {distance:.10g}"
        )

    # 3-D distance / midpoint
    n = number_pattern()
    p3 = re.findall(
        r"\b([A-Za-z])\s*\(\s*(" + n + r")\s*,\s*(" + n + r")\s*,\s*(" + n + r")\s*\)", raw
    )
    if len(p3) >= 2 and ("distance" in norm or "midpoint" in norm or "mid point" in norm):
        a, b = p3[:2]
        av = tuple(float(v) for v in a[1:])
        bv = tuple(float(v) for v in b[1:])
        if "midpoint" in norm or "mid point" in norm:
            m = tuple((x + y) / 2 for x, y in zip(av, bv))
            return f"Three-dimensional midpoint:\nM = ({m[0]:g}, {m[1]:g}, {m[2]:g})"
        d = math.sqrt(sum((y - x) ** 2 for x, y in zip(av, bv)))
        return (
            "Three-dimensional distance formula:\n"
            "d = sqrt((x2-x1)^2 + (y2-y1)^2 + (z2-z1)^2)\n"
            f"d = {d:.10g}"
        )

    # Angle classification only when an explicit degree is present
    m = re.search(
        r"\b(?:angle|angle measure|measure of angle)\b"
        r".{0,50}?\b(" + number_pattern() + r")\s*(?:degrees?|deg|°)\b",
        norm
    )
    if m:
        deg = float(m.group(1))
        if 0 <= deg <= 360:
            if math.isclose(deg, 0):
                kind = "zero angle"
            elif deg < 90:
                kind = "acute angle"
            elif math.isclose(deg, 90):
                kind = "right angle"
            elif deg < 180:
                kind = "obtuse angle"
            elif math.isclose(deg, 180):
                kind = "straight angle"
            elif deg < 360:
                kind = "reflex angle"
            else:
                kind = "full angle"
            return f"Angle measure: {deg:g} degrees\nClassification: {kind}."

    # ---------- DEFINITIONS ONLY WHEN NO NUMBERS ----------
    if not ns:
        # Specific concepts must precede generic line definitions.
        if "collinear" in norm:
            return (
                "Three points are collinear exactly when all three lie on one straight line. "
                "Their coordinates can verify this by comparing slopes, or by checking that "
                "the relevant direction vectors are proportional."
            )

        if "coincident" in norm and "line" in norm:
            return (
                "Intersecting lines share a point; parallel distinct lines never meet; "
                "coincident lines are the same geometric line and share every point."
            )

        if "parallel" in norm and "intersect" in norm and "line" in norm:
            return (
                "Intersecting lines share one point in a plane. Parallel distinct lines "
                "do not intersect. Coincident lines lie exactly on top of each other "
                "and share every point."
            )

        if "intersecting" in norm and "parallel" in norm and "line" in norm:
            return (
                "Intersecting lines share a point. Parallel distinct lines in a plane "
                "never meet. Coincident lines are the same line and share every point."
            )

        if "line, ray, and segment" in norm or "line ray and segment" in norm:
            return (
                "A line has no endpoints and extends infinitely in both directions. "
                "A ray has one endpoint and extends infinitely in one direction. "
                "A segment has two endpoints and contains the finite portion between them."
            )

        if "two distinct points" in norm and "exactly one line" in norm:
            return (
                "Through any two distinct points, exactly one straight line can be drawn. "
                "The points fix the line's direction and position."
            )

        definitions = (
            (("ray", "rays"),
             "A ray has one endpoint and extends infinitely in one direction. In ray AB, A is the endpoint and the ray passes through B."),
            (("segment",),
             "A segment AB consists of endpoints A and B and every point between them. Its length AB is a nonnegative number."),
            (("plane", "planes"),
             "A plane is a flat two-dimensional surface extending without boundaries. Three noncollinear points determine exactly one plane."),
            (("intersection",),
             "An intersection is the set of points common to two or more geometric objects. Two distinct lines in a plane intersect in at most one point."),
            (("line", "lines"),
             "A line extends infinitely in both directions. Two distinct points determine exactly one line."),
        )
        for keys, answer in definitions:
            if any(k in norm for k in keys):
                return answer

        if "between" in norm:
            return (
                "To determine whether B lies between A and C, verify that the three points "
                "are collinear and that B lies within the segment AC."
            )
        if any(w in norm for w in ("interior", "exterior", "inside", "outside")):
            if "angle" in norm:
                return (
                    "The interior of an angle is the region between its two rays, excluding the rays themselves."
                )
            return (
                "Interior and exterior are defined relative to a specified geometric object or boundary."
            )

    return None


def geometry_proof_fast_path(text):
    """Deterministic angle relationships and elementary geometric proofs."""

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    n = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def find_measure(labels):
        for label in labels:
            m = re.search(
                r"\b" + label +
                r"\b\s*(?:=|is|measures?|of)?\s*(" + n +
                r")\s*(?:degrees?|deg|°)?\b", low
            )
            if m:
                return float(m.group(1))
        return None

    # Complementary and supplementary angle calculations.
    is_complement = any(
        w in low for w in ("complement", "complementary")
    )
    is_supplement = any(
        w in low for w in ("supplement", "supplementary")
    )

    if is_complement or is_supplement:
        target = 90.0 if is_complement else 180.0
        label = "complementary" if is_complement else "supplementary"
        values = re.findall(
            r"(?<![a-z])(" + n + r")\s*(?:degrees?|deg|°)\b", low
        )
        if not values:
            values = re.findall(
                r"\b(?:angle|one angle|first angle)\s*(?:is|=|of)?\s*"
                r"(" + n + r")\b", low
            )
        if values:
            a = float(values[0])
            b = target - a
            if 0 <= a <= target:
                return (
                    f"{label.capitalize()} angles sum to {target:g}°.\n"
                    f"Unknown angle = {target:g}° - {a:g}° = {b:g}°."
                )
            return None

    # Vertical angles.
    if "vertical angles" in low or "vertical angle theorem" in low:
        if any(w in low for w in ("prove", "proof", "why", "explain")):
            return (
                "Proof: Vertical angles are congruent.\n"
                "1. Two lines intersect at O. (Given)\n"
                "2. Each pair of adjacent angles forms a linear pair. "
                "(Definition of linear pair)\n"
                "3. Each linear pair sums to 180°. "
                "(Linear Pair Postulate)\n"
                "4. The two vertical angles each supplement the same "
                "adjacent angle. (Steps 2–3)\n"
                "5. Angles supplementary to the same angle are congruent. "
                "(Congruent Supplements Theorem)\n"
                "Therefore, the vertical angles are congruent."
            )
        return (
            "Vertical angles are opposite angles formed by two intersecting "
            "lines. The Vertical Angles Theorem states that they are congruent."
        )

    # Linear pair.
    if "linear pair" in low:
        return (
            "Linear Pair Theorem: two adjacent angles whose noncommon sides "
            "are opposite rays are supplementary. Therefore their measures "
            "sum to 180°."
        )

    # Perpendicular lines.
    if "perpendicular" in low:
        if any(w in low for w in ("prove", "proof", "why", "show that")):
            return (
                "Proof structure:\n"
                "1. Given: line l is perpendicular to line m.\n"
                "2. By the definition of perpendicular lines, the lines "
                "intersect to form right angles.\n"
                "3. Every right angle measures 90°.\n"
                "Conclusion: each angle formed by l and m measures 90°."
            )
        return (
            "Perpendicular lines intersect to form right angles. Each "
            "right angle measures 90°; adjacent angles formed at the "
            "intersection are supplementary."
        )

    # Triangle angle sum theorem.
    if "triangle" in low and any(w in low for w in (
        "angle sum", "sum of the angles", "interior angles",
        "third angle", "missing angle"
    )):
        values = re.findall(
            r"(" + n + r")\s*(?:degrees?|deg|°)\b", low
        )
        if len(values) >= 2:
            a, b = float(values[0]), float(values[1])
            c = 180.0 - a - b
            if 0 <= a <= 180 and 0 <= b <= 180 and 0 <= c <= 180:
                return (
                    "Triangle Angle Sum Theorem: A + B + C = 180°.\n"
                    f"C = 180° - {a:g}° - {b:g}° = {c:g}°."
                )
        return (
            "Triangle Angle Sum Theorem: the interior angles of every "
            "Euclidean triangle sum to 180°. If two measures are known, "
            "subtract their sum from 180° to find the third."
        )

    # Generic proof request: do not fabricate a proof without a proposition.
    if re.search(r"\b(prove|proof|justify|show that)\b", low):
        return (
            "A valid geometric proof needs explicit givens and a precise "
            "conclusion. Supply the diagram relationships or written givens. "
            "A proof will then connect each statement to a definition, "
            "postulate, theorem, or previously established result."
        )

    return None


