            "half the segment; join the arc intersections.\\n"
            "- Angle bisector: draw an arc centered at the vertex "
            "to mark both sides; from those marks draw equal-radius "
            "intersecting arcs; join the vertex to their intersection."
        )

    # Core definitions and standard locus theorems.
    if any(w in low for w in (
        "equidistant from two points", "equidistant from two fixed points",
        "locus of points equidistant from two points"
    )):
        return (
            "The locus of points equidistant from two fixed points is the "
            "perpendicular bisector of the segment joining them. Every point "
            "on that perpendicular bisector has equal distances to the two "
            "fixed points, and the converse is also true."
        )

    if any(w in low for w in (
        "equidistant from the sides of an angle",
        "equidistant from two sides of an angle",
        "locus equidistant from the sides"
    )):
        return (
            "The locus of points inside an angle that are equidistant from "
            "its two sides is the angle bisector. Distance to a side means "
            "the perpendicular distance to the line containing that side."
        )

    if "angle bisector" in low and ("locus" in low or "equidistant" in low):
        return (
            "An angle bisector is the locus of points equidistant from the "
            "two sides of the angle. The converse also holds for points "
            "inside the angle."
        )

    if "perpendicular bisector" in low:
        return (
            "Perpendicular Bisector Theorem: any point on the perpendicular "
            "bisector of a segment is equidistant from the segment's endpoints. "
            "Converse: any point equidistant from the endpoints lies on the "
            "perpendicular bisector."
        )

    if "locus" in low and any(w in low for w in (
        "fixed distance", "constant distance", "distance from a point"
    )):
        return (
            "In a plane, the locus of points a fixed distance r from a fixed "
            "point C is a circle centered at C with radius r. In three "
            "dimensions, the corresponding locus is a sphere."
        )

    if "locus" in low and any(w in low for w in (
        "parallel line", "parallel to a line", "fixed line"
    )):
        return (
            "The locus of points at a fixed perpendicular distance d from "
            "a given line consists of two lines parallel to the given line, "
            "one on each side, each at distance d. If the condition is "
            "distance at most d, the locus is the strip between those lines."
        )

    if "locus" in low and any(w in low for w in (
        "two intersecting lines", "two lines", "angle"
    )):
        return (
