def geometry_special_topics_2_fast_path(text):
    """Special geometry topics: surveying, proofs, maps, curves, biology, solids."""

    _calc = _wants_calculation(text)
    import math
    import re

    low = " ".join(str(text or "").strip().lower().split())
    number = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def fmt(x):
        return f"{x:.10g}"

    def nums():
        return [
            float(v) for v in re.findall(
                r"(?<![a-z0-9.])(" + number + r")(?![a-z0-9.])",
                low
            )
        ]

    # Surveying and indirect measurement.
    if "mathematics in surveying" in low or "math in surveying" in low:
        return (
            "MATHEMATICS IN SURVEYING — Surveying determines positions, "
            "distances, elevations, and boundaries. Core methods include "
            "triangulation, trigonometry, coordinate geometry, scale, and "
            "error analysis.\n"
            "- Horizontal distance on level ground can be measured directly.\n"
            "- For a right triangle, tan(θ) = height / horizontal distance.\n"
            "- Coordinate differences give distance "
            "d = √((x₂-x₁)²+(y₂-y₁)²).\n"
            "Professional surveys also require calibrated instruments, "
            "datum references, corrections, and uncertainty estimates."
        )

    if "surveying problem" in low or "surveying problems" in low:
        v = nums()
        if len(v) >= 2 and "angle" in low and any(
            w in low for w in ("height", "distance", "elevation")
        ):
            angle = next(
                (float(x) for x in re.findall(
                    r"(" + number + r")\s*(?:degrees?|°)(?![a-z])", low
                )),
                None
            )
            if angle is not None and 0 < angle < 90:
                rad = math.radians(angle)
                if "height" in low and "distance" in low:
                    # Treat the first two non-angle numbers as the known
                    # horizontal distance and angle only when the wording
                    # explicitly requests the height from a distance.
                    distance = next(
                        (x for x in v if not math.isclose(x, angle)),
                        None
                    )
                    if distance is not None and distance > 0:
                        height = distance * math.tan(rad)
                        return (
                            f"Surveying right-triangle model: "
                            f"tan(θ) = height/distance. With θ = "
                            f"{fmt(angle)}° and horizontal distance = "
                            f"{fmt(distance)}, height = {fmt(distance)} × "
                            f"tan({fmt(angle)}°) = {fmt(height)}. "
                            "This assumes level ground and ignores instrument "
                            "height and curvature/refraction corrections."
                        )
        return (
            "Surveying problems commonly use scale drawings, similar "
            "triangles, bearings, coordinate distances, and trigonometry. "
            "Draw a labeled diagram, identify known horizontal/vertical "
            "distances and angles, choose a formula, keep units consistent, "
            "and state any assumptions."
        )

    # Which pocket? Keep as a puzzle topic; avoid inventing a specific puzzle.
    if "which pocket" in low:
        return (
            "WHICH POCKET? — Treat this as a geometric deduction puzzle. "
            "Identify the objects, pockets, and every stated constraint. "
            "Translate spatial clues into explicit conditions, eliminate "
            "impossible placements, and verify the remaining arrangement "
            "against all clues. To solve a specific instance, write down "
            "the exact clues or provide the puzzle diagram; without those "
            "constraints, no unique pocket assignment can be justified."
        )

    # Philately: stamps and geometric arrangements.
    if "philatelist" in low or "philatelists" in low or "stamp collection" in low:
        return (
            "FUN FOR PHILATELISTS — Geometry appears in stamp dimensions, "
            "perforation spacing, symmetry, rectangular arrays, and "
            "collection layouts. For stamps of width w and height h in "
            "r rows and c columns, the stamp area is rcwh. If gaps gₓ and "
            "gᵧ separate stamps, the array dimensions are "
            "cw + (c-1)gₓ by rh + (r-1)gᵧ. Distinguish stamp area from "
            "the area occupied by the complete layout."
        )

    # Pythagorean theorem proof.
    if "proving the pythagorean theorem" in low or (
        any(w in low for w in ("prove", "proof"))
        and "pythagorean theorem" in low
    ):
        return (
            "PROVING THE PYTHAGOREAN THEOREM — For a right triangle with "
            "legs a, b and hypotenuse c, a² + b² = c².\n"
            "Area proof by rearrangement: arrange four congruent right "
            "triangles inside a square of side a+b. The uncovered central "
            "square has side c, so its area is c². The large square's area "
            "is (a+b)², and the four triangles have total area 2ab. Thus\n"
            "(a+b)² - 2ab = c²,\n"
            "which simplifies to a² + b² = c². This assumes the central "
            "region is a square, as follows from the right angles and "
            "congruent triangle orientations."
        )

    # Pantograph.
    if "pantograph" in low:
        return (
