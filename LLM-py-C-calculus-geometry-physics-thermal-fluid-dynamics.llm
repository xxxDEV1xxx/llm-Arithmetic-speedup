                    "    T *= r**((g-1)/g)\n"
                    "    print(f'stage {stage}: p={p:.6g} kPa, T={T:.6g} K')\n")
        return ("#include <stdio.h>\n#include <math.h>\n"
                "int main(void) {\n"
                "    double T=300, p=100, r=2, g=1.4;\n"
                "    for (int s=1; s<=4; s++) {\n"
                "        p *= r; T *= pow(r, (g-1)/g);\n"
                "        printf(\"stage %d: p=%.6g kPa, T=%.6g K\\n\", s, p, T);\n"
                "    }\n    return 0;\n}\n")

    if ("tank" in low and "drain" in low) or ("torricelli" in low and "euler" in low):
        if is_py:
            return ("import math\n"
                    "A, a, h, dt, g = 1.0, 0.001, 2.0, 1.0, 9.81\n"
                    "t = 0.0\n"
                    "while h > 0:\n"
                    "    h -= a * math.sqrt(2*g*h) / A * dt\n"
                    "    if h < 0: h = 0\n"
                    "    t += dt\n"
                    "print(f'time to empty: {t:.6g} s')\n")
        return ("#include <stdio.h>\n#include <math.h>\n"
                "int main(void) {\n"
                "    double A=1, a=0.001, h=2, dt=1, g=9.81, t=0;\n"
                "    while (h > 0) {\n"
                "        h -= a * sqrt(2*g*h) / A * dt;\n"
                "        if (h < 0) h = 0;\n"
                "        t += dt;\n"
                "    }\n"
                "    printf(\"time to empty: %.6g s\\n\", t);\n"
                "    return 0;\n}\n")
    return None


def programming_fast_path(text):
    """Deterministic programming dispatcher; never calls a model."""
    if not isinstance(text, str):
        return None

    low = re.sub(r"\s+", " ", text.lower()).strip()

    intent = re.search(
        r"\b(write|create|generate|implement|build|code|program|"
        r"programming|script|function|class|algorithm|unit test|"
        r"test suite|hello world|factorial|fibonacci|fizzbuzz|"
        r"countdown|for loop|while loop|parser|compiler|"
        r"source code|code snippet|debug|refactor)\b",
        low,
    )
    if not intent:
        return None

    if re.search(r"\bc\s*(?:#|sharp)\b", low):
        lang = "csharp"
    elif re.search(r"\bc\+\+|\bcpp\b|c plus plus", low):
        lang = "cpp"
    elif re.search(r"\bpython(?:\s*3)?\b", low):
        lang = "python"
    elif re.search(
        r"\b(?:in c|c language|c program|write c code|"
        r"language\s*=\s*c)\b", low
    ):
        lang = "c"
    else:
        return (
            "PROGRAMMING FAST PATH: Specify Python, C, C++, or C#. "
            "No model was called."
        )

    def unsupported():
        return (
            f"PROGRAMMING FAST PATH: No deterministic {lang} handler "
            "matches this request. No model was called. Add an explicit "
            "handler for this task to enable it."
        )

    def emit(body):
        if lang == "python":
            return body + "\n"

        if lang == "c":
            return (
                "#include <stdio.h>\n"
                "#include <string.h>\n"
                "#include <stdbool.h>\n\n"
                "int main(void) {\n" +
                "".join("    " + x + "\n" for x in body.splitlines()) +
                "    return 0;\n}\n"
            )

        if lang == "cpp":
            return (
                "#include <iostream>\n"
                "#include <string>\n"
                "#include <algorithm>\n"
                "#include <vector>\n"
                "#include <cstdlib>\n\n"
                "int main() {\n" +
                "".join("    " + x + "\n" for x in body.splitlines()) +
                "    return 0;\n}\n"
            )

        return (
            "using System;\n"
            "using System.Linq;\n\n"
            "class Program\n{\n"
            "    static void Main()\n    {\n" +
            "".join("        " + x + "\n"
                    for x in body.splitlines()) +
            "    }\n}\n"
        )

    nmatch = re.search(r"\bn\s*=\s*(\d+)", low)
    n = int(nmatch.group(1)) if nmatch else 5

    fmatch = re.search(r"\bfactorial\s*(?:of\s*)?(\d+)", low)
    if fmatch:
        n = int(fmatch.group(1))

    if (
        lang == "python"
        and "function" in low
        and re.search(r"\b(add|addition|sum|adds)\b", low)
        and re.search(r"\b(integer|integers|number|numbers)\b", low)
    ):
        return (
            "def add(a: int, b: int) -> int:\n"
            "    return a + b\n"
            "\n"
            "\n"
            'if __name__ == "__main__":\n'
            "    assert add(2, 3) == 5\n"
            "    print(add(2, 3))\n"
        )

    if "hello" in low and "world" in low:
        if lang == "python":
            return 'print("Hello, world!")\n'
        if lang == "c":
            return '#include <stdio.h>\n\nint main(void) {\n    puts("Hello, world!");\n    return 0;\n}\n'
        if lang == "cpp":
            return '#include <iostream>\n\nint main() {\n    std::cout << "Hello, world!\\n";\n    return 0;\n}\n'
        return 'using System;\n\nclass Program {\n    static void Main() {\n        Console.WriteLine("Hello, world!");\n    }\n}\n'

    if "factorial" in low:
        if not 0 <= n <= 20:
            return "PROGRAMMING FAST PATH: factorial supports n from 0 to 20."
        if lang == "python":
            return (
                "import math\n\n"
                f"n = {n}\n"
                "print(math.factorial(n))\n"
            )
        if lang == "c":
            return emit(
                f"unsigned long long result = 1;\n"
                f"for (int i = 2; i <= {n}; ++i) result *= i;\n"
                "printf(\"%llu\\n\", result);"
            )
        if lang == "cpp":
            return emit(
                f"unsigned long long result = 1;\n"
                f"for (int i = 2; i <= {n}; ++i) result *= i;\n"
                "std::cout << result << '\\n';"
            )
        return emit(
            f"ulong result = 1;\n"
            f"for (int i = 2; i <= {n}; ++i) result *= (ulong)i;\n"
            "Console.WriteLine(result);"
        )

    if "fibonacci" in low:
        if not 0 <= n <= 100:
            return "PROGRAMMING FAST PATH: Fibonacci supports n from 0 to 100."
        if lang == "python":
            return (
                f"n = {n}\na, b = 0, 1\n"
                "for _ in range(n):\n"
                "    print(a)\n"
                "    a, b = b, a + b\n"
            )
        if lang == "c":
            return emit(
                f"unsigned long long a = 0, b = 1;\n"
                f"for (int i = 0; i < {n}; ++i) {{\n"
                '    printf("%llu\\n", a);\n'
                "    unsigned long long t = a + b;\n"
                "    a = b; b = t;\n}"
            )
        if lang == "cpp":
            return emit(
                f"unsigned long long a = 0, b = 1;\n"
                f"for (int i = 0; i < {n}; ++i) {{\n"
                "    std::cout << a << '\\n';\n"
                "    auto t = a + b; a = b; b = t;\n}"
            )
        return emit(
            f"ulong a = 0, b = 1;\n"
            f"for (int i = 0; i < {n}; ++i) {{\n"
            "    Console.WriteLine(a);\n"
            "    ulong t = a + b; a = b; b = t;\n}"
        )


    # DETERMINISTIC_EXTENDED_HANDLERS_V1
    # Specific protocol handlers must precede generic algorithm handlers.

    if lang == "python" and "crc-16" in low and "magic header" in low and "variable-length integer" in low:
        return r"""import unittest
from dataclasses import dataclass

MAGIC = b"PKT1"
VERSION = 1
MAX_PAYLOAD = 65535

# CRC-16/CCITT-FALSE: poly=0x1021, init=0xFFFF,
# refin=False, refout=False, xorout=0.
# CRC covers version, encoded length, and payload.

@dataclass(frozen=True)
class Packet:
    version: int
    payload: bytes

def encode_uleb128(value):
    if not isinstance(value, int) or isinstance(value, bool) or value < 0 or value > 0xFFFFFFFFFFFFFFFF:
        raise ValueError("value outside uint64 range")
    out = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        if value:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            return bytes(out)

def decode_uleb128(data, offset=0):
    if offset < 0 or offset > len(data):
        raise ValueError("invalid offset")
    value = 0
    for i in range(10):
        pos = offset + i
        if pos >= len(data):
            raise ValueError("truncated LEB128")
        byte = data[pos]
        value |= (byte & 0x7F) << (7 * i)
        if not byte & 0x80:
            consumed = i + 1
            if value > 0xFFFFFFFFFFFFFFFF:
                raise ValueError("LEB128 overflow")
            if encode_uleb128(value) != data[offset:offset + consumed]:
                raise ValueError("overlong LEB128")
            return value, consumed
    raise ValueError("overlong LEB128")

def crc16(data):
    crc = 0xFFFF
    for byte in data:
        crc ^= byte << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc

def build_packet(payload, version=VERSION):
    if len(payload) > MAX_PAYLOAD:
        raise ValueError("payload too large")
    body = bytes([version]) + encode_uleb128(len(payload)) + payload
    return MAGIC + body + crc16(body).to_bytes(2, "big")

def parse_packet(data, max_payload=MAX_PAYLOAD):
    if len(data) < len(MAGIC):
        raise ValueError("truncated magic header")
    if data[:len(MAGIC)] != MAGIC:
        raise ValueError("invalid magic header")
    if len(data) < len(MAGIC) + 1:
        raise ValueError("truncated version")
    version = data[len(MAGIC)]
    if version != VERSION:
        raise ValueError("unsupported version")
    length, used = decode_uleb128(data, len(MAGIC) + 1)
    if length > max_payload:
        raise ValueError("payload too large")
    payload_start = len(MAGIC) + 1 + used
    payload_end = payload_start + length
    packet_end = payload_end + 2
    if len(data) < packet_end:
        raise ValueError("truncated payload or checksum")
    if len(data) > packet_end:
        raise ValueError("length mismatch: trailing bytes")
    expected = int.from_bytes(data[payload_end:packet_end], "big")
    actual = crc16(data[len(MAGIC):payload_end])
    if expected != actual:
        raise ValueError("CRC-16 mismatch")
    return Packet(version, data[payload_start:payload_end])

class ProtocolTests(unittest.TestCase):
    def test_valid_packet(self):
        self.assertEqual(parse_packet(build_packet(b"abc")).payload, b"abc")

    def test_empty_payload(self):
        self.assertEqual(parse_packet(build_packet(b"")).payload, b"")

    def test_invalid_magic(self):
        with self.assertRaisesRegex(ValueError, "magic"):
            parse_packet(b"NOPE" + build_packet(b"x")[4:])

    def test_unsupported_version(self):
        with self.assertRaisesRegex(ValueError, "version"):
            parse_packet(build_packet(b"x", version=2))

    def test_truncated_packet(self):
        with self.assertRaises(ValueError):
            parse_packet(build_packet(b"abc")[:-1])

    def test_trailing_bytes(self):
        with self.assertRaisesRegex(ValueError, "length mismatch"):
            parse_packet(build_packet(b"x") + b"x")

    def test_bad_crc(self):
        packet = bytearray(build_packet(b"abc"))
        packet[-1] ^= 1
        with self.assertRaisesRegex(ValueError, "CRC"):
            parse_packet(bytes(packet))

    def test_oversized_payload(self):
        with self.assertRaisesRegex(ValueError, "too large"):
            parse_packet(build_packet(b"abc"), max_payload=2)

    def test_malformed_length_encoding(self):
        with self.assertRaises(ValueError):
            decode_uleb128(b"\x80\x00")

    def test_truncated_length_encoding(self):
        with self.assertRaises(ValueError):
            decode_uleb128(b"\x80")

    def test_length_boundary(self):
        self.assertEqual(parse_packet(build_packet(b"x" * 127)).payload, b"x" * 127)
        self.assertEqual(parse_packet(build_packet(b"x" * 128)).payload, b"x" * 128)

if __name__ == "__main__":
    unittest.main()
"""

    if lang == "python" and "leb128" in low and "decode" in low:
        return r"""import unittest

def decode_uleb128(data, offset=0):
    if offset < 0 or offset > len(data):
        raise ValueError("invalid offset")
    value = 0
    for i in range(10):
        pos = offset + i
        if pos >= len(data):
            raise ValueError("truncated encoding")
        byte = data[pos]
        value |= (byte & 0x7F) << (7 * i)
        if not byte & 0x80:
            count = i + 1
            if value > 0xFFFFFFFFFFFFFFFF:
                raise ValueError("uint64 overflow")
            if encode_uleb128(value) != data[offset:offset + count]:
                raise ValueError("overlong encoding")
            return value, count
    raise ValueError("overlong encoding")

def encode_uleb128(value):
    if not isinstance(value, int) or isinstance(value, bool) or not 0 <= value <= 0xFFFFFFFFFFFFFFFF:
        raise ValueError("value outside uint64 range")
    result = bytearray()
    while True:
        byte = value & 0x7F
        value >>= 7
        result.append(byte | 0x80 if value else byte)
        if not value:
            return bytes(result)

class LEB128Tests(unittest.TestCase):
    def test_values(self):
        for value in (0, 1, 127, 128, 300, 16384, 0xFFFFFFFFFFFFFFFF):
            encoded = encode_uleb128(value)
            self.assertEqual(decode_uleb128(encoded), (value, len(encoded)))

    def test_offset(self):
        self.assertEqual(decode_uleb128(b"x\xac\x02", 1), (300, 2))

    def test_truncated(self):
        with self.assertRaises(ValueError):
            decode_uleb128(b"\x80")

    def test_overlong(self):
        with self.assertRaises(ValueError):
            decode_uleb128(b"\x80\x00")

    def test_too_many_bytes(self):
        with self.assertRaises(ValueError):
            decode_uleb128(b"\x81" * 10 + b"\x00")

    def test_invalid_offset(self):
        with self.assertRaises(ValueError):
            decode_uleb128(b"\x00", 2)

if __name__ == "__main__":
    unittest.main()
"""

    if lang == "python" and "checksum" in low and "1-byte type" in low:
        return r"""import unittest

def parse_packet(data):
    if len(data) < 4:
        raise ValueError("truncated packet header")
    packet_type = data[0]
    length = int.from_bytes(data[1:3], "big")
    expected_size = 3 + length + 1
    if len(data) < expected_size:
        raise ValueError("truncated payload or checksum")
    if len(data) > expected_size:
        raise ValueError("length mismatch")
    payload = data[3:3 + length]
    if data[-1] != sum(payload) % 256:
        raise ValueError("checksum mismatch")
    return {"type": packet_type, "payload": payload}

def build_packet(packet_type, payload):
    return bytes([packet_type]) + len(payload).to_bytes(2, "big") + payload + bytes([sum(payload) % 256])

class PacketTests(unittest.TestCase):
    def test_valid(self):
        self.assertEqual(parse_packet(build_packet(7, b"abc")), {"type": 7, "payload": b"abc"})

    def test_empty_payload(self):
        self.assertEqual(parse_packet(build_packet(1, b""))["payload"], b"")

    def test_bad_checksum(self):
        packet = bytearray(build_packet(1, b"abc"))
        packet[-1] ^= 1
        with self.assertRaisesRegex(ValueError, "checksum"):
            parse_packet(bytes(packet))

    def test_truncated(self):
        with self.assertRaises(ValueError):
            parse_packet(build_packet(1, b"abc")[:-1])

    def test_length_mismatch(self):
        with self.assertRaisesRegex(ValueError, "length mismatch"):
            parse_packet(build_packet(1, b"x") + b"x")

    def test_large_length_boundary(self):
        payload = b"x" * 256
        self.assertEqual(parse_packet(build_packet(2, payload))["payload"], payload)

if __name__ == "__main__":
    unittest.main()
