        ),
        (
            "Circle",
            "A circle is the set of points in a plane at a fixed distance from a center.",
            "circle; ⊙O may denote a circle centered at O",
            "circle centered at O, when the center is named",
            ("circle", "a circle"),
        ),
        (
            "Arc AB",
            "The part of a circle between points A and B.",
            "⌢AB (arc AB)",
            "arc AB",
            ("arc ab", "arc from a to b"),
        ),
        (
            "Degree measure of arc AB",
            "The measure of arc AB, expressed in degrees.",
            "m(⌢AB)",
            "measure of arc AB",
            ("degree measure of arc ab", "measure of arc ab"),
        ),
        (
            "P sub one",
            "The point or quantity named P with subscript one.",
            "P₁",
            "P sub one",
            ("p sub one", "p sub 1", "p subscript one", "p subscript 1"),
        ),
        (
            "Point P with coordinates (x, y)",
            "Point P has horizontal coordinate x and vertical coordinate y.",
            "P(x, y)",
            "point P, coordinates x and y",
            ("point p with coordinates", "coordinates of point p"),
        ),
        (
            "Directed distance from R to S",
            "The signed distance from R toward S along a specified line or axis; its sign depends on the chosen positive direction.",
            "directed RS; use an explicit sign or coordinate difference when required",
            "directed distance from R to S",
            ("directed distance from r to s", "directed distance r to s"),
        ),
    ]

    def render(entry):
        name, full, symbol, ascii_form, aliases = entry
        return (
            name + "\n"
            "Full form: " + full + "\n"
            "Symbol form: " + symbol + "\n"
            "Keyboard-safe form: " + ascii_form
        )

    # A complete list is returned for explicit list requests.
    if any(term in low for term in (
        "symbol list", "list of geometry symbols",
        "geometry notation list", "all geometry symbols",
        "all the geometry symbols", "list all symbols",
    )):
        return "\n\n".join(render(entry) for entry in entries)

    # Avoid intercepting ordinary geometry questions. Individual lookup
    # requires a notation/symbol request or an explicit "what symbol" query.
    wants_symbol = any(term in low for term in (
        "symbol", "notation", "shorthand", "write in symbols",
        "what is the symbol", "what symbol", "symbol for",
        "how do i write",
    ))
    if not wants_symbol:
        return None

    # Match the most specific alias first to avoid matching "parallel"
    # before "not parallel", or "congruent" before "not congruent".
    matches = []
    for entry in entries:
        for alias in entry[4]:
            if alias in low:
                matches.append((len(alias), entry))
                break

    if not matches:
        return None

    matches.sort(key=lambda item: item[0], reverse=True)
    # If multiple requested terms are present, return each distinct match.
    output = []
    seen = set()
    for _, entry in matches:
        if entry[0] not in seen:
            output.append(render(entry))
            seen.add(entry[0])
    return "\n\n".join(output)



def parallel_lines_fast_path(text):
    """Parallel lines, transversals, angle relationships, and parallel planes."""

    _calc = _wants_calculation(text)
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    n = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def angle_values():
        return [
            float(x) for x in re.findall(
                r"(?<![a-z0-9.])(" + n + r")\s*(?:degrees?|degs?|°)\b",
                low
            )
        ]

    def angle_sum_result(target, value, relationship):
        answer = target - value
        if not 0 <= value <= target:
            return None
        return (
            f"{relationship}\n"
            f"Unknown angle = {target:g}° - {value:g}° "
            f"= {answer:g}°."
        )

    # Direct numerical relationships between two angles.
    vals = angle_values()
    asks_for_angle = any(w in low for w in (
        "find", "calculate", "determine", "measure", "what is",
        "how many degrees", "unknown angle"
    ))

    same_side = any(w in low for w in (
        "same-side interior", "same side interior",
        "consecutive interior", "co-interior"
    ))
    corresponding = "corresponding angle" in low
    alternate_interior = "alternate interior" in low
    alternate_exterior = "alternate exterior" in low
    vertical = "vertical angle" in low
    linear_pair = "linear pair" in low

    parallel_context = any(w in low for w in (
        "parallel line", "parallel lines", "transversal",
        "alternate interior", "alternate exterior",
        "corresponding angle", "same-side interior",
        "consecutive interior", "co-interior"
    ))

    if parallel_context and asks_for_angle and vals:
        a = vals[0]
        if same_side:
            return angle_sum_result(
                180.0, a,
                "Same-side interior angles formed by parallel lines "
                "and a transversal are supplementary."
            )
        if corresponding:
            return (
                "Corresponding Angles Theorem: if two parallel lines "
                "are cut by a transversal, corresponding angles are "
                "congruent.\n"
                f"Unknown angle = {a:g}°."
            )
        if alternate_interior:
            return (
                "Alternate Interior Angles Theorem: for parallel lines "
                "cut by a transversal, alternate interior angles are "
                "congruent.\n"
                f"Unknown angle = {a:g}°."
            )
        if alternate_exterior:
            return (
                "Alternate Exterior Angles Theorem: for parallel lines "
                "cut by a transversal, alternate exterior angles are "
                "congruent.\n"
                f"Unknown angle = {a:g}°."
            )
        if vertical:
            return (
                "Vertical Angles Theorem: vertical angles are congruent.\n"
                f"Unknown angle = {a:g}°."
            )
        if linear_pair:
            return angle_sum_result(
                180.0, a,
                "Linear Pair Theorem: adjacent angles forming a straight "
                "line are supplementary."
            )

    # Identify the theorem or converse requested.
    if "converse" in low and parallel_context:
        if same_side:
            return (
                "Converse of the Same-Side Interior Angles Theorem: "
                "if same-side interior angles are supplementary, "
                "the two lines are parallel."
            )
        if alternate_interior:
            return (
                "Converse of the Alternate Interior Angles Theorem: "
                "if alternate interior angles are congruent, "
                "the two lines are parallel."
            )
        if alternate_exterior:
            return (
                "Converse of the Alternate Exterior Angles Theorem: "
                "if alternate exterior angles are congruent, "
                "the two lines are parallel."
            )
        if corresponding:
            return (
                "Converse of the Corresponding Angles Postulate: "
                "if corresponding angles are congruent, "
                "the two lines are parallel."
            )

    # Parallel line and transversal concepts.
    if parallel_context:
        if "prove" in low or "proof" in low:
            return (
                "Parallel-lines proof framework:\n"
                "1. State the given line and transversal relationships.\n"
                "2. Identify the relevant angle pair from the diagram.\n"
                "3. Apply the appropriate theorem or its converse.\n"
                "4. State the conclusion only if the hypotheses are met.\n"
                "The angle positions and the given measures must be "
                "specified to complete a particular proof."
            )

        if same_side:
            return (
                "Same-Side Interior Angles Theorem: when parallel lines "
                "are cut by a transversal, same-side interior angles "
                "sum to 180°."
            )
        if corresponding:
            return (
                "Corresponding angles occupy matching positions at the "
                "two intersections. If the lines are parallel, the "
                "Corresponding Angles Postulate guarantees congruence."
            )
        if alternate_interior:
            return (
                "Alternate interior angles lie between the two lines "
                "and on opposite sides of the transversal. For parallel "
                "lines, they are congruent."
            )
        if alternate_exterior:
            return (
                "Alternate exterior angles lie outside the two lines "
                "and on opposite sides of the transversal. For parallel "
                "lines, they are congruent."
            )
        if "transversal" in low:
            return (
                "A transversal is a line that intersects two or more "
                "coplanar lines at distinct points. With parallel lines, "
                "it creates corresponding, alternate interior, alternate "
                "exterior, and same-side interior angle pairs."
            )
        return (
            "Parallel lines in a plane do not intersect. A transversal "
            "crossing parallel lines creates angle relationships that "
            "can be used to calculate measures or prove parallelism."
        )

    # Parallel postulate.
    if "parallel postulate" in low or "euclid" in low:
        return (
            "Euclidean parallel postulate: through a point not on a given "
            "line, exactly one line in the same plane is parallel to "
            "the given line. Equivalent formulations include the "
            "corresponding-angle characterization of parallel lines."
        )

    # Skew lines: three-dimensional distinction.
    if "skew line" in low or "skew lines" in low:
        return (
            "Skew lines are noncoplanar lines that do not intersect. "
            "They are not parallel, because parallel lines must be "
            "coplanar. Skew lines occur in three-dimensional geometry, "
            "not in a single plane."
        )

    # Parallel planes.
    if "parallel plane" in low or "parallel planes" in low:
        return (
            "Distinct parallel planes are coplanar with neither each "
            "other nor any intersection line in common; more precisely, "
            "they are disjoint planes in Euclidean three-dimensional "
            "space. A line perpendicular to one of two parallel planes "
            "is perpendicular to the other."
        )

    # Triangle angle measures often appear in the parallel-lines unit.
    if "triangle" in low and any(w in low for w in (
        "angle sum", "third angle", "missing angle",
        "sum of the angles", "interior angles"
    )):
        if len(vals) >= 2:
            a, b = vals[0], vals[1]
            c = 180.0 - a - b
            if 0 <= a <= 180 and 0 <= b <= 180 and 0 <= c <= 180:
                return (
                    "Triangle Angle Sum Theorem: A + B + C = 180°.\n"
                    f"C = 180° - {a:g}° - {b:g}° = {c:g}°."
                )
        return (
            "The interior angles of a Euclidean triangle sum to 180°. "
            "Subtract the two known angle measures from 180° to find "
            "the third angle."
        )

    # Construction questions: explain the method without pretending to
    # operate a compass or straightedge.
    if "construct" in low and any(w in low for w in (
        "parallel line", "parallel lines"
    )):
        return (
            "Straightedge-and-compass construction of a parallel line:\n"
            "1. Given line l and a point P outside l, draw a transversal "
            "through P that intersects l at A.\n"
            "2. Copy the angle formed by the transversal and l at A "
            "to vertex P, using the corresponding-angle position.\n"
            "3. Draw the ray through P along the copied angle.\n"
            "The resulting line through P is parallel to l by the "
            "Converse of the Corresponding Angles Theorem."
        )

    return None



def congruent_triangles_fast_path(text):
    """Triangle classification, congruence criteria, and angle sums."""

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    n = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    # Triangle classification by three explicitly supplied side lengths.
    side_match = re.search(
        r"\bsides?\s*(?:are|of lengths?|=|:)?\s*"
        r"(" + n + r")\s*[,and ]+\s*(" + n + r")\s*[,and ]+\s*"
        r"(" + n + r")",
        low
    )
    if side_match and any(w in low for w in (
        "classify", "classification", "what type", "triangle"
    )):
        a, b, c = sorted(float(x) for x in side_match.groups())
        if a <= 0 or a + b <= c:
            return "These lengths do not form a nondegenerate triangle."
        if math.isclose(a, b) and math.isclose(b, c):
            side_type = "equilateral"
        elif math.isclose(a, b) or math.isclose(b, c):
            side_type = "isosceles"
        else:
            side_type = "scalene"

        comparison = a*a + b*b
        largest_sq = c*c
        if math.isclose(comparison, largest_sq, rel_tol=1e-9, abs_tol=1e-9):
            angle_type = "right"
        elif comparison > largest_sq:
            angle_type = "acute"
        else:
            angle_type = "obtuse"

        return (
            f"Side classification: {side_type} triangle.\n"
            f"Angle classification: {angle_type} triangle.\n"
            f"Triangle inequality: {a:g} + {b:g} > {c:g}, so the "
            "three positive lengths form a triangle."
        )

    # Triangle angle sum.
    vals = [
        float(x) for x in re.findall(
            r"(?<![a-z0-9.])(" + n + r")\s*(?:degrees?|degs?|°)\b",
            low
        )
    ]
    if "triangle" in low and any(w in low for w in (
        "angle sum", "third angle", "missing angle", "interior angles"
    )):
        if len(vals) >= 2:
            a, b = vals[:2]
            c = 180.0 - a - b
            if 0 <= a <= 180 and 0 <= b <= 180 and 0 <= c <= 180:
                return (
                    "Triangle Angle Sum Theorem: A + B + C = 180°.\n"
                    f"C = 180° - {a:g}° - {b:g}° = {c:g}°."
                )
        return (
            "The interior angles of a Euclidean triangle sum to 180°. "
            "A triangle's third angle equals 180° minus the sum of "
            "the other two angles."
        )

    # Criteria: distinguish sufficient conditions from non-criteria.
    asks_criterion = any(w in low for w in (
        "congruence", "congruent", "prove triangles", "prove the triangles",
        "which criterion", "which postulate", "which theorem",
        "triangle congruence", "triangle congruence theorem",
        "hl theorem", "hypotenuse leg"
    ))
    if asks_criterion:
        if re.search(r"\b(sss|side.side.side)\b", low):
            return (
                "SSS Congruence Postulate: if the three sides of one "
                "triangle are congruent to the three corresponding sides "
                "of another triangle, the triangles are congruent."
            )
        if re.search(r"\b(sas|side.angle.side)\b", low):
            return (
                "SAS Congruence Postulate: two corresponding sides and "
                "the included angle between those sides are congruent. "
                "The angle must be included between the two known sides."
            )
        if re.search(r"\b(asa|angle.side.angle)\b", low):
            return (
                "ASA Congruence Postulate: two corresponding angles and "
                "the included side between those angles are congruent."
            )
        if re.search(r"\b(aas|saa|angle.angle.side)\b", low):
            return (
                "AAS Congruence Theorem: two corresponding angles and "
                "a corresponding nonincluded side are congruent. The "
                "third angle is determined by the 180° triangle angle sum."
            )
        if re.search(r"\b(hl|hypotenuse.leg)\b", low):
            return (
                "HL Congruence Theorem: two right triangles are congruent "
                "if their hypotenuses and one pair of corresponding legs "
                "are congruent. Both triangles must be right triangles."
            )
        if re.search(r"\b(aaa|angle.angle.angle)\b", low):
            return (
                "AAA is not a triangle-congruence criterion. Three equal "
                "corresponding angles establish similarity, but the "
                "triangles may have different side lengths."
            )
        if re.search(r"\bssa\b|side.side.angle", low):
            return (
                "SSA is not a general triangle-congruence criterion. "
                "Two sides and a nonincluded angle can produce zero, "
                "one, or two possible triangles. Special cases require "
                "additional conditions."
            )
        if "included angle" in low:
            return (
                "The included angle is the angle between the two specified "
                "sides. Two sides and their included angle establish SAS "
                "congruence when the corresponding parts match."
            )
        if "included side" in low:
            return (
                "The included side lies between the two specified angles. "
                "Two angles and their included side establish ASA "
                "congruence when the corresponding parts match."
            )

        return (
            "Triangle congruence criteria:\n"
            "- SSS: three corresponding sides.\n"
            "- SAS: two corresponding sides and the included angle.\n"
            "- ASA: two corresponding angles and the included side.\n"
            "- AAS: two corresponding angles and a nonincluded side.\n"
            "- HL: hypotenuse and one leg, for right triangles only.\n"
            "AAA proves similarity, not congruence; SSA is not sufficient "
            "in general."
        )

    # Classification by angle measures.
    if "triangle" in low and any(w in low for w in (
        "classify", "classification", "what type", "types of triangle"
    )):
        if len(vals) >= 3:
            a, b, c = vals[:3]
            if any(v <= 0 or v >= 180 for v in (a, b, c)):
                return None
            if not math.isclose(a + b + c, 180.0, abs_tol=1e-7):
                return (
                    f"These measures sum to {a+b+c:g}°, not 180°. "
                    "They cannot be the three interior angles of a "
                    "Euclidean triangle."
                )
            if any(math.isclose(v, 90.0) for v in (a, b, c)):
                kind = "right"
            elif any(v > 90.0 for v in (a, b, c)):
                kind = "obtuse"
            else:
                kind = "acute"
            return f"The triangle is {kind} because its angles are {a:g}°, {b:g}°, and {c:g}°."

    # General proof guidance, only when no specific criterion was identified.
    if re.search(r"\b(prove|proof|justify)\b", low) and "triangle" in low:
        return (
            "Triangle congruence proof checklist:\n"
            "1. Identify the two triangles and preserve vertex correspondence.\n"
            "2. List the given congruent sides and angles.\n"
            "3. Verify one complete criterion: SSS, SAS, ASA, AAS, or HL.\n"
            "4. State the congruence in corresponding vertex order.\n"
            "5. Use CPCTC only after triangle congruence has been established.\n"
            "Do not use AAA or general SSA as a congruence criterion."
        )

    return None



def using_congruent_triangles_fast_path(text):
    """CPCTC, isosceles triangles, bisectors, medians, altitudes,
    right-triangle congruence, overlapping triangles, and constructions."""

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    n = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    # Isosceles triangle theorem and converse.
    if "isosceles" in low and "triangle" in low:
        if any(w in low for w in ("prove", "proof", "theorem", "explain")):
            return (
                "Isosceles Triangle Theorem: if two sides of a triangle "
                "are congruent, the angles opposite those sides are "
                "congruent.\n"
                "Converse: if two angles of a triangle are congruent, "
                "the sides opposite those angles are congruent.\n"
                "The vertex angle is between the congruent sides; the "
                "base angles are opposite those sides."
            )

        vals = [
            float(v) for v in re.findall(
                r"(?<![a-z0-9.])(" + n + r")\s*(?:(?:degrees?|deg)\b|°)",
                low
            )
        ]
        if (
            len(vals) >= 1
            and "vertex angle" not in low
            and any(w in low for w in ("base angle", "base angles"))
        ):
            base = vals[0]
            if 0 <= base <= 90:
                vertex = 180.0 - 2.0 * base
                return (
                    "Isosceles Triangle Theorem: the two base angles "
                    "are congruent.\n"
                    f"Vertex angle = 180° - 2({base:g}°) "
                    f"= {vertex:g}°."
                )

        if len(vals) >= 1 and "vertex angle" in low:
            vertex = vals[0]
            if 0 <= vertex <= 180:
                base = (180.0 - vertex) / 2.0
                return (
                    "The base angles of an isosceles triangle are equal.\n"
                    f"Each base angle = (180° - {vertex:g}°)/2 "
                    f"= {base:g}°."
                )

        return (
            "An isosceles triangle has at least two congruent sides. "
            "The angles opposite those sides are congruent. Its altitude "
            "from the vertex between the congruent sides to the base is "
            "also a median, angle bisector, and perpendicular bisector "
            "of the base."
        )

    # Right-triangle congruence.
    if any(w in low for w in (
        "right triangle", "right triangles", "hypotenuse"
    )):
        if re.search(r"\b(hl|hypotenuse.leg)\b", low):
            return (
                "Hypotenuse-Leg (HL) Congruence Theorem: if two right "
                "triangles have congruent hypotenuses and one pair of "
                "congruent corresponding legs, the triangles are "
                "congruent. Confirm that both triangles are right "
                "triangles before applying HL."
            )
        if "congruen" in low or "prove" in low or "proof" in low:
            return (
                "To prove two right triangles congruent, first establish "
                "that both contain a right angle. Then check a valid "
                "criterion such as HL, SAS, ASA, AAS, or SSS. HL specifically "
                "requires congruent hypotenuses and one corresponding leg."
            )

    # CPCTC: only after triangle congruence is established.
    if any(w in low for w in (
        "cpctc", "corresponding parts", "corresponding angles",
        "corresponding sides"
    )):
        if "congruent" in low or "cpctc" in low or "prove" in low:
            return (
                "CPCTC means Corresponding Parts of Congruent Triangles "
                "are Congruent.\n"
                "1. Prove the two triangles congruent using SSS, SAS, "
                "ASA, AAS, or HL when applicable.\n"
                "2. Write the triangle names in matching vertex order.\n"
                "3. Identify the corresponding vertices, sides, or angles.\n"
                "4. Apply CPCTC to establish the requested congruence.\n"
                "CPCTC cannot be used before triangle congruence has "
                "been established."
            )

    # Angle and segment bisectors.
    if "bisector" in low or "bisects" in low or "bisect" in low:
        vals = [
            float(v) for v in re.findall(
                r"(?<![a-z0-9.])(" + n + r")\s*(?:(?:degrees?|deg)\b|°)",
                low
            )
        ]
        if "angle" in low and vals and any(
            w in low for w in ("find", "each", "half", "measure")
        ):
            angle = vals[0]
            if 0 <= angle <= 360:
                half = angle / 2.0
                return (
                    "An angle bisector divides an angle into two "
                    "congruent angles.\n"
                    f"Each angle = {angle:g}° / 2 = {half:g}°."
                )

        return (
            "An angle bisector divides an angle into two congruent "
            "angles. A segment bisector passes through a segment's "
            "midpoint, dividing it into two equal lengths. A perpendicular "
            "bisector intersects a segment at its midpoint at 90°."
        )

    # Median and centroid.
    if "median" in low and "triangle" in low:
        if "centroid" in low or "two to one" in low or "2:1" in low:
            return (
                "The three medians of a triangle meet at the centroid. "
                "The centroid divides each median in a 2:1 ratio, measured "
                "from the vertex toward the midpoint of the opposite side. "
                "Thus vertex-to-centroid length is twice centroid-to-midpoint "
                "length."
            )
        return (
            "A triangle median joins a vertex to the midpoint of the "
            "opposite side. The three medians intersect at the centroid. "
            "A median is not necessarily perpendicular to the opposite side."
        )

    # Altitudes and orthogonality.
    if "altitude" in low or "altitudes" in low:
        return (
            "A triangle altitude is a perpendicular segment from a vertex "
            "to the line containing the opposite side. The three altitudes "
            "are concurrent at the orthocenter. In an obtuse triangle, "
            "some altitude segments meet extensions of the sides."
        )

    # Overlapping triangles: shared sides must be identified explicitly.
    if "overlapping triangle" in low or "overlapping triangles" in low:
        return (
            "For overlapping-triangle proofs:\n"
            "1. Name both triangles in corresponding vertex order.\n"
            "2. Identify shared sides and shared angles from the stated "
            "geometry; a shared side is congruent to itself by the "
            "Reflexive Property.\n"
            "3. List all additional given equalities.\n"
            "4. Establish SSS, SAS, ASA, AAS, or HL.\n"
            "5. Use CPCTC only after proving the triangles congruent.\n"
            "Overlap in a drawing alone does not establish congruence."
        )

    # Construction explanations.
    if "construct" in low and any(w in low for w in (
        "angle bisector", "perpendicular bisector", "median", "altitude"
    )):
        if "angle bisector" in low:
            return (
                "Compass-and-straightedge angle-bisector construction:\n"
                "1. Center the compass at the angle vertex and draw an arc "
                "intersecting both rays.\n"
                "2. From the two intersection points, draw equal-radius "
                "arcs that intersect inside the angle.\n"
                "3. Draw a ray from the vertex through the arcs' "
                "intersection. It bisects the angle."
            )
        if "perpendicular bisector" in low:
            return (
                "Compass-and-straightedge perpendicular-bisector construction:\n"
                "1. Set the compass radius to more than half the segment.\n"
                "2. Draw intersecting arcs from each endpoint using the "
                "same radius.\n"
                "3. Draw the line through the two arc intersections. "
                "It is perpendicular to the segment and passes through "
                "its midpoint."
            )
        return (
            "A median is constructed by locating the midpoint of a side "
            "and joining it to the opposite vertex. An altitude is "
            "constructed by drawing a perpendicular from a vertex to "
            "the line containing the opposite side."
        )

    # Generic proof guidance.
    if re.search(r"\b(prove|proof|justify)\b", low) and "triangle" in low:
        return (
            "Triangle proof framework:\n"
            "1. Identify the two triangles and their vertex correspondence.\n"
            "2. Record the givens and any shared sides or angles.\n"
            "3. Prove triangle congruence using a valid criterion.\n"
            "4. Apply CPCTC to establish the requested corresponding parts.\n"
            "A specific proof requires the exact givens and conclusion."
        )

    return None



def polygons_fast_path(text):
    """Polygon identification, angle sums, regular polygons, and diagonals."""
    # Defer pure definitions when the prompt asks for a numeric/code answer.
    if _wants_calculation(text):
        return None

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    n = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    # Determine polygon side count from common names.
    names = {
        "triangle": 3, "quadrilateral": 4, "quadrangle": 4,
        "pentagon": 5, "hexagon": 6, "heptagon": 7,
        "septagon": 7, "octagon": 8, "nonagon": 9,
        "enneagon": 9, "decagon": 10, "hendecagon": 11,
        "undecagon": 11, "dodecagon": 12,
    }

    sides = None
    m = re.search(r"\b(\d+)\s*[- ]?sided\b", low)
    if m:
        sides = int(m.group(1))
    else:
        for name, count in names.items():
            if re.search(r"\b" + name + r"s?\b", low):
                sides = count
                break

    asks_angle_sum = any(w in low for w in (
        "sum of interior angles", "interior angle sum",
        "sum of the interior angles", "interior angles sum"
    ))
    asks_each_interior = any(w in low for w in (
        "each interior angle", "measure of each interior angle",
        "interior angle of a regular", "regular polygon interior angle"
    ))
    asks_exterior = any(w in low for w in (
        "each exterior angle", "exterior angle of a regular",
        "regular polygon exterior angle", "exterior angles of a regular"
    ))
    asks_diagonals = "diagonal" in low or "diagonals" in low

    if sides is not None and (
        asks_angle_sum or asks_each_interior or asks_exterior or asks_diagonals
    ):
        if sides < 3 or sides > 100000:
            return None

        interior_sum = (sides - 2) * 180.0
        if asks_angle_sum:
            return (
                f"For an {sides}-sided polygon, the interior-angle sum is "
                "S = (n - 2) × 180°.\n"
                f"S = ({sides} - 2) × 180° = {interior_sum:g}°."
            )

        if asks_each_interior:
            if "regular" not in low:
                return (
                    "The interior-angle sum is "
                    f"(n - 2) × 180° = {interior_sum:g}°. "
                    "Equal individual interior angles require a regular "
                    "polygon or additional information."
                )
            each = interior_sum / sides
            return (
                "For a regular n-sided polygon, each interior angle is "
                "((n - 2) × 180°) / n.\n"
                f"Each interior angle = {interior_sum:g}° / {sides} "
                f"= {each:.10g}°."
            )

        if asks_exterior:
            if "regular" not in low:
                return (
                    "The exterior angles of a simple convex polygon, taking "
                    "one consistently oriented exterior angle at each "
                    "vertex, sum to 360°. Individual exterior angles are "
                    "equal only for a regular polygon."
                )
            each = 360.0 / sides
            return (
                "For a regular polygon, each exterior angle is 360° / n.\n"
                f"Each exterior angle = 360° / {sides} = {each:.10g}°."
            )

        if asks_diagonals:
            diagonals = sides * (sides - 3) // 2
            return (
                "The number of diagonals of a convex n-sided polygon is "
                "D = n(n - 3) / 2.\n"
                f"D = {sides}({sides} - 3) / 2 = {diagonals}."
            )

    # Interior angle sums supplied as a single measure.
    if asks_angle_sum:
        m = re.search(
            r"\b(?:sum|total)\b.{0,35}?\b(" + n +
            r")\s*(?:(?:degrees?|deg)\b|°)", low
        )
        if m:
            total = float(m.group(1))
            q = total / 180.0 + 2.0
            nearest = round(q)
            if math.isclose(q, nearest, abs_tol=1e-8) and nearest >= 3:
                return (
                    f"S = (n - 2) × 180°.\n"
                    f"n = S/180° + 2 = {total:g}/180 + 2 = {nearest}.\n"
                    f"The polygon has {nearest} sides."
                )

    # Classify convex vs concave when supplied an explicit definition request.
    if "convex" in low or "concave" in low:
        if "difference" in low or "versus" in low or "compare" in low:
            return (
                "A convex polygon has every interior angle less than 180° "
                "and every segment joining two points of the polygon remains "
                "inside it. A concave polygon has at least one interior "
                "angle greater than 180°; some segments joining points "
                "in the polygon pass outside it."
            )
        if "concave" in low and "convex" not in low:
            return (
                "A concave polygon has at least one interior angle greater "
                "than 180°. At least one diagonal lies partly outside the "
                "polygon."
            )
        if "convex" in low:
            return (
                "A convex polygon has all interior angles less than 180°. "
                "Every diagonal lies inside or on the polygon, and every "
                "segment connecting two points in the polygon stays inside."
            )

    # Regular polygons.
    if "regular polygon" in low or "regular polygons" in low:
        return (
            "A regular polygon is both equilateral (all sides congruent) "
            "and equiangular (all interior angles congruent). For n sides, "
            "the interior-angle sum is (n - 2) × 180°, each interior angle "
            "is ((n - 2) × 180°)/n, and each exterior angle is 360°/n."
        )

    # Polygon definition and naming.
    if "polygon" in low:
        return (
            "A polygon is a closed plane figure formed by a finite sequence "
            "of straight segments joined endpoint-to-endpoint, with exactly "
            "two sides meeting at each vertex. A simple polygon's sides "
            "do not cross except at shared endpoints. Polygons are named "
            "by their number of sides; a regular polygon is both equilateral "
            "and equiangular."
        )

    # Construction principles.
    if "construct" in low and any(w in low for w in (
        "polygon", "pentagon", "hexagon", "regular"
    )):
        return (
            "A regular polygon construction must establish equal side "
            "lengths and equal angles. For a regular n-gon inscribed in "
            "a circle, the central angle between adjacent vertices is "
            "360°/n. A straightedge-and-compass construction is possible "
            "for some side counts, but not every regular polygon is "
            "constructible using only those tools."
        )

    return None



def quadrilaterals_fast_path(text):
    """Quadrilateral properties, classification, proofs, and calculations."""
    # Defer pure definitions when the prompt asks for a numeric/code answer.
    if _wants_calculation(text):
        return None

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    n = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def values_with_units():
        return [
            float(x) for x in re.findall(
                r"(?<![a-z0-9.])(" + n +
                r")\s*(?:degrees?|degs?|°)\b", low
            )
        ]

    # Parallelogram properties and tests.
    if "parallelogram" in low:
        if any(w in low for w in ("prove", "proof", "show that", "test")):
            return (
                "Parallelogram proof criteria: a quadrilateral is a "
                "parallelogram if any one of the following is established:\n"
                "1. Both pairs of opposite sides are parallel.\n"
                "2. Both pairs of opposite sides are congruent.\n"
                "3. One pair of opposite sides is both parallel and congruent.\n"
                "4. The diagonals bisect each other.\n"
                "5. Both pairs of opposite angles are congruent.\n"
                "Use the criterion whose hypotheses are actually given."
            )
        return (
            "Parallelogram properties:\n"
            "- Opposite sides are parallel and congruent.\n"
            "- Opposite angles are congruent.\n"
            "- Consecutive angles are supplementary.\n"
            "- Diagonals bisect each other.\n"
            "- Each diagonal divides the parallelogram into two congruent "
            "triangles.\n"
            "The diagonals are not necessarily congruent or perpendicular."
        )

    # Rectangle.
    if "rectangle" in low and not (
        "square" in low and "rhombus" in low
    ):
        return (
            "A rectangle is a parallelogram with four right angles. "
            "Its opposite sides are parallel and congruent, and its "
            "diagonals are congruent and bisect each other. The diagonals "
            "are not necessarily perpendicular. A rectangle is a square "
            "only when all four sides are congruent."
        )

    # Rhombus. Let explicit square classification reach the square handler.
    if ("rhombus" in low or "rhombi" in low) and not (
        "square" in low and any(w in low for w in (
            "classify", "classification", "explain", "why", "properties"
        ))
    ):
        return (
            "A rhombus is a parallelogram with four congruent sides. "
            "Its diagonals bisect each other, are perpendicular, and "
            "bisect the opposite angles. Its diagonals are not necessarily "
            "congruent. A rhombus is a square if it also has four right angles."
        )

    # Square.
    if "square" in low and any(w in low for w in (
        "quadrilateral", "geometry", "diagonal", "property",
        "prove", "classify", "side", "angle", "explain",
        "rectangle", "rhombus"
    )):
        return (
            "A square is both a rectangle and a rhombus. It has four "
            "congruent sides, four right angles, parallel opposite sides, "
            "and congruent diagonals. Its diagonals bisect each other "
            "perpendicularly and bisect the vertex angles."
        )

    # Isosceles trapezoid.
    if "isosceles trapezoid" in low or "isosceles trapezium" in low:
        return (
            "An isosceles trapezoid has a pair of parallel bases and "
            "congruent legs. Its base angles are congruent, its diagonals "
            "are congruent, and consecutive angles along either leg are "
            "supplementary. The converse also holds under the usual "
            "convex-trapezoid definition."
        )

    # Trapezoids.
    if "trapezoid" in low or "trapezoids" in low:
        if "median" in low or "midsegment" in low or "mid-segment" in low:
            return (
                "Trapezoid midsegment theorem: the segment joining the "
                "midpoints of the two legs is parallel to both bases. "
                "Its length equals the average of the base lengths:\n"
                "m = (b1 + b2)/2."
            )
        return (
            "A trapezoid is a quadrilateral with at least one pair of "
            "parallel opposite sides under the inclusive definition; some "
            "textbooks use an exclusive definition requiring exactly one "
            "pair. The parallel sides are the bases. Consecutive interior "
            "angles along a leg are supplementary."
        )

    # Angle sum of a quadrilateral.
    if "quadrilateral" in low and any(w in low for w in (
        "angle sum", "sum of angles", "interior angles",
        "missing angle", "fourth angle"
    )):
        vals = values_with_units()
        if len(vals) >= 3:
            a, b, c = vals[:3]
            d = 360.0 - a - b - c
            if all(0 < v < 360 for v in (a, b, c)) and 0 < d < 360:
                return (
                    "The interior angles of a simple quadrilateral sum "
                    "to 360°.\n"
                    f"Fourth angle = 360° - {a:g}° - {b:g}° - "
                    f"{c:g}° = {d:g}°."
                )
        return (
            "The interior angles of a simple quadrilateral sum to 360°. "
            "For a missing angle, subtract the known interior-angle "
            "measures from 360°."
        )

    # General quadrilateral facts.
    if "quadrilateral" in low or "quadrilaterals" in low:
        if any(w in low for w in ("congruen", "prove", "proof")):
            return (
                "To prove two quadrilaterals congruent, establish a "
                "one-to-one correspondence between all four vertices "
                "and prove the corresponding sides and angles match. "
                "A quadrilateral cannot generally be proved congruent "
                "from only three side lengths; additional angle, diagonal, "
                "or structural information may be necessary."
            )
        return (
            "A quadrilateral is a four-sided polygon. Its interior angles "
            "sum to 360°. Important classes include parallelograms, "
            "rectangles, rhombi, squares, and trapezoids. To classify one, "
            "check side parallelism, side congruence, angle measures, and "
            "diagonal properties."
        )

    # Symmetry.
    if "symmetric polygon" in low or "symmetry" in low:
        return (
            "A line of reflection symmetry divides a figure into two "
            "mirror-image halves. Rotational symmetry means a rotation "
            "through an angle smaller than 360° maps the figure onto itself. "
            "A regular n-gon has n reflection symmetries and rotational "
            "symmetry at multiples of 360°/n."
        )

    # Reflections.
    if "reflection" in low and "quadrilateral" in low:
        return (
            "A reflection is a rigid transformation that preserves "
            "distances and angle measures. Reflecting a quadrilateral "
            "preserves its side lengths, angles, parallelism, and "
            "congruence; orientation is reversed."
        )

    return None



def similar_triangles_fast_path(text):
    """Similarity, ratios, proportions, scale factors, and proportionality."""

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    n = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    # Identify similarity criteria.
    if "scale factor" not in low and any(w in low for w in (
        "similar triangle", "similar triangles", "triangle similarity",
        "prove triangles similar", "prove the triangles similar",
        "similarity criterion", "similarity criteria",
        "aa similarity"
    )):
        if re.search(r"\b(aaa|aa|angle.angle)\b", low):
            return (
                "AA Similarity Criterion: if two angles of one triangle "
                "are congruent to two corresponding angles of another "
                "triangle, the triangles are similar. The third angles "
                "must also be congruent because each triangle's angle "
                "sum is 180°."
            )
        if re.search(r"\b(sas|side.angle.side)\b", low):
            return (
                "SAS Similarity Criterion: two pairs of corresponding "
                "sides must be proportional, and the included angles "
                "between those side pairs must be congruent."
            )
        if re.search(r"\b(sss|side.side.side)\b", low):
            return (
                "SSS Similarity Criterion: all three pairs of corresponding "
                "side lengths must be proportional, with one common "
                "positive scale factor."
            )
        if re.search(r"\b(asa|aas)\b", low):
            return (
                "If two corresponding angles are congruent, AA similarity "
                "already establishes triangle similarity. The third angle "
                "follows from the triangle angle sum."
            )
        return (
            "Triangle similarity criteria:\n"
            "- AA: two pairs of corresponding angles are congruent.\n"
            "- SAS: two pairs of corresponding sides are proportional "
            "and the included angles are congruent.\n"
            "- SSS: all three pairs of corresponding sides are proportional.\n"
            "State the vertex correspondence before comparing side ratios."
        )

    # Shadows and indirect measurement.
    if "shadow" in low or "shadows" in low:
        vals = [
            float(v) for v in re.findall(
                r"(?<![a-z0-9.])(" + n + r")\s*(?:m|meters?|metres?|ft|feet)\b",
                low
            )
        ]
        if len(vals) >= 3 and any(w in low for w in (
            "height", "find", "calculate", "determine"
        )):
            object_height, object_shadow, known_shadow = vals[:3]
            if object_shadow > 0:
                height = object_height * known_shadow / object_shadow
                return (
                    "Shadow method: under the same sun angle, the height "
                    "and shadow form similar right triangles.\n"
                    "height1/shadow1 = height2/shadow2\n"
                    f"Unknown height = {object_height:g} × "
                    f"{known_shadow:g} / {object_shadow:g} "
                    f"= {height:.10g}."
                )
        return (
            "Similar-triangle shadow method: objects illuminated by the "
            "same parallel sunlight rays form similar triangles, assuming "
            "level ground and corresponding shadow measurements. Use "
            "height1/shadow1 = height2/shadow2."
        )

    # Proportion and ratio equations: solve a/b = c/d.
    if any(w in low for w in ("proportion", "proportional", "ratio")):
        m = re.search(
            r"(" + n + r")\s*/\s*(" + n + r")\s*=\s*"
            r"(" + n + r")\s*/\s*(" + n + r")",
            low
        )
        if m:
            a, b, c, d = map(float, m.groups())
            if b == 0 or d == 0:
                return "A proportion cannot have a zero denominator."
            if a / b == c / d:
                return (
                    f"Proportion verified: {a:g}/{b:g} = "
                    f"{c:g}/{d:g} = {a/b:.10g}."
                )
            return (
                f"The two ratios are {a/b:.10g} and {c/d:.10g}; "
                "they are not equal, so the stated proportion is false."
            )

        m = re.search(
            r"\b(" + n + r")\s*:\s*(" + n + r")\s*=\s*"
            r"(" + n + r")\s*:\s*(" + n + r")",
            low
        )
        if m:
            a, b, c, d = map(float, m.groups())
            if b == 0 or d == 0:
                return "A ratio cannot have a zero denominator."
            if math.isclose(a / b, c / d, rel_tol=1e-9, abs_tol=1e-9):
                return "The ratios are equal; the proportion is valid."
            return "The ratios differ; the stated proportion is not valid."

    # Scale factor / missing corresponding side.
    if "scale factor" in low or (
        "similar" in low and any(w in low for w in (
            "missing side", "unknown side", "find the side",
            "corresponding side"
        ))
    ):
        vals = [
            float(v) for v in re.findall(
                r"(?<![a-z0-9.])(" + n + r")(?![a-z0-9.])", low
            )
        ]
        if len(vals) >= 2 and vals[0] != 0:
            factor = vals[1] / vals[0]
            return (
                "For similar figures, corresponding lengths have a "
                "constant ratio.\n"
                f"Scale factor = {vals[1]:g}/{vals[0]:g} "
                f"= {factor:.10g}.\n"
                "Apply the same factor to every corresponding length, "
                "using a consistent direction for the ratio."
            )
        return (
            "For similar triangles, corresponding side lengths are "
            "proportional. Establish the vertex correspondence, write "
            "a proportion using matching sides, and solve for the "
            "unknown length."
        )

    # Basic proportionality theorem.
    if any(w in low for w in (
        "proportionality theorem", "side splitter theorem",
        "parallel line divides", "parallel to one side",
        "proportional segments"
    )):
        return (
            "Triangle Proportionality Theorem: a line parallel to one "
            "side of a triangle that intersects the other two sides "
            "divides those sides proportionally. For triangle ABC, if "
            "D lies on AB, E lies on AC, and DE is parallel to BC, then "
            "AD/DB = AE/EC and AD/AB = AE/AC."
        )

    # Similar polygons.
    if "similar polygon" in low or "similar polygons" in low:
        return (
            "Similar polygons have congruent corresponding angles and "
            "proportional corresponding side lengths. Their perimeters "
            "scale by k, while their areas scale by k², where k is the "
            "ratio of corresponding side lengths."
        )

    # Products of lengths.
    if "product" in low and any(w in low for w in (
        "length", "segments", "secant", "chord"
    )):
        return (
            "A product-of-lengths theorem must be selected from the "
            "specific geometry. For intersecting chords inside a circle, "
            "PA × PB = PC × PD. For two secants from an external point, "
            "external segment × whole secant is equal for both secants. "
            "The point locations determine which formula applies."
        )

    # Similarity in space.
    if "similarity in space" in low or "similar solids" in low:
        return (
            "Similar solids have the same shape with proportional "
            "corresponding linear dimensions. If the linear scale factor "
            "is k, surface areas scale by k² and volumes by k³."
        )

    # Generic similarity explanation.
    if "similar" in low and "triangle" in low:
        return (
            "Similar triangles have congruent corresponding angles and "
            "proportional corresponding sides. Name the vertices in "
            "matching order, then form equal ratios of corresponding "
            "side lengths. AA, SAS similarity, or SSS similarity can "
            "establish similarity."
        )

    return None



def right_triangles_fast_path(text):
    """Right-triangle calculations and theorem reference."""

    _calc = _wants_calculation(text)
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    number = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def nums():
        return [
            float(x) for x in re.findall(
                r"(?<![a-z0-9.])(" + number + r")(?![a-z0-9.])",
                low
            )
        ]

    def fmt(x):
        return f"{x:.10g}"

    # Special right triangles.
    if "45-45-90" in low or "45–45–90" in low or "45/45/90" in low:
        return (
            "45°-45°-90° special right triangle:\n"
            "- The legs are congruent.\n"
            "- If each leg is x, the hypotenuse is x√2.\n"
            "- If the hypotenuse is h, each leg is h/√2 = h√2/2.\n"
            "Side ratio: 1 : 1 : √2."
        )

    if "30-60-90" in low or "30–60–90" in low or "30/60/90" in low:
        return (
            "30°-60°-90° special right triangle:\n"
            "- The side opposite 30° is the short leg x.\n"
            "- The side opposite 60° is x√3.\n"
            "- The hypotenuse is 2x.\n"
            "Side ratio: 1 : √3 : 2."
        )

    # Altitude and HL prompts must precede the broad Pythagorean branch.
    if any(w in low for w in (
        "altitude to the hypotenuse", "altitude-on-hypotenuse",
        "geometric mean theorem", "geometric mean"
    )):
        return (
            "Right-triangle altitude and geometric-mean relationships. "
            "If altitude h is drawn from the right angle to the "
            "hypotenuse, splitting it into segments p and q, then "
            "h² = pq and h = √(pq). If the full hypotenuse is "
            "c = p + q, the leg relationships are a² = cp and "
            "b² = cq, according to the corresponding segment. "
            "These relations follow from similar right triangles."
        )

    if "hypotenuse-leg" in low or re.search(r"\\bhl\\b", low):
        return (
            "HL Congruence Theorem: two right triangles are congruent "
            "if their hypotenuses are congruent and one pair of "
            "corresponding legs is congruent. Both triangles must "
            "already be known to be right triangles."
        )

    # Pythagorean theorem.
    if (
        "pythagorean" in low
        or "hypotenuse" in low
        or (
            "right triangle" in low and any(w in low for w in (
                "missing side", "unknown side", "find the leg",
                "find the side", "calculate the side"
            ))
        )
        or any(w in low for w in (
            "converse", "determine whether", "is it a right",
            "right-angled", "right angled"
        ))
    ):
        if any(w in low for w in (
            "converse", "determine whether", "is it a right",
            "right-angled", "right angled"
        )):
            v = nums()
            if len(v) >= 3 and all(x > 0 for x in v[:3]):
                a, b, c = sorted(v[:3])
                if math.isclose(a*a + b*b, c*c, rel_tol=1e-9, abs_tol=1e-9):
                    return (
                        f"Converse of the Pythagorean theorem: "
                        f"{fmt(a)}² + {fmt(b)}² = {fmt(c)}², so the "
                        "triangle is right."
                    )
                return (
                    f"Check: {fmt(a)}² + {fmt(b)}² = {fmt(a*a+b*b)}, "
                    f"while {fmt(c)}² = {fmt(c*c)}. The side lengths "
                    "do not satisfy the Pythagorean theorem, so the "
                    "triangle is not right."
                )
            return (
                "Converse of the Pythagorean theorem: for side lengths "
                "a ≤ b ≤ c, the triangle is right exactly when "
                "a² + b² = c², with c the longest side."
            )

        v = nums()
        if len(v) >= 2 and all(x > 0 for x in v[:2]):
            a, b = v[:2]
            if (
                ("hypotenuse" in low or "longest side" in low)
                and not any(w in low for w in (
                    "missing leg", "unknown leg", "find the leg",
                    "other leg"
                ))
            ):
                h = math.hypot(a, b)
                return (
                    "Pythagorean theorem: c² = a² + b².\n"
                    f"c = √({fmt(a)}² + {fmt(b)}²) = {fmt(h)}."
                )
            if any(w in low for w in (
                "missing leg", "unknown leg", "find the leg",
                "other leg"
            )):
                # Prefer an explicit hypotenuse/leg description.
                hyp = re.search(
                    r"hypotenuse(?:\s+is|\s+of|\s*[:=])?\s*"
                    r"(" + number + r")", low
                )
                leg = re.search(
                    r"(?:leg|side)(?:\s+is|\s+of|\s*[:=])?\s*"
                    r"(" + number + r")", low
                )
                if hyp and leg:
                    c, a = float(hyp.group(1)), float(leg.group(1))
                else:
                    c, a = max(a, b), min(a, b)
                if c <= a:
                    return "Invalid right-triangle data: the hypotenuse must be longer than either leg."
                other = math.sqrt(c*c - a*a)
                return (
                    "Pythagorean theorem: a² + b² = c².\n"
                    f"Missing leg = √({fmt(c)}² - {fmt(a)}²) "
                    f"= {fmt(other)}."
                )

        return (
            "Pythagorean theorem: for legs a and b and hypotenuse c, "
            "a² + b² = c². Find the hypotenuse with "
            "c = √(a² + b²), or find a missing leg with "
            "a = √(c² - b²). The hypotenuse is opposite the right angle."
        )

    # Altitude to hypotenuse / geometric mean theorems.
    if any(w in low for w in (
        "altitude to the hypotenuse", "altitude-on-hypotenuse",
        "geometric mean theorem", "geometric mean"
    )):
        return (
            "Right-triangle altitude and geometric-mean relationships. "
            "If altitude h is drawn from the right angle to the hypotenuse, "
            "splitting it into segments p and q:\n"
            "- h² = pq, so h = √(pq).\n"
            "- If the full hypotenuse is c = p + q, each leg satisfies "
            "a² = cp or b² = cq, according to its adjacent hypotenuse "
            "segment.\n"
            "These relations follow from the similarity of the three "
            "right triangles."
        )

    # Hypotenuse-leg congruence.
    if "hypotenuse-leg" in low or re.search(r"\bhl\b", low):
        return (
            "HL Congruence Theorem: two right triangles are congruent "
            "if their hypotenuses are congruent and one pair of "
            "corresponding legs is congruent. Both triangles must "
            "already be known to be right triangles."
        )

    # Leg-leg / leg-angle congruence.
    if "right triangle" in low and any(w in low for w in (
        "congruent", "congruence", "prove triangles"
    )):
        return (
            "For right-triangle congruence, valid criteria include "
            "HL (hypotenuse and one leg), LL (both legs), and a suitable "
            "leg-angle criterion when the angle correspondence is known. "
            "Identify the right angles and corresponding parts before "
            "choosing a criterion."
        )

    return None



def trigonometry_fast_path(text):
    """Right-triangle trigonometry, inverse functions, and applications."""
    import math
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())
    number = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def fmt(x):
        return f"{x:.10g}"

    def get_named(label):
        m = re.search(
            r"\b" + label + r"\b\s*(?:is|of|=|:)?\s*(" + number + r")",
            low
        )
        return float(m.group(1)) if m else None

    # Angle of elevation / depression.
    if "angle of elevation" in low or "angle of depression" in low:
        vals = [
            float(x) for x in re.findall(
                r"(?<![a-z0-9.])(" + number +
                r")\s*(?:degrees?|degs?|°)(?![a-z])",
                low
            )
        ]
        if vals:
            theta = vals[0]
            if not 0 < theta < 90:
                return "For a standard right-triangle elevation/depression problem, the acute angle must be between 0° and 90°."
            # Parse explicitly named height and horizontal distance.
            height = get_named("height")
            distance = get_named("distance")
            horizontal = get_named("horizontal")
            if distance is None:
                distance = horizontal

            if height is not None and height > 0:
                d = height / math.tan(math.radians(theta))
                return (
                    f"Angle of elevation/depression = {fmt(theta)}°.\n"
                    f"Using tan(θ) = opposite/adjacent, horizontal "
                    f"distance = height/tan(θ) = {fmt(height)}/"
                    f"tan({fmt(theta)}°) = {fmt(d)}."
                )
            if distance is not None and distance > 0:
                h = distance * math.tan(math.radians(theta))
                return (
                    f"Using tan(θ) = opposite/adjacent, height = "
                    f"distance × tan(θ) = {fmt(distance)} × "
                    f"tan({fmt(theta)}°) = {fmt(h)}."
                )
        return (
            "For elevation/depression problems, draw a right triangle. "
            "Relative to the acute angle, use sin θ = opposite/hypotenuse, "
            "cos θ = adjacent/hypotenuse, or tan θ = opposite/adjacent. "
            "The angle of depression equals the corresponding angle of "
            "elevation when the horizontal lines are parallel."
        )

    # Named side values and a given angle: calculate missing side.
    if any(w in low for w in (
        "find the opposite", "find opposite", "find the adjacent",
        "find adjacent", "find the hypotenuse", "calculate the hypotenuse",
        "missing side", "unknown side"
    )) and any(w in low for w in ("sine", "cosine", "tangent", "sin", "cos", "tan", "angle")):
        angle_match = re.search(
            r"(" + number + r")\s*(?:degrees?|degs?|°)(?![a-z])",
            low
        )
        if angle_match:
            theta = float(angle_match.group(1))
            if not 0 < theta < 90:
                return "The angle must be acute for a standard right-triangle side calculation."
            rad = math.radians(theta)
            hyp = get_named("hypotenuse")
            opp = get_named("opposite")
            adj = get_named("adjacent")

            if "opposite" in low and "find" in low and hyp is not None:
                ans = hyp * math.sin(rad)
                return f"sin(θ) = opposite/hypotenuse, so opposite = {fmt(hyp)} × sin({fmt(theta)}°) = {fmt(ans)}."
            if "adjacent" in low and "find" in low and hyp is not None:
                ans = hyp * math.cos(rad)
                return f"cos(θ) = adjacent/hypotenuse, so adjacent = {fmt(hyp)} × cos({fmt(theta)}°) = {fmt(ans)}."
            if "hypotenuse" in low and "find" in low and opp is not None:
                ans = opp / math.sin(rad)
                return f"sin(θ) = opposite/hypotenuse, so hypotenuse = {fmt(opp)}/sin({fmt(theta)}°) = {fmt(ans)}."
            if "hypotenuse" in low and "find" in low and adj is not None:
                ans = adj / math.cos(rad)
                return f"cos(θ) = adjacent/hypotenuse, so hypotenuse = {fmt(adj)}/cos({fmt(theta)}°) = {fmt(ans)}."
            if "opposite" in low and "find" in low and adj is not None:
                ans = adj * math.tan(rad)
                return f"tan(θ) = opposite/adjacent, so opposite = {fmt(adj)} × tan({fmt(theta)}°) = {fmt(ans)}."
            if "adjacent" in low and "find" in low and opp is not None:
                ans = opp / math.tan(rad)
                return f"tan(θ) = opposite/adjacent, so adjacent = {fmt(opp)}/tan({fmt(theta)}°) = {fmt(ans)}."

    # Inverse trig for an angle from side lengths.
    if any(w in low for w in (
        "find the angle", "find angle", "calculate the angle",
        "measure of the angle"
    )):
        opp = get_named("opposite")
        adj = get_named("adjacent")
        hyp = get_named("hypotenuse")
        theta = None
        formula = ""
        if opp is not None and adj is not None and adj != 0:
            theta = math.degrees(math.atan2(opp, adj))
            formula = f"θ = arctan({fmt(opp)}/{fmt(adj)})"
        elif opp is not None and hyp is not None and hyp != 0:
            ratio = opp / hyp
            if -1 <= ratio <= 1:
                theta = math.degrees(math.asin(ratio))
                formula = f"θ = arcsin({fmt(opp)}/{fmt(hyp)})"
        elif adj is not None and hyp is not None and hyp != 0:
            ratio = adj / hyp
            if -1 <= ratio <= 1:
                theta = math.degrees(math.acos(ratio))
                formula = f"θ = arccos({fmt(adj)}/{fmt(hyp)})"
        if theta is not None:
            return f"{formula} = {fmt(theta)}°."

    # Evaluate direct trig values such as sin 30 degrees.
    direct = re.search(
        r"\b(sin|sine|cos|cosine|tan|tangent)\s*"
        r"(?:of\s*)?(" + number + r")\s*"
        r"(?:degrees?|degs?|°)(?![a-z])",
        low
    )
    if direct:
        fn = direct.group(1)
        theta = float(direct.group(2))
        rad = math.radians(theta)
        if fn in ("sin", "sine"):
            value = math.sin(rad)
            name = "sin"
        elif fn in ("cos", "cosine"):
            value = math.cos(rad)
            name = "cos"
        else:
            if math.isclose(math.cos(rad), 0.0, abs_tol=1e-12):
                return "tan(θ) is undefined at this angle because cos(θ) = 0."
            value = math.tan(rad)
            name = "tan"
        return f"{name}({fmt(theta)}°) = {fmt(value)}."

    # SOH-CAH-TOA and core definitions.
    if any(w in low for w in (
        "soh cah toa", "soh-cah-toa", "trigonometric ratios",
        "sine cosine tangent", "right triangle trigonometry",
        "right-triangle trigonometry"
    )):
        return (
            "SOH-CAH-TOA for an acute angle θ in a right triangle:\n"
            "- sin θ = opposite / hypotenuse (SOH)\n"
            "- cos θ = adjacent / hypotenuse (CAH)\n"
            "- tan θ = opposite / adjacent (TOA)\n"
            "Choose the ratio containing the known side and the unknown "
            "side. For an angle, use inverse functions: arcsin, arccos, "
            "or arctan. Check that the angle is measured from the correct "
            "vertex and that opposite/adjacent are identified relative "
            "to that angle."
        )

    # Exact special-angle values.
    if any(w in low for w in (
        "special angle values", "exact trig values", "special angles"
    )):
        return (
            "Exact special-angle values:\n"
            "Angle | sin | cos | tan\n"
            "30° | 1/2 | √3/2 | √3/3\n"
            "45° | √2/2 | √2/2 | 1\n"
            "60° | √3/2 | 1/2 | √3\n"
            "tan 90° is undefined."
        )

    if "trigonometry" in low or "trigonometric" in low:
        return (
            "Right-triangle trigonometry relates an acute angle θ to "
            "side lengths: sin θ = opposite/hypotenuse, "
            "cos θ = adjacent/hypotenuse, and tan θ = opposite/adjacent. "
            "Use inverse trigonometric functions to recover an angle. "
            "For non-right triangles, use the Law of Sines or Law of Cosines "
            "when their conditions are satisfied."
        )

    return None



def area_geometry_fast_path(text):
    """Deterministic area, perimeter, circumference, and sector calculations."""
    # Defer pure definitions when the prompt asks for a numeric/code answer.
    if _wants_calculation(text):
        return None

    _calc = _wants_calculation(text)
    import math
    import re

    low = " ".join(str(text or "").strip().lower().split())
    num = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def fmt(x):
        return f"{x:.10g}"

    def named(label):
        m = re.search(
            r"\b" + label + r"\b\s*(?:is|of|=|:)?\s*(" + num + r")",
            low
        )
        return float(m.group(1)) if m else None

    def all_nums():
        return [
            float(x) for x in re.findall(
                r"(?<![a-z0-9.])(" + num + r")(?![a-z0-9.])",
                low
            )
        ]

    # Circle area.
    if "circle" in low and any(w in low for w in (
        "area", "radius", "diameter"
    )):
        r = named("radius")
        d = named("diameter")
        if r is None and d is not None:
            r = d / 2
        if r is None:
            vals = all_nums()
            if vals:
                r = vals[0]
        if r is not None and r > 0:
            a = math.pi * r * r
            return (
                f"Circle area: A = πr². With radius r = {fmt(r)}, "
                f"A = {fmt(a)} square units."
            )
        return "Circle area formula: A = πr². If diameter d is given, use r = d/2."

    # Circumference.
    if "circumference" in low:
        r = named("radius")
        d = named("diameter")
        if r is None and d is not None:
            r = d / 2
        if r is None:
            vals = all_nums()
            if vals:
                r = vals[0]
        if r is not None and r > 0:
            return (
                f"Circumference: C = 2πr = πd. "
                f"For r = {fmt(r)}, C = {fmt(2 * math.pi * r)}."
            )
        return "Circumference formulas: C = 2πr = πd."

    # Sector area and arc length.
    if "sector" in low or "arc length" in low:
        r = named("radius")
        angle = named("angle")
        if angle is None:
            m = re.search(r"(" + num + r")\s*(?:degrees?|°)(?![a-z])", low)
            if m:
                angle = float(m.group(1))
        if r is None:
            vals = all_nums()
            if len(vals) >= 2:
                r = vals[0]
                if angle is None:
                    angle = vals[1]
        if r is not None and angle is not None and r > 0:
            if not 0 <= angle <= 360:
                return "For a minor or major sector, use a central angle from 0° through 360°."
            arc = 2 * math.pi * r * angle / 360
            sector = math.pi * r * r * angle / 360
            if "arc length" in low:
                return (
                    f"Arc length: s = (θ/360°) × 2πr. "
                    f"For θ = {fmt(angle)}° and r = {fmt(r)}, "
                    f"s = {fmt(arc)} units."
                )
            return (
                f"Sector area: A = (θ/360°)πr². "
                f"For θ = {fmt(angle)}° and r = {fmt(r)}, "
                f"A = {fmt(sector)} square units. "
                f"The corresponding arc length is {fmt(arc)} units."
            )
        return (
            "Sector area: A = (θ/360°)πr². "
            "Arc length: s = (θ/360°)2πr, where θ is the central angle."
        )

    # Triangle area.
    if "triangle" in low and "area" in low:
        b = named("base")
        h = named("height")
        if b is None or h is None:
            vals = all_nums()
            if len(vals) >= 2:
                b = vals[0] if b is None else b
                h = vals[1] if h is None else h
        if b is not None and h is not None and b > 0 and h > 0:
            return (
                f"Triangle area: A = ½bh = ½ × {fmt(b)} × {fmt(h)} "
                f"= {fmt(0.5 * b * h)} square units."
            )
        return "Triangle area: A = ½bh, where b is the base and h is the perpendicular height."

    # Trapezoid area.
    if "trapezoid" in low and "area" in low:
        a = named("base1")
        b = named("base2")
        h = named("height")
        if a is None or b is None or h is None:
            vals = all_nums()
            if len(vals) >= 3:
                a = vals[0] if a is None else a
                b = vals[1] if b is None else b
                h = vals[2] if h is None else h
        if a is not None and b is not None and h is not None:
            return (
                f"Trapezoid area: A = ½(b₁ + b₂)h = "
                f"½({fmt(a)} + {fmt(b)}) × {fmt(h)} "
                f"= {fmt(0.5 * (a + b) * h)} square units."
            )
        return "Trapezoid area: A = ½(b₁ + b₂)h, where b₁ and b₂ are the parallel bases."

    # Parallelogram area.
    if "parallelogram" in low and "area" in low:
        b = named("base")
        h = named("height")
        if b is None or h is None:
            vals = all_nums()
            if len(vals) >= 2:
                b = vals[0] if b is None else b
                h = vals[1] if h is None else h
        if b is not None and h is not None:
            return f"Parallelogram area: A = bh = {fmt(b)} × {fmt(h)} = {fmt(b*h)} square units."
        return "Parallelogram area: A = bh, using the perpendicular height rather than the slanted side."

    # Rectangle and square area.
    if ("rectangle" in low or "square" in low) and "area" in low:
        if "square" in low and "rectangle" not in low:
            s = named("side")
            if s is None:
                vals = all_nums()
                if vals:
                    s = vals[0]
            if s is not None and s > 0:
                return f"Square area: A = s² = {fmt(s)}² = {fmt(s*s)} square units."
            return "Square area: A = s². Its perimeter is P = 4s."
        l = named("length")
        w = named("width")
        if l is None or w is None:
            vals = all_nums()
            if len(vals) >= 2:
                l = vals[0] if l is None else l
                w = vals[1] if w is None else w
        if l is not None and w is not None:
            return f"Rectangle area: A = lw = {fmt(l)} × {fmt(w)} = {fmt(l*w)} square units."
        return "Rectangle area: A = length × width. Perimeter: P = 2(length + width)."

    # Regular polygon area.
    if "regular polygon" in low and "area" in low:
        n = named("sides")
        s = named("side")
        ap = named("apothem")
        if n is not None and s is not None and ap is not None and n >= 3:
            perimeter = n * s
            return (
                f"Regular polygon area: A = ½ap, where p is perimeter "
                f"and a is apothem. p = {fmt(n)} × {fmt(s)} = "
                f"{fmt(perimeter)}; A = ½ × {fmt(ap)} × "
                f"{fmt(perimeter)} = {fmt(0.5*ap*perimeter)} square units."
            )
        return "Regular polygon area: A = ½ap, where a is the apothem and p is the perimeter."

    # Similar polygons: area and perimeter scale factors.
    if "similar" in low and ("area" in low or "perimeter" in low):
        return (
            "For similar polygons with corresponding side-length scale "
            "factor k, perimeters scale by k and areas scale by k². "
            "Thus A₂/A₁ = k² and P₂/P₁ = k. Do not apply the linear "
            "scale factor directly to area."
        )

    # General area formulas.
    if "area" in low:
        return (
            "Common area formulas:\n"
            "- Rectangle: A = lw\n"
            "- Triangle: A = ½bh\n"
            "- Parallelogram: A = bh\n"
            "- Trapezoid: A = ½(b₁ + b₂)h\n"
            "- Regular polygon: A = ½ap\n"
            "- Circle: A = πr²\n"
            "Use perpendicular height for triangle, parallelogram, and "
            "trapezoid formulas."
        )

    return None



def coordinate_geometry_fast_path(text):
    """Coordinate plane, distance, midpoint, slope, lines, and circles."""

    _calc = _wants_calculation(text)
    import math
    import re

    low = " ".join(str(text or "").strip().lower().split())
    num = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"

    def fmt(x):
        return f"{x:.10g}"

    # Parse explicitly labeled points, e.g. A(1, 2), point B = (3, 4).
    points = {}
    for m in re.finditer(
        r"\b(?:point\s+)?([a-z])\s*=\s*\(\s*(" + num +
        r")\s*,\s*(" + num + r")\s*\)|"
        r"\b([a-z])\s*\(\s*(" + num + r")\s*,\s*(" + num + r")\s*\)",
        low
    ):
        if m.group(1):
            label, x, y = m.group(1), m.group(2), m.group(3)
        else:
            label, x, y = m.group(4), m.group(5), m.group(6)
        points[label.upper()] = (float(x), float(y))

    # Circle equation from center and radius.
    if "circle" in low and ("equation" in low or "center" in low):
        center = re.search(
            r"center\s*(?:is|at|=|:)?\s*\(\s*(" + num +
            r")\s*,\s*(" + num + r")\s*\)", low
        )
        radius = re.search(r"radius\s*(?:is|of|=|:)?\s*(" + num + r")", low)
        if center and radius:
            h, k = float(center.group(1)), float(center.group(2))
            r = float(radius.group(1))
            if r > 0:
                return (
                    f"Circle equation: (x - h)² + (y - k)² = r². "
                    f"With center ({fmt(h)}, {fmt(k)}) and radius {fmt(r)}, "
                    f"(x - ({fmt(h)}))² + (y - ({fmt(k)}))² = {fmt(r*r)}."
                )
        return (
            "Circle equation in standard form: (x - h)² + (y - k)² = r², "
            "where (h, k) is the center and r is the radius."
        )

    # Three-dimensional distance must precede the two-dimensional branch.
    if "distance" in low and any(w in low for w in (
        "3d", "three-dimensional", "space coordinates"
    )):
        return (
            "In three-dimensional coordinate geometry, a point is "
            "(x, y, z). Distance between P₁ and P₂ is "
            "d = √((x₂ - x₁)² + (y₂ - y₁)² + (z₂ - z₁)²). "
            "The midpoint is ((x₁ + x₂)/2, (y₁ + y₂)/2, "
            "(z₁ + z₂)/2)."
        )

    # Distance.
    if "distance" in low and ("point" in low or "coordinate" in low or points):
        if len(points) >= 2:
            labels = sorted(points)
            p, q = points[labels[0]], points[labels[1]]
            dx, dy = q[0] - p[0], q[1] - p[1]
            d = math.hypot(dx, dy)
            return (
                f"Distance formula: d = √((x₂ - x₁)² + (y₂ - y₁)²).\n"
                f"Using {labels[0]}{p} and {labels[1]}{q}: "
                f"d = √(({fmt(dx)})² + ({fmt(dy)})²) = {fmt(d)}."
            )
        return (
            "Distance formula: d = √((x₂ - x₁)² + (y₂ - y₁)²). "
            "Substitute the two points' coordinates, square the coordinate "
            "differences, add, then take the square root."
        )

    # Midpoint.
    if "midpoint" in low:
        if len(points) >= 2:
            labels = sorted(points)
            p, q = points[labels[0]], points[labels[1]]
            mx, my = (p[0] + q[0]) / 2, (p[1] + q[1]) / 2
            return (
                f"Midpoint formula: M = ((x₁ + x₂)/2, (y₁ + y₂)/2).\n"
                f"For {labels[0]}{p} and {labels[1]}{q}, "
                f"M = ({fmt(mx)}, {fmt(my)})."
            )
        return "Midpoint formula: M = ((x₁ + x₂)/2, (y₁ + y₂)/2)."

    # Slope and parallel/perpendicular lines.
    if "slope" in low or "parallel lines" in low or "perpendicular lines" in low:
        if len(points) >= 2 and "equation" not in low:
            labels = sorted(points)
            p, q = points[labels[0]], points[labels[1]]
            dx, dy = q[0] - p[0], q[1] - p[1]
            if math.isclose(dx, 0.0, abs_tol=1e-12):
                slope = "undefined (vertical line)"
            else:
                slope = fmt(dy / dx)
            return (
                f"Slope formula: m = (y₂ - y₁)/(x₂ - x₁).\n"
                f"For {labels[0]}{p} and {labels[1]}{q}, "
                f"Δy = {fmt(dy)}, Δx = {fmt(dx)}, slope = {slope}."
            )
        return (
            "Slope formula: m = (y₂ - y₁)/(x₂ - x₁). "
            "Parallel nonvertical lines have equal slopes. Perpendicular "
            "nonvertical lines have slopes that are negative reciprocals "
            "(m₁m₂ = -1). A vertical line is perpendicular to a horizontal line."
        )

    # Line equation.
    if "equation of a line" in low or "line equation" in low:
        if len(points) >= 2:
            labels = sorted(points)
            p, q = points[labels[0]], points[labels[1]]
            dx, dy = q[0] - p[0], q[1] - p[1]
            if math.isclose(dx, 0.0, abs_tol=1e-12):
                return f"Both points have x = {fmt(p[0])}; the vertical line is x = {fmt(p[0])}."
            m = dy / dx
            b = p[1] - m * p[0]
            return (
                f"Slope-intercept form: y = mx + b. The slope is {fmt(m)} "
                f"and the intercept is {fmt(b)}, so the line is "
                f"y = {fmt(m)}x {'+' if b >= 0 else '-'} {fmt(abs(b))}."
            )
        return (
            "Line equations: slope-intercept form y = mx + b; "
            "point-slope form y - y₁ = m(x - x₁); and standard form "
            "Ax + By = C. Two distinct points determine a line."
        )

    # Distance / midpoint theorem and coordinate proofs.
    if "midpoint theorem" in low:
        return (
            "Triangle Midpoint Theorem: the segment joining the midpoints "
            "of two sides of a triangle is parallel to the third side and "
            "has half its length."
        )

    if "coordinate plane" in low or "coordinate geometry" in low:
        return (
            "Coordinate geometry represents geometric objects with ordered "
            "pairs (x, y). Core tools: distance "
            "d = √((x₂ - x₁)² + (y₂ - y₁)²), midpoint "
            "M = ((x₁ + x₂)/2, (y₁ + y₂)/2), and slope "
            "m = (y₂ - y₁)/(x₂ - x₁). Use these to establish lengths, "
            "midpoints, parallelism, perpendicularity, and congruence."
        )

    # Coordinates in three-dimensional space.
    if "3d" in low or "three-dimensional" in low or "space coordinates" in low:
        return (
            "In three-dimensional coordinate geometry, a point is (x, y, z). "
            "Distance between P₁ and P₂ is "
            "d = √((x₂ - x₁)² + (y₂ - y₁)² + (z₂ - z₁)²). "
            "The midpoint is ((x₁ + x₂)/2, (y₁ + y₂)/2, (z₁ + z₂)/2)."
        )

    return None



def locus_geometry_fast_path(text):
    """Locus definitions, distance conditions, bisectors, and constructions."""
    # Defer pure definitions when the prompt asks for a numeric/code answer.
    if _wants_calculation(text):
        return None

    _calc = _wants_calculation(text)
    import re
    import math

    low = " ".join(str(text or "").strip().lower().split())

    # Construction requests must precede theorem-definition branches.
