    if lang == "python" and "prime" in low and "function" in low and "test" in low:
        return r"""import unittest

def is_prime(n):
    if not isinstance(n, int) or isinstance(n, bool) or n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    divisor = 3
    while divisor * divisor <= n:
        if n % divisor == 0:
            return False
        divisor += 2
    return True

class PrimeTests(unittest.TestCase):
    def test_two(self):
        self.assertTrue(is_prime(2))

    def test_nine(self):
        self.assertFalse(is_prime(9))

    def test_one(self):
        self.assertFalse(is_prime(1))

    def test_negative(self):
        self.assertFalse(is_prime(-7))

    def test_other_prime(self):
        self.assertTrue(is_prime(97))

if __name__ == "__main__":
    unittest.main()
"""


    if "prime" in low:
        if not 2 <= n <= 1000000000:
            return "PROGRAMMING FAST PATH: prime handler supports n from 2 to 1000000000."
        if lang == "python":
            return (
                f"n = {n}\n"
                "is_prime = n >= 2 and all("
                "n % i for i in range(2, int(n ** 0.5) + 1))\n"
                "print(is_prime)\n"
            )
        if lang == "c":
            return emit(
                f"int n = {n};\n"
                "bool prime = true;\n"
                "for (int i = 2; (long long)i * i <= n; ++i)\n"
                "    if (n % i == 0) { prime = false; break; }\n"
                'printf("%s\\n", prime ? "true" : "false");'
            )
        if lang == "cpp":
            return emit(
                f"int n = {n};\n"
                "bool prime = true;\n"
                "for (int i = 2; (long long)i * i <= n; ++i)\n"
                "    if (n % i == 0) { prime = false; break; }\n"
                'std::cout << (prime ? "true" : "false") << "\\n";'
            )
        return emit(
            f"int n = {n};\n"
            "bool prime = true;\n"
            "for (int i = 2; (long long)i * i <= n; ++i)\n"
            "    if (n % i == 0) { prime = false; break; }\n"
            'Console.WriteLine(prime ? "true" : "false");'
        )

    if "fizzbuzz" in low:
        if not 1 <= n <= 100000:
            return "PROGRAMMING FAST PATH: FizzBuzz supports n from 1 to 100000."
        if lang == "python":
            return (
                f"for i in range(1, {n} + 1):\n"
                '    print("Fizz" * (i % 3 == 0) + '
                '"Buzz" * (i % 5 == 0) or i)\n'
            )
        if lang == "c":
            return emit(
                f"for (int i = 1; i <= {n}; ++i) {{\n"
                '    if (i % 15 == 0) puts("FizzBuzz");\n'
                '    else if (i % 3 == 0) puts("Fizz");\n'
                '    else if (i % 5 == 0) puts("Buzz");\n'
                '    else printf("%d\\n", i);\n}'
            )
        if lang == "cpp":
            return emit(
                f"for (int i = 1; i <= {n}; ++i) {{\n"
                '    if (i % 15 == 0) std::cout << "FizzBuzz\\n";\n'
                '    else if (i % 3 == 0) std::cout << "Fizz\\n";\n'
                '    else if (i % 5 == 0) std::cout << "Buzz\\n";\n'
                "    else std::cout << i << '\\n';\n}"
            )
        return emit(
            f"for (int i = 1; i <= {n}; ++i) {{\n"
            '    if (i % 15 == 0) Console.WriteLine("FizzBuzz");\n'
            '    else if (i % 3 == 0) Console.WriteLine("Fizz");\n'
            '    else if (i % 5 == 0) Console.WriteLine("Buzz");\n'
            "    else Console.WriteLine(i);\n}"
        )

    if "countdown" in low or "while loop" in low:
        if not 0 <= n <= 100000:
            return "PROGRAMMING FAST PATH: n must be between 0 and 100000."
        if lang == "python":
            return f"n = {n}\nwhile n > 0:\n    print(n)\n    n -= 1\n"
        if lang == "c":
            return emit(
                f"int n = {n};\nwhile (n > 0) {{\n"
                '    printf("%d\\n", n);\n    --n;\n}'
            )
        if lang == "cpp":
            return emit(
                f"int n = {n};\nwhile (n > 0) {{\n"
                "    std::cout << n << '\\n';\n    --n;\n}"
            )
        return emit(
            f"int n = {n};\nwhile (n > 0) {{\n"
            "    Console.WriteLine(n);\n    --n;\n}"
        )

    if "sum" in low and any(x in low for x in ("range", "0 to", "0..")):
        if not 0 <= n <= 100000:
            return "PROGRAMMING FAST PATH: n must be between 0 and 100000."
        if lang == "python":
            return f"n = {n}\nprint(sum(range(n)))\n"
        if lang == "c":
            return emit(
                f"long long total = 0;\n"
                f"for (int i = 0; i < {n}; ++i) total += i;\n"
                'printf("%lld\\n", total);'
            )
        if lang == "cpp":
            return emit(
                f"long long total = 0;\n"
                f"for (int i = 0; i < {n}; ++i) total += i;\n"
                "std::cout << total << '\\n';"
            )
        return emit(
            f"long total = 0;\n"
            f"for (int i = 0; i < {n}; ++i) total += i;\n"
            "Console.WriteLine(total);"
        )

    if "for loop" in low:
        if not 0 <= n <= 100000:
            return "PROGRAMMING FAST PATH: n must be between 0 and 100000."
        if lang == "python":
            return f"for i in range({n}):\n    print(i)\n"
        if lang == "c":
            return emit(
                f"for (int i = 0; i < {n}; ++i) printf(\"%d\\\\n\", i);"
            )
        if lang == "cpp":
            return emit(
                f"for (int i = 0; i < {n}; ++i) "
                "std::cout << i << '\\\\n';"
            )
        return emit(
            f"for (int i = 0; i < {n}; ++i) Console.WriteLine(i);"
        )

    return unsupported()



# Optional Python correctness checker. If unavailable, preserve generated text.
import importlib.util as _llm_checker_importlib
_llm_checker_spec = _llm_checker_importlib.spec_from_file_location(
    "_llm_python_correctness", "/usr/local/lib/llm_python_correctness.py"
)
if _llm_checker_spec is not None and _llm_checker_spec.loader is not None and os.path.isfile("/usr/local/lib/llm_python_correctness.py"):
    _llm_checker_module = _llm_checker_importlib.module_from_spec(_llm_checker_spec)
    _llm_checker_spec.loader.exec_module(_llm_checker_module)
    verify_python_output = _llm_checker_module.verify_python_output
else:
    def verify_python_output(text):
        return text


def basic_programs_fast_path(text):
    _low = __import__("re").sub(r"\s+", " ", text.strip().lower())
    if any(k in _low for k in (
        "firewall", "iptables", "harden", "hostapd", "rogue", "contested",
        "ax1500", "ctw", "sentinel", "nethunter", "flash set", "wlan0",
        "mfp", "ieee80211w", "client isolation", "nftables", "deauth",
    )):
        return None
    """Deterministic Python for rudimentary tasks: counting, sums, tables, dice, coins."""
    import re

    low = " ".join(str(text or "").lower().split())
    if not low or len(low.split()) > 40:
        return None
    if re.search(r"\b(?:javascript|java|rust|bash|shell|php|ruby|perl|golang)\b|c\+\+|c#", low):
        return None
    if re.search(r"\bc (?:program|code|language)\b", low):
        return None
    if not (
        re.search(r"\b(?:write|make|create|generate|build|code|program|script)\b", low)
        or re.search(r"\bhow (?:do|can|would) (?:i|you)\b", low)
        or "python" in low
    ):
        return None

    ones = {"zero": 0, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6,
            "seven": 7, "eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12,
            "thirteen": 13, "fourteen": 14, "fifteen": 15, "sixteen": 16,
            "seventeen": 17, "eighteen": 18, "nineteen": 19}
    tens = {"twenty": 20, "thirty": 30, "forty": 40, "fifty": 50, "sixty": 60,
            "seventy": 70, "eighty": 80, "ninety": 90}
    ones_1_9 = "|".join(k for k in ones if 0 < ones[k] < 10)

    def to_digits(m):
        return str(sum(tens.get(w, ones.get(w, 0)) for w in re.split(r"[\s-]+", m.group(0))))

    low = re.sub(r"\b(?:one |a )?hundred\b", "100", low)
    low = re.sub(
        r"\b(?:" + "|".join(tens) + r")(?:[\s-](?:" + ones_1_9 + r"))?\b|\b(?:" + "|".join(ones) + r")\b",
        to_digits,
        low,
    )

    def fill(code, **kw):
        for k, v in kw.items():
            code = code.replace("@" + k + "@", str(v))
        return code

    ints = [int(x) for x in re.findall(r"\d+", low)]

    # ---- dice ----
    if re.search(r"\b(?:dice|die)\b", low):
        sm = re.search(r"(\d+)[- ]sided|\bd(\d+)\b", low)
        sides = int(sm.group(1) or sm.group(2)) if sm else 6
        cm = re.search(r"(\d+)\s+(?:\d+[- ]sided\s+)?(?:dice|die)\b", low)
        tm = re.search(r"(\d+)\s+times\b", low)
        times = int(tm.group(1)) if tm else 1
        if cm:
            dice = int(cm.group(1))
        elif re.search(r"\b(?:a|1)\s+(?:\d+[- ]sided\s+)?(?:die|dice)\b", low):
            dice = 1
        elif re.search(r"\bdice\b", low):
            dice = 2
        else:
            dice = 1
        if not (1 <= dice <= 100 and 2 <= sides <= 1000 and 1 <= times <= 1000):
            return None
        if dice == 1 and times == 1:
            return fill("import random\n\nprint(random.randint(1, @S@))", S=sides)
        if dice == 1:
            return fill(
                "import random\n\nfor roll in range(1, @T@ + 1):\n"
                "    print(f'Roll {roll}: {random.randint(1, @S@)}')",
                T=times, S=sides,
            )
        return fill(
            "import random\n\nfor roll in range(1, @T@ + 1):\n"
            "    values = [random.randint(1, @S@) for _ in range(@D@)]\n"
            "    print(f'Roll {roll}: {values} total = {sum(values)}')",
            T=times, S=sides, D=dice,
        )

    # ---- coin ----
    if re.search(r"\bcoins?\b", low):
        tm = re.search(r"(\d+)\s+times\b", low)
        flips = int(tm.group(1)) if tm else 1
        if not 1 <= flips <= 100000:
            return None
        if flips == 1:
            return "import random\n\nprint(random.choice(['heads', 'tails']))"
        return fill(
            "import random\n\nflips = @N@\nheads = 0\nfor _ in range(flips):\n"
            "    if random.choice(['heads', 'tails']) == 'heads':\n"
            "        heads += 1\nprint('Heads:', heads, 'Tails:', flips - heads)",
            N=flips,
        )

    # ---- countdown ----
    m = re.search(r"count(?:s|ing)?\s*down\s+(?:from\s+)?(\d+)(?:\s+(?:to|until)\s+(\d+))?", low)
    if m:
        a = int(m.group(1))
        b = int(m.group(2)) if m.group(2) is not None else 1
        if a < b or a - b > 100000:
            return None
        return fill("for i in range(@A@, @B1@, -1):\n    print(i)", A=a, B1=b - 1)

    # ---- sum ----
    m = re.search(
        r"(?:sum(?:s|ming)?|add(?:s|ing)?\s+up)\s+(?:of\s+)?(?:all\s+)?(?:the\s+)?"
        r"(?:integers\s+|numbers\s+|natural numbers\s+)?(?:from\s+)?(?:between\s+)?(\d+)\s*(?:to|through|-|and)\s*(\d+)",
        low,
    )
    fm = re.search(r"sum\s+(?:of\s+)?(?:the\s+)?first\s+(\d+)", low)
    if m or fm:
        a, b = (int(m.group(1)), int(m.group(2))) if m else (1, int(fm.group(1)))
        if a > b or b - a > 1000000:
            return None
        return fill("total = 0\nfor i in range(@A@, @B1@):\n    total += i\nprint(total)", A=a, B1=b + 1)

    # ---- factorial ----
    m = re.search(r"factorial\s*(?:of\s+)?(\d+)|(\d+)\s+factorial", low)
    if m:
        n = int(m.group(1) or m.group(2))
        if n > 500:
            return None
        return fill("n = @N@\nresult = 1\nfor i in range(2, n + 1):\n    result *= i\nprint(result)", N=n)

    # ---- fibonacci ----
    if "fibonacci" in low:
        n = ints[0] if ints else 10
        if not 1 <= n <= 1000:
            return None
        return fill("n = @N@\na, b = 0, 1\nfor _ in range(n):\n    print(a)\n    a, b = b, a + b", N=n)

    # ---- multiplication table ----
    m = re.search(r"(?:multiplication|times)\s+table(?:\s+(?:of|for))?\s+(\d+)", low)
    if m:
        return fill("n = @N@\nfor i in range(1, 11):\n    print(f'{n} x {i} = {n * i}')", N=int(m.group(1)))

    # ---- even / odd numbers ----
    pm = re.search(r"\b(even|odd)\s+(?:numbers?|integers)\b", low)
    if pm:
        if len(ints) >= 2:
            a, b = ints[0], ints[1]
        elif len(ints) == 1:
            a, b = 1, ints[0]
        else:
            return None
        if a > b or b - a > 1000000:
            return None
        cond = "i % 2 == 0" if pm.group(1) == "even" else "i % 2 == 1"
        return fill("for i in range(@A@, @B1@):\n    if @C@:\n        print(i)", A=a, B1=b + 1, C=cond)

    # ---- squares ----
    if re.search(r"\bsquares\b|\bsquare numbers\b", low) and "root" not in low and ints:
        if len(ints) >= 2:
            a, b = ints[0], ints[1]
        else:
            a, b = 1, ints[0]
        if a > b or b - a > 1000000:
            return None
        return fill("for i in range(@A@, @B1@):\n    print(i, i * i)", A=a, B1=b + 1)

    # ---- primes ----
    if re.search(r"\bprimes?\b", low):
        if re.search(r"\bprimes\b|prime numbers", low):
            limit = ints[-1] if ints else 50
            if not 2 <= limit <= 100000:
                return None
            return fill(
                "limit = @N@\nfor n in range(2, limit + 1):\n    is_prime = True\n"
                "    for d in range(2, int(n ** 0.5) + 1):\n        if n % d == 0:\n"
                "            is_prime = False\n            break\n    if is_prime:\n        print(n)",
                N=limit,
            )
        if ints:
            return fill(
                "n = @N@\nis_prime = n > 1\nfor d in range(2, int(n ** 0.5) + 1):\n"
                "    if n % d == 0:\n        is_prime = False\n        break\n"
                "print(n, 'is prime' if is_prime else 'is not prime')",
                N=ints[-1],
            )

    # ---- temperature conversion ----
    fl = re.findall(r"-?\d+(?:\.\d+)?", low)
    if re.search(r"celsius\s+to\s+fahrenheit|\bc\s+to\s+f\b", low):
        if fl:
            return fill("c = @V@\nf = c * 9 / 5 + 32\nprint(f)", V=fl[0])
        return "for c in range(0, 101, 10):\n    f = c * 9 / 5 + 32\n    print(c, 'C =', f, 'F')"
    if re.search(r"fahrenheit\s+to\s+celsius|\bf\s+to\s+c\b", low):
        if fl:
            return fill("f = @V@\nc = (f - 32) * 5 / 9\nprint(c)", V=fl[0])
        return "for f in range(32, 213, 20):\n    c = (f - 32) * 5 / 9\n    print(f, 'F =', round(c, 1), 'C')"

    # ---- circle area ----
    if re.search(r"\barea\b.*\bcircle\b|\bcircle\b.*\barea\b", low):
        rm = re.search(r"radius\s*(?:of|=|is)?\s*(\d+(?:\.\d+)?)", low)
        if rm:
            return fill("import math\n\nr = @R@\nprint(math.pi * r ** 2)", R=rm.group(1))
        return "import math\n\nr = float(input('Radius: '))\nprint(math.pi * r ** 2)"

    # ---- count up (generic, last) ----
    for pat in (
        r"\bcount(?:s|ing)?\s+(?:up\s+)?(?:from\s+(\d+)\s+)?(?:to|till|until|through|up to)\s+(\d+)",
        r"\b(?:print|display|show|list|output)s?\s+(?:out\s+)?(?:all\s+)?(?:the\s+)?(?:numbers?|integers)\s+(?:from\s+)?(\d+)\s+(?:to|through|up to|until)\s+(\d+)",
        r"\bloop\s+(?:from\s+)?(\d+)\s+(?:to|through)\s+(\d+)",
    ):
        m = re.search(pat, low)
        if m:
            a = int(m.group(1)) if m.group(1) is not None else 1
            b = int(m.group(2))
            if abs(b - a) > 1000000:
                return None
            if a <= b:
                return fill("for i in range(@A@, @B1@):\n    print(i)", A=a, B1=b + 1)
            return fill("for i in range(@A@, @B1@, -1):\n    print(i)", A=a, B1=b - 1)

    # ---- hello world ----
    if re.search(r"\bhello,? world\b", low):
        return "print('Hello, World!')"

    return None



def intermediate_programs_fast_path(text):
    """Deterministic Python for intermediate tasks: fizzbuzz, gcd/lcm, palindromes, binary search,
    bubble sort, collatz, trapezoid/Simpson integration, bisection, projectile and gas-class demos."""
    import re

    orig = " ".join(str(text or "").split())
    low = orig.lower().replace("\u00b2", "^2").replace("\u00b0", " degrees")
    if not low or len(low.split()) > 90:
        return None
    if re.search(r"\b(?:javascript|java|rust|bash|shell|php|ruby|perl|golang)\b|c\+\+|c#", low):
        return None
    if re.search(r"\bc (?:program|code|language)\b", low):
        return None
    if not (
        re.search(r"\b(?:write|make|create|generate|build|code|program|script|class|function)\b", low)
        or re.search(r"\bhow (?:do|can|would) (?:i|you)\b", low)
        or "python" in low
    ):
        return None

    ones = {"zero": 0, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6,
            "seven": 7, "eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12,
            "thirteen": 13, "fourteen": 14, "fifteen": 15, "sixteen": 16,
            "seventeen": 17, "eighteen": 18, "nineteen": 19}
    tens = {"twenty": 20, "thirty": 30, "forty": 40, "fifty": 50, "sixty": 60,
            "seventy": 70, "eighty": 80, "ninety": 90}
    ones_1_9 = "|".join(k for k in ones if 0 < ones[k] < 10)

    def to_digits(m):
        return str(sum(tens.get(w, ones.get(w, 0)) for w in re.split(r"[\s-]+", m.group(0))))

    low = re.sub(r"\b(?:one |a )?hundred\b", "100", low)
    low = re.sub(
        r"\b(?:" + "|".join(tens) + r")(?:[\s-](?:" + ones_1_9 + r"))?\b|\b(?:" + "|".join(ones) + r")\b",
        to_digits,
        low,
    )

    NUM = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?"

    def fill(code, **kw):
        for k, v in kw.items():
            code = code.replace("@" + k + "@", str(v))
        return code

    def expr_to_py(expr):
        e = expr.strip().replace("^", "**")
        e = re.sub(r"(\d)\s*(x|\()", r"\1*\2", e)
        if not re.fullmatch(r"[0-9x+\-*/(). a-z]+", e):
            return None
        if any(w not in ("x", "sin", "cos", "tan", "exp", "log", "sqrt", "pi") for w in re.findall(r"[a-z]+", e)):
            return None
        uses = bool(re.search(r"\b(?:sin|cos|tan|exp|log|sqrt|pi)\b", e))
        return re.sub(r"\b(sin|cos|tan|exp|log|sqrt|pi)\b", r"math.\1", e), uses

    # ---- class with the ideal gas law ----
    if (re.search(r"\bclass\b", low) and "gas" in low and re.search(r"\bpressure\b", low)
            and re.search(r"ideal gas|pv\s*=\s*nrt", low)):
        cm = re.search(r"\bclass\s+([A-Za-z_]\w*)", orig)
        cname = cm.group(1) if cm else "Gas"

        def val(name, default):
            vm = re.search(r"\b" + name + r"\s*=\s*(" + NUM + r")", orig)
            return vm.group(1) if vm else default

        fm = re.search(r"factor\s*(?:of|=)\s*(" + NUM + r")", low)
        factor = fm.group(1) if fm else "2"
        if float(factor) <= 0:
            return None
        return fill(
            "R = 8.314462618  # J/(mol K)\n\n\n"
            "class @C@:\n"
            "    def __init__(self, n, T, V):\n"
            "        self.n = n  # amount of gas, mol\n"
            "        self.T = T  # temperature, K\n"
            "        self.V = V  # volume, m^3\n\n"
            "    def pressure(self):\n"
            "        return self.n * R * self.T / self.V\n\n"
            "    def isothermal_compress(self, factor):\n"
            "        if factor <= 0:\n"
            "            raise ValueError('factor must be positive')\n"
            "        self.V = self.V / factor\n\n\n"
            "gas = @C@(n=@N@, T=@T@, V=@V@)\n"
            "print(f'P = {gas.pressure():.1f} Pa at V = {gas.V} m^3')\n"
            "gas.isothermal_compress(@F@)\n"
            "print(f'P = {gas.pressure():.1f} Pa at V = {gas.V} m^3')",
            C=cname, N=val("n", "2.0"), T=val("T", "300.0"), V=val("V", "0.05"), F=factor,
        )

    # ---- projectile simulation ----
    if re.search(r"\bprojectile\b", low):
        def pick(pat, default):
            pm = re.search(pat, low)
            return pm.group(1) if pm else default

        v0 = pick(r"(" + NUM + r")\s*m\s*/\s*s\b(?!\s*(?:\^|\*\*|2))", "20")
        ang = pick(r"(" + NUM + r")\s*(?:degrees?|deg)\b", "45")
        grav = pick(r"\bg\s*=\s*(" + NUM + r")", "9.81")
        dt = pick(r"(?:time steps?|timestep|step size|dt)\s*(?:of|=)?\s*(" + NUM + r")", "0.01")
        h0 = pick(r"from\s+(?:a\s+)?height\s+of\s+(" + NUM + r")\s*m\b", "0")
        try:
            ok = float(v0) > 0 and float(grav) > 0 and 1e-5 <= float(dt) <= 1 and float(h0) >= 0
        except ValueError:
            return None
        if not ok:
            return None
        return fill(
            "import math\n\n"
            "v0 = @V0@  # launch speed, m/s\n"
            "angle = math.radians(@ANG@)  # launch angle\n"
            "g = @G@  # m/s^2\n"
            "dt = @DT@  # time step, s\n\n"
            "vx = v0 * math.cos(angle)\n"
            "vy = v0 * math.sin(angle)\n"
            "x, y, t = 0.0, @H0@, 0.0\n"
            "max_height = y\n"
            "while True:\n"
            "    x_new = x + vx * dt\n"
            "    y_new = y + vy * dt - 0.5 * g * dt * dt\n"
            "    if y_new < 0.0:\n"
            "        frac = y / (y - y_new)\n"
            "        x_land = x + (x_new - x) * frac\n"
            "        t_land = t + dt * frac\n"
            "        break\n"
            "    x, y, t = x_new, y_new, t + dt\n"
            "    vy -= g * dt\n"
            "    max_height = max(max_height, y)\n"
            "print(f'Maximum height: {max_height:.2f} m')\n"
            "print(f'Range: {x_land:.2f} m')\n"
            "print(f'Flight time: {t_land:.2f} s')",
            V0=v0, ANG=ang, G=grav, DT=dt, H0=float(h0),
        )

    # ---- bisection root finding ----
    if re.search(r"\bbisect", low):
        em = (re.search(r"root of\s+(.+?)\s+(?:on|in|between|over|within)\b", low)
              or re.search(r"f\(x\)\s*=\s*(.+?)\s+(?:on|in|between|over|within)\b", low))
        im = (re.search(r"\[\s*(" + NUM + r")\s*,\s*(" + NUM + r")\s*\]", low)
              or re.search(r"between\s+(" + NUM + r")\s+and\s+(" + NUM + r")", low))
        tm = re.search(r"(?:tolerance|tol|precision)\s*(?:of|=)?\s*(" + NUM + r")", low)
        conv = expr_to_py(em.group(1)) if em else None
        if not (conv and im):
            return None
        a, b = im.group(1), im.group(2)
        tol = tm.group(1) if tm else "1e-6"
        if float(a) >= float(b) or float(tol) <= 0:
            return None
        imp = "import math\n\n" if conv[1] else ""
        return (
            imp + "def f(x):\n    return " + conv[0] + "\n\n\n"
            "def bisection(f, a, b, tol):\n"
            "    if f(a) * f(b) > 0:\n"
            "        raise ValueError('f(a) and f(b) must have opposite signs')\n"
            "    iterations = 0\n"
            "    while (b - a) / 2 > tol:\n"
            "        mid = (a + b) / 2\n"
            "        if f(mid) == 0:\n"
            "            return mid, iterations\n"
            "        if f(a) * f(mid) < 0:\n"
            "            b = mid\n"
            "        else:\n"
            "            a = mid\n"
            "        iterations += 1\n"
            "    return (a + b) / 2, iterations\n\n\n"
            "root, iterations = bisection(f, " + a + ", " + b + ", " + tol + ")\n"
            "print('root:', root)\n"
            "print('iterations:', iterations)"
        )

    # ---- trapezoid / Simpson integration ----
    if re.search(r"trapezoid|trapezium|simpson", low):
        em = (re.search(r"integrat\w*\s+(?:the function\s+)?(.+?)\s+(?:from|over|between)\s+", low)
              or re.search(r"f\(x\)\s*=\s*(.+?)\s+(?:from|over|between|on)\b", low))
        lm = re.search(r"(?:from|between)\s+(" + NUM + r")\s+(?:to|and)\s+(" + NUM + r")", low)
        sm = re.search(r"(\d+)\s+(?:steps|intervals|subintervals|trapezoids|slices|panels)", low)
        xm = re.search(r"exact value\s*(?:of|is|=)?\s*(" + NUM + r")", low)
        conv = expr_to_py(em.group(1)) if em else None
        if not (conv and lm):
            return None
        steps = int(sm.group(1)) if sm else 1000
        if not 1 <= steps <= 10000000:
            return None
        imp = "import math\n\n" if conv[1] else ""
        if "simpson" in low:
            rule = ("def simpson(f, a, b, n):\n    if n % 2:\n        n += 1\n    h = (b - a) / n\n"
                    "    total = f(a) + f(b)\n    for i in range(1, n):\n"
                    "        total += (4 if i % 2 else 2) * f(a + i * h)\n    return total * h / 3\n")
            call = "simpson"
        else:
            rule = ("def trapezoid(f, a, b, n):\n    h = (b - a) / n\n    total = 0.5 * (f(a) + f(b))\n"
                    "    for i in range(1, n):\n        total += f(a + i * h)\n    return total * h\n")
            call = "trapezoid"
        tail = "print('integral:', result)"
        if xm:
            tail += "\nexact = " + xm.group(1) + "\nprint('error:', abs(result - exact))"
        return (imp + "def f(x):\n    return " + conv[0] + "\n\n\n" + rule
                + "\n\na, b, n = " + lm.group(1) + ", " + lm.group(2) + ", " + str(steps)
                + "\nresult = " + call + "(f, a, b, n)\n" + tail)

    # ---- bubble sort ----
    if re.search(r"bubble\s*sort", low):
        lm = re.search(r"\[([^\]]*)\]", orig)
        toks = re.findall(NUM, lm.group(1)) if lm else []
        toks = toks or ["5", "2", "9", "1", "7"]
        if len(toks) > 200:
            return None
        cmp = "<" if "descending" in low else ">"
        return fill(
            "def bubble_sort(items):\n"
            "    items = list(items)\n"
            "    n = len(items)\n"
            "    for p in range(n - 1):\n"
            "        swapped = False\n"
            "        for i in range(n - 1 - p):\n"
            "            if items[i] @C@ items[i + 1]:\n"
            "                items[i], items[i + 1] = items[i + 1], items[i]\n"
            "                swapped = True\n"
            "        print(f'Pass {p + 1}: {items}')\n"
            "        if not swapped:\n"
            "            break\n"
            "    return items\n\n\n"
            "print(bubble_sort([@L@]))",
            C=cmp, L=", ".join(toks),
        )

    # ---- collatz ----
    if "collatz" in low:
        ints = re.findall(r"\d+", low)
        start = int(ints[0]) if ints else 27
        if not 1 <= start <= 10 ** 9:
            return None
        return fill(
            "n = @N@\nsequence = [n]\nwhile n != 1:\n"
            "    n = n // 2 if n % 2 == 0 else 3 * n + 1\n"
            "    sequence.append(n)\n"
            "print(sequence)\nprint('steps:', len(sequence) - 1)",
            N=start,
        )

    # ---- binary search ----
    if re.search(r"binary\s*search", low):
        nm = re.search(r"\b([a-z_]*search[a-z_]*)\s*\(", low)
        fname = nm.group(1) if nm else "binary_search"
        cm = re.search(r"(\d+)\s+(?:numbers|elements|items|integers|values)", low)
        count = int(cm.group(1)) if cm else 20
        if not 2 <= count <= 10000:
            return None
        return fill(
            "def @F@(items, target):\n"
            "    lo, hi = 0, len(items) - 1\n"
            "    while lo <= hi:\n"
            "        mid = (lo + hi) // 2\n"
            "        if items[mid] == target:\n"
            "            return mid\n"
            "        if items[mid] < target:\n"
            "            lo = mid + 1\n"
            "        else:\n"
            "            hi = mid - 1\n"
            "    return -1\n\n\n"
            "items = [2 * i + 1 for i in range(@N@)]\n"
            "mid = len(items) // 2\n"
            "for target in (items[mid], items[0], items[-1], items[mid] + 1):\n"
            "    print(target, @F@(items, target))",
            F=fname, N=count,
        )

    # ---- palindrome ----
    if "palindrome" in low:
        nm = re.search(r"\b([a-z_]*palindrome[a-z_]*)\s*\(", low)
        fname = nm.group(1) if nm else "is_palindrome"
        quoted = [x or y for x, y in re.findall(r"'([^']+)'|\"([^\"]+)\"", orig)]
        samples = quoted[:10] or ["A man, a plan, a canal: Panama", "Hello, World", "Was it a car or a cat I saw?"]
        return fill(
            "def @F@(text):\n"
            "    cleaned = ''.join(ch.lower() for ch in text if ch.isalnum())\n"
            "    return cleaned == cleaned[::-1]\n\n\n"
            "for s in @S@:\n"
            "    print(repr(s), @F@(s))",
            F=fname, S=repr(samples),
        )

    # ---- gcd / lcm ----
    if re.search(r"\bgcd\b|\blcm\b|greatest common|least common|euclid", low):
        ints = [int(x) for x in re.findall(r"\d+", low)]
        a, b = (ints[0], ints[1]) if len(ints) >= 2 else (48, 180)
        if a <= 0 or b <= 0:
            return None
        nm = re.search(r"\b([a-z_]\w*)\s*\(\s*a\s*,\s*b\s*\)", low)
        gname = nm.group(1) if nm and nm.group(1) not in ("lcm", "print") else "gcd"
        return fill(
            "def @G@(a, b):\n"
            "    while b:\n"
            "        a, b = b, a % b\n"
            "    return a\n\n\n"
            "def lcm(a, b):\n"
            "    return a // @G@(a, b) * b\n\n\n"
            "a, b = @A@, @B@\n"
            "print('gcd:', @G@(a, b))\n"
            "print('lcm:', lcm(a, b))",
            G=gname, A=a, B=b,
        )

    # ---- fizzbuzz ----
    if re.search(r"fizz\s*buzz", low):
        rm = re.search(r"(\d+)\s+(?:to|through|up to)\s+(\d+)", low)
        um = re.search(r"up to\s+(\d+)", low)
        if rm:
            a, b = int(rm.group(1)), int(rm.group(2))
        elif um:
            a, b = 1, int(um.group(1))
        else:
            a, b = 1, 100
        if a > b or b - a > 100000:
            return None
        return fill(
            "for i in range(@A@, @B1@):\n"
            "    if i % 15 == 0:\n"
            "        print('FizzBuzz')\n"
            "    elif i % 3 == 0:\n"
            "        print('Fizz')\n"
            "    elif i % 5 == 0:\n"
            "        print('Buzz')\n"
            "    else:\n"
            "        print(i)",
            A=a, B1=b + 1,
        )

    return None



def chess_fast_path(text):
    """Persistent legal chess board and ASCII rendering."""
    import json
    import os
    import re
    import sys

    chess_path = "/data/app/flex/venv/lib/python3.11/site-packages"
    if chess_path not in sys.path:
        sys.path.insert(0, chess_path)

    try:
        import chess
    except ImportError:
        return "Chess handler error: python-chess is unavailable at " + chess_path

    state_dir = os.path.expanduser("~/.local/state/llm")
    state_file = os.path.join(state_dir, "chess.json")
    low = " ".join(str(text or "").strip().lower().split())

    if not low:
        return None

    start_cmd = bool(re.fullmatch(
        r"(?:(?:start|begin|new|reset|restart)\s+(?:a\s+)?chess(?:\s+game)?|chess(?:\s+game)?|new\s+game|reset\s+game|restart\s+game)\s*[.!?]*",
        low
    ))
    show_cmd = bool(re.search(
        r"\b(show|display|print|board|position|current position)\b", low
    )) and bool(re.search(r"\b(chess|board|position)\b", low))

    move_cmd = bool(re.search(
        r"\b(?:[a-h][1-8]\s+(?:to|->)\s+[a-h][1-8]|(?:move|play\s+)?(?:king|queen|rook|bishop|knight|horse|pawn)\s+to\s+[a-h][1-8])\b", low
    )) or bool(re.fullmatch(
        r"\s*(?:[KQRBN]?[a-h][1-8](?:x[a-h][1-8]|[a-h][1-8])?[+#]?|O-O(?:-O)?[+#]?)\s*",
        str(text or "").strip()
    ))

    active = os.path.exists(state_file)
    if not (start_cmd or show_cmd or (active and move_cmd)):
        return None

    os.makedirs(state_dir, exist_ok=True)
    board = chess.Board()

    if active and not start_cmd:
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                saved = json.load(f)
            board.set_fen(saved["fen"])
        except Exception:
            board = chess.Board()

    def render(b):
        out = [
            "    a b c d e f g h",
            "  +-----------------+"
        ]
        for rank in range(7, -1, -1):
            cells = []
            for file_idx in range(8):
                piece = b.piece_at(chess.square(file_idx, rank))
                if piece is None:
                    cells.append(".")
                else:
                    letter = piece.symbol()
                    if piece.color == chess.WHITE:
                        cells.append("\033[97m" + letter.upper() + "\033[0m")
                    else:
                        cells.append("\033[91m" + letter.lower() + "\033[0m")
            out.append(f"{rank + 1} | " + " ".join(cells) + f" | {rank + 1}")
        out.append("  +-----------------+")
        out.append("    a b c d e f g h")
        out.append("White: uppercase; Black: lowercase red.")
        out.append("Turn: " + ("White" if b.turn == chess.WHITE else "Black"))
        if b.is_check():
            out.append("CHECK!")
        if b.is_checkmate():
            out.append("CHECKMATE.")
        elif b.is_stalemate():
            out.append("STALEMATE.")
        return "\n".join(out)

    if start_cmd:
        board = chess.Board()
        message = "Started a new chess game."
    elif move_cmd:
        # Accept UCI/SAN first, then natural forms such as "pawn to a3".
        move_text = str(text or "").strip()
        move = None

        try:
            candidate = chess.Move.from_uci(move_text.lower().replace(" ", ""))
            if candidate in board.legal_moves:
                move = candidate
        except Exception:
            pass

        if move is None:
            try:
                move = board.parse_san(move_text)
            except Exception:
                pass

        if move is None:
            # Parse explicit source and destination first, e.g. "a2 to a3".
            source_target = re.search(
                r"\b([a-h][1-8])\s+(?:to|->)\s+([a-h][1-8])\b", low
            )
            if source_target:
                source = chess.parse_square(source_target.group(1))
                target = chess.parse_square(source_target.group(2))
                candidates = [
                    m for m in board.legal_moves
                    if m.from_square == source and m.to_square == target
                ]
                if len(candidates) == 1:
                    move = candidates[0]
                elif len(candidates) > 1:
                    return "That move needs a promotion choice."

        if move is None:
            # Also accept destination-only instructions such as "pawn to a3".
            target_match = re.search(r"\b([a-h][1-8])\b", low)
            if target_match:
                target = chess.parse_square(target_match.group(1))
                piece_type = None
                for name, ptype in (
                    ("queen", chess.QUEEN), ("rook", chess.ROOK),
                    ("bishop", chess.BISHOP), ("knight", chess.KNIGHT),
                    ("horse", chess.KNIGHT), ("pawn", chess.PAWN),
                    ("king", chess.KING)
                ):
                    if re.search(r"\b" + name + r"\b", low):
                        piece_type = ptype
                        break

                candidates = [
                    m for m in board.legal_moves
                    if m.to_square == target
                    and (
                        piece_type is None
                        or board.piece_type_at(m.from_square) == piece_type
                    )
                ]

                if len(candidates) == 1:
                    move = candidates[0]
                elif len(candidates) > 1:
                    options = ", ".join(
                        chess.square_name(m.from_square) + "-" +
                        chess.square_name(m.to_square) for m in candidates
                    )
                    return "That move is ambiguous. Specify the source square: " + options
        if move is None or move not in board.legal_moves:
            return "I couldn't match that to a legal move. Use a move such as 'pawn to a3', 'e2 to e4', or standard notation like 'Nf3'.\n\n" + render(board)

        san = board.san(move)
        board.push(move)
        message = "You played: " + san

        # White moves first; Stockfish automatically replies for Black.
        if board.turn == chess.BLACK:
            import subprocess

            engine = None
            try:
                engine = subprocess.Popen(
                    ["/data/sda4/llm-tools/stockfish/stockfish"],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    bufsize=1
                )

                def engine_send(command):
                    engine.stdin.write(command + "\n")
                    engine.stdin.flush()

                def engine_wait_for(prefix):
                    for line in engine.stdout:
                        if line.startswith(prefix):
                            return line.strip()
                    raise RuntimeError(
                        "Stockfish exited before returning " + prefix
                    )

                engine_send("uci")
                engine_wait_for("uciok")
                engine_send("setoption name Threads value 1")
                engine_send("setoption name Hash value 32")
                engine_send("isready")
                engine_wait_for("readyok")
                engine_send("position fen " + board.fen())
                engine_send("go movetime 300")

                bestmove_line = engine_wait_for("bestmove")
                parts = bestmove_line.split()
                if len(parts) < 2 or parts[1] == "(none)":
                    raise RuntimeError("Stockfish found no legal reply")

                reply = chess.Move.from_uci(parts[1])
                if reply not in board.legal_moves:
                    raise RuntimeError("Stockfish returned an illegal move")

                reply_san = board.san(reply)
                board.push(reply)
                message += "\nStockfish played: " + reply_san

            except Exception as exc:
                message += "\nStockfish reply failed: " + str(exc)
            finally:
                if engine is not None:
                    try:
                        engine_send("quit")
                        engine.wait(timeout=2)
                    except Exception:
                        try:
                            engine.terminate()
                            engine.wait(timeout=2)
                        except Exception:
                            engine.kill()
    else:
        message = "Current chess position."

    with open(state_file, "w", encoding="utf-8") as f:
        json.dump({"fen": board.fen()}, f)

    return message + "\n\n" + render(board)



def benchmark_thermodynamics_fast_path(text):
    import re

    raw = str(text or "").lower().replace("³", "^3")
    number = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+))"

    if "carnot" in raw and "efficien" in raw:
        temps = [float(m.group(1)) for m in re.finditer(number + r"\s*k\b", raw)]
        if len(temps) >= 2:
            hot, cold = max(temps[0:2]), min(temps[0:2])
            if cold > 0 and hot > cold:
                eta = 1.0 - cold / hot
                return (
                    "Carnot efficiency:\n"
                    f"η = 1 - Tc/Th = 1 - {cold:g}/{hot:g}\n"
                    f"η = {eta:.6g} = {eta * 100:.6g}%"
                )

    if "ideal gas" in raw and "pressure" in raw:
        moles = re.search(number + r"\s*(?:mol|moles)\b", raw)
        temp = re.search(number + r"\s*k\b", raw)
        volume = re.search(number + r"\s*m\s*\^?\s*3\b", raw)
        if moles and temp and volume:
            n, T, V = float(moles.group(1)), float(temp.group(1)), float(volume.group(1))
            if n > 0 and T > 0 and V > 0:
                R = 8.314462618
                pressure = n * R * T / V
                return (
                    "Ideal gas law:\n"
                    f"P = nRT/V = {n:g}*{R:g}*{T:g}/{V:g}\n"
                    f"P = {pressure:.6g} Pa = {pressure / 1000:.6g} kPa"
                )

    return None




def geometry_transformations_euler_fast_path(text):
    """General deterministic coordinate transformations and discrete geometry."""
    import math
    import re

    raw = str(text or "").strip().lower()
    raw = raw.replace("−", "-").replace("–", "-").replace("°", " degrees ")
    raw = re.sub(r"\s+", " ", raw)
    num = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?"

    def fmt(v):
        if abs(v) < 1e-12:
            v = 0.0
        if abs(v - round(v)) < 1e-10:
            return str(int(round(v)))
        return f"{v:.10g}"

    def point(match):
        return float(match.group(1)), float(match.group(2))

    # Euler trail: an undirected connected graph has zero or two odd-degree
    # vertices. Ignore isolated vertices when assessing connectivity.
    if (
        ("euler trail" in raw or "eulerian trail" in raw
         or ("single stroke" in raw and "each edge" in raw))
        and ("vertex" in raw or "degree" in raw or "edge" in raw)
    ):
        return (
            "Euler trail vertex-degree condition:\n"
            "A graph must be connected after isolated vertices are ignored, "
            "and it must have exactly 0 or 2 vertices of odd degree.\n"
            "0 odd-degree vertices: an Euler circuit exists.\n"
            "2 odd-degree vertices: an open Euler trail exists; it starts "
            "at one odd-degree vertex and ends at the other.\n"
            "Any other number of odd-degree vertices: no Euler trail exists."
        )

    # Regular polygon from its exterior angle.
    if "regular polygon" in raw and "exterior angle" in raw:
        m = re.search(r"exterior angle(?:\s+(?:is|of))?\s*[:=]?\s*(" + num + r")", raw)
        if not m:
            m = re.search(r"(" + num + r")\s*degrees?\s+exterior angle", raw)
        if m:
            angle = abs(float(m.group(1)))
            if 0 < angle < 360:
                sides = 360.0 / angle
                if abs(sides - round(sides)) < 1e-9:
                    n = int(round(sides))
                    return (
                        "Regular polygon exterior-angle solution:\n"
                        "The exterior angles sum to 360 degrees.\n"
                        f"n = 360 degrees / {fmt(angle)} degrees = {n}\n"
                        f"The polygon has {n} sides."
                    )
                return (
                    "Regular polygon exterior-angle check:\n"
                    f"n = 360 / {fmt(angle)} = {fmt(sides)}.\n"
                    "A regular polygon must have an integer number of sides; "
                    "the supplied angle does not give an integer."
                )

    # Tessellation vertex-angle explanation.
    if "tessellat" in raw and (
        "360" in raw or "interior angle" in raw or "vertex" in raw
        or "without gaps" in raw or "without overlaps" in raw
    ):
        return (
            "Why tessellation angles sum to 360 degrees:\n"
            "The angles around a point make one complete turn, which is "
            "360 degrees. At a tessellation vertex, the polygon interiors "
            "meet without gaps or overlaps, so their interior angles fill "
            "that complete turn.\n"
            "Therefore, the angles at the vertex sum to 360 degrees."
        )

    # Dilation from the origin by a signed scale factor.
    if "dilat" in raw and ("factor" in raw or "scale factor" in raw):
        pm = re.search(r"\(\s*(" + num + r")\s*,\s*(" + num + r")\s*\)", raw)
        fm = re.search(
            r"(?:scale\s+)?factor(?:\s+of)?\s*(?:is|=|:)?\s*(" + num + r")",
            raw
        )
        if pm and fm and ("origin" in raw or "from the origin" in raw):
            x, y = point(pm)
            k = float(fm.group(1))
            xx, yy = k*x, k*y
            explanation = (
                "The negative factor places the image on the opposite ray "
                "from the origin; its distance from the origin is multiplied "
                "by the absolute value of the factor."
                if k < 0 else
                "The image remains on the same ray from the origin, with "
                "its distance multiplied by the scale factor."
            )
            return (
                "Dilation from the origin:\n"
                f"Rule: (x, y) -> ({fmt(k)}x, {fmt(k)}y)\n"
                f"Image: ({fmt(x)}, {fmt(y)}) -> ({fmt(xx)}, {fmt(yy)})\n"
                + explanation
            )

    # Translation of one or more named points by a vector.
    if "translat" in raw and "vector" in raw:
        vm = re.search(
            r"vector\s*(?:of\s*)?\(\s*(" + num + r")\s*,\s*(" + num + r")\s*\)",
            raw
        )
        if not vm:
            vm = re.search(
                r"by\s*\(\s*(" + num + r")\s*,\s*(" + num + r")\s*\)",
                raw
            )
        if vm:
            dx, dy = float(vm.group(1)), float(vm.group(2))
            points = re.findall(
                r"\b([abc])\s*\(\s*(" + num + r")\s*,\s*(" + num + r")\s*\)",
                raw
            )
            if points:
                lines = [
                    "Translation by a vector:",
                    f"Rule: (x, y) -> (x {dx:+g}, y {dy:+g})",
                    "Image coordinates:"
                ]
                for label, xs, ys in points:
                    x, y = float(xs), float(ys)
                    lines.append(
                        f"{label.upper()}({fmt(x)},{fmt(y)}) -> "
                        f"{label.upper()}'({fmt(x+dx)},{fmt(y+dy)})"
                    )
                return "\n".join(lines)

    # Single-point reflection or rotation about the origin.
    if "reflect" in raw:
        pm = re.search(r"\(\s*(" + num + r")\s*,\s*(" + num + r")\s*\)", raw)
        if pm:
            x, y = point(pm)
            if re.search(r"\by\s*[- ]?axis\b", raw):
                xx, yy, rule = -x, y, "(x, y) -> (-x, y)"
            elif re.search(r"\bx\s*[- ]?axis\b", raw):
                xx, yy, rule = x, -y, "(x, y) -> (x, -y)"
            elif "origin" in raw:
                xx, yy, rule = -x, -y, "(x, y) -> (-x, -y)"
            elif re.search(r"\by\s*=\s*x\b", raw):
                xx, yy, rule = y, x, "(x, y) -> (y, x)"
            elif re.search(r"\by\s*=\s*-x\b", raw):
                xx, yy, rule = -y, -x, "(x, y) -> (-y, -x)"
            else:
                xx = yy = None
                rule = ""
            if xx is not None:
                return (
                    "Reflection:\n"
                    f"Rule: {rule}\n"
                    f"Image: ({fmt(x)}, {fmt(y)}) -> "
                    f"({fmt(xx)}, {fmt(yy)})"
                )

    if "rotat" in raw and "origin" in raw:
        pm = re.search(r"\(\s*(" + num + r")\s*,\s*(" + num + r")\s*\)", raw)
        if pm:
            x, y = point(pm)
            clockwise = "clockwise" in raw and "counterclockwise" not in raw
            am = re.search(r"(" + num + r")\s*(?:degrees?|°)", raw)
            if am:
                angle = float(am.group(1)) % 360
                if abs(angle - 90) < 1e-9:
                    xx, yy = (y, -x) if clockwise else (-y, x)
                    rule = "(x, y) -> (y, -x)" if clockwise else "(x, y) -> (-y, x)"
                elif abs(angle - 180) < 1e-9:
                    xx, yy, rule = -x, -y, "(x, y) -> (-x, -y)"
                elif abs(angle - 270) < 1e-9:
                    xx, yy = (-y, x) if clockwise else (y, -x)
                    rule = "(x, y) -> (-y, x)" if clockwise else "(x, y) -> (y, -x)"
                else:
                    xx = yy = None
                    rule = ""
                if xx is not None:
                    direction = "clockwise" if clockwise else "counterclockwise"
                    return (
                        f"Rotation {fmt(angle)} degrees {direction} about the origin:\n"
                        f"Rule: {rule}\n"
                        f"Image: ({fmt(x)}, {fmt(y)}) -> "
                        f"({fmt(xx)}, {fmt(yy)})"
                    )

    return None


def geometry_advanced_extension_fast_path(text):
    """Deterministic handlers for additional geometry benchmark topics."""
    import math
    import re

    low = " ".join(str(text or "").lower().split())

    def fmt(x):
        return f"{x:.10g}"

    # Largest angle is opposite the longest side.
    if "largest" in low and "angle" in low and "triangle" in low and "sides" in low:
        m = re.search(
            r"sides\s+(\d+(?:\.\d+)?)\s*cm\s*,?\s*"
            r"(\d+(?:\.\d+)?)\s*cm\s*,?\s*(?:and\s*)?"
            r"(\d+(?:\.\d+)?)\s*cm", low
        )
        if m:
            sides = sorted(map(float, m.groups()))
            a, b, c = sides
            if a + b > c:
                return (
                    "In a triangle, the largest angle is opposite the longest side.\n"
                    f"Side lengths in order: {fmt(a)}, {fmt(b)}, {fmt(c)} cm.\n"
                    f"Therefore, the largest angle is opposite the {fmt(c)} cm side."
                )

    # Order angles by their opposite side lengths.
    if "order the angles" in low and "opposite sides" in low:
        m = re.search(
            r"sides\s+measure\s+(\d+(?:\.\d+)?)\s*cm\s*,?\s*"
            r"(\d+(?:\.\d+)?)\s*cm\s*,?\s*and\s*"
            r"(\d+(?:\.\d+)?)\s*cm", low
        )
        if m:
            sides = sorted(map(float, m.groups()))
            a, b, c = sides
            if a + b > c:
                return (
                    "In a triangle, larger sides are opposite larger angles.\n"
                    f"Smallest to largest: angle opposite {fmt(a)} cm "
                    "< angle opposite " + fmt(b) + " cm < angle opposite "
                    + fmt(c) + " cm."
                )

    # Quadrilateral interior angle sum.
    if "quadrilateral" in low and "interior angles" in low and "x" in low:
        vals = [float(v) for v in re.findall(r"(\d+(?:\.\d+)?)\s*°", low)]
        if len(vals) >= 3:
            x = 360 - sum(vals[:3])
            if 0 < x < 360:
                return (
                    "The interior angles of a quadrilateral sum to 360 degrees.\n"
                    f"x = 360 - ({' + '.join(fmt(v) for v in vals[:3])})\n"
                    f"x = {fmt(x)} degrees."
                )

    # Cylinder volume V = pi*r^2*h.
    if "cylinder" in low and "volume" in low and "height" in low:
        vm = re.search(r"volume\s+(\d+(?:\.\d+)?)\s*π?\s*cm", low)
        rm = re.search(r"radius\s+(\d+(?:\.\d+)?)", low)
        if vm and rm:
            volume_coefficient = float(vm.group(1))
            radius = float(rm.group(1))
            if radius > 0:
                h = volume_coefficient / (radius * radius)
                return (
                    "Cylinder volume: V = πr²h.\n"
                    f"h = V/(πr²) = ({fmt(volume_coefficient)}π)/(π × "
                    f"{fmt(radius)}²) = {fmt(h)} cm."
                )

    # Locus: at most r is a filled disk; exactly r is a circle.
    if "locus" in low and "4 cm" in low and ("given point" in low or "a point" in low):
        if "at most" in low and "exactly" in low:
            return (
                "At most 4 cm: all points whose distance from the given point is "
                "less than or equal to 4 cm, forming a filled disk including its boundary.\n"
                "Exactly 4 cm: all points whose distance is exactly 4 cm, forming "
                "the circumference of a circle of radius 4 cm."
            )

    # Compass-and-straightedge angle copy.
    if "copy a given angle" in low and "compass" in low and "straightedge" in low:
        return (
            "Construction to copy angle AOB at a new ray with endpoint P:\n"
            "1. Draw the new ray starting at P.\n"
            "2. Center the compass at O and draw an arc intersecting OA and OB at C and D.\n"
            "3. Without changing the radius, center the compass at P and draw an arc "
            "intersecting the new ray at E.\n"
            "4. Set the compass width to CD. Center it at E and mark F where this arc "
            "intersects the arc centered at P.\n"
            "5. Draw ray PF. The copied angle equals the original angle because the "
            "same radii and chord length are used."
        )

    # Equilateral triangle on a given segment.
    if "equilateral triangle" in low and "given side" in low:
        return (
            "Construction on given segment AB:\n"
            "1. Set the compass width to AB.\n"
            "2. Draw an arc centered at A.\n"
            "3. Without changing the compass width, draw an arc centered at B; "
            "let an intersection be C.\n"
            "4. Draw segments AC and BC.\n"
            "Since AB = AC = BC, triangle ABC is equilateral and each angle is 60 degrees."
        )

    # Law of cosines for two sides and included angle.
    if "include an angle" in low and "third side" in low:
        m = re.search(
            r"measure\s+(\d+(?:\.\d+)?)\s*m\s+and\s+"
            r"(\d+(?:\.\d+)?)\s*m.*?angle\s+of\s+"
            r"(\d+(?:\.\d+)?)\s*°",
            low,
        )
        if m:
            a, b, deg = map(float, m.groups())
            c2 = a*a + b*b - 2*a*b*math.cos(math.radians(deg))
            c = math.sqrt(max(0, c2))
            return (
                "Use the Law of Cosines because two sides and their included angle are known.\n"
                f"c² = a² + b² - 2ab cos(C)\n"
                f"c² = {fmt(a)}² + {fmt(b)}² - 2({fmt(a)})({fmt(b)})cos({fmt(deg)}°)\n"
                f"c = sqrt({fmt(c2)}) ≈ {fmt(c)} m."
            )

    # Arc length in terms of pi.
    if "arc" in low and "central angle" in low and "radius" in low:
        m = re.search(
            r"radius\s+(\d+(?:\.\d+)?)\s*cm.*?"
            r"(\d+(?:\.\d+)?)\s*°\s*central angle", low
        )
        if not m:
            m = re.search(
                r"radius\s+(\d+(?:\.\d+)?)\s*cm.*?"
                r"(\d+(?:\.\d+)?)\s*°", low
            )
        if m:
            r, deg = map(float, m.groups())
            if r > 0 and 0 < deg <= 360:
                coeff = r * deg / 180
                return (
                    "Arc length: s = (θ/360°) × 2πr.\n"
                    f"s = ({fmt(deg)}/360) × 2π × {fmt(r)}\n"
                    f"s = {fmt(coeff)}π cm."
                )

    # Rolling wheel: distance = revolutions × circumference.
    if "revolutions" in low and "rolls without slipping" in low:
        m = re.search(
            r"radius\s+(\d+(?:\.\d+)?)\s*m.*?"
            r"through\s+(\d+(?:\.\d+)?)\s*revolutions", low
        )
        if m:
            r, turns = map(float, m.groups())
            coeff = 2 * r * turns
            return (
                "Each revolution travels one circumference, 2πr.\n"
                f"Distance = {fmt(turns)} × 2π × {fmt(r)}\n"
                f"= {fmt(coeff)}π m ≈ {fmt(coeff*math.pi)} m."
            )

    return None


def geometry_extension_fast_path(text):
    """Deterministic solvers for common triangle and quadrilateral problems."""
    import math
    import re

    low = " ".join(str(text or "").lower().split())

    def fmt(v):
        return f"{v:.10g}"

    def nums(pattern):
        m = re.search(pattern, low)
        return [float(v) for v in m.groups()] if m else None

    # Triangle angle sum: three linear expressions in x.
    if "triangle" in low and "largest" in low and "x" in low:
        pat = (
            r"\(?\s*(\d+(?:\.\d+)?)?\s*x"
            r"\s*([+-]\s*\d+(?:\.\d+)?)?\s*\)?\s*°?"
        )
        found = list(re.finditer(pat, low))
        if len(found) >= 3:
            terms = []
            for m in found[:3]:
                a = float(m.group(1)) if m.group(1) else 1.0
                b = float(m.group(2).replace(" ", "")) if m.group(2) else 0.0
                terms.append((a, b))
            a_sum = sum(a for a, _ in terms)
            b_sum = sum(b for _, b in terms)
            if a_sum:
                x = (180 - b_sum) / a_sum
                angles = [a*x + b for a, b in terms]
                if x > 0 and all(0 < v < 180 for v in angles):
                    return (
                        "Triangle angle sum: the three angles total 180 degrees.\n"
                        f"Equation: {fmt(a_sum)}x {b_sum:+g} = 180.\n"
                        f"x = {fmt(x)}.\n"
                        "Angles: " + ", ".join(fmt(v) + " degrees" for v in angles) + ".\n"
                        f"Largest angle = {fmt(max(angles))} degrees."
                    )

    # Isosceles triangle perimeter: two equal sides and a base.
    if "isosceles" in low and "perimeter" in low:
        m = re.search(
            r"perimeter\s+of\s+(\d+(?:\.\d+)?)\s*cm.*?"
            r"base\s+of\s+(\d+(?:\.\d+)?)\s*cm", low
        )
        if m:
            perimeter, base = map(float, m.groups())
            side = (perimeter - base) / 2
            if side > 0 and 2*side > base:
                return (
                    "An isosceles triangle has two equal sides.\n"
                    f"Each equal side = (perimeter - base) / 2\n"
                    f"= ({fmt(perimeter)} - {fmt(base)}) / 2\n"
                    f"= {fmt(side)} cm."
                )

    # Isosceles triangle: equal legs and base, perimeter.
    if "isosceles" in low and "perimeter" in low:
        m = re.search(
            r"equal\s+(?:legs|sides)\s+of\s+(\d+(?:\.\d+)?)\s*cm"
            r".*?base\s+of\s+(\d+(?:\.\d+)?)\s*cm", low
        )
        if m:
            a, b = map(float, m.groups())
            return (
                "Perimeter is the sum of all three sides.\n"
                f"P = {fmt(a)} + {fmt(a)} + {fmt(b)} = {fmt(2*a+b)} cm."
            )

    # Isosceles altitude to base: split the base into two equal halves.
    if "isosceles" in low and "altitude" in low:
        m = re.search(
            r"(?:equal sides|sides)\s+of\s+(\d+(?:\.\d+)?)\s*cm"
            r".*?base\s+of\s+(\d+(?:\.\d+)?)\s*cm", low
        )
        if not m:
            m = re.search(
                r"equal\s+sides\s+of\s+(\d+(?:\.\d+)?)\s*cm"
                r".*?base\s+of\s+(\d+(?:\.\d+)?)\s*cm", low
            )
        if m:
            side, base = map(float, m.groups())
            half = base / 2
            radicand = side*side - half*half
            if radicand >= 0:
                h = math.sqrt(radicand)
                return (
                    "The altitude to the base bisects the base, forming a right triangle.\n"
                    "By the Pythagorean theorem, h² + (base/2)² = side².\n"
                    f"h = sqrt({fmt(side)}² - {fmt(half)}²)\n"
                    f"h = sqrt({fmt(radicand)}) = {fmt(h)} cm."
                )

    # Triangle inequality: |a-b| < third side < a+b.
    if "third side" in low and "triangle" in low:
        m = re.search(
            r"two sides.*?(\d+(?:\.\d+)?)\s*cm.*?"
            r"and\s+(\d+(?:\.\d+)?)\s*cm", low
        )
        if m:
            a, b = map(float, m.groups())
            lo, hi = abs(a-b), a+b
            return (
                "Triangle inequality: the third side must be greater than the difference "
                "and less than the sum of the other two sides.\n"
                f"|{fmt(a)} - {fmt(b)}| < x < {fmt(a)} + {fmt(b)}\n"
                f"{fmt(lo)} < x < {fmt(hi)} cm."
            )

    # Parallelogram: opposite angles equal, adjacent angles supplementary.
    if "parallelogram" in low and "remaining three angles" in low:
        m = re.search(r"(\d+(?:\.\d+)?)\s*°", low)
        if m:
            a = float(m.group(1))
            if 0 < a < 180:
                b = 180 - a
                return (
                    "In a parallelogram, opposite angles are equal and adjacent angles "
                    "sum to 180 degrees.\n"
                    f"Given angle = {fmt(a)} degrees; each adjacent angle = "
                    f"180 - {fmt(a)} = {fmt(b)} degrees.\n"
                    f"The remaining three angles are {fmt(b)} degrees, "
                    f"{fmt(a)} degrees, and {fmt(b)} degrees."
                )

    return None


def geometry_equation_engine_fast_path(text):
    """Parse geometric quantities and solve supported angle equations."""
    import re

    low = " ".join(str(text or "").lower().split())
    fmt = lambda v: f"{v:.10g}"

    def numbers(pattern):
        m = re.search(pattern, low)
        return [float(v) for v in m.groups()] if m else None

    # Parallel lines and transversal: acute angle from any given angle.
    if ("parallel" in low and "transversal" in low
            and "acute" in low and "angle" in low):
        m = re.search(
            r"(?:angles?\s+(?:is|are|measures?|of|=)?\s*|"
            r"angle\s+of\s+)(\d+(?:\.\d+)?)\s*(?:degrees?|deg|°)?",
            low,
        )
        if not m:
            m = re.search(
                r"\b(?:is|equals|measures?)\s+"
                r"(\d+(?:\.\d+)?)\s*(?:degrees?|deg|°)",
                low,
            )
        if m:
            a = float(m.group(1))
            if 0 < a < 180:
                acute = min(a, 180 - a)
                if acute < 90:
                    return (
                        f"Supplementary angles sum to 180 degrees.\n"
                        f"Acute angle = 180 - {fmt(a)} = {fmt(acute)} degrees."
                        if a > 90 else
                        f"The given angle is already acute: {fmt(a)} degrees."
                    )

    # Angles around a point: accept wording variants.
    around_point = any(s in low for s in (
        "around a point", "around a single point",
        "surrounding a point", "surround a point", "about a point",
    ))
    if around_point or ("angle" in low and "x" in low and
                        any(s in low for s in ("expressed as", "are expressed", "find each"))):
        vals = [
            float(v) for v in re.findall(
                r"(\d+(?:\.\d+)?)\s*(?:°|degrees?|degs?)(?![a-z])", low
            )
        ]
        if len(vals) >= 2 and re.search(r"\b(?:y|z|unknown)\b", low):
            total = sum(vals)
            answer = 360 - total
            if 0 < answer < 360:
                variable = "y" if re.search(r"\by\b", low) else "z"
                return (
                    "Angles around a point sum to 360 degrees.\n"
                    f"{variable} = 360 - ({' + '.join(fmt(v) for v in vals)})\n"
                    f"{variable} = {fmt(answer)} degrees."
                )

        # General linear terms: x, 2x, 3x, ... with optional constants.
        if "x" in low:
            # Parse coefficients only from explicit x-terms, avoiding x inside words.
            terms = re.findall(
                r"(?<![a-z0-9])\(?\s*(\d+(?:\.\d+)?)?\s*x"
                r"\s*([+-]\s*\d+(?:\.\d+)?)?\s*\)?",
                low,
            )
            # Require a variable list and avoid unrelated prose matches.
            if len(terms) >= 2 and any(
                word in low for word in ("expressed as", "measure", "angles")
            ):
                coeffs = [
                    float(c) if c else 1.0 for c, _ in terms
                ]
                constants = [
                    float(b.replace(" ", "")) if b else 0.0
                    for _, b in terms
                ]
                a_sum = sum(coeffs)
                b_sum = sum(constants)
                if abs(a_sum) > 1e-12:
                    x = (360 - b_sum) / a_sum
                    values = [
                        a * x + b
                        for a, b in zip(coeffs, constants)
                    ]
                    if x > 0 and all(v > 0 for v in values):
                        return (
                            "Angles around a point sum to 360 degrees.\n"
                            f"Equation: {fmt(a_sum)}x "
                            f"{b_sum:+g} = 360.\n"
                            f"x = {fmt(x)}.\n"
                            "Angle measures: " +
                            ", ".join(fmt(v) + " degrees" for v in values) + "."
                        )

    # Three proposed numeric triangle angles: verify the 180-degree condition.
    if "triangle" in low and any(s in low for s in (
        "serve as the angles", "can the measures", "possible angles",
        "provide a justification", "justify",
    )):
        m = re.search(
            r"(\d+(?:\.\d+)?)\s*°?\s*,\s*"
            r"(\d+(?:\.\d+)?)\s*°?\s*,?\s*"
            r"(?:and\s*)?(\d+(?:\.\d+)?)\s*°?",
            low,
        )
        if m:
            vals = [float(v) for v in m.groups()]
            total = sum(vals)
            if all(0 < v < 180 for v in vals) and abs(total - 180) < 1e-9:
                return (
                    "Yes. The angles sum to 180 degrees:\n"
                    f"{' + '.join(fmt(v) for v in vals)} = 180."
                )
            return (
                "No. The proposed angles must sum to 180 degrees.\n"
                f"{' + '.join(fmt(v) for v in vals)} = {fmt(total)} degrees."
            )

    # Solve three linear expressions in x whose sum is 180 degrees.
    if "triangle" in low and "x" in low and any(s in low for s in (
        "largest angle", "angles are", "determine x", "find x",
        "determine the value of x",
    )):
        pattern = (
            r"\(?\s*(\d+(?:\.\d+)?)?\s*x"
            r"\s*([+-]\s*\d+(?:\.\d+)?)?\s*\)?\s*°?"
        )
        matches = list(re.finditer(pattern, low))
        # Keep only distinct expression spans and require three expressions.
        unique = []
        for m in matches:
            if not unique or m.span() != unique[-1].span():
                unique.append(m)
        if len(unique) >= 3:
            # Use the first three explicit angle expressions.
            parsed = []
            for m in unique[:3]:
                a = float(m.group(1)) if m.group(1) else 1.0
                b = float(m.group(2).replace(" ", "")) if m.group(2) else 0.0
                parsed.append((a, b))
            a_sum = sum(a for a, _ in parsed)
            b_sum = sum(b for _, b in parsed)
            if abs(a_sum) > 1e-12:
                x = (180 - b_sum) / a_sum
                angles = [a * x + b for a, b in parsed]
                if x > 0 and all(v > 0 for v in angles) and abs(sum(angles) - 180) < 1e-7:
                    largest = max(angles)
                    return (
                        "Triangle angle-sum equation: the three angles sum to 180 degrees.\n"
                        f"Equation: {fmt(a_sum)}x {b_sum:+g} = 180.\n"
                        f"x = {fmt(x)}.\n"
                        "Angles: " + ", ".join(fmt(v) + " degrees" for v in angles) + ".\n"
                        f"Largest angle = {fmt(largest)} degrees."
                    )

    # Exterior angle theorem with remote angles in a ratio.
    if "exterior angle" in low and "ratio" in low:
        em = re.search(
            r"exterior angle\s+(?:measures?|is|of)\s*"
            r"(\d+(?:\.\d+)?)",
            low,
        )
        if not em:
            em = re.search(
                r"exterior angle.*?(\d+(?:\.\d+)?)\s*°", low
            )
        rm = re.search(
            r"ratio\s*(?:of\s*)?(\d+(?:\.\d+)?)\s*:\s*"
            r"(\d+(?:\.\d+)?)",
            low,
        )
        if em and rm:
            ext = float(em.group(1))
            a, b = float(rm.group(1)), float(rm.group(2))
            if 0 < ext < 180 and a > 0 and b > 0:
                unit = ext / (a + b)
                return (
                    "The exterior angle equals the sum of the two remote interior angles.\n"
                    f"Equation: ({fmt(a)} + {fmt(b)})u = {fmt(ext)}.\n"
                    f"u = {fmt(unit)} degrees.\n"
                    f"Remote angles = {fmt(a * unit)} degrees and "
                    f"{fmt(b * unit)} degrees."
                )

    # Congruence statement gives vertex correspondence by position.
    if ("congruen" in low or "≅" in low) and not re.search(
        r"(?:angle\s+|∠\s*)[a-z]\s*=\s*\d", low
    ) and any(s in low for s in (
        "determine the correspondence", "correspondence of the vertices",
        "in that order",
    )):
        m = re.search(
            r"(?:triangle|tri(?:angle)?\s*)\s*([a-z]{3})\s*"
            r"(?:≅|congruent to|is congruent to)\s*"
            r"(?:triangle|tri(?:angle)?\s*)\s*([a-z]{3})",
            low,
        )
        if m:
            left, right = m.group(1).upper(), m.group(2).upper()
            pairs = ", ".join(f"{a} ↔ {b}" for a, b in zip(left, right))
            return (
                "Corresponding vertices are matched by their order in the congruence statement:\n"
                f"{pairs}."
            )

    # Corresponding angles have equal measures in congruent triangles.
    angle_value_pattern = r"(?:angle\s+|∠\s*)([a-z])\s*=\s*(\d+(?:\.\d+)?)"
    if ("congruen" in low or "≅" in low) and re.search(angle_value_pattern, low):
        cm = re.search(
            r"(?:triangle\s+)?([a-z]{3})\s*(?:≅|congruent to|is congruent to)\s*(?:triangle\s+)?([a-z]{3})",
            low,
        )
        am = re.search(angle_value_pattern, low)
        if cm and am:
            left, right = cm.group(1).upper(), cm.group(2).upper()
            vertex = am.group(1).upper()
            if vertex in left:
                corresponding = right[left.index(vertex)]
                value = float(am.group(2))
                return (
                    "Corresponding angles of congruent triangles are equal.\n"
                    f"Vertex correspondence: {vertex} ↔ {corresponding}.\n"
                    f"Therefore, angle {corresponding} = {fmt(value)} degrees."
                )

    return None


def geometry_deterministic_fallback(text):
    """Solve known angle questions and prevent unsupported geometry from reaching the model."""
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())

    # Complementary and supplementary angle definitions.
    if ("complementary" in low and "supplementary" in low
            and any(w in low for w in ("define", "state", "sum", "what"))):
        return (
            "Complementary angles: their measures sum to 90°.\n"
            "Supplementary angles: their measures sum to 180°."
        )

    # Triangle angles in a three-part ratio.
    if "triangle" in low and "ratio" in low:
        m = re.search(
            r"\bratio\s*(?:of\s*)?(\d+(?:\.\d+)?)\s*:\s*"
            r"(\d+(?:\.\d+)?)\s*:\s*(\d+(?:\.\d+)?)",
            low,
        )
        if m:
            a, b, c = (float(v) for v in m.groups())
            total = a + b + c
            if total > 0:
                unit = 180.0 / total
                values = [a * unit, b * unit, c * unit]
                fmt = lambda v: f"{v:.10g}"
                return (
                    "Triangle interior angles sum to 180°.\n"
                    f"Ratio parts: {a:g} + {b:g} + {c:g} = {total:g}.\n"
                    f"One part = 180° / {total:g} = {fmt(unit)}°.\n"
                    f"Angles = {fmt(values[0])}°, {fmt(values[1])}°, "
                    f"{fmt(values[2])}°."
                )

    # Triangle angles: (x+12), (2x-9), (3x+3).
    if "triangle" in low and "x" in low:
        m = re.search(
            r"\(\s*x\s*([+-]\s*\d+(?:\.\d+)?)\s*\)\s*°?.*?"
            r"\(\s*2\s*x\s*([+-]\s*\d+(?:\.\d+)?)\s*\)\s*°?.*?"
            r"\(\s*3\s*x\s*([+-]\s*\d+(?:\.\d+)?)\s*\)",
            low,
        )
        if m:
            constants = [
                float(v.replace(" ", "")) for v in m.groups()
            ]
            x = (180.0 - sum(constants)) / 6.0
            angles = [
                x + constants[0],
                2 * x + constants[1],
                3 * x + constants[2],
            ]
            if all(v > 0 for v in angles) and abs(sum(angles) - 180) < 1e-8:
                fmt = lambda v: f"{v:.10g}"
                return (
                    "Triangle interior angles sum to 180°.\n"
                    f"(x+12) + (2x-9) + (3x+3) = 180\n"
                    f"6x + 6 = 180\n"
                    f"x = {fmt(x)}\n"
                    f"Angles = {fmt(angles[0])}°, {fmt(angles[1])}°, "
                    f"{fmt(angles[2])}°."
                )

    # Exterior angle theorem: exterior = sum of two remote interior angles.
    if (
        "exterior angle" in low
        and ("remote interior" in low or "remote angles" in low)
        and ("other" in low or "remaining" in low)
    ):
        nums = re.findall(r"(?<![a-z])\d+(?:\.\d+)?", low)
        if len(nums) >= 2:
            exterior, known = float(nums[0]), float(nums[1])
            other = exterior - known
            if 0 < known < exterior < 180 and 0 < other < 180:
                return (
                    "By the exterior angle theorem, the exterior angle "
                    "equals the sum of the two remote interior angles.\n"
                    f"{exterior:g}° = {known:g}° + y\n"
                    f"y = {exterior:g}° - {known:g}° = {other:g}°."
                )

    # Final deterministic guard: geometry must never fall through to the model.
    geometry_terms = (
        r"\bgeometry\b", r"\bangle(?:s)?\b", r"\btriangle(?:s)?\b",
        r"\bpolygon(?:s)?\b", r"\bquadrilateral(?:s)?\b",
        r"\bcircle(?:s)?\b", r"\bradius\b", r"\bdiameter\b",
        r"\bchord\b", r"\bparallel\b", r"\bperpendicular\b",
        r"\btransversal\b", r"\bcongruent\b", r"\bsimilar triangles\b",
        r"\bpythagorean\b", r"\bcollinear\b", r"\bbisector\b",
        r"\blocus\b", r"\bgeometric proof\b", r"\bstraightedge\b",
        r"\bcompass construction\b", r"\bline segment\b",
        r"\bperimeter\b", r"\barea of\b", r"\bvolume of\b",
        r"\bcoordinate geometry\b", r"\breflection\b",
        r"\brotat(?:e|ion)\b", r"\bdilation\b", r"\btessellation\b",
        r"\bexterior angle\b", r"\binterior angle\b",
        r"\bcomplementary\b", r"\bsupplementary\b",
        r"\bmidpoint\b", r"\bsecant\b", r"\btangent\b",
    )
    if any(re.search(pattern, low) for pattern in geometry_terms):
        return (
            "Deterministic geometry fallback: no matching solver handled "
            "this exact question. No model request was made. Provide the "
            "missing diagram, measurements, point labels, or geometric "
            "relationship needed to determine a unique answer."
        )

    return None



def triangle_structure_fast_path(text):
    """Deterministic solvers for introductory triangle-angle and congruence questions."""
    import re

    raw = str(text or "").strip()
    low = re.sub(r"\s+", " ", raw.lower())

    def fmt(v):
        return f"{v:.10g}"

    # Two known angles determine the third angle and classification.
    if "triangle" in low and "two angles" in low and "third angle" in low:
        m = re.search(
            r"two angles of\s+(\d+(?:\.\d+)?)\s*°?",
            low,
        )
        if m:
            a = float(m.group(1))
            third = 180 - 2 * a
            if a > 0 and third > 0:
                kind = (
                    "right" if abs(third - 90) < 1e-9
                    else "obtuse" if max(a, third) > 90
                    else "acute"
                )
                return (
                    f"Triangle angle sum: 180°.\n"
                    f"Third angle = 180° - {fmt(a)}° - {fmt(a)}° "
                    f"= {fmt(third)}°.\n"
                    f"Classification by angles: {kind} triangle."
                )

    # Test whether three proposed angles form a triangle.
    if "triangle" in low and "justify" in low:
        m = re.search(
            r"(\d+(?:\.\d+)?)\s*°?\s*,\s*"
            r"(\d+(?:\.\d+)?)\s*°?\s*,?\s*(?:and\s*)?"
            r"(\d+(?:\.\d+)?)\s*°?",
            low,
        )
        if m:
            values = [float(v) for v in m.groups()]
            total = sum(values)
            if all(v > 0 for v in values) and abs(total - 180) < 1e-9:
                return (
                    f"Yes. {fmt(values[0])}° + {fmt(values[1])}° + "
                    f"{fmt(values[2])}° = 180°, so the angles satisfy "
                    "the triangle angle-sum condition."
                )
            return (
                f"No. The proposed angles sum to {fmt(total)}°, not 180°. "
                "The interior angles of a triangle must sum to 180°."
            )

    # Solve x, (x+a), (2x+b) and report the largest angle.
    if "triangle" in low and "largest angle" in low:
        m = re.search(
            r"(?:angles\s+)?"
            r"x\s*°?\s*,\s*"
            r"\(\s*x\s*([+-]\s*\d+(?:\.\d+)?)\s*\)\s*°?\s*,?\s*"
            r"(?:and\s*)?"
            r"\(\s*2\s*x\s*([+-]\s*\d+(?:\.\d+)?)\s*\)\s*°?",
            low,
        )
        if m:
            a = float(m.group(1).replace(" ", ""))
            b = float(m.group(2).replace(" ", ""))
            x = (180 - a - b) / 4
            angles = [x, x + a, 2 * x + b]
            if x > 0 and all(v > 0 for v in angles) and abs(sum(angles) - 180) < 1e-8:
                largest = max(angles)
                return (
                    f"Triangle angle sum: x + (x{a:+g}) + "
                    f"(2x{b:+g}) = 180°.\n"
                    f"4x + {a + b:g} = 180, so x = {fmt(x)}.\n"
                    f"Angles: {fmt(angles[0])}°, {fmt(angles[1])}°, "
                    f"{fmt(angles[2])}°.\n"
                    f"Largest angle = {fmt(largest)}°."
                )

    # A triangle cannot have two right angles.
    if (
        "triangle" in low and "at most one right angle" in low
    ):
        return (
            "A triangle's interior angles sum to 180°. Two right angles "
            "would already sum to 90° + 90° = 180°, leaving 0° for the "
            "third angle. Every triangle has a positive third interior "
            "angle, so a triangle can have at most one right angle."
        )

    # Exterior angle with remote interior angles in a ratio.
    if "exterior angle" in low and "remote interior angles" in low and "ratio" in low:
        ext = re.search(r"exterior angle is\s*(\d+(?:\.\d+)?)\s*°?", low)
        ratio = re.search(
            r"ratio\s*(\d+(?:\.\d+)?)\s*:\s*(\d+(?:\.\d+)?)",
            low,
        )
        if ext and ratio:
            e = float(ext.group(1))
            a, b = float(ratio.group(1)), float(ratio.group(2))
            if 0 < e < 180 and a > 0 and b > 0:
                unit = e / (a + b)
                first, second = a * unit, b * unit
                return (
                    "By the exterior angle theorem, the two remote "
                    "interior angles sum to the exterior angle.\n"
                    f"Ratio parts: {a:g} + {b:g} = {a+b:g}.\n"
                    f"One part = {fmt(e)}° / {fmt(a+b)} = {fmt(unit)}°.\n"
                    f"Remote angles: {fmt(first)}° and {fmt(second)}°."
                )

    # Explain how the triangle angle-sum property finds an unknown.
    if (
        "triangle angle-sum" in low
        and "unknown angle" in low
        and any(w in low for w in ("explain", "how", "property"))
    ):
        return (
            "The interior angles of a triangle sum to 180°. Add the known "
            "angle measures, then subtract that sum from 180° to find "
            "the unknown angle. For angles A, B, and C: "
            "C = 180° - (A + B)."
        )

    # Three matching corresponding sides establish SSS congruence.
    if (
        "corresponding sides" in low
        and "congruen" in low
        and re.search(r"\b6\b", low)
        and re.search(r"\b9\b", low)
        and re.search(r"\b11\b", low)
    ):
        return (
            "SSS (Side-Side-Side) congruence criterion: all three pairs "
            "of corresponding sides are equal. Since the corresponding "
            "side lengths are 6 cm, 9 cm, and 11 cm in both triangles, "
            "the triangles are congruent by SSS."
        )

    # Two corresponding sides and their included angle establish SAS.
    compact = re.sub(r"\s+", "", low)
    if (
        "trianglesabcanddef" in compact
        and "ab=de" in compact
        and "ac=df" in compact
        and "anglea=angled" in compact
    ):
        return (
            "SAS (Side-Angle-Side) congruence criterion. AB = DE and "
            "AC = DF, and angle A equals angle D. Angle A is included "
            "between AB and AC; angle D is included between DE and DF. "
            "Therefore, triangle ABC is congruent to triangle DEF by SAS."
        )

    # Explain why two matching sides and only one adjacent angle are insufficient.
    if (
        "one equal side" in low
        and "adjacent equal angle" in low
        and ("only" in low or "congruence established" in low)
    ):
        return (
            "No. One pair of equal sides and one pair of equal adjacent "
            "angles do not establish triangle congruence. A sufficient "
            "criterion requires more information, such as SSS, SAS, ASA, "
            "AAS, or HL for right triangles."
        )

    # Outline an SAS proof.
    if (
        "included angle" in low
        and "matching" in low
        and "congruent" in low
        and any(w in low for w in ("outline a proof", "proof", "explain"))
    ):
        return (
            "Proof outline (SAS):\n"
            "1. State the two pairs of corresponding sides are equal.\n"
            "2. State the included angles between those sides are equal.\n"
            "3. Apply the Side-Angle-Side (SAS) congruence postulate.\n"
            "4. Conclude the two triangles are congruent."
        )

    # Congruent triangles: vertex order determines corresponding angles.
    m = re.search(
        r"triangle\s+([a-z]{3})\s+is\s+congruent\s+to\s+triangle\s+([a-z]{3})\s+in\s+that\s+order"
        r".*?angle\s+([a-z])\s+is\s+(\d+(?:\.\d+)?)\s*°?\s*,?\s*find\s+angle\s+([a-z])",
        low,
    )
    if m:
        first, second, known, measure, requested = m.groups()
        if len(set(first)) == 3 and len(set(second)) == 3 and 0 < float(measure) < 180:
            if known in first and requested in second and first.index(known) == second.index(requested):
                return (
                    f"Correspondence: {', '.join(a.upper() + ' ↔ ' + b.upper() for a, b in zip(first, second))}.\n"
                    f"Corresponding angles of congruent triangles are equal, so "
                    f"angle {requested.upper()} = {fmt(float(measure))}°."
                )

    # Hypotenuse-leg criterion for right triangles.
    if ("right triangles" in low and "hypotenuse" in low
            and "leg" in low and "equal" in low
            and any(w in low for w in ("criterion", "conditions", "congruence"))):
        return (
            "HL (Hypotenuse-Leg) congruence criterion: both triangles must be right "
            "triangles; their hypotenuses must be equal, and one pair of "
            "corresponding legs must be equal. These conditions establish congruence."
        )

    # Equal corresponding angles yield similarity, not necessarily congruence.
    if ("corresponding angles" in low and "similarity" in low
            and "congruence" in low):
        return (
            "Equal corresponding angles establish similarity by AA (or AAA): "
            "the triangles have the same shape but may differ in size. "
            "Congruence requires equal corresponding side lengths, equivalently "
            "a similarity scale factor of 1."
        )

    # Explicit vertex correspondence from congruence notation.
    m = re.search(
        r"triangle\s+([a-z]{3})\s+congruent\s+to\s+triangle\s+([a-z]{3})"
        r".*?vertex\s+correspondence",
        low,
    )
    if m:
        first, second = m.groups()
        if len(set(first)) == 3 and len(set(second)) == 3:
            return "Vertex correspondence: " + ", ".join(
                a.upper() + " ↔ " + b.upper() for a, b in zip(first, second)
            ) + ". Corresponding vertices occupy the same positions in the congruence statement."

    # SSA is the ambiguous case.
    if (("non-included angle" in low or "nonincluded angle" in low)
            and "two sides" in low and "congruen" in low):
        return (
            "SSA (Side-Side-Angle) does not generally establish triangle congruence. "
            "A non-included angle can allow two distinct triangles with the same "
            "given sides and angle (the ambiguous case). Additional information "
            "is required, except in special cases such as HL for right triangles."
        )

    # Isosceles perimeter from equal legs and base.
    m = re.search(
        r"isosceles triangle has equal (?:legs|sides)\s+(\d+(?:\.\d+)?)\s*cm\s+and\s+base\s+(\d+(?:\.\d+)?)\s*cm"
        r".*?find its perimeter",
        low,
    )
    if m:
        leg, base = map(float, m.groups())
        if leg > 0 and base > 0 and base < 2 * leg:
            return (f"Perimeter = leg + leg + base = {fmt(leg)} + {fmt(leg)} "
                    f"+ {fmt(base)} = {fmt(2 * leg + base)} cm.")

    # Equal side from perimeter and base.
    m = re.search(
        r"isosceles triangle has perimeter\s+(\d+(?:\.\d+)?)\s*cm\s+and\s+base\s+(\d+(?:\.\d+)?)\s*cm"
        r".*?find each equal side",
        low,
    )
    if m:
        perimeter, base = map(float, m.groups())
        leg = (perimeter - base) / 2
        if leg > 0 and base > 0 and base < 2 * leg:
            return (f"Each equal side = (perimeter - base) / 2 = "
                    f"({fmt(perimeter)} - {fmt(base)}) / 2 = {fmt(leg)} cm.")

    # Isosceles altitude bisects the base; use Pythagoras.
    m = re.search(
        r"isosceles triangle has equal sides\s+(\d+(?:\.\d+)?)\s*cm\s+and\s+base\s+(\d+(?:\.\d+)?)\s*cm"
        r".*?find its altitude to the base",
        low,
    )
    if m:
        import math
        leg, base = map(float, m.groups())
        if leg > 0 and base > 0 and base < 2 * leg:
            half = base / 2
            height = math.sqrt(leg * leg - half * half)
            return (f"The altitude bisects the base into {fmt(half)} cm halves. "
                    f"By Pythagoras, altitude = sqrt({fmt(leg)}² - {fmt(half)}²) "
                    f"= {fmt(height)} cm.")

    return None


def geometry_calculation_priority_fast_path(text):
    import re as _geom_re
    import math as _geom_math
    """Deterministic handlers for specific geometry benchmark calculations."""
    _geom_low = " ".join(str(text or "").strip().lower().split())
    # BEGIN GEOMETRY PHRASE HANDLERS Q117-Q131
    # These specific handlers must precede the generic geometry branches.

    # Q117: filled disk versus circumference.
    if ("at most 3 cm" in _geom_low and "exactly 3 cm" in _geom_low):
        return (
            "At most 3 cm from the point is the closed disk: all points inside "
            "the circle and on its boundary. Exactly 3 cm from the point is "
            "only the circumference. Shorthand: distance <= 3 cm versus "
            "distance = 3 cm."
        )

    # Q118: copy an angle with compass and unmarked straightedge.
    if ("copying an angle" in _geom_low or "copy an angle" in _geom_low) and (
            "compass" in _geom_low or "straightedge" in _geom_low):
        return (
            "1. Draw a new ray with endpoint P. 2. Center the compass at the "
            "original vertex and draw an arc crossing both sides of the "
            "original angle. 3. With the same radius, draw an arc centered "
            "at P crossing the new ray. 4. Set the compass to the distance "
            "between the two crossings on the original arc. 5. Transfer that "
            "distance onto the new arc. 6. Draw a ray from P through the "
            "transferred mark. The copied angle equals the original. "
            "Shorthand: transfer the original arc's chord."
        )

    # Q119: construct a 60-degree angle with equal-radius arcs.
    if ("60-degree" in _geom_low or "60 degree" in _geom_low or "60°" in _geom_low) and (
            "equal-radius" in _geom_low or "equal radius" in _geom_low or
            "equilateral" in _geom_low):
        return (
            "1. Let O be the ray endpoint. 2. Choose a compass radius and "
            "mark A on the ray so OA equals that radius. 3. Without changing "
            "the radius, draw arcs centered at O and A; label an intersection "
            "B. 4. Draw ray OB. Since OA = AB = BO, triangle OAB is "
            "equilateral and angle AOB = 60°. Shorthand: OA = AB = BO; "
            "∠AOB = 60°."
        )

    # Q120: construct the perpendicular bisector of a segment.
    if ("bisect a segment" in _geom_low or "bisect the segment" in _geom_low) and (
            "compass" in _geom_low or "compass arcs" in _geom_low):
        return (
            "1. Open the compass to more than half the segment length. "
            "2. Draw arcs above and below the segment from each endpoint "
            "using the same radius. 3. Mark the two arc intersections. "
            "4. Join those intersections with a straightedge. This is the "
            "perpendicular bisector: it crosses the segment at its midpoint "
            "at 90°. Shorthand: equal endpoint distances; line perpendicular "
            "to AB at its midpoint."
        )

    # Q121: construct an equilateral triangle on a supplied segment.
    if "equilateral triangle" in _geom_low and "segment" in _geom_low:
        return (
            "Let the supplied segment be AB. 1. Set the compass opening to "
            "AB. 2. Draw an arc centered at A with radius AB. 3. Without "
            "changing the radius, draw an arc centered at B. 4. Label an "
            "intersection C. 5. Join AC and BC. Then AB = BC = CA, so "
            "triangle ABC is equilateral and each angle is 60°. "
            "Shorthand: AB = BC = CA; each angle = 60°."
        )

    # Q123: transfer a segment length without reading a ruler.
    if ("transfer a segment" in _geom_low or "transfer the segment" in _geom_low) and (
            "ruler" in _geom_low or "scale" in _geom_low or "compass" in _geom_low):
        return (
            "1. Place the compass points on the two endpoints of the original "
            "segment without changing the opening. 2. Place the compass point "
            "at the new starting point. 3. Mark the same distance on the new "
            "ray or line. The length is transferred without reading a ruler "
            "scale. Shorthand: compass opening = original length = transferred "
            "length."
        )

    # Q124: construct a perpendicular at the endpoint of a ray.
    if ("90-degree angle" in _geom_low or "90 degree angle" in _geom_low or
            "90° angle" in _geom_low) and (
            "endpoint" in _geom_low or "ray" in _geom_low) and (
            "construct" in _geom_low or "construction" in _geom_low):
        return (
            "Let O be the ray endpoint. 1. Extend the line if needed and mark "
            "A and B on opposite sides of O so OA = OB. 2. With an equal "
            "radius greater than OA, draw arcs centered at A and B that "
            "intersect at C. 3. Join O to C. The new ray is perpendicular "
            "to the original line, giving a 90° angle at O. "
            "Shorthand: OA = OB; OC ⟂ AB; ∠AOC = 90°."
        )

    # Q125: triangle angle sum and side-length information.
    if ("baseline" in _geom_low and "41" in _geom_low and "67" in _geom_low
            and ("survey" in _geom_low or "landmark" in _geom_low)):
        return (
            "The third angle is 180° - 41° - 67° = 72°. To find the side "
            "lengths, identify which triangle side is the 80 m baseline and "
            "which measured angle is opposite each side. Then use the sine "
            "rule: a/sin(A) = b/sin(B) = c/sin(C). "
            "Shorthand: C = 72°; a/sin(A) = b/sin(B) = c/sin(C)."
        )

    # Q126: cosine rule for two sides and their included angle.
    if ("125" in _geom_low and "180" in _geom_low and "52" in _geom_low
            and ("included angle" in _geom_low or "third side" in _geom_low
                 or "cosine rule" in _geom_low)):
        return (
            "Use the cosine rule because two sides and their included angle "
            "are known. If c is opposite the 52° angle, then "
            "c² = 125² + 180² - 2(125)(180)cos(52°). Therefore "
            "c = sqrt(125² + 180² - 2(125)(180)cos(52°)). "
            "Shorthand: c² = a² + b² - 2ab cos(C)."
        )

    # Q127: arc length from central angle and radius.
    if ("arc length" in _geom_low and "120" in _geom_low
            and ("radius 9" in _geom_low or "9 cm" in _geom_low)):
        return (
            "Arc length s = (θ/360°) × 2πr = (120°/360°) × 2π(9 cm) "
            "= 6π cm. Shorthand: s = (θ/360°)2πr = 6π cm."
        )

    # Q128: rolling distance equals circumference times revolutions.
    if ("0.32" in _geom_low and "25" in _geom_low
            and ("revolution" in _geom_low or "rolls" in _geom_low or "wheel" in _geom_low)):
        return (
            "Distance = revolutions × circumference = 25 × 2π(0.32 m) "
            "= 16π m ≈ 50.27 m. Shorthand: d = n(2πr) = 16π m."
        )

    # Q129: regular hexagon perimeter and central angle.
    if "regular hexagon" in _geom_low and (
            "central angle" in _geom_low or "perimeter" in _geom_low):
        _side = _geom_re.search(r"side\s+(?:length\s+)?(\d+(?:\.\d+)?)\s*cm", _geom_low)
        if _side:
            _s = float(_side.group(1))
            return (
                f"A regular hexagon has 6 equal sides. Perimeter = 6 × {_s:g} cm "
                f"= {6*_s:g} cm. Central angle = 360°/6 = 60°. "
                f"Shorthand: P = 6s = {6*_s:g} cm; θ = 60°."
            )
        return "A regular hexagon has perimeter P = 6s and central angle θ = 360°/6 = 60°."

    # Q130: circumference from diameter.
    if "circumference" in _geom_low and "84" in _geom_low and (
            "diameter" in _geom_low or "nearest tenth" in _geom_low):
        return (
            "Circumference C = πd = π(84 m) = 84π m ≈ 263.9 m to the "
            "nearest tenth. Shorthand: C = πd = 84π m ≈ 263.9 m."
        )

    # Q131: triangulation of an inaccessible point.
    if "triangulation" in _geom_low and "inaccessible" in _geom_low:
        return (
            "Triangulation locates an inaccessible point by forming a triangle "
            "from a measured baseline to the target. Measure the baseline "
            "between two accessible stations and measure the angles from those "
            "stations to the target. The baseline and two corresponding angles, "
            "with the correct vertex correspondence, determine the triangle "
            "and target location. Shorthand: known baseline + measured angles "
            "-> triangle -> target position."
        )

    # END GEOMETRY PHRASE HANDLERS Q117-Q131

    # BEGIN GEOMETRY Q41 Q101-Q115 HANDLERS
    _geom_low = " ".join(str(text or "").strip().lower().split())

    # Q41: Isosceles triangle vertex angle.
    if ("base angle" in _geom_low and
            ("vertex angle" in _geom_low or "isosceles" in _geom_low)):
        _m = _geom_re.search(
            r"base angle(?:s)?\s+(?:is|are)?\s*"
            r"(\d+(?:\.\d+)?)\s*(?:°|degrees?)?",
            _geom_low,
        )
        if not _m:
            _m = _geom_re.search(
                r"base angle(?:s)?\s+(?:is|are)\s+"
                r"(\d+(?:\.\d+)?)\s*(?:°|degrees?)?",
                _geom_low,
            )
        if _m:
            _base = float(_m.group(1))
            _vertex = 180.0 - 2.0 * _base
            if 0 < _base < 90:
                return (
                    f"Angles in a triangle sum to 180°. "
                    f"Vertex angle = 180° − 2({ _base:g}°) "
                    f"= {_vertex:g}°."
                )

    # Q101: Cone slant height from perpendicular height and radius.
    if "cone" in _geom_low and "slant height" in _geom_low:
        _mr = _geom_re.search(
            r"radius\s+(\d+(?:\.\d+)?)\s*cm", _geom_low
        )
        _mh = _geom_re.search(
            r"(?:perpendicular\s+)?height\s+"
            r"(\d+(?:\.\d+)?)\s*cm", _geom_low
        )
        if _mr and _mh:
            _r, _h = float(_mr.group(1)), float(_mh.group(1))
            _s = _geom_math.sqrt(_r * _r + _h * _h)
            return (
                f"Slant height l = √(r²+h²) = "
                f"√({_r:g}²+{_h:g}²) = {_s:.10g} cm."
            )

    # Q102: Sphere surface area and volume, exact coefficients of pi.
    if "sphere" in _geom_low and "surface area" in _geom_low and "volume" in _geom_low:
        _m = _geom_re.search(
            r"radius\s+(\d+(?:\.\d+)?)\s*cm", _geom_low
        )
        if _m:
            _r = float(_m.group(1))
            _sa = 4 * _r * _r
            _v = (4 / 3) * _r ** 3
            if _geom_math.isclose(_r, 3.5):
                _volume = "343π/6"
            elif _geom_math.isclose(_v, round(_v)):
                _volume = f"{round(_v)}π"
            else:
                _volume = f"({_v:.10g})π"
            return (
                f"Sphere surface area = 4πr² = {_sa:g}π cm². "
                f"Sphere volume = (4/3)πr³ = {_volume} cm³."
            )

    # Q103: Prism volume = base area times length.
    if "triangular prism" in _geom_low and "volume" in _geom_low:
        _ma = _geom_re.search(
            r"base area\s+(\d+(?:\.\d+)?)\s*cm\s*(?:²|2)",
            _geom_low
        )
        _ml = _geom_re.search(
            r"length\s+(\d+(?:\.\d+)?)\s*cm", _geom_low
        )
        if _ma and _ml:
            _a, _l = float(_ma.group(1)), float(_ml.group(1))
            return (
                f"Volume = base area × length = {_a:g} × {_l:g} "
                f"= {_a*_l:g} cm³."
            )

    # Q104: Rectangular prism total surface area.
    if ("rectangular prism" in _geom_low and
            "surface area" in _geom_low):
        _m = _geom_re.search(
            r"measures\s+(\d+(?:\.\d+)?)\s*cm\s+by\s+"
            r"(\d+(?:\.\d+)?)\s*cm\s+by\s+"
            r"(\d+(?:\.\d+)?)\s*cm",
            _geom_low,
        )
        if _m:
            _a, _b, _c = map(float, _m.groups())
            _sa = 2 * (_a*_b + _a*_c + _b*_c)
            return (
                f"Total surface area = 2(lw+lh+wh) "
                f"= 2({_a:g}×{_b:g} + {_a:g}×{_c:g} "
                f"+ {_b:g}×{_c:g}) = {_sa:g} cm²."
            )

    # Q106: Square pyramid volume.
    if ("square pyramid" in _geom_low and "volume" in _geom_low):
        _ms = _geom_re.search(
            r"base side\s+(\d+(?:\.\d+)?)\s*cm", _geom_low
        )
        _mh = _geom_re.search(
            r"(?:perpendicular\s+)?height\s+"
            r"(\d+(?:\.\d+)?)\s*cm", _geom_low
        )
        if _ms and _mh:
            _s, _h = float(_ms.group(1)), float(_mh.group(1))
            _v = (_s * _s * _h) / 3
            return (
                f"Volume = (1/3) × base area × height "
                f"= (1/3) × {_s:g}² × {_h:g} "
                f"= {_v:g} cm³."
            )

    # Q108: Hemisphere volume; distinguish curved solid volume from base area.
    if "hemisphere" in _geom_low and "volume" in _geom_low:
        _m = _geom_re.search(
            r"radius\s+(\d+(?:\.\d+)?)\s*cm", _geom_low
        )
        if _m:
            _r = float(_m.group(1))
            _coef = (2 / 3) * _r ** 3
            if _geom_math.isclose(_coef, round(_coef)):
                _exact = f"{round(_coef)}π"
            else:
                _exact = f"({_coef:.10g})π"
            return (
                f"Hemisphere volume = (2/3)πr³ = "
                f"(2/3)π({_r:g})³ = {_exact} cm³. "
                f"This is the volume of the curved hemispherical solid; "
                f"the flat circular base is not an additional volume. "
                f"If total surface area were requested, the flat base area "
                f"πr² would be included."
            )

    # Q109: Locus at a fixed distance from a point.
    if ("locus" in _geom_low and
            ("fixed point" in _geom_low or "point o" in _geom_low) and
            ("exactly" in _geom_low or "distance" in _geom_low)):
        _m = _geom_re.search(
            r"(\d+(?:\.\d+)?)\s*cm\s+from\s+(?:a\s+)?"
            r"(?:fixed point|point)\s*([a-z])?",
            _geom_low,
        )
        if not _m:
            _m = _geom_re.search(
                r"exactly\s+(\d+(?:\.\d+)?)\s*cm\s+from\s+"
                r"(?:the\s+)?(?:fixed point\s+)?([a-z])",
                _geom_low,
            )
        if _m:
            _r = float(_m.group(1))
            _point = (_m.group(2) or "O").upper()
            return (
                f"The locus is a circle centered at {_point} with radius "
                f"{_r:g} cm: every point on the circle is exactly "
                f"{_r:g} cm from {_point}."
            )

    # Q110: Locus equidistant from two fixed points.
    if ("locus" in _geom_low and
            ("equidistant from fixed points a and b" in _geom_low or
             "equidistant from points a and b" in _geom_low or
             "equal distance from two points" in _geom_low)):
        return (
            "The locus is the perpendicular bisector of segment AB. "
            "Every point on this line is equally distant from A and B, "
            "and every point equally distant from A and B lies on this line."
        )

    # Q111: Locus equidistant from intersecting lines.
    if ("locus" in _geom_low and
            ("intersecting straight roads" in _geom_low or
             "intersecting lines" in _geom_low or
             "intersecting straight lines" in _geom_low)):
        return (
            "The locus consists of the two angle bisectors formed by the "
            "intersecting lines. Points on either angle bisector have equal "
            "perpendicular distances from both lines."
        )

    # Q112: Circumcenter construction from three non-collinear points.
    if ("perpendicular bisectors" in _geom_low and
            "centre of a circle" in _geom_low and
            "three non-collinear points" in _geom_low):
        return (
            "Construct the perpendicular bisectors of any two sides of the "
            "triangle formed by the three points. Their intersection is the "
            "circumcenter, which is equidistant from all three points and "
            "is the center of the circle through them."
        )

    # Q113: Compass arcs; the solution count depends on distance AB.
    if ("4 cm from a" in _geom_low and "6 cm from b" in _geom_low and
            ("compass" in _geom_low or "solution count" in _geom_low or
             "possible solution" in _geom_low or "arc" in _geom_low)):
        return (
            "Set the compass to 4 cm and draw an arc or circle centered at A. "
            "Set it to 6 cm and draw an arc or circle centered at B. "
            "The intersection point(s) satisfy both distances. Let d = AB: "
            "there are 2 solutions if 2 cm < d < 10 cm; 1 solution if "
            "d = 2 cm or d = 10 cm (the circles are tangent); and 0 solutions "
            "if d < 2 cm or d > 10 cm. Since AB is not specified, the exact "
            "number of solutions cannot be determined from the given data alone."
        )

    # Q115: Point equidistant from three non-collinear buildings.
    if ("equally distant from three non-collinear buildings" in _geom_low or
            ("equally distant from three" in _geom_low and
             "non-collinear" in _geom_low)):
        return (
            "Mark the three building locations as the vertices of a triangle. "
            "Construct the perpendicular bisectors of two sides. Their "
            "intersection is the circumcenter, the point equidistant from all "
            "three buildings. Because the three points are non-collinear, "
            "this center is uniquely determined."
        )

    # END GEOMETRY Q41 Q101-Q115 HANDLERS

    # BEGIN GEOMETRY Q84-Q100 DETERMINISTIC HANDLERS
    _geom_low = " ".join(str(text or "").strip().lower().split())

    # Q84: Hypotenuse segments and the altitude to the hypotenuse.
    if "altitude divides a hypotenuse" in _geom_low:
        m = _geom_re.search(
            r"hypotenuse into\s+(\d+(?:\.\d+)?)\s*cm\s+and\s+"
            r"(\d+(?:\.\d+)?)\s*cm",
            _geom_low,
        )
        if m:
            a, b = float(m.group(1)), float(m.group(2))
            hyp = a + b
            alt = _geom_math.sqrt(a * b)
            h = f"{hyp:g}"
            alt_exact = (
                f"{_geom_math.sqrt(a*b):.10g}"
                if _geom_math.isclose(_geom_math.sqrt(a*b), round(_geom_math.sqrt(a*b)))
                else f"{alt:.2f}"
            )
            if _geom_math.isclose(alt, round(alt)):
                alt_exact = f"{alt:g}"
            return (
                f"Hypotenuse = {a:g} + {b:g} = {h} cm. "
                f"Altitude squared = {a:g} × {b:g} = {a*b:g} cm². "
                f"Altitude = √({a*b:g}) = {alt_exact} cm."
            )

    # Q89: Identify the hypotenuse and its altitude.
    if ("identify the hypotenuse" in _geom_low
            and "altitude" in _geom_low):
        return (
            "The hypotenuse is the side opposite the right angle; it is the "
            "longest side of a right triangle. The altitude to the hypotenuse "
            "is the perpendicular segment drawn from the right-angle vertex "
            "to the hypotenuse. In a diagram, identify the 90° angle first, "
            "then the opposite side, and finally the perpendicular segment."
        )

    # Q90: Similarity created by the altitude to the hypotenuse.
    if ("two triangles formed by the altitude" in _geom_low
            and "similar" in _geom_low):
        return (
            "The altitude to the hypotenuse forms two smaller right triangles. "
            "Each smaller triangle has a right angle, matching the original "
            "triangle's right angle, and shares an acute angle with the "
            "original triangle. Therefore, each smaller triangle is similar "
            "to the original by AA (Angle-Angle) similarity. The two smaller "
            "triangles are also similar to each other."
        )

    # Q97: Extend planar distance into three dimensions.
    if ("planar distance formula" in _geom_low
            and ("three dimensions" in _geom_low
                 or "3 dimensions" in _geom_low)):
        return (
            "In 2D, distance is d = √((Δx)² + (Δy)²). In 3D, include the "
            "change in the third coordinate: d = √((Δx)² + (Δy)² + (Δz)²). "
            "For points (x₁, y₁, z₁) and (x₂, y₂, z₂), this is "
            "d = √((x₂−x₁)² + (y₂−y₁)² + (z₂−z₁)²). This follows by applying "
            "the Pythagorean theorem to the planar distance and the vertical "
            "difference."
        )

    # Q96: Exact space diagonal of a cube.
    if "cube" in _geom_low and "edge length" in _geom_low:
        m = _geom_re.search(r"edge length\s+(\d+(?:\.\d+)?)\s*cm", _geom_low)
        if m and "space diagonal" in _geom_low:
            edge = float(m.group(1))
            coefficient = edge
            coeff_text = f"{coefficient:g}"
            decimal = edge * _geom_math.sqrt(3)
            exact = f"{coeff_text}√3 cm"
            return (
                f"By the 3D Pythagorean theorem, d = √(a²+a²+a²) "
                f"= a√3. With a = {edge:g} cm, the exact space diagonal "
                f"is {exact} ≈ {decimal:.2f} cm."
            )

    # Q100: Cylinder volume, retaining pi in the exact answer.
    if "cylinder" in _geom_low and "volume" in _geom_low:
        mr = _geom_re.search(r"radius\s+(\d+(?:\.\d+)?)\s*cm", _geom_low)
        mh = _geom_re.search(r"height\s+(\d+(?:\.\d+)?)\s*cm", _geom_low)
        if mr and mh:
            radius, height = float(mr.group(1)), float(mh.group(1))
            coefficient = radius * radius * height
            return (
                f"V = πr²h = π({radius:g})²({height:g}) "
                f"= {coefficient:g}π cm³."
            )

    # 3D space diagonals: rectangular rooms and boxes.
    if ("space diagonal" in _geom_low
            and ("measures" in _geom_low or "measuring" in _geom_low)):
        m = _geom_re.search(
            r"(?:measures|measuring)\s+"
            r"(\d+(?:\.\d+)?)\s*m\s+by\s+"
            r"(\d+(?:\.\d+)?)\s*m\s+by\s+"
            r"(\d+(?:\.\d+)?)\s*m",
            _geom_low,
        )
        if m:
            a, b, c = map(float, m.groups())
            square = a*a + b*b + c*c
            diagonal = _geom_math.sqrt(square)
            if _geom_math.isclose(diagonal, round(diagonal), abs_tol=1e-10):
                result = f"{diagonal:g}"
            elif "two decimals" in _geom_low:
                result = f"{diagonal:.2f}"
            else:
                result = f"{diagonal:.10g}"
            answer = (
                f"Space diagonal = √(a²+b²+c²) "
                f"= √({a:g}² + {b:g}² + {c:g}²) "
                f"= √({square:g}) = {result} m."
            )
            threshold = _geom_re.search(
                r"(?:longer than|greater than|exceed)\s+"
                r"(\d+(?:\.\d+)?)\s*m",
                _geom_low,
            )
            if threshold:
                limit = float(threshold.group(1))
                answer += (
                    f" Since {result} m is "
                    f"{'greater' if diagonal > limit else 'not greater'} "
                    f"than {limit:g} m, the answer is "
                    f"{'yes' if diagonal > limit else 'no'}."
                )
            return answer

    # END GEOMETRY Q84-Q100 DETERMINISTIC HANDLERS

    import re
    import math

    low = re.sub(r"\s+", " ", str(text or "").strip().lower())

    # Q31: SAS congruence proof outline.
    if (
        "included angle" in low
        and any(x in low for x in ("outline a proof", "proof outline"))
        and ("congruent" in low or "congruence" in low)
        and "side" in low
    ):
        return (
            "Proof outline (SAS):\n"
            "1. Identify the two pairs of corresponding sides.\n"
            "2. State that both pairs of corresponding sides are congruent.\n"
            "3. State that the included angles between those sides are congruent.\n"
            "4. Apply the Side-Angle-Side (SAS) congruence postulate.\n"
            "5. Conclude that the triangles are congruent."
        )

    # Q46: strict interval for the third side of a triangle.
    if (
        "strict interval" in low
        and "third side" in low
        and "side" in low
    ):
        nums = re.findall(r"(?<![a-z0-9.])(\d+(?:\.\d+)?)\s*cm\b", low)
        if len(nums) >= 2:
            a, b = map(float, nums[:2])
            if a > 0 and b > 0 and a != b:
                lo, hi = sorted((abs(a - b), a + b))
                return (
                    "By the Triangle Inequality Theorem, the third side x "
                    "must be greater than the difference and less than "
                    "the sum of the other two sides.\n"
                    f"|{a:g} - {b:g}| < x < {a:g} + {b:g}\n"
                    f"{lo:g} < x < {hi:g} cm"
                )

    # Q56: missing rectangle side from its diagonal.
    if (
        "rectangle" in low
        and "diagonal" in low
        and "side" in low
        and "cm" in low
    ):
        diag = re.search(
            r"diagonal\s+(?:of\s+)?(\d+(?:\.\d+)?)\s*cm", low
        )
        side = re.search(
            r"(?:one side|a side|side)\s+(?:is\s+)?"
            r"(\d+(?:\.\d+)?)\s*cm", low
        )
        if diag and side:
            d, s = float(diag.group(1)), float(side.group(1))
            if d > 0 and s > 0 and d > s:
                other = math.sqrt(d * d - s * s)
                return (
                    "Use the Pythagorean theorem: diagonal² = side₁² + side₂².\n"
                    f"Other side = sqrt({d:g}² - {s:g}²)\n"
                    f"= sqrt({d*d:g} - {s*s:g}) = {other:.10g} cm."
                )

    # Q65: scale 1:n, convert model centimetres to represented metres.
    if (
        "scale" in low
        and "represented height" in low
        and "metres" in low
    ):
        height = re.search(r"(\d+(?:\.\d+)?)\s*cm\s+tall", low)
        scale = re.search(r"scale\s*(?:of\s*)?1\s*:\s*(\d+(?:\.\d+)?)", low)
        if height and scale:
            h, factor = float(height.group(1)), float(scale.group(1))
            if h > 0 and factor > 0:
                actual_cm = h * factor
                actual_m = actual_cm / 100
                return (
                    f"Actual height = model height × scale factor\n"
                    f"= {h:g} cm × {factor:g} = {actual_cm:.10g} cm\n"
                    f"= {actual_m:.10g} m."
                )


    # Q41: isosceles triangle vertex angle from equal base angles.
    if (
        "isosceles" in low
        and "base angle" in low
        and "vertex angle" in low
    ):
        m = re.search(r"each base angle is\s*(\d+(?:\.\d+)?)\s*°?", low)
        if m:
            base = float(m.group(1))
            vertex = 180.0 - 2.0 * base
            if 0 < base < 90 and vertex > 0:
                return (
                    f"Base angles are equal. Vertex angle = 180° - "
                    f"2({base:g}°) = {vertex:g}°."
                )

    # Q49: order angles by their opposite side lengths.
    if "order the angles" in low and "opposite sides" in low:
        m = re.search(
            r"opposite sides are\s+([\d.]+)\s*,\s*([\d.]+)\s*,"
            r"\s*(?:and\s+)?([\d.]+)\s*cm\b",
            low,
        )
        if m:
            sides = sorted(float(x) for x in m.groups())
            if sides[0] > 0 and sides[0] + sides[1] > sides[2]:
                return (
                    "In a triangle, the larger side is opposite the larger "
                    "angle.\n"
                    f"Smallest to largest: angle opposite {sides[0]:g} cm, "
                    f"angle opposite {sides[1]:g} cm, then angle opposite "
                    f"{sides[2]:g} cm."
                )

    # Q55: remaining angles of a parallelogram.
    if (
        "parallelogram" in low
        and "other three angles" in low
    ):
        m = re.search(r"angle of\s*(\d+(?:\.\d+)?)\s*°?", low)
        if m:
            a = float(m.group(1))
            if 0 < a < 180:
                adjacent = 180.0 - a
                return (
                    "Opposite angles in a parallelogram are equal, and "
                    "adjacent angles are supplementary.\n"
                    f"The four angles are {a:g}°, {adjacent:g}°, "
                    f"{a:g}°, and {adjacent:g}°.\n"
                    f"The other three angles are {adjacent:g}°, "
                    f"{a:g}°, and {adjacent:g}°."
                )

    # Q58: missing interior angle of a quadrilateral.
    if (
        "quadrilateral" in low
        and "find x" in low
    ):
        vals = re.findall(r"(\d+(?:\.\d+)?)\s*°", low)
        if len(vals) >= 3:
            a, b, c = map(float, vals[:3])
            x = 360.0 - a - b - c
            if all(0 < v < 360 for v in (a, b, c)) and 0 < x < 360:
                return (
                    "The interior angles of a quadrilateral sum to 360°.\n"
                    f"x = 360° - {a:g}° - {b:g}° - {c:g}° "
                    f"= {x:g}°."
                )


    # Q64: corresponding side in similar triangles.
    if ("similar triangles" in low and "corresponding sides" in low
            and "second smaller side" in low):
        m = re.search(
            r"corresponding sides\s+([\d.]+)\s*cm\s+and\s+"
            r"([\d.]+)\s*cm", low)
        n = re.search(r"smaller side is\s+([\d.]+)\s*cm", low)
        if m and n:
            a, b, small = float(m.group(1)), float(m.group(2)), float(n.group(1))
            if a > 0 and b > a and small > 0:
                answer = small * b / a
                return (f"Scale factor = {b:g}/{a:g} = {b/a:g}.\n"
                        f"Corresponding larger side = {small:g} × {b/a:g} "
                        f"= {answer:.10g} cm.")

    # Q66: linear ratio from similar polygon perimeters.
    if ("similar polygons" in low and "perimeters" in low
            and "linear scale ratio" in low):
        m = re.search(
            r"perimeters\s+([\d.]+)\s*cm\s+and\s+([\d.]+)\s*cm", low)
        if m:
            from fractions import Fraction
            a, b = (Fraction(x) for x in m.groups())
            if a > 0 and b > 0:
                ratio = a / b
                return (f"Similar polygons have the same perimeter ratio "
                        f"as their corresponding side lengths.\n"
                        f"Linear scale ratio = {a}:{b} = "
                        f"{ratio.numerator}:{ratio.denominator}.")

    # Q68: map distance conversion.
    if ("towns are" in low and "apart" in low and "km" in low
            and "map uses" in low):
        m = re.search(r"map uses\s+1\s*cm\s+for\s+([\d.]+)\s*km", low)
        n = re.search(r"towns are\s+([\d.]+)\s*cm\s+apart", low)
        if m and n:
            scale, distance = float(m.group(1)), float(n.group(1))
            if scale > 0 and distance > 0:
                result = scale * distance
                return (f"Represented separation = {distance:g} cm × "
                        f"{scale:g} km/cm = {result:.10g} km.")

    # Q69: enlargement of photograph.
    if ("photograph" in low and "original height" in low
            and "enlarged height" in low):
        m = re.search(r"width\s+([\d.]+)\s*cm\s+to\s+([\d.]+)\s*cm", low)
        n = re.search(r"original height is\s+([\d.]+)\s*cm", low)
        if m and n:
            old_w, new_w, old_h = map(float, (*m.groups(), n.group(1)))
            if old_w > 0 and new_w > 0 and old_h > 0:
                new_h = old_h * new_w / old_w
                return (f"Enlargement factor = {new_w:g}/{old_w:g} "
                        f"= {new_w/old_w:g}.\n"
                        f"Enlarged height = {old_h:g} × "
                        f"{new_w/old_w:g} = {new_h:.10g} cm.")

    # Q71: scale expressed as 1:n.
    if ("scale" in low and "wall" in low and "represented" in low
            and "line" in low):
        m = re.search(r"([\d.]+)\s*m\s+wall", low)
        n = re.search(r"([\d.]+)\s*cm\s+line", low)
        if m and n:
            actual_m, drawing_cm = float(m.group(1)), float(n.group(1))
            if actual_m > 0 and drawing_cm > 0:
                denominator = actual_m * 100 / drawing_cm
                return (f"Convert {actual_m:g} m to "
                        f"{actual_m*100:g} cm.\n"
                        f"Scale = {drawing_cm:g}:{actual_m*100:g} "
                        f"= 1:{denominator:.10g}.")

    # Q72: volume under uniform enlargement.
    if ("solid is enlarged uniformly" in low and "original volume" in low):
        m = re.search(r"factor\s+(\d+(?:\.\d+)?)(?!\d)", low)
        n = re.search(r"original volume is\s+([\d.]+)\s*cm", low)
        if m and n:
            factor, volume = float(m.group(1)), float(n.group(1))
            if factor > 0 and volume > 0:
                result = volume * factor**3
                return (f"Volume scales by the cube of the linear factor.\n"
                        f"New volume = {volume:g} × {factor:g}³ "
                        f"= {result:.10g} cm³.")

    # Q74: diagonal of a rectangular garden.
    if ("garden is" in low and "by" in low
            and "opposite corners" in low):
        m = re.search(
            r"garden is\s+([\d.]+)\s*m\s+by\s+([\d.]+)\s*m", low)
        if m:
            a, b = map(float, m.groups())
            if a > 0 and b > 0:
                d = math.hypot(a, b)
                return (f"By Pythagoras, d = √({a:g}² + {b:g}²) "
                        f"= {d:.10g} m.")

    # Q75: ladder height, rounded to two decimal places.
    if ("ladder" in low and "from a vertical wall" in low
            and "height reached" in low):
        m = re.search(r"([\d.]+)\s*m\s+ladder", low)
        n = re.search(r"([\d.]+)\s*m\s+from a vertical wall", low)
        if m and n:
            ladder, base = float(m.group(1)), float(n.group(1))
            if ladder > base > 0:
                height = math.sqrt(ladder**2 - base**2)
                return (f"Height = √({ladder:g}² - {base:g}²) "
                        f"= {height:.2f} m.")

    # Q77: exact and decimal diagonal of a square.
    if ("square has side" in low and "diagonal" in low
            and "exactly" in low):
        m = re.search(r"square has side\s+([\d.]+)\s*cm", low)
        if m:
            side = float(m.group(1))
            if side > 0:
                d = side * math.sqrt(2)
                return (f"Square diagonal = side × √2.\n"
                        f"Exact: {side:g}√2 cm.\n"
                        f"To two decimal places: {d:.2f} cm.")

    # Q78: ramp length, rounded to nearest centimetre.
    if ("ramp rises" in low and "horizontal run" in low
            and "nearest centimetre" in low):
        m = re.search(r"ramp rises\s+([\d.]+)\s*m", low)
        n = re.search(r"horizontal run of\s+([\d.]+)\s*m", low)
        if m and n:
            rise, run = float(m.group(1)), float(n.group(1))
            if rise > 0 and run > 0:
                exact = math.hypot(rise, run)
                rounded = round(exact * 100) / 100
                return (f"Ramp length = √({rise:g}² + {run:g}²) "
                        f"= {exact:.10g} m.\n"
                        f"To the nearest centimetre: {rounded:.2f} m.")

    # Q79: direct displacement from perpendicular travel.
    if ("drone travels" in low and "east" in low
            and "north" in low and "direct displacement" in low):
        m = re.search(
            r"drone travels\s+([\d.]+)\s*km east and then\s+"
            r"([\d.]+)\s*km north", low)
        if m:
            east, north = map(float, m.groups())
            if east > 0 and north > 0:
                d = math.hypot(east, north)
                return (f"Direct displacement = √({east:g}² + "
                        f"{north:g}²) = {d:.10g} km.")
    return None



def parallel_transversal_acute_angle_fast_path(text):
    """Calculate the acute angle formed by parallel lines and a transversal."""
    low = " ".join(str(text or "").strip().lower().split())
    if not all(term in low for term in ("parallel", "transversal", "angle")):
        return None
    if not re.search(r"\bacute\b", low):
        return None

    normalized = low.replace("°", " degrees ")
    number = r"(\d+(?:\.\d+)?)"
    patterns = (
        r"(?:one angle|an angle|given angle|angle)\s*"
        r"(?:is|equals|=|of|:)?\s*" + number + r"\s*(?:degrees?|deg)\b",
        r"(?:one angle|an angle|given angle|angle)\s*"
        r"(?:is|equals|=|of|:)?\s*" + number + r"\b",
    )
    angle = None
    for pattern in patterns:
        match = re.search(pattern, normalized)
        if match:
            angle = float(match.group(1))
            break
    if angle is None or not 0 < angle < 180:
        return None

    acute = angle if angle < 90 else 180 - angle
    if abs(acute - 90) < 1e-9:
        return (
            "The given angle is 90 degrees, so its supplementary angle is "
            "also 90 degrees. There is no strictly acute angle in this case."
        )
    shown_angle = f"{angle:g}"
    shown_acute = f"{acute:g}"
    if angle > 90:
        return (
            f"Acute angle = 180 degrees - {shown_angle} degrees "
            f"= {shown_acute} degrees. "
            "Angles that form a linear pair are supplementary."
        )
    return (
        f"The given angle is already acute: {shown_angle} degrees. "
        f"Therefore, the acute angle measure is {shown_acute} degrees."
    )



def geometry_gap_fast_path(text):
    """Deterministic solutions for geometry prompts previously stolen by definition handlers."""
    import math
    import re

    if not isinstance(text, str):
        return None
    raw = text.lower().replace("²", "^2").replace("³", "^3").replace("’", "'")
    raw = re.sub(r"\s+", " ", raw).strip()
    nospace = raw.replace(" ", "")
    num = r"([-+]?\d+(?:\.\d+)?)"

    def fmt(v):
        return f"{v:.6g}"

    def simp_sqrt(v):
        if v <= 0 or abs(v - round(v)) > 1e-9:
            return None
        n = int(round(v))
        k = 1
        for i in range(math.isqrt(n), 1, -1):
            if n % (i * i) == 0:
                k = i
                break
        if k == 1:
            return None
        r = n // (k * k)
        return str(k) if r == 1 else f"{k}√{r}"

    def radical(v):
        hv = round(math.sqrt(v), 2)
        base = f"√{fmt(v)}"
        s = simp_sqrt(v)
        if s is None:
            return f"{base} ≈ {hv:g}"
        if s.isdigit():
            return f"{base} = {s}"
        return f"{base} = {s} ≈ {hv:g}"

    def has(*words):
        return all(w in raw for w in words)

    asks_explain = ("explain" in raw or "why" in raw or "describe" in raw)

    # ---- Angles around a point with one unknown (no coefficients) ----
    if "around a point" in raw and "find" in raw and not re.search(r"\d\s*[xyz]\b", raw):
        var = re.search(r"\b([xyz])\b", raw)
        known = re.findall(num + r"\s*(?:°|deg)", raw)
        if var and len(known) >= 2:
            vals = [float(k) for k in known]
            s = sum(vals)
            if s < 360:
                v = var.group(1)
                lhs = " + ".join(f"{fmt(k)}°" for k in vals)
                return "\n".join([
                    "Angles around a point sum to 360°.",
                    f"{lhs} + {v} = 360°",
                    f"{v} = 360° - {fmt(s)}° = {fmt(360 - s)}°",
                ])

    # ---- Corresponding angle in congruent triangles ----
    m = re.search(r"triangle\s+([a-z]{3})\s+(?:is\s+)?(?:congruent to|≅)\s+triangle\s+([a-z]{3})", raw)
    if m and "angle" in raw:
        t1, t2 = m.groups()
        ma = re.search(r"angle\s+([a-z])\s*(?:is|=|measures)?\s*" + num, raw)
        mf = re.search(r"find\s+(?:the\s+)?(?:angle\s+|∠)?([a-z])\b", raw)
        if ma and mf:
            given, val, want = ma.group(1), float(ma.group(2)), mf.group(1)
            pair = None
            if given in t1 and want in t2 and t1.index(given) == t2.index(want):
                pair = True
            elif given in t2 and want in t1 and t2.index(given) == t1.index(want):
                pair = True
            if pair:
                return (f"Triangle {t1.upper()} ≅ triangle {t2.upper()}: corresponding angles are equal, "
                        f"so ∠{want.upper()} = ∠{given.upper()} = {fmt(val)}°.")

    # ---- Isosceles: strict range for the base ----
    if "isosceles" in raw and "range" in raw and "base" in raw and "altitude" not in raw:
        mleg = re.search(r"(?:equal sides?|legs?)\s*(?:are|is|of|=)?\s*" + num, raw)
        if mleg:
            L = float(mleg.group(1))
            return "\n".join([
                "Triangle inequality: |L - L| < b < L + L",
                f"0 < b < {fmt(2 * L)} cm (strict)",
            ])

    # ---- Isosceles: altitude to the base and area ----
    if (("isosceles" in raw or "equal sides" in raw) and "base" in raw
            and ("altitude" in raw or "area" in raw)
            and not any(w in raw for w in ("explain", "why", "bisect", "describe", "state", "perimeter"))):
        mleg = re.search(r"(?:equal sides?|legs?)\s*(?:are|is|of|=)?\s*" + num, raw)
        mbase = re.search(r"\bbase\s*(?:is|of|=|measures)?\s*" + num, raw)
        if mleg and mbase:
            L, b = float(mleg.group(1)), float(mbase.group(1))
            half = b / 2.0
            h2 = L * L - half * half
            if h2 > 0:
                h = math.sqrt(h2)
                out = [
                    f"The altitude bisects the base: half-base = {fmt(half)} cm.",
                    f"altitude = √({fmt(L * L)} - {fmt(half * half)}) = {radical(h2)} cm",
                ]
                if "area" in raw:
                    out.append(f"Area = (1/2)*base*altitude = (1/2)*{fmt(b)}*{round(h, 2):g} = {round(b * h / 2, 2):g} cm^2")
                return "\n".join(out)

    # ---- Largest angle from three sides ----
    if "largest" in raw and "angle" in raw and "sides" in raw:
        ns = [float(x) for x in re.findall(num, raw)]
        if len(ns) == 3:
            c = max(ns)
            rest = list(ns)
            rest.remove(c)
            a, b = rest
            if a + b > c:
                ang = math.degrees(math.acos((a * a + b * b - c * c) / (2 * a * b)))
                kind = "obtuse" if ang > 90 else ("right" if abs(ang - 90) < 1e-9 else "acute")
                return "\n".join([
                    f"The largest angle is opposite the largest side, {fmt(c)} cm.",
                    f"cos(C) = ({fmt(a)}^2 + {fmt(b)}^2 - {fmt(c)}^2)/(2*{fmt(a)}*{fmt(b)})",
                    f"C ≈ {ang:.1f}° ({kind})",
                ])

    # ---- Triangle inequality with linear sides in x ----
    if "triangle" in raw and re.search(r"\bx\b", raw) and "inequalit" in raw:
        ms = re.search(r"sides?\s+(.+?)\s+form", raw)
        if ms:
            parts = [p.replace(" ", "") for p in re.split(r"\s*,\s*(?:and\s+)?|\s+and\s+", ms.group(1))]
            terms = []
            for p in parts:
                mt = re.match(r"^(\d*)x(?:([+-])(\d+(?:\.\d+)?))?$", p)
                if not mt:
                    terms = []
                    break
                a = float(mt.group(1)) if mt.group(1) else 1.0
                bb = float(mt.group(3)) if mt.group(3) else 0.0
                if mt.group(2) == "-":
                    bb = -bb
                terms.append((a, bb, p))
            if len(terms) == 3:
                lower, upper, feasible, degenerate = 0.0, float("inf"), True, False
                lines = ["Triangle inequality: each sum of two sides must exceed the third."]
                for i in range(3):
                    j, k = [t for t in range(3) if t != i]
                    A = terms[j][0] + terms[k][0] - terms[i][0]
                    B = terms[j][1] + terms[k][1] - terms[i][1]
                    lines.append(f"({terms[j][2]}) + ({terms[k][2]}) > ({terms[i][2]})  ->  {A:g}x + {B:g} > 0")
                    if A == 0:
                        if B <= 0:
                            feasible = False
                            degenerate = degenerate or B == 0
                    elif A > 0:
                        lower = max(lower, -B / A)
                    else:
                        upper = min(upper, -B / A)
                if feasible and lower < upper:
                    lines.append(f"Valid for x > {lower:g}" + (f" and x < {upper:g}" if upper != float("inf") else ""))
                else:
                    lines.append("No positive x works." + (" One inequality reduces to 0 > 0, which is false (degenerate triangle)." if degenerate else ""))
                return "\n".join(lines)

    # ---- Kite / parallelogram perimeter ----
    if "kite" in raw and "perimeter" in raw:
        ns = [float(x) for x in re.findall(num, raw)]
        if len(ns) == 2:
            a, b = ns
            return f"A kite has two pairs of equal adjacent sides: P = 2(a + b) = 2({fmt(a)} + {fmt(b)}) = {fmt(2 * (a + b))} cm"
    if "parallelogram" in raw and "perimeter" in raw and "adjacent sides" in raw:
        ns = [float(x) for x in re.findall(num, raw)]
        if len(ns) == 2:
            a, b = ns
            return f"Opposite sides are equal: P = 2(a + b) = 2({fmt(a)} + {fmt(b)}) = {fmt(2 * (a + b))} cm"

    # ---- Altitude to the hypotenuse ----
    if (has("altitude", "hypotenuse") and ("segment" in raw or "ratio" in raw)
            and not any(w in raw for w in ("explain", "why", "describe", "how"))):
        mr = re.search(r"ratio\s*(\d+)\s*:\s*(\d+)", raw)
        mseg = re.search(r"(shorter|longer|smaller|larger)\s+segment\s*(?:is|=)?\s*" + num, raw)
        if mr and mseg:
            lo, hi = sorted([float(mr.group(1)), float(mr.group(2))])
            val = float(mseg.group(2))
            if mseg.group(1) in ("shorter", "smaller"):
                s, l = val, val * hi / lo
            else:
                l, s = val, val * lo / hi
            return "\n".join([
                f"Segments: {fmt(s)} cm and {fmt(l)} cm (hypotenuse = {fmt(s + l)} cm).",
                f"h^2 = p*q = {fmt(s)}*{fmt(l)} = {fmt(s * l)}",
                f"h = {radical(s * l)} cm",
            ])
        ns = [float(x) for x in re.findall(num + r"\s*cm", raw)]
        if len(ns) == 2:
            p, q = ns
            out = []
            if "find the hypotenuse" in raw or "hypotenuse and" in raw:
                out.append(f"Hypotenuse = p + q = {fmt(p)} + {fmt(q)} = {fmt(p + q)} cm")
            out.append(f"Altitude: h^2 = p*q = {fmt(p)}*{fmt(q)} = {fmt(p * q)}")
            out.append(f"h = {radical(p * q)} cm")
            return "\n".join(out)

    # ---- Projection (leg) theorem: leg^2 = hypotenuse * projection ----
    if has("projection", "hypotenuse", "leg") and not any(w in raw for w in ("explain", "why", "describe")):
        s2 = raw.replace("on the hypotenuse", "on h")
        mh = re.search(r"\bhypotenuse\s*(?:is|of|=)?\s*" + num, s2)
        ml = re.search(r"\bleg(?!'s)\s*(?:is|of|=)?\s*" + num, s2)
        mp = re.search(r"projection\s*(?:on h\s*)?(?:is|of|=)?\s*" + num, s2)
        hyp = float(mh.group(1)) if mh else None
        leg = float(ml.group(1)) if ml else None
        prj = float(mp.group(1)) if mp else None
        known = [v is not None for v in (hyp, leg, prj)]
        if sum(known) == 2:
            head = "Projection (leg) theorem: leg^2 = hypotenuse * projection"
            if leg is None:
                return "\n".join([head, f"leg^2 = {fmt(hyp)} * {fmt(prj)} = {fmt(hyp * prj)}", f"leg = {radical(hyp * prj)} cm"])
            if hyp is None and prj:
                return "\n".join([head, f"hypotenuse = leg^2/projection = {fmt(leg)}^2/{fmt(prj)} = {fmt(leg * leg / prj)} cm"])
            if prj is None and hyp:
                return "\n".join([head, f"projection = leg^2/hypotenuse = {fmt(leg)}^2/{fmt(hyp)} = {round(leg * leg / hyp, 2):g} cm"])

    # ---- 3D distance from coordinate differences ----
    if "differ" in raw:
        diffs = re.findall(num + r"\s*(?:units?\s*)?in\s*([xyz])\b", raw)
        if len(diffs) == 3:
            d2 = sum(float(v) ** 2 for v, _ in diffs)
            return "\n".join([
                "d = √(Δx^2 + Δy^2 + Δz^2)",
                "d = √(" + " + ".join(f"{fmt(float(v))}^2" for v, _ in diffs) + f") = √{fmt(d2)}",
                f"d = {radical(d2)}",
            ])

    # ---- Similar solids: area and volume ratios ----
    if "similar solids" in raw and "surface" in raw and "volume" in raw:
        mr = re.search(r"ratio\s*(\d+)\s*:\s*(\d+)", raw)
        if mr:
            a, b = int(mr.group(1)), int(mr.group(2))
            return "\n".join([
                f"Length ratio {a}:{b}.",
                f"Surface-area ratio = {a}^2:{b}^2 = {a * a}:{b * b}",
                f"Volume ratio = {a}^3:{b}^3 = {a ** 3}:{b ** 3}",
            ])

    # ---- Explanation / definition handlers (narrow triggers) ----
    if has("counterexample", "diagonal", "rectangle"):
        return ("Counterexample: an isosceles trapezoid that is not a rectangle. "
                "Its diagonals are equal in length, but its angles are not all 90°.")
    if has("rectangle", "diagonal", "two triangles", "congruent") and asks_explain:
        return ("Rectangle ABCD with diagonal AC: AB = CD and BC = DA (opposite sides are equal) and AC is common, "
                "so triangle ABC ≅ triangle CDA by SSS. (SAS or HL also work, since angles B and D are right angles.)")
    if has("rectangle", "diagonal", "equal") and asks_explain:
        return ("Rectangle ABCD: in triangles ABC and DCB, AB = DC, BC is common, and angle ABC = angle DCB = 90°. "
                "By SAS, triangle ABC ≅ triangle DCB, so AC = DB: the diagonals are equal.")
    if has("altitude", "isosceles", "bisect", "base") and asks_explain:
        return ("Let AB = AC and let AD be the altitude from A to BC. Triangles ABD and ACD are right triangles "
                "with equal hypotenuses AB = AC and the common leg AD. By Hypotenuse-Leg they are congruent, "
                "so BD = DC: the altitude bisects the base.")
    if has("equal sides", "opposite angles") and ("relationship" in raw or "explain" in raw):
        return ("Isosceles Triangle Theorem: angles opposite equal sides are equal. "
                "Converse: sides opposite equal angles are equal.")
    if has("median", "altitude", "angle bisector"):
        return "\n".join([
            "Median: joins a vertex to the midpoint of the opposite side.",
            "Altitude: perpendicular segment from a vertex to the line containing the opposite side.",
            "Angle bisector: divides the angle at a vertex into two congruent angles.",
        ])
    if has("perpendicular bisector", "equidistant") and re.search(r"\barcs?\b", raw):
        return ("Draw arcs of equal radius r (greater than half of AB) centered at A and at B. "
                "Each intersection point P lies on both arcs, so PA = r = PB. "
                "The line through the two intersections is the perpendicular bisector of AB: it meets AB at its midpoint at 90°.")
    if has("perpendicular bisector", "equidistant", "endpoint") and asks_explain:
        return ("Let P be on the perpendicular bisector of AB with midpoint M. Triangles PMA and PMB share PM, "
                "have AM = BM, and angle PMA = angle PMB = 90°. By SAS they are congruent, so PA = PB.")
    if has("angle bisector", "defining property"):
        return ("An angle bisector is the ray from the vertex that divides the angle into two congruent angles; "
                "each of its points is equidistant from the two sides of the angle.")
    if has("rectangle", "parallelogram", "angle", "distinguish"):
        return ("A rectangle is a parallelogram with four right angles (90°). A general parallelogram only has "
                "opposite angles equal and consecutive angles supplementary; if one angle is 90°, all four are, and it is a rectangle.")
    if has("similar triangles", "side ratio", "determines"):
        return ("Corresponding sides of similar triangles are all proportional with one scale factor k. "
                "Once one corresponding ratio is known, k = A'B'/AB, every other corresponding side ratio equals k.")
    if "a^2+b^2=c^2" in nospace and ("meaning" in raw or "identify each side" in raw):
        return ("In a right triangle the square on the hypotenuse c equals the sum of the squares on the legs a and b. "
                "c is the side opposite the right angle (the longest side); a and b are the two sides that form the right angle.")
    if ("geometric-mean" in raw or "geometric mean" in raw) and has("altitude", "hypotenuse segments"):
        return ("If the altitude h to the hypotenuse splits it into p and q, the two small triangles are similar, "
                "so h/p = q/h. Hence h^2 = p*q and h = √(pq): the altitude is the geometric mean of the two segments.")
    if has("lateral surface area", "total surface area"):
        return ("Lateral surface area = sum of the areas of the side faces only (bases excluded). "
                "Total surface area = lateral surface area + the area of the base(s).")
    if has("locus", "inside an angle", "equally distant"):
        return ("The locus is the angle bisector: the ray from the vertex dividing the angle into two equal angles. "
                "Every point on it is equidistant from the two arms.")
    if "perpendicular to a line through a point outside" in raw and ("construct" in raw or "describe" in raw):
        return "\n".join([
            "1. With centre P (outside line l), draw an arc cutting l at two points A and B.",
            "2. With centres A and B and the same radius (more than half of AB), draw arcs that meet at C.",
            "3. Draw line PC. Since PA = PB and CA = CB, PC is the perpendicular bisector of chord AB, so PC is perpendicular to l.",
        ])
    if "pantograph" in raw and "preserves" in raw:
        return ("A pantograph is a parallelogram linkage with a fixed pivot; the tracing point and drawing point stay collinear "
                "with the pivot, so the drawing point is always k times as far from it as the tracer. Lengths scale by |k| and areas by k^2. "
                "A uniform dilation preserves angle measures, shape (similarity), parallelism and ratios of lengths; "
                "it does not preserve lengths or areas unless |k| = 1.")
    return None



def physics_gap_fast_path(text):
    """Deterministic thermo/fluid/calculus answers and C/Python program generators."""
    import math
    import re

    if not isinstance(text, str):
        return None
    sup = {"⁰": "0", "¹": "1", "²": "2", "³": "3", "⁴": "4",
           "⁵": "5", "⁶": "6", "⁷": "7", "⁸": "8", "⁹": "9"}
    low = text.lower().replace("’", "'")
    for dash in ("–", "−", "—"):
        low = low.replace(dash, "-")
    low = re.sub(r"\s+", " ", low).strip()
    low = re.sub(
        r"(\d(?:\.\d+)?)\s*×\s*10\s*⁻\s*([⁰¹²³⁴⁵⁶⁷⁸⁹]+)",
        lambda m: m.group(1) + "e-" + "".join(sup[c] for c in m.group(2)),
        low,
    )
    num_re = re.compile(r"(?<![\w.])-?(?:\d+\.?\d*|\.\d+)(?:e[-+]?\d+)?")

    def strip_sup(s):
        return re.sub(r"[⁰¹²³⁴⁵⁶⁷⁸⁹⁻·]", "", s)

    def nums(s):
        return [float(x) for x in num_re.findall(strip_sup(s))]

    def g6(v):
        return f"{v:.6g}"

    mp = re.match(r"^write an? (python|c) program that (.+)$", low)

    # ------------------------------------------------------------------
    # Theory answers
    # ------------------------------------------------------------------
    if not mp:
        t = strip_sup(low)
        n = nums(low)
        if (re.search(r"\bmol\b", t) and "pressure" in t
                and ("ideal gas" in t or "ideal-gas" in t) and len(n) >= 3 and n[2] > 0):
            nn, T, V = n[:3]
            P = nn * 8.314 * T / V
            return ("Ideal-gas law: P = nRT/V\n"
                    f"P = {g6(nn)}*8.314*{g6(T)}/{g6(V)} = {g6(P)} Pa ({g6(P / 1000)} kPa)")
        if "composite wall" in t and len(n) >= 7:
            t1, k1, t2, k2, A, Ti, To = n[:7]
            R1, R2 = t1 / (k1 * A), t2 / (k2 * A)
            Q = (Ti - To) / (R1 + R2)
            return ("Series conduction through the composite wall:\n"
                    f"R1 = L1/(k1*A) = {g6(R1)} K/W, R2 = L2/(k2*A) = {g6(R2)} K/W\n"
                    f"Q = (Ti - To)/(R1 + R2) = {g6(Ti - To)}/{g6(R1 + R2)} = {g6(Q)} W")
        if "ice" in t and "steam" in t and "kg" in t and len(n) >= 3:
            m, T0, Tf = n[:3]
            ci, Lf, cw, Lv = 2100.0, 334000.0, 4186.0, 2260000.0
            if len(n) >= 7:
                ci, Lf, cw, Lv = n[3], n[4] * 1000.0, n[5], n[6] * 1e6
            q100 = m * (ci * (0 - T0) + Lf + cw * 100.0 + Lv)
            out = ["Heating ice to steam:",
                   "Q = m*[ci*(0 - Ti) + Lf + cw*100 + Lv]",
                   f"Q (to steam at 100 C) = {g6(q100)} J"]
            if Tf > 100:
                cs = 2010.0
                qs = m * cs * (Tf - 100.0)
                out.append(f"Superheat 100 -> {g6(Tf)} C with cs = 2010 J/(kg K) (assumed, not given): {g6(qs)} J")
                out.append(f"Total = {g6(q100 + qs)} J")
            return "\n".join(out)
        if "reynolds" in t and len(n) >= 3 and n[2] > 0:
            V, D, nu = n[:3]
            Re = V * D / nu
            regime = "laminar" if Re < 2300 else ("transitional" if Re < 4000 else "turbulent")
            return f"Re = V*D/nu = {g6(V)}*{g6(D)}/{g6(nu)} = {g6(Re)}\nFlow regime: {regime}"
        if ("mass-flow" in t or "mass flow" in t) and "diameter" in t and len(n) >= 3:
            rho, V, D = n[:3]
            A = math.pi * D * D / 4.0
            return ("Mass flow rate: mdot = rho*A*V\n"
                    f"A = pi*D^2/4 = {g6(A)} m^2\n"
                    f"mdot = {g6(rho)}*{g6(A)}*{g6(V)} = {g6(rho * A * V)} kg/s")
        if "bernoulli" in t and len(n) >= 4:
            rho, p1, V1, V2 = n[:4]
            p2 = p1 * 1000.0 + 0.5 * rho * (V1 * V1 - V2 * V2)
            return ("Bernoulli (same elevation): p1 + 1/2*rho*V1^2 = p2 + 1/2*rho*V2^2\n"
                    f"p2 = {g6(p1 * 1000.0)} + 0.5*{g6(rho)}*({g6(V1)}^2 - {g6(V2)}^2) = {g6(p2)} Pa ({g6(p2 / 1000)} kPa)")
        if (re.search(r"\b(orifice|hole)\b", t) and ("exit" in t or "efflux" in t)
                and "below" in t and n and n[0] > 0):
            h = n[0]
            return ("Torricelli equation:\nV = sqrt(2*g*h)\n"
                    f"V = sqrt(2*9.81*{g6(h)}) = {g6(math.sqrt(2 * 9.81 * h))} m/s")
        if "dynamic pressure" in t and len(n) >= 2:
            rho, V = n[:2]
            return f"Dynamic pressure: q = 1/2*rho*V^2 = 0.5*{g6(rho)}*{g6(V)}^2 = {g6(0.5 * rho * V * V)} Pa"
        if "pump" in t and "shaft power" in t and len(n) >= 4:
            rho, Q, H, eta = n[:4]
            if eta > 0:
                return ("Shaft power: P = rho*g*Q*H/eta\n"
                        f"P = {g6(rho)}*9.81*{g6(Q)}*{g6(H)}/{g6(eta / 100.0)} = {g6(rho * 9.81 * Q * H / (eta / 100.0))} W")
        if "integrate 4x³ + 3x with respect to x" in low:
            return "Integral of (4x^3 + 3x) dx = x^4 + (3/2)x^2 + C"
        if "limit of (x² - 9)/(x - 3)" in low:
            return ("(x^2 - 9)/(x - 3) = (x - 3)(x + 3)/(x - 3) = x + 3 for x != 3\n"
                    "Limit as x -> 3 = 3 + 3 = 6")
        if "differentiate the product x²·cos(x)" in low:
            return ("Product rule: d/dx[x^2 cos(x)] = 2x cos(x) + x^2*(-sin(x))\n"
                    "= 2x cos(x) - x^2 sin(x)")
        if "definite integral of 4x³ + 3x from 0 to 2" in low:
            return ("Antiderivative F(x) = x^4 + (3/2)x^2\n"
                    "F(2) - F(0) = 16 + 6 - 0 = 22")
        if "differentiate the quotient (x² + 4)/(x - 2)" in low:
            return ("Quotient rule: [(2x)(x - 2) - (x^2 + 4)(1)]/(x - 2)^2\n"
                    "= (x^2 - 4x - 4)/(x - 2)^2")
        if "differentiate cos(x³ + 3x)" in low:
            return ("Chain rule with u = x^3 + 3x, u' = 3x^2 + 3:\n"
                    "d/dx cos(u) = -(3x^2 + 3) sin(x^3 + 3x)")
        if "integrate x·exp(x²) with respect to x" in low:
            return ("Substitute u = x^2, du = 2x dx:\n"
                    "Integral of x e^(x^2) dx = (1/2) e^(x^2) + C")
        if "natural logarithm of (x³ + 2x² + 2)" in low:
            return ("d/dx ln(u) = u'/u with u = x^3 + 2x^2 + 2, u' = 3x^2 + 4x:\n"
                    "= (3x^2 + 4x)/(x^3 + 2x^2 + 2)")
        if "integrate x·cos(x) with respect to x" in low:
            return ("Integration by parts with u = x, dv = cos(x) dx:\n"
                    "Integral of x cos(x) dx = x sin(x) + cos(x) + C")
        return None

    # ------------------------------------------------------------------
    # Program generators (python / c), values parsed from the prompt
    # ------------------------------------------------------------------
    lang = "c" if mp.group(1) == "c" else "python"
    task = mp.group(2)
    tn = nums(task)
    pi_s = "3.141592653589793"

    def has(*w):
        return all(x in task for x in w)

    def lit(v):
        return repr(float(v))

    def val(v):
        return v if isinstance(v, str) else lit(v)

    def pyfmt(label, expr, unit, p="6"):
        u = (" " + unit) if unit else ""
        return "print(f'" + label + ": {" + expr + ":." + p + "g}" + u + "')"

    def cfmt(label, expr, unit, p="6"):
        u = (" " + unit.replace("%", "%%")) if unit else ""
        return '    printf("' + label + ": %." + p + "g" + u + '\\n", ' + expr + ");"

    def c_head():
        return ["#include <stdio.h>", "#include <math.h>", "", "int main(void) {",
                "    double pi = " + pi_s + ";"]

    def scalar(vars_, prints, comment=None, tail=None):
        if lang == "python":
            out = ["from math import *"]
            if comment:
                out.append("# " + comment)
            for k, v in vars_:
                out.append(k + " = " + val(v))
            for p in prints:
                out.append(pyfmt(*p))
            if tail:
                out += tail[0]
        else:
            out = c_head()
            if comment:
                out.append("    /* " + comment + " */")
            for k, v in vars_:
                out.append("    double " + k + " = " + val(v) + ";")
            for p in prints:
                out.append(cfmt(*p))
            if tail:
                out += ["    " + x for x in tail[1]]
            out += ["    return 0;", "}"]
        return "\n".join(out) + "\n"

    def loop(vars_, var, values, derived, prints, tail=None):
        vs = ", ".join(lit(v) for v in values)
        if lang == "python":
            out = ["from math import *"]
            for k, v in vars_:
                out.append(k + " = " + val(v))
            out.append("for " + var + " in [" + vs + "]:")
            for k, e in derived:
                out.append("    " + k + " = " + e)
            for p in prints:
                out.append("    " + pyfmt(*p))
            if tail:
                out += ["    " + x for x in tail[0]]
        else:
            out = c_head()
            for k, v in vars_:
                out.append("    double " + k + " = " + val(v) + ";")
            out.append("    double xs[] = {" + vs + "};")
            out.append("    for (int i = 0; i < " + str(len(values)) + "; i++) {")
            out.append("        double " + var + " = xs[i];")
            for k, e in derived:
                out.append("        double " + k + " = " + e + ";")
            for p in prints:
                out.append("    " + cfmt(*p))
            if tail:
                out += ["        " + x for x in tail[1]]
            out += ["    }", "    return 0;", "}"]
        return "\n".join(out) + "\n"

    def raw(py_lines, c_lines, d):
        out = "\n".join(py_lines if lang == "python" else c_lines) + "\n"
        for k, v in d.items():
            out = out.replace("@" + k + "@", str(v))
        return out

    def frange(a, b, s):
        k = int(round((b - a) / s)) + 1
        return [round(a + i * s, 10) for i in range(k)]

    regime_tail = (
        ["regime = 'laminar' if Re < 2300 else ('transitional' if Re < 4000 else 'turbulent')",
         "print('flow regime:', regime)"],
        ['printf("flow regime: %s\\n", Re < 2300 ? "laminar" : (Re < 4000 ? "transitional" : "turbulent"));'],
    )

    # ---------------- cross-domain loops ----------------
    if has("loops over pipe diameters") and len(tn) >= 5:
        return loop([("Q", tn[3]), ("nu", tn[4])], "D", tn[:3],
                    [("V", "Q/(pi*D*D/4)"), ("Re", "V*D/nu")],
                    [("diameter", "D", "m"), ("mean velocity", "V", "m/s"), ("Reynolds number", "Re", "")])
    if has("loops over water masses") and len(tn) >= 7:
        return loop([("c", tn[6]), ("dT", tn[5])], "m", tn[:5], [("Q", "m*c*dT")],
                    [("mass", "m", "kg"), ("heat", "Q", "J"), ("heat", "Q/1000", "kJ")])
    if has("hydrostatic pressure of fresh water") and len(tn) >= 3:
        return loop([("rho", 1000.0), ("g", 9.81)], "h", frange(tn[0], tn[1], tn[2]),
                    [("p", "rho*g*h")],
                    [("depth", "h", "m"), ("pressure", "p", "Pa"), ("pressure", "p/1000", "kPa")])
    if has("ideal-gas pressure of 1 mol") and len(tn) >= 6:
        return loop([("nmol", tn[0]), ("R", 8.314), ("V", tn[1])], "T", tn[2:],
                    [("P", "nmol*R*T/V")], [("temperature", "T", "K"), ("pressure", "P", "Pa")])
    if has("cold-reservoir") and len(tn) >= 5:
        return loop([("Th", tn[4])], "Tc", tn[:4], [("eta", "(1-Tc/Th)*100")],
                    [("cold reservoir", "Tc", "K"), ("Carnot efficiency", "eta", "%")])
    if has("loops over volumetric flow rates") and len(tn) >= 6:
        return loop([("D", tn[4]), ("nu", tn[5])], "Q", tn[:4],
                    [("V", "Q/(pi*D*D/4)"), ("Re", "V*D/nu")],
                    [("flow rate", "Q", "m^3/s"), ("velocity", "V", "m/s"), ("Reynolds number", "Re", "")],
                    tail=regime_tail)
    if has("three-layer wall"):
        return scalar(
            [("t1", 0.25), ("k1", 0.72), ("t2", 0.12), ("k2", 0.045), ("t3", 0.02), ("k3", 0.8),
             ("A", 12.0), ("Ti", 22.0), ("To", -4.0),
             ("R1", "t1/(k1*A)"), ("R2", "t2/(k2*A)"), ("R3", "t3/(k3*A)"),
             ("Rtot", "R1+R2+R3"), ("Q", "(Ti-To)/Rtot")],
            [("total thermal resistance", "Rtot", "K/W"), ("heat-loss rate", "Q", "W")],
            comment="layer data are example values (brick, insulation, plaster); edit as needed")
    if has("loops over velocities") and len(tn) >= 5:
        return loop([("D", tn[2]), ("L", tn[3]), ("nu", tn[4]), ("g", 9.81)], "V", frange(tn[0], tn[1], 0.2),
                    [("Re", "V*D/nu"),
                     ("f", "(Re<2300)*(64/Re)+(Re>=2300)*0.316*pow(Re,-0.25)"),
                     ("hf", "f*(L/D)*V*V/(2*g)")],
                    [("velocity", "V", "m/s"), ("Reynolds number", "Re", ""),
                     ("friction factor", "f", ""), ("head loss", "hf", "m")])
    if has("newton cooling") and len(tn) >= 4:
        return loop([("T0", tn[0]), ("Ts", tn[1]), ("k", tn[2])], "t", frange(0.0, 60.0, tn[3]),
                    [("T", "Ts+(T0-Ts)*exp(-k*t)")],
                    [("time", "t", "min"), ("temperature", "T", "C")])
    if has("successive stages") and len(tn) >= 3:
        return loop([("T0", tn[0]), ("p0", tn[1]), ("r", tn[2]), ("g", 1.4)], "stage", [1, 2, 3, 4],
                    [("p", "p0*pow(r,stage)"), ("T", "T0*pow(r,stage*(g-1)/g)")],
                    [("stage", "stage", ""), ("pressure", "p", "kPa"), ("temperature", "T", "K")])
    if has("parabolic velocity profile") and len(tn) >= 2:
        py = ["from math import *", "R = @R@", "Umax = @U@", "N = 1000", "dr = R / N", "Q = 0.0",
              "for i in range(N):", "    r = (i + 0.5) * dr",
              "    u = Umax * (1 - (r / R) * (r / R))", "    Q += u * 2 * pi * r * dr",
              "exact = pi * R * R * Umax / 2",
              "print(f'numerical flow rate: {Q:.6g} m^3/s')",
              "print(f'analytic flow rate: {exact:.6g} m^3/s')",
              "print(f'relative error: {abs(Q - exact) / exact:.3g}')"]
        c = c_head() + ["    double R = @R@, Umax = @U@;", "    int N = 1000;", "    double dr = R / N, Q = 0.0;",
                        "    for (int i = 0; i < N; i++) {", "        double r = (i + 0.5) * dr;",
                        "        double u = Umax * (1 - (r / R) * (r / R));",
                        "        Q += u * 2 * pi * r * dr;", "    }",
                        "    double exact = pi * R * R * Umax / 2;",
                        '    printf("numerical flow rate: %.6g m^3/s\\n", Q);',
                        '    printf("analytic flow rate: %.6g m^3/s\\n", exact);',
                        '    printf("relative error: %.3g\\n", fabs(Q - exact) / exact);',
                        "    return 0;", "}"]
        return raw(py, c, {"R": lit(tn[-2]), "U": lit(tn[-1])})
    if has("projectile range") and len(tn) >= 3:
        angs = ", ".join(lit(a) for a in tn[1:])
        py = ["from math import *", "v = @V@", "g = 9.81", "best_angle = 0.0", "best_range = -1.0",
              "for ang in [@ANGS@]:", "    rng = v * v * sin(2 * ang * pi / 180) / g",
              "    print(f'angle {ang:g} deg: range = {rng:.6g} m')",
              "    if rng > best_range:", "        best_range = rng", "        best_angle = ang",
              "print(f'maximum range {best_range:.6g} m at {best_angle:g} deg')"]
        c = c_head() + ["    double v = @V@, g = 9.81;", "    double angs[] = {@ANGS@};",
                        "    double best_angle = 0.0, best_range = -1.0;",
                        "    for (int i = 0; i < @NA@; i++) {",
                        "        double rng = v * v * sin(2 * angs[i] * pi / 180) / g;",
                        '        printf("angle %g deg: range = %.6g m\\n", angs[i], rng);',
                        "        if (rng > best_range) { best_range = rng; best_angle = angs[i]; }", "    }",
                        '    printf("maximum range %.6g m at %g deg\\n", best_range, best_angle);',
                        "    return 0;", "}"]
        return raw(py, c, {"V": lit(tn[0]), "ANGS": angs, "NA": len(tn) - 1})
    if has("tank of surface area") and len(tn) >= 3:
        py = ["from math import *", "A = @A@", "a = @a@", "h = @h@", "dt = @dt@", "g = 9.81", "t = 0.0",
              "while h > 0:", "    h = max(h - a * sqrt(2 * g * h) / A * dt, 0.0)", "    t += dt",
              "print(f'time to empty: {t:.6g} s')"]
        c = c_head() + ["    double A = @A@, a = @a@, h = @h@, dt = @dt@, g = 9.81, t = 0.0;",
                        "    while (h > 0) {", "        h = h - a * sqrt(2 * g * h) / A * dt;",
                        "        if (h < 0) h = 0;", "        t += dt;", "    }",
                        '    printf("time to empty: %.6g s\\n", t);', "    return 0;", "}"]
        return raw(py, c, {"A": lit(tn[0]), "a": lit(tn[1]), "h": lit(tn[2]),
                           "dt": lit(tn[3] if len(tn) > 3 else 1.0)})
    if has("finite-difference") and len(tn) >= 6:
        py = ["from math import *", "N = @N@", "T_left = @TL@", "T_right = @TR@", "alpha = @AL@",
              "L = @L@", "steps = @ST@", "dx = L / (N - 1)", "dt = 0.4 * dx * dx / alpha",
              "r = alpha * dt / (dx * dx)", "T = [0.0] * N", "T[0] = T_left", "T[N - 1] = T_right",
              "for _ in range(steps):", "    Tn = T[:]", "    for i in range(1, N - 1):",
              "        Tn[i] = T[i] + r * (T[i + 1] - 2 * T[i] + T[i - 1])", "    T = Tn",
              "print(f'time step: {dt:.6g} s')", "for i in range(N):",
              "    print(f'node {i}: x = {i * dx:.6g} m, T = {T[i]:.6g} C')"]
        c = c_head() + ["    int N = @N@, steps = @ST@;",
                        "    double T_left = @TL@, T_right = @TR@, alpha = @AL@, L = @L@;",
                        "    double T[256] = {0}, Tn[256];", "    double dx = L / (N - 1);",
                        "    double dt = 0.4 * dx * dx / alpha;", "    double r = alpha * dt / (dx * dx);",
                        "    T[0] = T_left; T[N - 1] = T_right;",
                        "    for (int s = 0; s < steps; s++) {",
                        "        for (int i = 0; i < N; i++) Tn[i] = T[i];",
                        "        for (int i = 1; i < N - 1; i++) Tn[i] = T[i] + r * (T[i + 1] - 2 * T[i] + T[i - 1]);",
                        "        for (int i = 0; i < N; i++) T[i] = Tn[i];", "    }",
                        '    printf("time step: %.6g s\\n", dt);',
                        '    for (int i = 0; i < N; i++) printf("node %d: x = %.6g m, T = %.6g C\\n", i, i * dx, T[i]);',
                        "    return 0;", "}"]
        return raw(py, c, {"N": int(tn[0]), "TL": lit(tn[1]), "TR": lit(tn[2]), "AL": lit(tn[3]),
                           "L": lit(tn[4]), "ST": int(tn[5])})
    if has("colebrook") and len(tn) >= 2:
        py = ["from math import *", "Re = @RE@", "rr = @RR@", "f = 0.02", "used = 0",
              "for it in range(1, 101):", "    used = it",
              "    rhs = -2 * log10(rr / 3.7 + 2.51 / (Re * sqrt(f)))", "    fn = 1 / (rhs * rhs)",
              "    if abs(fn - f) < 1e-12:", "        f = fn", "        break", "    f = fn",
              "print(f'Darcy friction factor: {f:.6g}')", "print(f'iterations: {used}')"]
        c = c_head() + ["    double Re = @RE@, rr = @RR@, f = 0.02;", "    int used = 0;",
                        "    for (int it = 1; it <= 100; it++) {", "        used = it;",
                        "        double rhs = -2 * log10(rr / 3.7 + 2.51 / (Re * sqrt(f)));",
                        "        double fn = 1 / (rhs * rhs);",
                        "        if (fabs(fn - f) < 1e-12) { f = fn; break; }", "        f = fn;", "    }",
                        '    printf("Darcy friction factor: %.6g\\n", f);',
                        '    printf("iterations: %d\\n", used);', "    return 0;", "}"]
        return raw(py, c, {"RE": lit(tn[0]), "RR": lit(tn[1])})
    if has("otto-cycle") and len(tn) >= 3:
        return loop([("g", tn[-1])], "r", frange(tn[-3], tn[-2], 1.0), [("eta", "(1-pow(r,1-g))*100")],
                    [("compression ratio", "r", ""), ("efficiency", "eta", "%")])
    if has("water heated by") and len(tn) >= 5:
        py = ["from math import *", "m = @M@", "cp = 4186.0", "P = @P@", "UA = @UA@", "Tamb = @TA@",
              "dt = @DT@", "T = Tamb", "steps = int(7200 / dt)", "every = int(600 / dt)",
              "for step in range(1, steps + 1):", "    T += (P - UA * (T - Tamb)) / (m * cp) * dt",
              "    if step % every == 0:", "        print(f'time {step * dt / 60:g} min: T = {T:.6g} C')"]
        c = c_head() + ["    double m = @M@, cp = 4186.0, P = @P@, UA = @UA@, Tamb = @TA@, dt = @DT@;",
                        "    double T = Tamb;", "    int steps = (int)(7200 / dt), every = (int)(600 / dt);",
                        "    for (int step = 1; step <= steps; step++) {",
                        "        T += (P - UA * (T - Tamb)) / (m * cp) * dt;",
                        '        if (step % every == 0) printf("time %g min: T = %.6g C\\n", step * dt / 60, T);',
                        "    }", "    return 0;", "}"]
        return raw(py, c, {"M": lit(tn[0]), "P": lit(tn[1] * 1000.0), "UA": lit(tn[2]),
                           "TA": lit(tn[3]), "DT": lit(tn[4])})
    if has("dittus-boelter") and len(tn) >= 4:
        Re, Pr, D, k = tn[-4:]
        return scalar([("Re", Re), ("Pr", Pr), ("D", D), ("k", k),
                       ("Nu", "0.023*pow(Re,0.8)*pow(Pr,0.4)"), ("h", "Nu*k/D")],
                      [("Nu", "Nu", ""), ("h", "h", "W/(m^2 K)")])

    # ---------------- calculus programs ----------------
    xm = re.search(r"at x = (-?[\d.]+)", task)
    x0 = xm.group(1) if xm else None
    bm = re.search(r"from (-?[\d.]+|π) to (-?[\d.]+|π)", task)
    nm = re.search(r"(\d+) (?:intervals|panels|steps)", task)

    def calc(kind, fx, dfx=None, x0=None, a=None, b=None, n=None, exact=None, xs=None, lim=None):
        if lang == "python":
            out = ["from math import *", "", "def f(x):", "    return " + fx, ""]
            if dfx:
                out += ["def df(x):", "    return " + dfx, ""]
            if kind == "diff":
                out += ["x0 = " + x0, "h = 1e-5",
                        "central = (f(x0 + h) - f(x0 - h)) / (2 * h)", "analytic = df(x0)",
                        pyfmt("analytic derivative", "analytic", "", "8"),
                        pyfmt("central difference", "central", "", "8"),
                        pyfmt("absolute error", "abs(central - analytic)", "", "3")]
            elif kind in ("trap", "simp"):
                out += ["a = " + a, "b = " + b, "n = " + str(n), "hs = (b - a) / n"]
                if kind == "trap":
                    out += ["s = 0.5 * (f(a) + f(b))", "for i in range(1, n):", "    s += f(a + i * hs)",
                            "approx = s * hs"]
                else:
                    out += ["s = f(a) + f(b)", "for i in range(1, n):",
                            "    s += (4 if i % 2 else 2) * f(a + i * hs)", "approx = s * hs / 3"]
                out += ["exact = " + exact,
                        pyfmt("numerical result", "approx", "", "10"),
                        pyfmt("exact value", "exact", "", "10"),
                        pyfmt("absolute error", "abs(approx - exact)", "", "3")]
            elif kind == "limit":
                out += ["for h in (0.1, 0.01, 0.001):", "    x = " + lim + " + h",
                        "    print(f'h = {h:g}: f(x) = {f(x):.8g}')"]
            else:
                out += ["for x in (" + ", ".join(lit(v) for v in xs) + "):",
                        "    print(f'x = {x:g}: tan(x)/x = {f(x):.8g}')"]
            return "\n".join(out) + "\n"
        out = ["#include <stdio.h>", "#include <math.h>", "",
               "static double f(double x) { return " + fx + "; }"]
        if dfx:
            out.append("static double df(double x) { return " + dfx + "; }")
        out += ["", "int main(void) {", "    double pi = " + pi_s + ";"]
        if kind == "diff":
            out += ["    double x0 = " + x0 + ", h = 1e-5;",
                    "    double central = (f(x0 + h) - f(x0 - h)) / (2 * h);",
                    "    double analytic = df(x0);",
                    cfmt("analytic derivative", "analytic", "", "8"),
                    cfmt("central difference", "central", "", "8"),
                    cfmt("absolute error", "fabs(central - analytic)", "", "3")]
        elif kind in ("trap", "simp"):
            out += ["    double a = " + a + ", b = " + b + ";", "    int n = " + str(n) + ";",
                    "    double hs = (b - a) / n, s, approx;"]
            if kind == "trap":
                out += ["    s = 0.5 * (f(a) + f(b));",
                        "    for (int i = 1; i < n; i++) s += f(a + i * hs);", "    approx = s * hs;"]
            else:
                out += ["    s = f(a) + f(b);",
                        "    for (int i = 1; i < n; i++) s += (i % 2 ? 4 : 2) * f(a + i * hs);",
                        "    approx = s * hs / 3;"]
            out += ["    double exact = " + exact + ";",
                    cfmt("numerical result", "approx", "", "10"),
                    cfmt("exact value", "exact", "", "10"),
                    cfmt("absolute error", "fabs(approx - exact)", "", "3")]
        elif kind == "limit":
            out += ["    double hs[] = {0.1, 0.01, 0.001};", "    for (int i = 0; i < 3; i++) {",
                    "        double x = " + lim + " + hs[i];",
                    '        printf("h = %g: f(x) = %.8g\\n", hs[i], f(x));', "    }"]
        else:
            out += ["    double xs[] = {" + ", ".join(lit(v) for v in xs) + "};",
                    "    for (int i = 0; i < " + str(len(xs)) + "; i++)",
                    '        printf("x = %g: tan(x)/x = %.8g\\n", xs[i], f(xs[i]));']
        out += ["    return 0;", "}"]
        return "\n".join(out) + "\n"

    poly = "4*pow(x,3)+3*x"
    poly_exact = "pow(b,4)+1.5*pow(b,2)-pow(a,4)-1.5*pow(a,2)"
    if has("numerically differentiates cos(x)") and x0:
        return calc("diff", "cos(x)", "-sin(x)", x0=x0)
    if has("x²·cos(x)") and x0:
        return calc("diff", "x*x*cos(x)", "2*x*cos(x)-x*x*sin(x)", x0=x0)
    if has("(x² + 4)/(x - 2)") and x0:
        return calc("diff", "(x*x+4)/(x-2)", "(x*x-4*x-4)/pow(x-2,2)", x0=x0)
    if has("cos(x³ + 3x)") and x0:
        return calc("diff", "cos(pow(x,3)+3*x)", "-(3*x*x+3)*sin(pow(x,3)+3*x)", x0=x0)
    if has("ln(x³ + 2x² + 2)") and x0:
        return calc("diff", "log(pow(x,3)+2*pow(x,2)+2)",
                    "(3*x*x+4*x)/(pow(x,3)+2*pow(x,2)+2)", x0=x0)
    if has("estimates the limit", "(x² - 9)/(x - 3)"):
        lm = re.search(r"→ (-?[\d.]+)", task)
        return calc("limit", "(x*x-9)/(x-3)", lim=lm.group(1) if lm else "3")
    if has("tan(x)/x", "x = "):
        seg = task.split("x = ", 1)[1].split(" to illustrate")[0]
        xs = nums(seg)
        if xs:
            return calc("table", "tan(x)/x", xs=xs)
    if bm and nm:
        a, b = bm.group(1).replace("π", "pi"), bm.group(2).replace("π", "pi")
        n_ = int(nm.group(1))
        if has("trapezoidal", "4x³ + 3x"):
            return calc("trap", poly, a=a, b=b, n=n_, exact=poly_exact)
        if has("simpson", "4x³ + 3x"):
            return calc("simp", poly, a=a, b=b, n=n_, exact=poly_exact)
        if has("trapezoidal", "x·exp(x²)"):
            return calc("trap", "x*exp(x*x)", a=a, b=b, n=n_, exact="(exp(b*b)-exp(a*a))/2")
        if has("simpson", "x·cos(x) from"):
            return calc("simp", "x*cos(x)", a=a, b=b, n=n_,
                        exact="(b*sin(b)+cos(b))-(a*sin(a)+cos(a))")

    # ---------------- single-value programs ----------------
    if (has("heat required to raise") or has("heat needed to raise")) and "kilojoules" in task and len(tn) >= 4:
        m_, T1, T2, c_ = tn[:4]
        return scalar([("m", m_), ("c", c_), ("T1", T1), ("T2", T2)],
                      [("heat", "m*c*(T2-T1)", "J"), ("heat", "m*c*(T2-T1)/1000", "kJ")])
    if has("carnot efficiency expressed as a percentage") and len(tn) >= 2:
        return scalar([("Th", tn[0]), ("Tc", tn[1])], [("Carnot efficiency", "(1-Tc/Th)*100", "%")])
    if has("ideal-gas law") and len(tn) >= 3:
        return scalar([("nmol", tn[0]), ("R", 8.314), ("T", tn[1]), ("V", tn[2])],
                      [("pressure", "nmol*R*T/V", "Pa"), ("pressure", "nmol*R*T/V/1000", "kPa")])
    if has("conduction rate") and len(tn) >= 4:
        return scalar([("k", tn[0]), ("A", tn[1]), ("dT", tn[2]), ("L", tn[3])],
                      [("conduction rate", "k*A*dT/L", "W")])
    if has("heat absorbed by") and len(tn) >= 4:
        return scalar([("m", tn[0]), ("c", tn[1]), ("T1", tn[2]), ("T2", tn[3])],
                      [("heat absorbed", "m*c*(T2-T1)", "J")])
    if has("isothermal compression") and len(tn) >= 3:
        return scalar([("P1", tn[0]), ("V1", tn[1]), ("V2", tn[2])],
                      [("final pressure", "P1*V1/V2", "kPa")])
    if has("isentropically") and len(tn) >= 3:
        return scalar([("T1", tn[0]), ("r", tn[1]), ("g", tn[2])],
                      [("exit temperature", "T1*pow(r,(g-1)/g)", "K")])
    if has("net work of a carnot") and len(tn) >= 3:
        return scalar([("Qh", tn[0]), ("Th", tn[1]), ("Tc", tn[2])],
                      [("net work", "Qh*(1-Tc/Th)", "J")])
    if has("combined gas law") and len(tn) >= 5:
        return scalar([("P1", tn[0]), ("V1", tn[1]), ("T1", tn[2]), ("P2", tn[3]), ("T2", tn[4])],
                      [("V2", "P1*V1*T2/(T1*P2)", "L")])
    if has("mixing") and len(tn) >= 4:
        return scalar([("m1", tn[0]), ("T1", tn[1]), ("m2", tn[2]), ("T2", tn[3])],
                      [("final temperature", "(m1*T1+m2*T2)/(m1+m2)", "C")])
    if has("two-layer wall") and len(tn) >= 7:
        return scalar([("t1", tn[0]), ("k1", tn[1]), ("t2", tn[2]), ("k2", tn[3]), ("A", tn[4]),
                       ("Ti", tn[5]), ("To", tn[6]), ("Rtot", "t1/(k1*A)+t2/(k2*A)")],
                      [("total thermal resistance", "Rtot", "K/W"), ("heat-loss rate", "(Ti-To)/Rtot", "W")])
    if has("ice at", "steam") and len(tn) >= 3:
        return scalar([("m", tn[0]), ("T0", tn[1]), ("Tf", tn[2]), ("ci", 2100.0), ("Lf", 334000.0),
                       ("cw", 4186.0), ("Lv", 2260000.0), ("cs", 2010.0)],
                      [("total heat", "m*(ci*(0-T0)+Lf+cw*100+Lv+cs*(Tf-100))", "J")],
                      comment="steam specific heat cs is an assumed value; it is not given in the prompt")
    if has("mean velocity inside") and len(tn) >= 2:
        return scalar([("D", tn[0]), ("Q", tn[1])], [("mean velocity", "Q/(pi*D*D/4)", "m/s")])
    if has("hydrostatic pressure for a fluid") and len(tn) >= 2:
        return scalar([("rho", tn[0]), ("h", tn[1]), ("g", 9.81)], [("hydrostatic pressure", "rho*g*h", "Pa")])
    if has("reynolds number") and len(tn) >= 3:
        return scalar([("V", tn[0]), ("D", tn[1]), ("nu", tn[2]), ("Re", "V*D/nu")],
                      [("Reynolds number", "Re", "")], tail=regime_tail)
    if has("applies continuity") and len(tn) >= 3:
        return scalar([("A1", tn[0]), ("V1", tn[1]), ("A2", tn[2])], [("V2", "A1*V1/A2", "m/s")])
    if has("darcy-weisbach") and len(tn) >= 4:
        return scalar([("f", tn[0]), ("L", tn[1]), ("D", tn[2]), ("V", tn[3]), ("g", 9.81)],
                      [("head loss", "f*(L/D)*V*V/(2*g)", "m")])
    if has("mass-flow rate of water") and len(tn) >= 3:
        return scalar([("rho", tn[0]), ("V", tn[1]), ("D", tn[2])],
                      [("mass-flow rate", "rho*(pi*D*D/4)*V", "kg/s")])
    if has("bernoulli") and len(tn) >= 4:
        return scalar([("p1", tn[0] * 1000.0), ("V1", tn[1]), ("V2", tn[2]), ("rho", tn[3]),
                       ("p2", "p1+0.5*rho*(V1*V1-V2*V2)")],
                      [("second-station pressure", "p2", "Pa"), ("second-station pressure", "p2/1000", "kPa")])
    if has("efflux velocity") and len(tn) >= 1:
        return scalar([("h", tn[0]), ("g", 9.81)], [("efflux velocity", "sqrt(2*g*h)", "m/s")])
    if has("dynamic pressure of air") and len(tn) >= 2:
        return scalar([("rho", tn[0]), ("V", tn[1])], [("dynamic pressure", "0.5*rho*V*V", "Pa")])
    if has("poiseuille") and len(tn) >= 4:
        return scalar([("R", tn[0]), ("L", tn[1]), ("dp", tn[2]), ("mu", tn[3])],
                      [("flow rate", "pi*pow(R,4)*dp/(8*mu*L)", "m^3/s")])
    if has("shaft power") and len(tn) >= 4:
        return scalar([("Q", tn[0]), ("H", tn[1]), ("eta", tn[2] / 100.0), ("rho", tn[3]), ("g", 9.81)],
                      [("shaft power", "rho*g*Q*H/eta", "W")])
    if has("stokes") and len(tn) >= 4:
        return scalar([("r", tn[0] / 1000.0), ("rs", tn[1]), ("rf", tn[2]), ("mu", tn[3]), ("g", 9.81)],
                      [("terminal velocity", "2*r*r*g*(rs-rf)/(9*mu)", "m/s")])
    return None


