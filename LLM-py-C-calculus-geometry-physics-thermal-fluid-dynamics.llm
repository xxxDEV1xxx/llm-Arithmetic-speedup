    if lang == "python" and "bank account" in low and "deposit" in low and "withdraw" in low:
        return r"""import unittest

class BankAccount:
    def __init__(self, balance=0):
        if balance < 0:
            raise ValueError("initial balance cannot be negative")
        self._balance = balance

    def deposit(self, amount):
        if amount < 0:
            raise ValueError("deposit cannot be negative")
        self._balance += amount
        return self._balance

    def withdraw(self, amount):
        if amount < 0:
            raise ValueError("withdrawal cannot be negative")
        if amount > self._balance:
            raise ValueError("insufficient funds")
        self._balance -= amount
        return self._balance

    def balance(self):
        return self._balance

class BankAccountTests(unittest.TestCase):
    def test_deposit_and_withdraw(self):
        account = BankAccount(100)
        account.deposit(50)
        account.withdraw(30)
        self.assertEqual(account.balance(), 120)

    def test_negative_deposit(self):
        with self.assertRaises(ValueError):
            BankAccount().deposit(-1)

    def test_negative_withdrawal(self):
        with self.assertRaises(ValueError):
            BankAccount(10).withdraw(-1)

    def test_overdraft(self):
        with self.assertRaisesRegex(ValueError, "insufficient"):
            BankAccount(10).withdraw(11)

    def test_zero_balance(self):
        self.assertEqual(BankAccount().balance(), 0)

if __name__ == "__main__":
    unittest.main()
"""

    if lang == "python" and "merge sort" in low and "recursive" in low:
        return r"""import unittest

def merge_sort(items):
    if len(items) <= 1:
        return list(items)
    middle = len(items) // 2
    left = merge_sort(items[:middle])
    right = merge_sort(items[middle:])
    result = []
    i = j = 0
    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1
    result.extend(left[i:])
    result.extend(right[j:])
    return result

class MergeSortTests(unittest.TestCase):
    def test_sorted(self):
        self.assertEqual(merge_sort([1, 2, 3]), [1, 2, 3])

    def test_reverse_sorted(self):
        self.assertEqual(merge_sort([4, 3, 2, 1]), [1, 2, 3, 4])

    def test_empty(self):
        self.assertEqual(merge_sort([]), [])

    def test_duplicates(self):
        self.assertEqual(merge_sort([3, 1, 3, 2, 1]), [1, 1, 2, 3, 3])

if __name__ == "__main__":
    unittest.main()
