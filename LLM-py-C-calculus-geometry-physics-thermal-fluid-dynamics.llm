def parse_packet(data):
    if len(data) < 2:
        raise ValueError("truncated length header")
    length = int.from_bytes(data[:2], "big")
    expected = 2 + length
    if len(data) < expected:
        raise ValueError("truncated payload")
    if len(data) > expected:
        raise ValueError("length mismatch")
    return data[2:]

class LengthPacketTests(unittest.TestCase):
    def test_valid(self):
        self.assertEqual(parse_packet(b"\x00\x03abc"), b"abc")

    def test_empty(self):
        self.assertEqual(parse_packet(b"\x00\x00"), b"")

    def test_truncated_header(self):
