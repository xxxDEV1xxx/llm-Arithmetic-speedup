import io
import unittest

def parse_csv(text, required_columns):
    reader = csv.DictReader(io.StringIO(text, newline=""))
    if not reader.fieldnames:
        raise ValueError("CSV header is missing")
    missing = set(required_columns) - set(reader.fieldnames)
    if missing:
        raise ValueError("missing required columns: " + ", ".join(sorted(missing)))
    records = []
    errors = []
    for line_number, row in enumerate(reader, start=2):
        if None in row or any(value is None for value in row.values()):
            errors.append(f"line {line_number}: malformed column count")
            continue
        records.append(row)
    return records, errors

class CSVTests(unittest.TestCase):
    def test_valid(self):
        rows, errors = parse_csv("name,age\nAda,37\nLin,28\n", ["name", "age"])
        self.assertEqual(len(rows), 2)
        self.assertEqual(rows[0]["name"], "Ada")
        self.assertEqual(errors, [])

    def test_missing_required_column(self):
        with self.assertRaisesRegex(ValueError, "missing required"):
            parse_csv("name\nAda\n", ["name", "age"])

    def test_malformed_rows_reported(self):
        rows, errors = parse_csv("name,age\nAda,37\nBad\nExtra,1,x\n", ["name", "age"])
        self.assertEqual(len(rows), 1)
        self.assertEqual(len(errors), 2)

    def test_empty_input(self):
        with self.assertRaises(ValueError):
            parse_csv("", ["name"])

if __name__ == "__main__":
    unittest.main()
