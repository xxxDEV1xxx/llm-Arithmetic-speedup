            "print(f'integral: {res}')\n"
            "print(f'error vs pi: {abs(res-math.pi)}')",
            "    double pi=3.141592653589793; int n=200; if(n%2)n++;\n"
            "    double a=0,b=pi,h=(b-a)/n,s=0+b*sin(b);\n"
