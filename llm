            r"\s*=\s*([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)",
            low
        )
        return float(match.group(1)) if match else default

    def numbers_after(label, default):
        match = re.search(
            label + r"\s*(?:=|:)\s*"
            r"(\[[^\]]+\]|[-+0-9.eE,\s]+(?:and\s+[-+0-9.eE,\s]+)?)",
            low
        )
        if not match:
            return default
        raw = match.group(1).strip().strip("[]")
        found = re.findall(
            r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?",
            raw
        )
        return [float(x) for x in found] if found else default

