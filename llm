def freezer(action):
    """Freeze or thaw the complete Ollama service."""
    if action not in {"freeze", "thaw"}:
        raise ValueError(f"unknown freezer action: {action}")

    state = "FROZEN" if action == "freeze" else "THAWED"
    try:
