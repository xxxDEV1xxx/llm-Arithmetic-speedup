def screensaver_dynamics_fast_path(text):
    """Emit full screensaver engine source or evaluate core equations."""
    import math
    import re

    raw = re.sub(r"\s+", " ", text.lower()).strip()

    want_code = bool(re.search(
        r"\b(?:reproduce|implement|generate|emit|source code|full code|on demand|give me the|write the|port the|show code|complete engine|runnable)\b",
        raw,
    ))
    fl2 = re.search(r"\bfluid ?2\b", raw)
    camp = re.search(r"\bcamp ?fire\b", raw)
    rain = re.search(r"\brain(?:drop)? wave\b|\braindrop\b|\bripple wave\b|\bwave only\b", raw)
    every = re.search(r"\ball (?:three |the )?(?:engines|screensavers)\b", raw)

    # ---- Full engine emission (needs a code verb AND an engine name) ----
    if want_code and every:
        return (
            "All emitted engines:\n\n=== FLUID2 ===\n" + FLUID2_SRC
            + "\n=== CAMPFIRE ===\n" + CAMPFIRE_SRC
            + "\n=== RAIN WAVE ===\n" + WAVE_SRC
        )
    if want_code and fl2:
        return "Fluid2 engine (complete working form):\n\n" + FLUID2_SRC
    if want_code and camp:
        return "Campfire engine (complete working form):\n\n" + CAMPFIRE_SRC
    if want_code and rain:
        return "Standalone raindrop wave subsystem:\n\n" + WAVE_SRC

    # ---- Numeric helpers (kept for synthesis tweaks) ----
    number = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"
    def get(labels, units=None):
        unit_part = r"\s*(?:" + units + r")?" if units else r""
        pattern = r"(?<![a-z])(?:" + labels + r")\s*(?:(?:is|of|equals?|=|:)\s*)?" + number + unit_part
        m = re.search(pattern, raw)
        return float(m.group(1)) if m else None

    n, s_, e, w = get(r"north|n\b"), get(r"south|s\b"), get(r"east|e\b"), get(r"west|w\b")
    prev = get(r"previous|prev|waveprev")
    damp = get(r"damp|damping")
    if None not in (n, s_, e, w, prev) and "wave" in raw:
        d = damp if damp is not None else 0.985
        nb = n + s_ + e + w
        v = (nb * 0.5 - prev) * d + nb * 0.003
        clamp = get(r"clamp") or 24.0
        v = max(-clamp, min(clamp, v))
        return f"Wave step: nb={nb:g}, v={v:g} (damp={d:g}, clamp=±{clamp:g})"

    energy, dx, dy = get(r"energy|impulse|splash"), get(r"dx"), get(r"dy")
    if energy is not None and dx is not None and dy is not None:
        k = get(r"kernel|falloff") or 0.12
        return f"Rain impulse Δwave={energy * math.exp(-(dx*dx+dy*dy)*k):.6g}"

    gm, dist, soft = get(r"gm"), get(r"distance|r\b"), get(r"soft")
    if gm is not None and dist is not None:
        soft = soft if soft is not None else 4.0
        return f"Soft gravity force={gm / (dist*dist + soft*soft):.6g}"

    return None


