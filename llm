    # Also derive temperature difference from labeled initial/final temperatures.
    ti = get(r"initial temperature|starting temperature|cold temperature", r"k\b|deg\s*c\b|celsius\b|kelvin\b")
    tf = get(r"final temperature|ending temperature|hot temperature", r"k\b|deg\s*c\b|celsius\b|kelvin\b")
    if dt is None and ti is not None and tf is not None:
        dt = tf - ti

    # Sensible heat: Q = m*cp*deltaT; inverse forms solve deltaT or cp.
    if mass is not None and mass > 0 and cp is not None and cp > 0:
        if energy is not None and (
            "specific heat" in raw or "specific heat capacity" in raw or "solve for cp" in raw
        ) and dt is not None and dt != 0:
            result = energy / (mass * dt)
            return (
                "Specific heat capacity:\n"
                f"cp = Q/(m*deltaT) = {energy:g} J/({mass:g} kg*{dt:g} K)\n"
                f"cp = {result:.6g} J/(kg*K)"
            )

        if energy is not None and dt is None:
            result = energy / (mass * cp)
            return (
                "Temperature change from sensible heat:\n"
                f"deltaT = Q/(m*cp) = {energy:g}/({mass:g}*{cp:g})\n"
                f"deltaT = {result:.6g} K"
            )

        if dt is not None and (
            energy is None or "calculate heat" in raw or "heat required" in raw
            or "heat energy" in raw or "thermal energy" in raw
            or "how much heat" in raw or "heat is needed" in raw
            or "heat needed" in raw
        ):
            result = mass * cp * dt
            return (
                "Sensible heat:\n"
                f"Q = m*cp*deltaT = {mass:g} kg*{cp:g} J/(kg*K)*{dt:g} K\n"
                f"Q = {result:.6g} J"
            )

    # Heat transfer rate from transferred energy and elapsed time: P = Q/t.
    elapsed = get(r"elapsed time|duration|time", r"s\b")
    if energy is not None and elapsed is not None and elapsed > 0 and (
        "heat transfer rate" in raw or "heat rate" in raw or "power" in raw
    ):
        rate = energy / elapsed
        return (
            "Average heat-transfer rate:\n"
            f"P = Q/t = {energy:g} J/{elapsed:g} s\n"
