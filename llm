def radiation_dynamics_fast_path(text):
    """Deterministic radiation / Geiger calculations (robust + OOK + equal-spacing)."""
    import re
    from collections import Counter

    raw = text.lower()
    raw = raw.replace("μ", "u").replace("µ", "u").replace("μsv", "usv").replace("µsv", "usv")
    raw = raw.replace("Δ", "delta ").replace("δ", "delta ")
    raw = re.sub(r"\s+", " ", raw).strip()

    number = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"

    def get(labels, units=None):
        unit_part = r"\s*(?:" + units + r")?" if units else r""
        pattern = (
            r"(?<![a-z])(?:"
            + labels
            + r")\s*(?:(?:is|of|equals?|=|:)\s*)?"
            + number
            + unit_part
        )
        m = re.search(pattern, raw)
        return float(m.group(1)) if m else None

    dr       = get(r"dose[\s-]*rate|dr\b", r"u?sv\s*/\s*h|usv/h")
    cps      = get(r"cps|counts?\s*per\s*second|count\s*rate")
    cpm      = get(r"cpm|counts?\s*per\s*minute")
    dose     = get(r"(?:current\s+)?dose\b", r"u?sv\b")
    baseline = get(r"baseline(?:\s+dose)?|background(?:\s+dose)?|device\s+dose\s+base", r"u?sv\b")
    distance = get(r"distance|\bd\b", r"m\b")
    peak     = get(r"peak(?:\s+dr|\s+dose\s*rate)?", r"u?sv\s*/\s*h|usv/h")
    floor_   = get(r"floor(?:\s+dr)?|background|min\s*dr", r"u?sv\s*/\s*h|usv/h")
    mean_cps = get(r"mean\s*cps|average\s*cps|mu\b|mean\s*count\s*rate")
    var_cps  = get(r"variance|sigma\s*\^?\s*2|s2\b")
    cv_iat   = get(r"cv[\s_]*iat|coefficient\s+of\s+variation|\bcv\b")

    RF_K_LOW, RF_K_MID, RF_K_HIGH = 0.01, 0.20, 1.00
    RF_DIST = 0.50
    SPIKE, ELEVATED, LOW = 0.27, 0.20, 0.10

    # 1. State classification
    if dr is not None and any(k in raw for k in (
            "state", "classify", "level", "spike", "elevated", "flat", "normal")):
        if dr >= SPIKE:      state = "SPIKE"
        elif dr >= ELEVATED: state = "ELEVATED"
        elif dr >= LOW:      state = "LOW ELEVATED"
        else:                state = "NORMAL / FLAT"
        return (
            "Dose-rate state classification:\n"
            f"DR = {dr:g} µSv/h\n"
            f"Thresholds: FLAT < {LOW}, LOW {LOW}–{ELEVATED}, "
            f"ELEVATED {ELEVATED}–{SPIKE}, SPIKE ≥ {SPIKE}\n"
            f"State = {state}"
        )

    # 2. CPM <-> CPS
    if cps is not None and ("cpm" in raw or "per minute" in raw):
        return (
            "Counts per minute:\n"
            f"CPM = CPS × 60 = {cps:g} × 60\n"
            f"CPM = {cps*60:.6g}"
        )
    if cpm is not None and ("cps" in raw or "per second" in raw):
        return (
            "Counts per second:\n"
            f"CPS = CPM / 60 = {cpm:g} / 60\n"
            f"CPS = {cpm/60:.6g}"
        )

    # 3. Session dose
    if dose is not None and baseline is not None:
        delta = dose - baseline
        return (
            "Session dose:\n"
            f"Δdose = current − baseline = {dose:g} − {baseline:g}\n"
            f"Δdose = {delta:.6g} µSv"
        )

    # 4. RF power estimate
    if cps is not None and any(k in raw for k in (
            "rf power", "power estimate", "rf est", "estimated power", "power")):
        d = distance if distance is not None else RF_DIST
        p_mid  = cps * d * d / RF_K_MID
        p_low  = cps * d * d / RF_K_HIGH
        p_high = cps * d * d / RF_K_LOW
        return (
            "RF power estimate (P = C·d²/K):\n"
            f"CPS = {cps:g}, d = {d:g} m\n"
            f"P_mid (K={RF_K_MID}) = {p_mid:.6g} W\n"
            f"P range = {p_low:.6g} … {p_high:.6g} W"
        )

    # 5. Poisson variance ratio
    if mean_cps is not None and var_cps is not None and mean_cps > 0:
        pvr = var_cps / mean_cps
        natural = 0.20 <= pvr <= 4.00
        return (
            "Poisson variance ratio:\n"
            f"σ²/μ = {var_cps:g} / {mean_cps:g} = {pvr:.6g}\n"
            f"Natural range ≈ 0.20–4.00 → "
            f"{'NATURAL' if natural else 'STRUCTURED / NON-NATURAL'}"
        )

    # 6. CV_IAT classification
    if cv_iat is not None:
        if cv_iat < 0.30:
            verdict = "STRUCTURED (non-Poisson)"
        elif 0.60 <= cv_iat <= 1.40:
            verdict = "POISSON / NATURAL"
        else:
            verdict = "INTERMEDIATE"
        return (
            "Inter-arrival CV classification:\n"
            f"CV_IAT = {cv_iat:g}\n"
            f"Verdict = {verdict}"
        )

    # 7. Two-source / beat decomposition
    if peak is not None and floor_ is not None and peak > floor_ > 0:
        a1 = (peak + floor_) / 2.0
        a2 = (peak - floor_) / 2.0
        return (
            "Two-source / beat envelope decomposition:\n"
            f"A1 = (peak+floor)/2 = {a1:.6g} µSv/h\n"
            f"A2 = (peak−floor)/2 = {a2:.6g} µSv/h\n"
            f"A2/A1 = {a2/a1:.6g}, floor/peak = {floor_/peak:.6g}"
        )

    # 8. Peak/floor ratio
    if peak is not None and floor_ is not None and floor_ > 0 and "ratio" in raw:
        return (
            "Peak-to-floor ratio:\n"
            f"peak/floor = {peak:g} / {floor_:g} = {peak/floor_:.6g}"
        )

    # ── Parse CPS sequence ────────────────────────────────────────────────

    def parse_cps_sequence(txt):
        # 1. Prefer text after the word "sequence" / "series" / "pattern"
        m = re.search(
            r"(?:sequence|series|pattern|counts?|burst)\s*[:=]?\s*([0-9\s,;\[\]]{7,})",
            txt,
        )
        if m:
            nums = re.findall(r"\d+", m.group(1))
            if len(nums) >= 4:
                return [int(x) for x in nums]
        # 2. Fallback: any run of 4+ integers anywhere
        m = re.search(r"((?:\d+[\s,;]+){3,}\d+)", txt)
        if m:
            nums = re.findall(r"\d+", m.group(1))
            if len(nums) >= 4:
                return [int(x) for x in nums]
        return None

    seq = parse_cps_sequence(raw)


    # ── OOK detector ──────────────────────────────────────────────────────
    if seq is not None and any(k in raw for k in (
            "ook", "on-off", "on off", "keying", "burst pattern",
            "on/off", "ook check", "burst")):
        try:
            runs = []
            cur, length = seq[0], 1
            for v in seq[1:]:
                if v == cur:
                    length += 1
                else:
                    runs.append((cur, length))
                    cur, length = v, 1
            runs.append((cur, length))

            bursts = []
            i = 0
            while i < len(runs):
                val, runlen = runs[i]
                if val > 0:
                    gap = 0
                    if i + 1 < len(runs) and runs[i + 1][0] == 0:
                        gap = runs[i + 1][1]
                        i += 1
                    bursts.append((val, runlen, gap))
                i += 1

            if len(bursts) >= 3:
                cps_counts = Counter(b[0] for b in bursts)
                dom_cps, _ = cps_counts.most_common(1)[0]
                matched = [b for b in bursts if b[0] == dom_cps]
                if len(matched) >= 3:
                    avg_run = sum(b[1] for b in matched) / len(matched)
                    avg_gap = sum(b[2] for b in matched) / len(matched)
                    def cv(vals):
                        if not vals:
                            return 99.0
                        mu = sum(vals) / len(vals)
                        if mu == 0:
                            return 99.0
                        var = sum((v - mu) ** 2 for v in vals) / len(vals)
                        return (var ** 0.5) / mu
                    cv_run = cv([b[1] for b in matched])
                    cv_gap = cv([b[2] for b in matched])
                    period = avg_run + avg_gap
                    duty = avg_run / period if period else 0
                    freq = 1.0 / period if period else 0
                    is_ook = cv_run < 0.35 and cv_gap < 0.55
                    verdict = ("OOK / ON-OFF KEYING LIKELY" if is_ook
                               else "BURSTS PRESENT (low consistency)")
                    return (
                        "OOK burst-pattern detector:\n"
                        f"Sequence length = {len(seq)}\n"
                        f"Dominant CPS = {dom_cps}  (repeated {len(matched)}×)\n"
                        f"Avg burst = {avg_run:.2f} samples, avg gap = {avg_gap:.2f} samples\n"
                        f"Duty = {duty:.2f}, period ≈ {period:.2f} samples, f ≈ {freq:.4f} /sample\n"
                        f"CV_run = {cv_run:.3f}, CV_gap = {cv_gap:.3f}\n"
                        f"Verdict = {verdict}"
                    )
            return (
                "OOK detector:\n"
                f"Sequence = {seq}\n"
                "Fewer than 3 consistent non-zero bursts – no OOK declared."
            )
        except Exception as exc:
            return f"OOK detector error: {exc}"

    # ── Equal-spacing detector ────────────────────────────────────────────
    if seq is not None and any(k in raw for k in (
            "equal spacing", "equally spaced", "periodic burst",
            "equal-spaced", "regular spacing", "spacing",
            "periodic", "equal interval", "burst check", "periodic burst check")):
        try:
            thr = 2
            mthr = re.search(r"threshold\s*[:=]?\s*(\d+)", raw)
            if mthr:
                thr = int(mthr.group(1))
            hits = [i for i, v in enumerate(seq) if v >= thr]
            if len(hits) >= 3:
                intervals = [hits[i + 1] - hits[i] for i in range(len(hits) - 1)]
                mu = sum(intervals) / len(intervals)
                var = sum((x - mu) ** 2 for x in intervals) / len(intervals)
                cv = (var ** 0.5) / mu if mu > 0 else 99.0
                is_equal = cv <= 0.15 and mu >= 1.0
                verdict = ("EQUAL SPACING / PERIODIC BURSTS" if is_equal
                           else "SPACING INCONSISTENT")
                return (
                    "Equal-spacing detector:\n"
                    f"Sequence length = {len(seq)}, threshold CPS ≥ {thr}\n"
                    f"Hit indices = {hits}\n"
                    f"Intervals = {intervals}\n"
                    f"Mean interval = {mu:.2f} samples, CV = {cv:.3f}\n"
                    f"Verdict = {verdict}"
                    + ("  (CV ≤ 0.15 → periodic source likely)" if is_equal else "")
                )
            return (
                "Equal-spacing detector:\n"
                f"Sequence = {seq}\n"
                f"Fewer than 3 hits with CPS ≥ {thr} – cannot assess spacing."
            )
        except Exception as exc:
            return f"Equal-spacing detector error: {exc}"

    return None


