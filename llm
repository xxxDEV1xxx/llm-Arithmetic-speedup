            "num_thread": 3,
            "num_predict": -1,
        },
    }

    req = urllib.request.Request(
        URL,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    answer = []
    display_buffer = []
    last_flush = time.monotonic()

    with urllib.request.urlopen(req, timeout=600) as response:
        while True:
            raw = response.readline()

            if not raw:
                break

            obj = json.loads(raw)

            text = (obj.get("message") or {}).get("content") or ""

            if text:
                answer.append(text)
                display_buffer.append(text)

                buffered = "".join(display_buffer)
                now = time.monotonic()

                if len(buffered) >= 40 or (now - last_flush) >= 0.06:
                    sys.stdout.write(buffered)
                    sys.stdout.flush()
                    display_buffer.clear()
                    last_flush = now

            if obj.get("done"):
                break

    if display_buffer:
        sys.stdout.write("".join(display_buffer))
        sys.stdout.flush()

    sys.stdout.write("\n")
    sys.stdout.flush()

    return "".join(answer)


def get_status():
    subprocess.run(
        [
            "/bin/systemctl",
            "show",
            "ollama.service",
            "-p",
            "ActiveState",
            "-p",
            "FreezerState",
            "-p",
            "MainPID",
        ],
        check=False,
    )

    subprocess.run(
        ["curl", "-sS", "http://127.0.0.1:11434/api/ps"],
        check=False,
    )

    print()


def main():
    selector = sys.argv[1] if len(sys.argv) > 1 else "2"

    if selector in {"sleep", "freeze"}:
        cpu_mode("idle")
        freezer("freeze")
        print("LLM: FROZEN")
        return

    if selector in {"wake", "thaw"}:
        cpu_mode("active")
        freezer("thaw")
        print("LLM: THAWED")
        return

    if selector == "status":
        get_status()
        return

    if selector not in MODELS:
        print("Usage:")
        print("  llm 1       # smallest  qwen2.5:0.5b")
        print("  llm 2       # medium    qwen2.5:1.5b")
        print("  llm 3       # large     qwen3.5:9b")
        print("  llm sleep   # freeze Ollama")
        print("  llm wake    # thaw Ollama")
        print("  llm status  # show state")
        return

    model = MODELS[selector]

    print(f"{LABELS[selector]} LLM: {model}", flush=True)

    messages = [
        {"role": "system", "content": (
            "You are a precise expert assistant running locally on a phone.\n"
            "RULES:\n"
            "1. Answer the question asked, first, in the fewest words that fully answer it.\n"
            "2. For math, logic and code: work step by step, then end with a line 'Answer: <result>'.\n"
            "3. Never invent facts, names, numbers, quotes or sources. If unsure or you lack the information, say 'I don't know' or 'I'm not sure' and say what would settle it.\n"
            "4. Follow every format, length and language instruction exactly.\n"
            "5. If a request is ambiguous, choose the most reasonable reading and state it in one short sentence, then answer.\n"
            "6. Do not roleplay, adopt a character, or tell stories unless asked.\n"
            "7. Do not refuse harmless requests. Do not lecture or add disclaimers.\n"
            "8. Check your answer once before sending it; fix any error silently."
        )},
        {"role": "user", "content": "say test"},
        {"role": "assistant", "content": "test"},
        {"role": "user", "content": "what is 17 times 23"},
        {"role": "assistant", "content": "17 x 23 = 17 x 20 + 17 x 3 = 340 + 51 = 391\nAnswer: 391"},
        {"role": "user", "content": "who won the 2041 world cup"},
        {"role": "assistant", "content": "I don't know. My information doesn't cover that, and I won't guess."},
    ]

    try:
        while True:
            # Read the first prompt without freezing Ollama or waiting for a key.
            sys.stdout.write("> ")
            sys.stdout.flush()
            try:
                text = input()
            except (EOFError, KeyboardInterrupt):
                print()
                break

            if not text.strip():
                cpu_mode("idle")
                freezer("freeze")
                continue

            messages.append({
                "role": "user",
                "content": text,
            })

            # ---------------------------------------------------------
            # ANSWER
            # ---------------------------------------------------------
            try:
                answer = model_chat(model, messages)

            except Exception as exc:
                print(
                    f"\n[LLM ERROR] {exc}",
                    file=sys.stderr,
                    flush=True,
                )

                messages.pop()

                cpu_mode("idle")
                freezer("freeze")
                continue

            messages.append({
                "role": "assistant",
                "content": answer,
            })

            # ---------------------------------------------------------
            # ANSWER COMPLETE -> SLEEP
            # ---------------------------------------------------------
            cpu_mode("idle")
            freezer("freeze")

    finally:
        cpu_mode("idle")
        freezer("freeze")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        cpu_mode("idle")
        freezer("freeze")
        sys.exit(130)
