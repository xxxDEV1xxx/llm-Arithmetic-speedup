        return (
            "Fourier's law for steady one-dimensional wall conduction:\n"
            f"P = k*A*deltaT/L = {conductivity:g}*{area:g}*{dt:g}/{thickness:g}\n"
            f"P = {rate:.6g} W"
        )

    # Linear thermal expansion: deltaL = alpha*L0*deltaT.
    alpha = get(
        r"linear expansion coefficient|coefficient of linear thermal expansion|thermal expansion coefficient|alpha",
        r"1\s*/\s*k\b|k\s*\^-1\b|1\s*/\s*deg\s*c\b|deg\s*c\s*\^-1\b"
    )
    original_length = get(r"original length|initial length|starting length", r"m\b")

    if alpha is not None and original_length is not None and original_length > 0 and dt is not None:
        change = alpha * original_length * dt
        return (
            "Linear thermal expansion:\n"
            f"deltaL = alpha*L0*deltaT = {alpha:g}*{original_length:g}*{dt:g}\n"
            f"deltaL = {change:.6g} m\n"
            f"Final length = {original_length + change:.6g} m"
        )

    # Thermal energy stored using heat capacity C: Q = C*deltaT.
    capacity = get(r"thermal capacity|heat capacity", r"j\s*/\s*k\b")
    if capacity is not None and dt is not None and (
        "thermal capacity" in raw or "heat capacity" in raw
    ):
        result = capacity * dt
        return (
            "Thermal energy using total heat capacity:\n"
            f"Q = C*deltaT = {capacity:g} J/K*{dt:g} K\n"
            f"Q = {result:.6g} J"
        )

    return None


def pressure_dynamics_fast_path(text):
    """Deterministic SI-unit calculations for common pressure problems."""
    import re

    raw = text.lower().replace("Δ", "delta ").replace("ρ", "rho")
    raw = raw.replace("°", " deg ").replace("³", "^3").replace("²", "^2")
    raw = re.sub(r"\s+", " ", raw).strip()
    number = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"

    def get(labels, units):
        pattern = (
            r"(?<![a-z])(?:"
            + labels
            + r")\s*(?:(?:is|of|equals?|=|:)\s*)?"
            + number + r"\s*(?:" + units + r")"
        )
        m = re.search(pattern, raw)
        return float(m.group(1)) if m else None

    # SI quantities
    pressure = get(
        r"absolute pressure|gauge pressure|pressure|p",
        r"pa\b|pascal(?:s)?\b|kpa\b|mpa\b|bar\b|atm\b"
    )
    force = get(r"force|normal force", r"n\b|newtons?\b")
    area = get(r"cross.section area|surface area|area", r"m\s*\^?\s*2\b|m2\b")
    density = get(r"density|rho", r"kg\s*/\s*m\s*\^?\s*3\b|kg/m3\b")
    depth = get(r"depth|height of fluid|fluid height|height", r"m\b")
    gravity = get(r"gravitational acceleration|gravity|g", r"m\s*/\s*s\s*\^?\s*2\b|m/s2\b")
    p0 = get(r"surface pressure|reference pressure|atmospheric pressure", r"pa\b|kpa\b|bar\b|atm\b")
    mass = get(r"mass", r"kg\b")
    volume = get(r"volume", r"m\s*\^?\s*3\b|m3\b")
    n_moles = get(r"number of moles|moles|amount of gas|n", r"mol\b|moles?\b")
    temperature = get(r"temperature|temp", r"k\b|kelvin\b")
    gas_volume = get(r"gas volume|volume", r"m\s*\^?\s*3\b|m3\b")
    gas_constant = 8.314462618  # J/(mol·K)

    # Unit conversion for pressure input
    if pressure is not None:
        if re.search(r"\bkpa\b", raw):
            pressure *= 1e3
        elif re.search(r"\bmpa\b", raw):
            pressure *= 1e6
        elif re.search(r"\bbar\b", raw):
            pressure *= 1e5
        elif re.search(r"\batm\b", raw):
            pressure *= 101325.0

    # Ideal gas law: P·V = n·R·T
    if (n_moles is not None and temperature is not None and gas_volume is not None
            and n_moles > 0 and temperature > 0 and gas_volume > 0
            and ("ideal gas" in raw or "gas law" in raw or "find pressure" in raw)):
        result = n_moles * gas_constant * temperature / gas_volume
        return (
            "Ideal gas law:\n"
            "P = n*R*T/V\n"
            f"P = {n_moles:g} mol * {gas_constant:g} J/(mol·K) * "
            f"{temperature:g} K / {gas_volume:g} m³\n"
            f"P = {result:.6g} Pa"
        )

    # Force over area: P = F/A
    if force is not None and area is not None and area > 0 and (
            "force" in raw or "contact pressure" in raw or "force per area" in raw):
        result = force / area
        return (
            "Pressure from force and area:\n"
            f"P = F/A = {force:g} N / {area:g} m²\n"
            f"P = {result:.6g} Pa"
        )

    # Hydrostatic pressure: ΔP = ρ·g·h
    if density is not None and depth is not None and depth >= 0 and (
            "hydrostatic" in raw or "fluid pressure" in raw or "pressure at depth" in raw):
        g = gravity if gravity is not None else 9.80665
        delta_p = density * g * depth
        if "absolute pressure" in raw and p0 is not None:
            result = p0 + delta_p
            label = "Absolute pressure"
        else:
            result = delta_p
            label = "Hydrostatic gauge pressure"
        return (
            f"{label}:\n"
            "ΔP = ρ·g·h\n"
            f"ΔP = {density:g} kg/m³ * {g:g} m/s² * {depth:g} m\n"
            f"ΔP = {delta_p:.6g} Pa\n"
            f"{label} = {result:.6g} Pa"
        )

    # Density from mass and volume
    if mass is not None and mass >= 0 and volume is not None and volume > 0 and (
            "density" in raw or "find rho" in raw):
        result = mass / volume
        return (
            "Density:\n"
            f"ρ = m/V = {mass:g} kg / {volume:g} m³\n"
            f"ρ = {result:.6g} kg/m³"
        )

    # Pressure from mass loading over area: P = m·g/A
    if mass is not None and mass >= 0 and area is not None and area > 0 and (
            "weight pressure" in raw or "mass on an area" in raw):
        g = gravity if gravity is not None else 9.80665
        result = mass * g / area
        return (
            "Pressure from a mass load:\n"
            f"P = m·g/A = {mass:g} * {g:g} / {area:g}\n"
            f"P = {result:.6g} Pa"
        )

    return None



def _eng_quantities(text):
    """Extract physical quantities from ordinary prose and normalize to SI."""
    import re

    s = text.replace("μ", "u").replace("µ", "u").replace("Ω", "Ω")
    units = [
        "dBm", "GHz", "MHz", "kHz", "Hz",
        "kohms", "kohm", "kΩ", "MΩ", "mΩ", "Ω", "ohms", "ohm",
        "uF", "nF", "pF", "mF", "F",
        "uH", "mH", "H",
        "mV", "V", "uA", "mA", "A",
        "kW", "mW", "W", "dB",
        "km", "cm", "mm", "m",
        "ms", "us", "ns", "s",
        "mC", "uC", "C", "mJ", "uJ", "J",
    ]
    unit_re = "|".join(re.escape(u) for u in sorted(units, key=len, reverse=True))
    number_re = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?"
    pattern = re.compile(
        r"(?<![A-Za-z0-9_])(" + number_re + r")\s*(" + unit_re + r")(?![A-Za-z])",
        re.IGNORECASE,
    )

    # Dimension, SI multiplier. The input spelling is retained to distinguish
    # common engineering prefixes before case normalization.
    scale = {
        "v": ("voltage", 1), "mv": ("voltage", 1e-3),
        "a": ("current", 1), "ma": ("current", 1e-3),
        "ua": ("current", 1e-6),
        "ohm": ("resistance", 1), "ohms": ("resistance", 1),
        "ω": ("resistance", 1), "kω": ("resistance", 1e3),
        "mω": ("resistance", 1e-3), "mωmega": ("resistance", 1e6),
        "kohm": ("resistance", 1e3), "kohms": ("resistance", 1e3),
        "mω": ("resistance", 1e-3),
        "f": ("capacitance", 1), "mf": ("capacitance", 1e-3),
        "uf": ("capacitance", 1e-6), "nf": ("capacitance", 1e-9),
        "pf": ("capacitance", 1e-12),
        "h": ("inductance", 1), "mh": ("inductance", 1e-3),
        "uh": ("inductance", 1e-6),
        "hz": ("frequency", 1), "khz": ("frequency", 1e3),
        "mhz": ("frequency", 1e6), "ghz": ("frequency", 1e9),
        "w": ("power", 1), "mw": ("power", 1e-3), "kw": ("power", 1e3),
        "db": ("decibels", 1), "dbm": ("dbm", 1),
        "m": ("distance", 1), "mm": ("distance", 1e-3),
        "cm": ("distance", 1e-2), "km": ("distance", 1e3),
        "s": ("time", 1), "ms": ("time", 1e-3),
        "us": ("time", 1e-6), "ns": ("time", 1e-9),
        "c": ("charge", 1), "mc": ("charge", 1e-3),
        "uc": ("charge", 1e-6),
        "j": ("energy", 1), "mj": ("energy", 1e-3),
        "uj": ("energy", 1e-6),
    }

    result = []
    for match in pattern.finditer(s):
        value = float(match.group(1))
        unit = match.group(2)
        key = unit.lower()

        # Handle ohm symbols and SI-prefix case explicitly.
        if unit in ("MΩ",):
            dim, factor = "resistance", 1e6
        elif unit in ("kΩ",):
            dim, factor = "resistance", 1e3
        elif unit in ("mΩ",):
            dim, factor = "resistance", 1e-3
        elif unit == "MΩ":
            dim, factor = "resistance", 1e6
        elif key in scale:
            dim, factor = scale[key]
        else:
            continue

        result.append({
            "dimension": dim,
            "value": value * factor,
            "original_value": value,
            "unit": unit,
            "start": match.start(),
            "end": match.end(),
        })
    return result


def electronics_hardware_fast_path(text):
    """Worked solutions for common DC, passive-component, and AC calculations."""
    import math

    raw = text.lower().replace("μ", "u").replace("µ", "u")
    raw = raw.replace("ω", "ohm").replace("Ω", "ohm")
    q = _eng_quantities(text)

    def values(dim):
        return [x["value"] for x in q if x["dimension"] == dim]

    vs = values("voltage")
    currents = values("current")
    resistors = values("resistance")
    caps = values("capacitance")
    inductors = values("inductance")
    powers = values("power")
    charges = values("charge")
    energies = values("energy")
    times = values("time")

    def worked(title, formula, substitution, result, unit, notes=None):
        out = [
            title,
            f"Formula: {formula}",
            f"Substitution: {substitution}",
            f"Result: {result:.6g} {unit}",
        ]
        if notes:
            out.append(notes)
        return "\n".join(out)

    # Equivalent resistance of two or more resistors.
    if len(resistors) >= 2 and ("parallel" in raw or "series" in raw):
        rs = resistors
        if "parallel" in raw:
            if any(r <= 0 for r in rs):
                return "Cannot calculate passive parallel resistance: every resistance must be positive."
            reciprocal_sum = sum(1.0 / r for r in rs)
            result = 1.0 / reciprocal_sum
            terms = " + ".join(f"1/{r:g}" for r in rs)
            return worked(
                "Equivalent resistance — parallel network",
                "1/R_eq = Σ(1/R_i)",
                f"R_eq = 1/({terms})",
                result, "Ω",
                f"Checked {len(rs)} resistor values.",
            )
        result = sum(rs)
        terms = " + ".join(f"{r:g}" for r in rs)
        return worked(
            "Equivalent resistance — series network",
            "R_eq = ΣR_i",
            f"R_eq = {terms}",
            result, "Ω",
            f"Checked {len(rs)} resistor values.",
        )

    # DC source and resistor: current, voltage, or power.
    if vs and resistors:
        voltage = vs[0]
        resistance = resistors[0]
        if resistance <= 0:
            return "Cannot apply Ohm's law: resistance must be positive."

        if "current" in raw or "amper" in raw or "milliamps" in raw or "ma " in raw:
            result = voltage / resistance
            if "milliamp" in raw or "milliamps" in raw:
                return worked(
                    "Current through a resistor",
                    "I = V/R",
                    f"I = {voltage:g} V / {resistance:g} Ω = {result:.6g} A",
                    result * 1000, "mA",
                )
            return worked(
                "Current through a resistor",
                "I = V/R",
                f"I = {voltage:g} V / {resistance:g} Ω",
                result, "A",
            )

        if "power" in raw or "watt" in raw or "dissipat" in raw:
            result = voltage * voltage / resistance
            current = voltage / resistance
            return (
                "Resistor power dissipation\n"
                "Formula: P = V²/R\n"
                f"Substitution: P = ({voltage:g} V)² / {resistance:g} Ω\n"
                f"Current check: I = V/R = {current:.6g} A\n"
                f"Result: {result:.6g} W"
            )

        if "voltage" in raw and currents:
            current = currents[0]
            result = current * resistance
            return worked(
                "Voltage across a resistor",
                "V = I R",
                f"V = {current:g} A × {resistance:g} Ω",
                result, "V",
            )

    # Explicit voltage/current pairs, when the question asks for power or R.
    if vs and currents:
        voltage, current = vs[0], currents[0]
        if "power" in raw or "watt" in raw:
            result = voltage * current
            return worked(
                "Electrical power",
                "P = V I",
                f"P = {voltage:g} V × {current:g} A",
                result, "W",
            )
        if ("resistance" in raw or "solve for r" in raw) and current != 0:
            result = voltage / current
            return worked(
                "Resistance from voltage and current",
                "R = V/I",
                f"R = {voltage:g} V / {current:g} A",
                result, "Ω",
            )

    # RC time constant.
    if resistors and caps and ("time constant" in raw or "rc" in raw):
        resistance, capacitance = resistors[0], caps[0]
        result = resistance * capacitance
        return (
            "RC time constant\n"
            "Formula: τ = R C\n"
            f"Unit conversion: R = {resistance:g} Ω; C = {capacitance:g} F\n"
            f"Substitution: τ = {resistance:g} × {capacitance:g}\n"
            f"Result: τ = {result:.6g} s"
        )

    # Capacitor charge, energy, and stored inductor energy.
    if caps and vs and ("energy" in raw or "stored" in raw):
        c, v = caps[0], vs[0]
        result = 0.5 * c * v * v
        return worked(
            "Energy stored in a capacitor",
            "E = ½ C V²",
            f"E = 0.5 × {c:g} F × ({v:g} V)²",
            result, "J",
        )

    if caps and vs and ("charge" in raw or "find q" in raw):
        c, v = caps[0], vs[0]
        result = c * v
        return worked(
            "Charge stored in a capacitor",
            "Q = C V",
            f"Q = {c:g} F × {v:g} V",
            result, "C",
        )

    if inductors and currents and ("energy" in raw or "stored" in raw):
        inductance, current = inductors[0], currents[0]
        result = 0.5 * inductance * current**2
        return worked(
            "Energy stored in an inductor",
            "E = ½ L I²",
            f"E = 0.5 × {inductance:g} H × ({current:g} A)²",
            result, "J",
        )

    # Capacitor and inductor reactance.
    frequencies = values("frequency")
    if caps and frequencies and ("reactance" in raw or "capacitive" in raw):
        c, f = caps[0], frequencies[0]
        if f <= 0 or c <= 0:
            return "Capacitive reactance requires positive capacitance and frequency."
        result = 1.0 / (2.0 * math.pi * f * c)
        return worked(
            "Capacitive reactance",
            "X_C = 1/(2πfC)",
            f"X_C = 1/(2π × {f:g} Hz × {c:g} F)",
            result, "Ω",
        )

    if inductors and frequencies and ("reactance" in raw or "inductive" in raw):
        inductance, f = inductors[0], frequencies[0]
        if f <= 0 or inductance <= 0:
            return "Inductive reactance requires positive inductance and frequency."
        result = 2.0 * math.pi * f * inductance
        return worked(
            "Inductive reactance",
            "X_L = 2πfL",
            f"X_L = 2π × {f:g} Hz × {inductance:g} H",
            result, "Ω",
        )

    # Ideal LC resonant frequency.
    if caps and inductors and ("resonance" in raw or "resonant frequency" in raw):
        c, inductance = caps[0], inductors[0]
        if c <= 0 or inductance <= 0:
            return "LC resonance requires positive capacitance and inductance."
        result = 1.0 / (2.0 * math.pi * math.sqrt(inductance * c))
        return worked(
            "Ideal LC resonant frequency",
            "f₀ = 1/(2π√(LC))",
            f"f₀ = 1/(2π√({inductance:g} H × {c:g} F))",
            result, "Hz",
        )

    return None


def electronics_radio_fast_path(text):
    """Worked solutions for wavelength, antennas, RF loss, and dBm."""
    import math

    raw = text.lower().replace("μ", "u").replace("µ", "u")
    raw = raw.replace("λ", "lambda")
    q = _eng_quantities(text)
    c0 = 299792458.0

    def values(dim):
        return [x["value"] for x in q if x["dimension"] == dim]

    frequencies = values("frequency")
    distances = values("distance")
    dbms = values("dbm")
    watts = values("power")

    def worked(title, formula, substitution, result, unit, note=None):
        out = [
            title,
            f"Formula: {formula}",
            f"Substitution: {substitution}",
            f"Result: {result:.6g} {unit}",
        ]
        if note:
            out.append(note)
        return "\n".join(out)

    # dBm is an absolute power level, not a generic decibel gain.
    if dbms and ("to milliwatts" in raw or "in milliwatts" in raw):
        dbm = dbms[0]
        result = 10.0 ** (dbm / 10.0)
        return (
            "Convert dBm to milliwatts\\n"
            "Formula: P(mW) = 10^(P(dBm)/10)\\n"
            f"Substitution: P = 10^({dbm:g}/10)\\n"
            f"Result: {result:.8g} mW"
        )

    if dbms and ("to watts" in raw or "in watts" in raw or "convert" in raw):
        dbm = dbms[0]
        result = 10.0 ** ((dbm - 30.0) / 10.0)
        return worked(
            "Convert dBm to watts",
            "P(W) = 10^((P(dBm) − 30)/10)",
            f"P = 10^(({dbm:g} − 30)/10)",
            result, "W",
        )

    if watts and any(token in raw for token in ("dbm", "db-m", "decibel-milliwatts")):
        power = watts[0]
        if power <= 0:
            return "Cannot convert to dBm: power must be greater than zero."
        result = 10.0 * math.log10(power / 1e-3)
        return worked(
            "Convert watts to dBm",
            "P(dBm) = 10 log₁₀(P(W)/0.001)",
            f"P = 10 log10({power:g}/0.001)",
            result, "dBm",
        )

    # Free-space wavelength.
    if frequencies and any(token in raw for token in ("wavelength", "lambda", "λ")):
        f = frequencies[0]
        if f <= 0:
            return "Wavelength requires a positive frequency."
        result = c0 / f
        return worked(
            "Free-space wavelength",
            "λ = c/f",
            f"λ = 299792458 m/s / {f:g} Hz",
            result, "m",
            "Assumes propagation in free space.",
        )

    # Quarter-wave and half-wave antenna dimensions.
    if frequencies and ("quarter wave" in raw or "quarter-wave" in raw):
        f = frequencies[0]
        if f <= 0:
            return "Antenna length requires a positive frequency."
        result = c0 / (4.0 * f)
        return worked(
            "Free-space quarter-wave antenna length",
            "L = c/(4f)",
            f"L = 299792458 / (4 × {f:g})",
            result, "m",
            "Practical antennas may need shortening for end effects and conductor properties.",
        )

    if frequencies and ("half wave" in raw or "half-wave" in raw):
        f = frequencies[0]
        if f <= 0:
            return "Antenna length requires a positive frequency."
        result = c0 / (2.0 * f)
        return worked(
            "Free-space half-wave antenna length",
            "L = c/(2f)",
            f"L = 299792458 / (2 × {f:g})",
            result, "m",
            "Practical antennas may need shortening for end effects and conductor properties.",
        )

    # Friis free-space path loss.
    if frequencies and distances and (
        "path loss" in raw or "free space loss" in raw or "friis" in raw
    ):
        f, d = frequencies[0], distances[0]
        if f <= 0 or d <= 0:
            return "Free-space path loss requires positive frequency and distance."
        wavelength = c0 / f
        result = 20.0 * math.log10(4.0 * math.pi * d / wavelength)
        return (
            "Free-space path loss (ideal Friis model)\n"
