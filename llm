            f"Step 2: FSPL = 20 log10(4π × {d:g} / {wavelength:.6g})\n"
            f"Result: FSPL = {result:.6g} dB\n"
            "Assumes unobstructed free-space propagation; excludes antenna gains, mismatch, and other losses."
        )

