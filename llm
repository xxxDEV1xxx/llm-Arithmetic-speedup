def cpu_mode(mode):
    """Set the Odysseus CPU governor policy."""
    if mode not in {"active", "idle"}:
        raise ValueError(f"unknown CPU mode: {mode}")

    try:
        subprocess.run(
            ["llm-cpu-mode", mode],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except FileNotFoundError:
        pass


def wait_for_key_and_wake():
    """
    Sleep on the current TTY until ANY key is pressed.

    The first byte is the wake trigger. Ollama is thawed immediately.
    The first printable byte is returned so it can become the first
    character of the next prompt.
    """
    if not sys.stdin.isatty():
        cpu_mode("active")
        freezer("thaw")
        return ""

    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)

    try:
        tty.setcbreak(fd)
        raw = os.read(fd, 1)
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old_attrs)

    if raw == b"\x03":
        raise KeyboardInterrupt

    if raw == b"\x04":
        raise EOFError

    # The wake event happens HERE, on the first received byte.
    cpu_mode("active")
    freezer("thaw")

    return raw.decode("utf-8", errors="ignore")


import math

KB_DIR = "/data/sda4/knowledge"
KB_INDEX = KB_DIR + "/.index.json"
EMBED_URL = "http://127.0.0.1:11434/api/embed"
EMBED_MODEL = "all-minilm"


def kb_embed(texts):
    out = []
    for i in range(0, len(texts), 16):
        req = urllib.request.Request(
            EMBED_URL,
            data=json.dumps({"model": EMBED_MODEL, "input": texts[i:i + 16]}).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=120) as r:
            out.extend(json.loads(r.read())["embeddings"])
    return out


def kb_chunks(text, limit=600):
    chunks = []
    cur = ""
    for para in text.replace("\r", "").split("\n\n"):
        para = para.strip()
        while len(para) > limit:
            cut = para.rfind(" ", 0, limit)
            cut = cut if cut > 0 else limit
            if cur:
                chunks.append(cur)
                cur = ""
            chunks.append(para[:cut].strip())
            para = para[cut:].strip()
        if not para:
            continue
        if cur and len(cur) + len(para) + 2 > limit:
            chunks.append(cur)
            cur = para
        else:
            cur = (cur + "\n\n" + para) if cur else para
    if cur:
        chunks.append(cur)
    return chunks


def kb_load():
    try:
        with open(KB_INDEX) as f:
            idx = json.load(f)
    except Exception:
        idx = {}
    names = sorted(n for n in os.listdir(KB_DIR) if n.endswith(".txt"))
    changed = False
    for gone in [k for k in idx if k not in names]:
        del idx[gone]
        changed = True
    for n in names:
        path = os.path.join(KB_DIR, n)
        st = os.stat(path)
        sig = [int(st.st_mtime), st.st_size]
        if idx.get(n, {}).get("sig") == sig:
            continue
        with open(path, errors="ignore") as f:
            chunks = kb_chunks(f.read())
        idx[n] = {"sig": sig, "chunks": chunks, "vecs": kb_embed(chunks) if chunks else []}
        changed = True
    if changed:
        with open(KB_INDEX, "w") as f:
            json.dump(idx, f)
    return idx


def kb_search(query, k=3, floor=0.25):
    idx = kb_load()
    pool = [(c, v) for e in idx.values() for c, v in zip(e["chunks"], e["vecs"])]
    if not pool:
        return []
    q = kb_embed([query])[0]
    qn = math.sqrt(sum(x * x for x in q)) or 1.0
    scored = []
    for c, v in pool:
        vn = math.sqrt(sum(x * x for x in v)) or 1.0
        scored.append((sum(a * b for a, b in zip(q, v)) / (qn * vn), c))
    scored.sort(reverse=True)
    return [c for s, c in scored[:k] if s >= floor]


def kb_wrap(messages):
    try:
        if not os.path.isdir(KB_DIR) or not messages:
            return messages
        last = messages[-1]
        if last.get("role") != "user":
            return messages
        hits = kb_search(last["content"])
        if not hits:
            return messages
        sys.stdout.write("[knowledge: %d]\n" % len(hits))
        note = "Reference notes (use them if relevant):\n" + "\n---\n".join(hits) + "\n\nQuestion: " + last["content"]
        return messages[:-1] + [{"role": "user", "content": note}]
    except Exception as e:
        sys.stdout.write("[knowledge error: %s]\n" % e)
        return messages



