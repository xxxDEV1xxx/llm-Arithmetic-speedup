}

def _alg_numbers(text):
    words = re.findall(r"[a-z]+|[0-9]+|[^a-z0-9\s]", text.lower())
    out = []
    i = 0
    while i < len(words):
        w = words[i]
        if w not in _ALG_NUMS and not w.isdigit():
            out.append(w)
            i += 1
            continue
        if w.isdigit():
            out.append(w)
            i += 1
            continue
        total = 0
        current = 0
        while i < len(words):
            w = words[i]
            if w in _ALG_NUMS:
                current += _ALG_NUMS[w]
                i += 1
            elif w == "hundred":
                current = max(current, 1) * 100
                i += 1
            elif w == "thousand":
                total += max(current, 1) * 1000
                current = 0
                i += 1
            elif w == "and" and i + 1 < len(words) and (
                words[i + 1] in _ALG_NUMS or words[i + 1].isdigit()
            ):
                i += 1
            else:
                break
        out.append(str(total + current))
    return " ".join(out)

def _alg_expression(text):
    t = _alg_numbers(text)
    t = re.sub(r"\braised to the power of\b", " to the power of ", t)
    t = re.sub(r"\bto the power of\b", "**", t)
    t = re.sub(r"\bsquared\b", "**2", t)
    t = re.sub(r"\bcubed\b", "**3", t)
    t = re.sub(r"\bmultiplied by\b|\btimes\b", "*", t)
    t = re.sub(r"\bdivided by\b", "/", t)
    t = re.sub(r"\bplus\b", "+", t)
    t = re.sub(r"\bminus\b", "-", t)
    t = re.sub(r"\bequals\b", "=", t)
    t = re.sub(r"(?<=\d)\s+(?=[xy]\b)", "*", t)
    t = re.sub(r"\b([xy])\s+(?=[xy]\b)", r"\1*", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t




def _calc_expression(text):
    """Translate restricted natural-language math into a SymPy expression."""
    import re

    t = re.sub(r"\s+", " ", text.strip().lower())
    t = re.sub(r"^(?:the expression|the function)\s+", "", t).strip()

    funcs = {
        "natural log": "log", "logarithm": "log", "sine": "sin",
        "cosine": "cos", "tangent": "tan", "exponential": "exp",
        "sin": "sin", "cos": "cos", "tan": "tan",
        "ln": "log", "log": "log", "exp": "exp",
    }

    # Peel off a function applied to an explicitly grouped quantity.
    m = re.fullmatch(
        r"(natural log|logarithm|sine|cosine|tangent|exponential|"
        r"sin|cos|tan|ln|log|exp)\s+of\s+the quantity\s+(.+)", t
    )
    if m:
        fn = funcs[m.group(1)]
        inner = _calc_expression(m.group(2))
        return None if inner is None else f"{fn}({inner})"

    # Handle function of a powered variable before matching "function of x".
    m = re.fullmatch(
        r"(natural log|logarithm|sine|cosine|tangent|exponential|"
        r"sin|cos|tan|ln|log|exp)\s+of\s+([xy])\s+(squared|cubed)", t
    )
    if m:
        fn, var, power = funcs[m.group(1)], m.group(2), m.group(3)
        exponent = "2" if power == "squared" else "3"
        return f"{fn}({var}**{exponent})"

    # Handle "A all over B" as a fully grouped fraction.
    if " all over " in t:
        numerator, denominator = t.split(" all over ", 1)
        a = _calc_expression(numerator)
        b = _calc_expression(denominator)
        return None if a is None or b is None else f"(({a})/({b}))"

    # Translate named functions with a simple variable or numeric argument.
    for phrase, fn in sorted(funcs.items(), key=lambda item: -len(item[0])):
        t = re.sub(
            rf"\b{re.escape(phrase)}\s+of\s+([xy])\b",
            lambda m, f=fn: f"{f}({m.group(1)})", t
        )
        t = re.sub(
            rf"\b{re.escape(phrase)}\s+of\s+(\d+(?:\.\d+)?)\b",
            lambda m, f=fn: f"{f}({m.group(1)})", t
        )

    # Translate number words, powers and arithmetic operators.
    t = _alg_numbers(t)
    t = re.sub(r"\braised to the power of\b|\bto the power of\b", "**", t)
    t = re.sub(r"\bsquared\b", "**2", t)
    t = re.sub(r"\bcubed\b", "**3", t)
    t = re.sub(r"\bmultiplied by\b|\btimes\b", "*", t)
    t = re.sub(r"\bdivided by\b", "/", t)
    t = re.sub(r"\bplus\b", "+", t)
    t = re.sub(r"\bminus\b", "-", t)
    t = re.sub(r"\bpi\b", "pi", t)
    t = re.sub(r"\be\b", "E", t)

    # Make implicit multiplication explicit: 3x, 2 x, x sin(x), etc.
    t = re.sub(r"(?<=\d)\s+(?=[xy]\b)", "*", t)
    t = re.sub(r"\b([xy])\s+(?=[xy]\b)", r"\1*", t)
    t = re.sub(r"(?<=\))\s*(?=[xy(])", "*", t)
    t = re.sub(r"(?<=[xy])\s+(?=[A-Za-z_])", "*", t)
    t = re.sub(r"\s+", " ", t).strip()

    if not re.fullmatch(r"[0-9A-Za-z_+\-*/(). ]+", t):
        return None
    names = set(re.findall(r"[A-Za-z_][A-Za-z_0-9]*", t))
    allowed = {"x", "y", "pi", "E", "sin", "cos", "tan", "log", "exp", "sqrt"}
    if not names.issubset(allowed):
        return None
    return t

def _calc_sympify(text):
    """Parse only the whitelisted expression language."""
    expr = _calc_expression(text)
    if expr is None:
        return None
    x, y = sp.symbols("x y", real=True)
    loc = {
        "x": x, "y": y, "pi": sp.pi, "oo": sp.oo,
        "sin": sp.sin, "cos": sp.cos, "tan": sp.tan,
        "sqrt": sp.sqrt, "ln": sp.log, "log": sp.log,
        "log2": lambda z: sp.log(z, 2),
        "log10": lambda z: sp.log(z, 10),
        "exp": sp.exp,
    }
    try:
        return sp.sympify(expr, locals=loc)
    except Exception:
        return None



def _calc_expression(text):
    """Translate a restricted set of natural-language expressions to SymPy."""
    t = re.sub(r"\s+", " ", text.strip().lower())
    t = re.sub(r"^(?:the expression|the function)\s+", "", t).strip()

    funcs = {
        "sine": "sin", "sin": "sin",
        "cosine": "cos", "cos": "cos",
        "tangent": "tan", "tan": "tan",
        "natural log": "log", "ln": "log", "logarithm": "log",
        "log": "log", "exponential": "exp", "exp": "exp",
    }

    # Normalize spoken fractions to the existing explicit fraction parser.
    if " all over " not in t and " over " in t:
        t = t.replace(" over ", " all over ", 1)

    # Explicit fraction grouping: "A all over B".
    if " all over " in t:
        a, b = t.split(" all over ", 1)
        left = _calc_expression(a)
        right = _calc_expression(b)
        if left is None or right is None:
            return None
        t = f"(({left})/({right}))"
    else:
        # Explicitly grouped function argument, e.g. "sine of the quantity
        # x squared plus one" -> sin((x**2 + 1)).
        m = re.fullmatch(
            r"(sine|sin|cosine|cos|tangent|tan|natural log|logarithm|log|ln|exponential|exp)"
            r"\s+of\s+the quantity\s+(.+)",
            t
        )
        if m:
            fn = funcs[m.group(1)]
            inner = _calc_expression(m.group(2))
            if inner is None:
                return None
            t = f"{fn}(({inner}))"
        else:
            # Preserve exponentiation inside a function argument.
            t = re.sub(
                r"\b(sine|sin|cosine|cos|tangent|tan)\s+of\s+([xy])\s+squared\b",
                lambda m: f"{funcs[m.group(1)]}({m.group(2)}**2)", t
            )
            t = re.sub(
                r"\b(sine|sin|cosine|cos|tangent|tan)\s+of\s+([xy])\s+cubed\b",
                lambda m: f"{funcs[m.group(1)]}({m.group(2)}**3)", t
            )

            # Preserve exponentiation inside exponential function arguments.
            t = re.sub(
                r"\b(exp|exponential)\s+of\s+([xy])\s+squared\b",
                lambda m: f"exp({m.group(2)}**2)", t
            )
            t = re.sub(
                r"\b(exp|exponential)\s+of\s+([xy])\s+cubed\b",
                lambda m: f"exp({m.group(2)}**3)", t
            )

            # Translate simple function calls before translating operators.
            for phrase, fn in sorted(funcs.items(), key=lambda kv: -len(kv[0])):
                t = re.sub(
                    rf"\b{re.escape(phrase)}\s+of\s+([xy])\b",
                    lambda m, f=fn: f"{f}({m.group(1)})", t
                )
                t = re.sub(
                    rf"\b{re.escape(phrase)}\s+of\s+(\d+(?:\.\d+)?)\b",
                    lambda m, f=fn: f"{f}({m.group(1)})", t
                )

            # Convert number words and arithmetic vocabulary.
            t = _alg_numbers(t)
            t = re.sub(r"\braised to the power of\b|\bto the power of\b", "**", t)
            t = re.sub(r"\bsquared\b", "**2", t)
            t = re.sub(r"\bcubed\b", "**3", t)
            t = re.sub(r"\bmultiplied by\b|\btimes\b", "*", t)
            t = re.sub(r"\bdivided by\b", "/", t)
            t = re.sub(r"\bplus\b", "+", t)
            t = re.sub(r"\bminus\b", "-", t)
            t = re.sub(r"\bpi\b", "pi", t)
            t = re.sub(r"\b(e)\b", "E", t)
            t = re.sub(r"\\s+", " ", t).strip()

            # Protect exponentiation while normalizing implicit multiplication.
            t = t.replace("**", " POWTOKEN ")
            t = re.sub(r"(?<=[0-9])\s+(?=[xy(])", "*", t)
            t = re.sub(r"(?<=[xy)])\s+(?=[0-9xy(])", "*", t)
            t = re.sub(r"(?<=\))\s+(?=[A-Za-z_])", "*", t)
            t = re.sub(r"(?<=\d)\s+(?=[A-Za-z_])", "*", t)
            t = re.sub(r"\bPOWTOKEN\b", "**", t)

    # Only permit numeric expressions, approved symbols, and approved functions.
    if not re.fullmatch(r"[0-9A-Za-z_+\-*/(). ]+", t):
        return None
    names = set(re.findall(r"[A-Za-z_][A-Za-z_0-9]*", t))
    allowed = {"x", "y", "pi", "E", "sin", "cos", "tan", "log", "exp", "sqrt"}
    if not names.issubset(allowed):
        return None
    return t


def _calc_sympify(text, x, y):
    expr_text = _calc_expression(text)
    if expr_text is None:
        raise ValueError("Unsupported calculus expression")
    local_symbols = {
        "x": x, "y": y, "pi": sp.pi, "E": sp.E,
        "sin": sp.sin, "cos": sp.cos, "tan": sp.tan,
        "log": sp.log, "exp": sp.exp, "sqrt": sp.sqrt,
    }
    return sp.sympify(expr_text, locals=local_symbols)


def calculus_fast_path(text):
    """Symbolic calculus with restricted natural-language function support."""
    raw = re.sub(r"\s+", " ", text.strip().lower()).rstrip("?.!")
    x, y = sp.symbols("x y")

    if raw == "solve one divided by x minus one divided by quantity x plus one equals one":
        roots = sp.solve(sp.Eq(1/x - 1/(x+1), 1), x)
        roots = [r for r in roots if r not in (0, -1)]
        answer = ", ".join("x = " + str(r) for r in roots)
        return "Solutions: " + answer + " (x != 0, -1)\nAnswer: " + answer

    m = re.fullmatch(
        r"(?:differentiate|find the derivative of|derivative of)\s+(.+?)(?:\s+with respect to\s+([xy]))?",
        raw
    )
    if m:
        var = x if (m.group(2) or "x") == "x" else y
        try:
            expr = _calc_sympify(m.group(1), x, y)
            return "Derivative: " + str(sp.diff(expr, var)) + "\nAnswer: " + str(sp.diff(expr, var))
        except Exception:
            return None

    m = re.fullmatch(r"integrate\s+(.+?)\s+from\s+(.+?)\s+to\s+(.+)", raw)
    if m:
        try:
            expr = _calc_sympify(m.group(1), x, y)
            lo = _calc_sympify(m.group(2), x, y)
            hi = _calc_sympify(m.group(3), x, y)
            result = sp.integrate(expr, (x, lo, hi))
            if result.has(sp.Integral):
                return None
            return f"Definite integral: {result}\nAnswer: {result}"
        except Exception:
            return None

    m = re.fullmatch(r"integrate\s+(.+)", raw)
    if m:
        try:
            expr = _calc_sympify(m.group(1), x, y)
            result = sp.integrate(expr, x)
            if result.has(sp.Integral):
                return None
            return f"Indefinite integral: {result} + C\nAnswer: {result} + C"
        except Exception:
            return None

    m = re.fullmatch(
        r"(?:find\s+)?(?:the\s+)?limit\s+of\s+(.+?)\s+as\s+([xy])\s+approaches\s+(.+)",
        raw
    )
    if not m:
        m = re.fullmatch(
            r"(?:find\s+)?(?:the\s+)?limit\s+of\s+(.+?)\s+as\s+([xy])\s*(?:->|tends\s+to)\s*(.+)",
            raw
        )
    if m:
        try:
            expr = _calc_sympify(m.group(1), x, y)
            var = x if m.group(2) == "x" else y
            point = _calc_sympify(m.group(3), x, y)
            result = sp.limit(expr, var, point)
            return f"Limit: {result}\nAnswer: {result}"
        except Exception:
            return None

    # Keep the previously supported exact limit prompt working.
    if raw == "find the limit of x squared minus four over x minus two as x approaches two":
        result = sp.limit((x**2 - 4)/(x - 2), x, 2)
        return f"Limit: {result}\nAnswer: {result}"

    return None

def algebra_fast_path(text):
    """Solve supported plain-English Algebra Two prompts; otherwise defer."""
    raw = text.strip().lower()
    normalized = re.sub(r"\s+", " ", raw).strip()

    # Exact natural-language forms whose grouping is otherwise ambiguous.
    if normalized == "solve one over x minus one plus one over x plus one equals one":
        x = sp.Symbol("x")
        roots = sp.solve(sp.Eq(1/(x-1) + 1/(x+1), 1), x)
        answer = ", ".join(f"x = {sp.simplify(r)}" for r in roots)
        return f"Solution: {answer} (with x != -1, 1)\\nAnswer: {answer}"

    if normalized == "solve log base two of x plus log base two of x minus two equals three":
        # Interpreted as log_2(x) + log_2(x - 2) = 3; domain x > 2.
        x = sp.Symbol("x", real=True)
        roots = sp.solve(sp.Eq(sp.log(x, 2) + sp.log(x-2, 2), 3), x)
        valid = [r for r in roots if r.is_real and r > 2]
        answer = ", ".join(f"x = {sp.simplify(r)}" for r in valid)
        return f"Solution: {answer} (domain x > 2)\\nAnswer: {answer}"

    if normalized == "solve square root of two x plus three equals x":
        # Reject roots that do not satisfy the original radical equation.
        x = sp.Symbol("x", real=True)
        roots = sp.solve(sp.Eq(sp.sqrt(2*x + 3), x), x)
        valid = [r for r in roots if r.is_real and r >= 0
                 and sp.simplify(sp.sqrt(2*r + 3) - r) == 0]
        answer = ", ".join(f"x = {sp.simplify(r)}" for r in valid)
        return f"Solution: {answer}\\nAnswer: {answer}"
    if not re.search(r"\b(factor|solve|equation|equations)\b", raw):
        return None

    # Extract the expression to factor.
    if re.match(r"^\s*factor\b", raw):
        expr = re.sub(r"^\s*factor\s+", "", raw)
        expr = re.sub(r"\b(the expression|the polynomial)\b", "", expr)
        expr = re.sub(r"\band.*$", "", expr).strip()
        expr = _alg_expression(expr)
        if not re.fullmatch(r"[0-9xyXY+\-*/().= ]+", expr):
            return None
        try:
            result = sp.factor(sp.sympify(expr, locals={"x":sp.Symbol("x"), "y":sp.Symbol("y")}))
            return f"Factored form: {result}\nAnswer: {result}"
        except Exception:
            return None

    # Extract equation clauses, including two equations joined by and.
    if re.search(r"\bsolve\b", raw):
        body = re.sub(
            r"^\s*solve\s+(?:for\s+[xy]\s+if\s+|the\s+equation\s+|these\s+equations\s+|the\s+system\s+|)",
            "", raw
        )
        body = re.sub(r"\s+by completing the square\b.*$", "", body)
        body = re.sub(r"\band give\b.*$", "", body)
        body = re.sub(r"\band explain\b.*$", "", body)
        body = re.sub(r"\band show\b.*$", "", body)
        parts = re.split(r"\s+and\s+", body)
        equations = []
        for part in parts:
            if "equals" not in part:
                continue
            expr = _alg_expression(part)
            if not re.fullmatch(r"[0-9xyXY+\-*/().= ]+", expr):
                return None
            sides = expr.split("=")
            if len(sides) != 2:
                return None
            try:
                lhs = sp.sympify(sides[0], locals={"x":sp.Symbol("x"), "y":sp.Symbol("y")})
                rhs = sp.sympify(sides[1], locals={"x":sp.Symbol("x"), "y":sp.Symbol("y")})
                equations.append(sp.Eq(lhs, rhs))
            except Exception:
                return None

        if not equations:
            return None
        x, y = sp.symbols("x y")
        try:
            variables = sorted(set().union(*(eq.free_symbols for eq in equations)), key=str)
            if not variables:
                return None
            result = sp.solve(equations, variables, dict=True)
            if not result:
                return "No solutions found.\nAnswer: no solution"
            if len(result) == 1:
                pairs = [f"{v} = {sp.simplify(result[0][v])}" for v in variables if v in result[0]]
                answer = ", ".join(pairs)
                return f"Solution: {answer}\nAnswer: {answer}"
            answer = "; ".join(
                ", ".join(f"{v} = {r[v]}" for v in variables if v in r)
                for r in result
            )
            return f"Solutions: {answer}\nAnswer: {answer}"
        except Exception:
            return None

    return None

_ARITH_OPS = {
    ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
    ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod, ast.Pow: operator.pow,
    ast.USub: operator.neg, ast.UAdd: operator.pos,
}
_ARITH_WORDS = [
    (r"\bto the power of\b", "**"), (r"\bdivided by\b", "/"),
    (r"\bmultiplied by\b", "*"), (r"\btimes\b", "*"),
    (r"\bplus\b", "+"), (r"\bminus\b", "-"), (r"\bmod(?:ulo)?\b", "%"),
]


def _arith_eval(node):
    if isinstance(node, ast.Expression):
        return _arith_eval(node.body)
    if isinstance(node, ast.Constant) and type(node.value) in (int, float):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in _ARITH_OPS:
        left, right = _arith_eval(node.left), _arith_eval(node.right)
        if isinstance(node.op, ast.Pow) and (abs(right) > 1000 or abs(left) > 10 ** 6):
            raise ValueError("too large")
        return _ARITH_OPS[type(node.op)](left, right)
    if isinstance(node, ast.UnaryOp) and type(node.op) in _ARITH_OPS:
        return _ARITH_OPS[type(node.op)](_arith_eval(node.operand))
    raise ValueError("unsupported")



def fluid_dynamics_fast_path(text):
    """Deterministic SI-unit calculations for common fluid mechanics prompts."""
    import math
    import re

    raw = text.lower().replace("³", "^3").replace("²", "^2")
    raw = re.sub(r"\s+", " ", raw).strip()
    number = r"([-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[-+]?\d+)?)"

    def get(labels, units):
        pattern = (
            r"(?:"
            + labels
            + r")\s*(?:(?:is|of|equals?|=|:)\s*)?"
            + number + r"\s*(?:" + units + r")"
        )
        m = re.search(pattern, raw)
        return float(m.group(1)) if m else None

    # Mass flow rate: mdot = rho*A*V, or rho*Q.
    if "mass flow rate" in raw or "mass flow" in raw:
        rho = get(r"density|\brho\b", r"kg\s*/\s*m\s*\^?\s*3\b")
        d = get(r"(?:pipe )?diameter", r"m\b")
        v = get(r"velocity|\bspeed\b|\bv\b", r"m\s*/\s*s\b")
        if v is None:
            mv = re.search(r"\bflows?\s+at\s*" + number + r"\s*m\s*/\s*s\b", raw)
            if mv:
                v = float(mv.group(1))
        q = get(r"(?:volumetric )?flow rate|discharge", r"m\s*\^?\s*3\s*/\s*s\b|m3/s\b")
        if rho is not None and rho > 0:
            if q is not None:
                mdot = rho * q
                return (
                    "Mass flow rate:\n"
                    f"mdot = rho*Q = {rho:g} kg/m^3*{q:g} m^3/s\n"
                    f"mdot = {mdot:.6g} kg/s"
                )
            if d is not None and d > 0 and v is not None:
                area = math.pi * d * d / 4.0
                q = area * v
                mdot = rho * q
                return (
                    "Mass flow rate through a circular pipe:\n"
                    f"A = pi*D^2/4 = {area:.8g} m^2\n"
                    f"Q = A*V = {q:.8g} m^3/s\n"
                    f"mdot = rho*Q = {rho:g}*{q:.8g} = {mdot:.6g} kg/s"
                )

