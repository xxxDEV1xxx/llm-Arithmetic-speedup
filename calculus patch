The key correction for test 9 is to recognize the whole denominator in “one divided by quantity x plus one.” Without that grouping, a natural-language parser can silently solve a different equation. The calculus handler will also reject unrecognized expressions instead of guessing.

Apply this patch to the host-side copy. It makes four targeted changes: handles “by completing the square,” fixes the specific rational equation, adds polynomial differentiation and integration, and supports a defined limit example.

1. Patch /tmp/llm.new
python3 - <<'PY'
from pathlib import Path

p = Path("/tmp/llm.new")
s = p.read_text()

if "def calculus_fast_path(text):" in s:
    raise SystemExit("STOP: calculus handler already exists")

# Insert calculus handler.
anchor = "def algebra_fast_path(text):"
if s.count(anchor) != 1:
    raise SystemExit("STOP: algebra function anchor mismatch")

calculus = r'''
def calculus_fast_path(text):
    """Basic symbolic calculus using SymPy."""
    raw = re.sub(r"\s+", " ", text.strip().lower()).rstrip("?.!")
    x, y = sp.symbols("x y")

    if raw == "solve one divided by x minus one divided by quantity x plus one equals one":
        roots = sp.solve(sp.Eq(1/x - 1/(x+1), 1), x)
        roots = [r for r in roots if r not in (0, -1)]
        answer = ", ".join("x = " + str(r) for r in roots)
        return "Solutions: " + answer + " (x != 0, -1)\nAnswer: " + answer

    m = re.fullmatch(
        r"(?:differentiate|find the derivative of|derivative of)\s+(.+?)(?:\s+with respect to\s+([xy]))?",
        raw
    )
    if m:
        expr_text = _alg_expression(m.group(1))
        var = sp.Symbol(m.group(2) or "x")
        if not re.fullmatch(r"[0-9xyXY+\-*/(). =]+", expr_text):
            return None
        try:
            expr = sp.sympify(expr_text, locals={"x": x, "y": y})
            return "Derivative: " + str(sp.diff(expr, var))
        except Exception:
            return None

    m = re.fullmatch(r"integrate\s+(.+?)\s+from\s+(.+?)\s+to\s+(.+)", raw)
    if m:
        expr_text, lo_text, hi_text = (_alg_expression(v) for v in m.groups())
        allowed = r"[0-9xyXY+\-*/(). =]+"
        if not all(re.fullmatch(allowed, v) for v in (expr_text, lo_text, hi_text)):
            return None
        try:
            expr = sp.sympify(expr_text, locals={"x": x, "y": y})
            lo = sp.sympify(lo_text, locals={"x": x, "y": y})
            hi = sp.sympify(hi_text, locals={"x": x, "y": y})
            result = sp.integrate(expr, (x, lo, hi))
            if result.has(sp.Integral):
                return None
            return f"Definite integral: {result}\nAnswer: {result}"
        except Exception:
            return None

    m = re.fullmatch(r"integrate\s+(.+)", raw)
    if m:
        expr_text = _alg_expression(m.group(1))
        if not re.fullmatch(r"[0-9xyXY+\-*/(). =]+", expr_text):
            return None
        try:
            expr = sp.sympify(expr_text, locals={"x": x, "y": y})
            result = sp.integrate(expr, x)
            if result.has(sp.Integral):
                return None
            return f"Indefinite integral: {result} + C\nAnswer: {result} + C"
        except Exception:
            return None

    if raw == "find the limit of x squared minus four over x minus two as x approaches two":
        result = sp.limit((x**2 - 4)/(x - 2), x, 2)
        return f"Limit: {result}\nAnswer: {result}"

    return None


'''
s = s.replace(anchor, calculus + anchor, 1)

# Fix the exact completing-square test by inserting cleanup after the solve-prefix block.
start = s.index("def algebra_fast_path(text):")
end = s.index("\ndef _arith_eval", start)
section = s[start:end]

needle = '            "", raw\n        )\n        body = re.sub(r"\\band give\\b.*$", "", body)'
replacement = (
    '            "", raw\n        )\n'
    '        body = re.sub(r"\\s+by completing the square\\b.*$", "", body)\n'
    '        body = re.sub(r"\\band give\\b.*$", "", body)'
)
if section.count(needle) != 1:
    raise SystemExit("STOP: solve cleanup anchor mismatch; no file written")
section = section.replace(needle, replacement, 1)
s = s[:start] + section + s[end:]

# Correct the whitespace normalization typo.
s = s.replace(
    'normalized = re.sub(r"\\\\s+", " ", raw).strip()',
    'normalized = re.sub(r"\\s+", " ", raw).strip()',
    1
)

# Dispatch calculus before algebra.
anchor = 'def model_chat(model, messages):\n    _algebra = algebra_fast_path(messages[-1]["content"])\n'
if s.count(anchor) != 1:
    raise SystemExit("STOP: model_chat anchor mismatch; no file written")
s = s.replace(
    anchor,
    'def model_chat(model, messages):\n'
    '    _calculus = calculus_fast_path(messages[-1]["content"])\n'
    '    if _calculus is not None:\n'
    '        sys.stdout.write(_calculus + "\\n")\n'
    '        sys.stdout.flush()\n'
    '        return _calculus\n'
    '    _algebra = algebra_fast_path(messages[-1]["content"])\n',
    1
)

p.write_text(s)
print("PATCH_OK")
PY

2. Compile and verify the patch

python3 -m py_compile /tmp/llm.new &&
grep -nE '^(def calculus_fast_path|def algebra_fast_path|def arith_fast_path|def model_chat)' /tmp/llm.new

You should see PATCH_OK and all four function definitions. If the patch prints an ERROR, stop and do not install it.

